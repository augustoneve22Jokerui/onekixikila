    color: var(--ok-text-secondary);
    font-size: 0.82rem;
    line-height: 1.55;
    padding: 0.85rem 1rem;
    display: flex; align-items: flex-start; gap: 8px;
    margin-bottom: 20px;
  }
  .admin-note i { color: var(--ok-purple-vibrant); flex-shrink: 0; }
  .admin-note.warning {
    background: var(--ok-color-token-028);
    border-color: var(--ok-color-token-029);
    color: var(--ok-color-token-030);
  }
  .admin-note.warning i { color: var(--ok-color-token-031); }

  /* =========================================================================
     FILTROS
     ========================================================================= */
  .kyc-filter-card { padding: 1.15rem 1.25rem; }
  .kyc-filter-card h2 {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--ok-text-primary);
    margin: 0;
    font-family: 'Space Grotesk', sans-serif;
  }
  .kyc-filter-card .form-label {
    font-size: 0.72rem;
    color: var(--ok-text-muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .kyc-filter-card .form-control,
  .kyc-filter-card .form-select,
  .kyc-modal .form-control,
  .kyc-modal .form-select {
    background: var(--ok-bg-elevated) !important;
    border: 1px solid var(--ok-border-strong) !important;
    color: var(--ok-text-primary) !important;
    min-height: 43px;
    border-radius: var(--ok-radius-md);
  }
  .kyc-filter-card .form-control::placeholder,
  .kyc-modal textarea::placeholder { color: var(--ok-text-muted); }
  .kyc-filter-card .form-control:focus,
  .kyc-filter-card .form-select:focus,
  .kyc-modal .form-control:focus,
  .kyc-modal .form-select:focus {
    border-color: var(--ok-purple-vibrant) !important;
    box-shadow: 0 0 0 3px var(--ok-purple-soft) !important;
  }
  .kyc-filter-card option,
  .kyc-modal option { background: var(--ok-bg-elevated); color: var(--ok-text-primary); }
  .kyc-filter-card .input-group-text {
    background: var(--ok-bg-elevated);
    border: 1px solid var(--ok-border-strong);
    color: var(--ok-text-muted);
    border-radius: var(--ok-radius-md) 0 0 var(--ok-radius-md);
  }
  .kyc-filter-card .input-group .form-control {
    border-radius: 0 var(--ok-radius-md) var(--ok-radius-md) 0 !important;
  }

  .btn-primary-ok {
    background: linear-gradient(135deg, var(--ok-color-token-008) 0%, var(--ok-color-token-009) 100%);
    border: none;
    color: var(--ok-color-token-010);
    border-radius: var(--ok-radius-md);
    min-height: 43px;
    font-weight: 700;
    box-shadow: 0 6px 18px var(--ok-color-token-032);
    transition: all 0.2s ease;
  }
  .btn-primary-ok:hover { transform: translateY(-1px); color: var(--ok-color-token-013); }
  .btn-ghost-ok {
    background: var(--ok-pill-bg);
    border: 1px solid var(--ok-border-subtle);
    color: var(--ok-text-primary);
    border-radius: var(--ok-radius-md);
    min-height: 43px;
    font-weight: 700;
    transition: all 0.2s ease;
  }
  .btn-ghost-ok:hover {
    background: var(--ok-pill-bg-hover);
    color: var(--ok-purple-vibrant);
  }

  /* =========================================================================
     TABELA KYC
     ========================================================================= */
  .kyc-table-wrap {
    overflow: auto;
    border-radius: var(--ok-radius-window);
  }
  .kyc-table { min-width: 980px; margin: 0; }
  .kyc-table thead th {
    color: var(--ok-text-muted);
    background: var(--ok-color-token-033);
    border-bottom: 1px solid var(--ok-border-subtle);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.95rem 0.85rem;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .kyc-table tbody td {
    border-bottom: 1px solid var(--ok-border-subtle);
    color: var(--ok-text-secondary);
    padding: 0.95rem 0.85rem;
    vertical-align: middle;
    font-size: 0.84rem;
  }
  .kyc-table tbody tr:last-child td { border-bottom: 0; }
  .kyc-table tbody tr { transition: background 0.15s ease; }
  .kyc-table tbody tr:hover { background: var(--ok-stream-hover); }

  .kyc-avatar {
    align-items: center;
    background: linear-gradient(140deg, var(--ok-color-token-034), var(--ok-color-token-035));
    border: 1px solid var(--ok-purple-border);
    border-radius: var(--ok-radius-md);
    color: var(--ok-color-token-036);
    display: inline-flex;
    flex: 0 0 40px;
    font-size: 0.84rem;
    font-weight: 800;
    height: 40px;
    justify-content: center;
    width: 40px;
  }
  .kyc-name {
    color: var(--ok-text-primary);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .kyc-subtext {
    color: var(--ok-text-muted);
    font-size: 0.72rem;
    margin-top: 0.2rem;
    overflow-wrap: anywhere;
  }

  .kyc-badge {
    border: 1px solid transparent;
    border-radius: var(--ok-radius-pill);
    display: inline-flex;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.025em;
    padding: 0.34rem 0.58rem;
    white-space: nowrap;
    text-transform: uppercase;
  }
  .kyc-state-review { background: var(--ok-color-token-037); border-color: var(--ok-color-token-038); color: var(--ok-color-token-031); }
  .kyc-state-pending { background: var(--ok-color-token-039); border-color: var(--ok-color-token-040); color: var(--ok-color-token-041); }
  .kyc-state-approved { background: var(--ok-color-token-042); border-color: var(--ok-color-token-043); color: var(--ok-color-token-044); }
  .kyc-state-rejected { background: var(--ok-color-token-045); border-color: var(--ok-color-token-046); color: var(--ok-color-token-047); }
  .kyc-state-other, .kyc-tier { background: var(--ok-pill-bg); border-color: var(--ok-border-subtle); color: var(--ok-text-secondary); }

  .kyc-actions { display: flex; justify-content: flex-end; gap: 0.4rem; }
  .kyc-actions .btn {
    align-items: center;
    display: inline-flex;
    justify-content: center;
    min-height: 36px;
    min-width: 36px;
    border-radius: var(--ok-radius-circle);
    transition: all 0.15s ease;
  }
  .kyc-actions .btn:hover { transform: translateY(-1px); }

  /* =========================================================================
     PAGINAÇÃO
     ========================================================================= */
  .kyc-card-footer {
    align-items: center;
    border-top: 1px solid var(--ok-border-subtle);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: space-between;
    padding: 1rem 1.2rem;
  }
  .kyc-pagination {
    display: flex; flex-wrap: wrap; gap: 0.35rem;
    list-style: none; margin: 0; padding: 0;
  }
  .kyc-pagination button {
    background: var(--ok-bg-elevated);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 9px;
    color: var(--ok-text-secondary);
    min-width: 36px;
    padding: 0.4rem 0.65rem;
    font-weight: 700;
    transition: all 0.15s ease;
    cursor: pointer;
  }
  .kyc-pagination button:hover:not(:disabled),
  .kyc-pagination button.is-current {
    background: var(--ok-purple-soft);
    border-color: var(--ok-purple-border);
    color: var(--ok-purple-vibrant);
  }
  .kyc-pagination button.is-current {
    background: linear-gradient(135deg, var(--ok-color-token-008) 0%, var(--ok-color-token-009) 100%);
    color: var(--ok-color-token-010);
  }
  .kyc-pagination button:disabled { cursor: not-allowed; opacity: 0.4; }

  /* =========================================================================
     ESTADOS
     ========================================================================= */
  .kyc-state-box {
    border: 1px dashed var(--ok-border-strong);
    border-radius: var(--ok-radius-window);
    color: var(--ok-text-muted);
    padding: 2.75rem 1rem;
    text-align: center;
    background: var(--ok-bg-surface);
  }
  .kyc-state-box i {
    color: var(--ok-purple-vibrant);
    display: block;
    font-size: 1.7rem;
    margin-bottom: 0.7rem;
  }

  /* =========================================================================
     ✦ MODAIS ULTRA APPLE LIGHT ✦
     ========================================================================= */
  .kyc-modal .modal-dialog {
    max-width: 620px;
    width: calc(100% - 2rem);
    margin: 1.75rem auto;
  }
  .kyc-modal .modal-dialog.modal-lg { max-width: 680px; }
  .kyc-modal .modal-dialog.modal-xl { max-width: 780px; }
  .kyc-modal .modal-dialog.modal-wide { max-width: 920px; }

  .kyc-modal .modal-content {
    background: var(--ok-bg-window);
    border: 1px solid var(--ok-border-subtle);
    border-radius: var(--ok-radius-window);
    color: var(--ok-text-primary);
    box-shadow: var(--ok-shadow-window);
    overflow: hidden;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
  }

  .kyc-modal .modal-header {
    padding: 1rem 1.15rem;
    border-bottom: 1px solid var(--ok-divider);
    background: var(--ok-glass-tint-strong);
    align-items: center;
    gap: 0.75rem;
  }
  .kyc-modal .modal-title {
    font-family: 'Space Grotesk', 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--ok-text-primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .kyc-modal .modal-title i { color: var(--ok-purple-vibrant); }
  .kyc-modal .modal-footer {
    padding: 0.85rem 1.15rem;
    border-top: 1px solid var(--ok-divider);
    background: var(--ok-glass-tint);
    gap: 0.5rem;
  }
  .kyc-modal .btn-close {
    background: transparent;
    opacity: 0.65;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    filter: none;
    background-image: none;
    position: relative;
    transition: all 0.15s ease;
    box-shadow: none;
  }
  .kyc-modal .btn-close::before {
    content: '×';
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--ok-text-muted);
    line-height: 1;
  }
  .kyc-modal .btn-close:hover { opacity: 1; background: var(--ok-pill-bg); }
  .kyc-modal .btn-close:hover::before { color: var(--ok-text-primary); }
  html[data-theme="light"] .kyc-modal .btn-close { filter: none; }
  html[data-theme="light"] .kyc-modal .btn-close::before { color: var(--ok-text-muted); }
  html[data-theme="light"] .kyc-modal .btn-close:hover::before { color: var(--ok-text-primary); }

  .kyc-modal .modal-body {
    padding: 1.15rem 1.2rem;
    background: var(--ok-bg-window);
  }

  /* Timeline multi-etapa */
  .kyc-timeline {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.85rem;
    background: var(--ok-bg-window-inner);
    border-bottom: 1px solid var(--ok-divider);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .kyc-timeline::-webkit-scrollbar { display: none; }

  .kyc-step {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.65rem 0.35rem 0.35rem;
    border-radius: var(--ok-radius-pill);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ok-text-muted);
    white-space: nowrap;
    transition: all 0.25s ease;
    border: 1px solid transparent;
    flex-shrink: 0;
  }
  .kyc-step .dot {
    width: 22px; height: 22px;
    border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--ok-pill-bg);
    border: 1px solid var(--ok-border-subtle);
    font-size: 0.62rem;
    font-weight: 800;
    color: var(--ok-text-muted);
    transition: all 0.25s ease;
    flex-shrink: 0;
  }
  .kyc-step.active {
    background: var(--ok-purple-soft);
    color: var(--ok-purple-vibrant);
    border-color: var(--ok-purple-border);
  }
  .kyc-step.active .dot {
    background: var(--ok-purple-vibrant);
    color: var(--ok-color-token-010);
    border-color: var(--ok-purple-vibrant);
    box-shadow: 0 4px 12px var(--ok-color-token-011);
  }
  .kyc-step.done {
    color: var(--ok-color-token-017);
  }
  .kyc-step.done .dot {
    background: var(--ok-color-token-015);
    border-color: var(--ok-color-token-016);
    color: var(--ok-color-token-017);
  }
  .kyc-step.done .dot::before { content: '✓'; }
  .kyc-step.done .dot span { display: none; }

  .kyc-step-sep {
    width: 14px; height: 1.5px;
    background: var(--ok-border-subtle);
    flex-shrink: 0;
  }
  .kyc-step-sep.done { background: var(--ok-color-token-016); }

  /* Painéis de etapa */
  .kyc-pane {
    display: none;
    animation: kycFadeIn 0.3s ease;
  }
  .kyc-pane.active { display: block; }
  @keyframes kycFadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .kyc-pane-title {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ok-purple-vibrant);
    margin: 0 0 0.75rem;
  }

  /* Grid de campos compactos */
  .kyc-field-grid {
    display: grid;
    gap: 0.65rem;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
  .kyc-field {
    background: var(--ok-bg-window-inner);
    border: 1px solid var(--ok-divider);
    border-radius: var(--ok-radius-inner);
    padding: 0.7rem 0.85rem;
    transition: all 0.15s ease;
  }
  .kyc-field:hover { border-color: var(--ok-border-strong); }
  .kyc-field-label {
    display: block;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ok-text-muted);
    margin-bottom: 0.28rem;
  }
  .kyc-field-value {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ok-text-primary);
    overflow-wrap: anywhere;
    line-height: 1.4;
  }
  .kyc-field-value.mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.02em;
  }

  /* Cartão de documento com thumbnail */
  .kyc-doc-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .kyc-doc-tile {
    background: var(--ok-bg-window-inner);
    border: 1px solid var(--ok-divider);
    border-radius: var(--ok-radius-inner);
    overflow: hidden;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
  }
  .kyc-doc-tile:hover {
    border-color: var(--ok-purple-border);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px var(--ok-shadow-card);
  }
  .kyc-doc-thumb {
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, var(--ok-bg-window) 0%, var(--ok-bg-window-inner) 100%);
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-purple-vibrant);
    font-size: 2rem;
    border-bottom: 1px solid var(--ok-divider);
    position: relative;
    overflow: hidden;
  }
  .kyc-doc-thumb img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .kyc-doc-thumb .file-badge {
    position: absolute;
    top: 8px; left: 8px;
    background: var(--ok-glass-tint-strong);
    border: 1px solid var(--ok-border-subtle);
    border-radius: var(--ok-radius-pill);
    padding: 2px 8px;
    font-size: 0.62rem;
    font-weight: 800;
    color: var(--ok-text-secondary);
    backdrop-filter: blur(10px);
  }
  .kyc-doc-body {
    padding: 0.75rem 0.85rem;
    display: flex; flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }
  .kyc-doc-name {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--ok-text-primary);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .kyc-doc-meta {
    font-size: 0.7rem;
    color: var(--ok-text-muted);
    display: flex; gap: 6px; flex-wrap: wrap;
    align-items: center;
  }
  .kyc-doc-meta .dot-sep { opacity: 0.4; }
  .kyc-doc-footer {
    display: flex; gap: 0.4rem;
    padding: 0 0.85rem 0.85rem;
  }

  /* Botões circulares Apple */
  .ok-icon-btn {
    width: 36px; height: 36px;
    border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--ok-border-subtle);
    background: var(--ok-bg-elevated);
    color: var(--ok-text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
    padding: 0;
  }
  .ok-icon-btn:hover {
    background: var(--ok-purple-soft);
    border-color: var(--ok-purple-border);
    color: var(--ok-purple-vibrant);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px var(--ok-shadow-card);
  }
  .ok-icon-btn.primary {
    background: linear-gradient(135deg, var(--ok-color-token-008) 0%, var(--ok-color-token-009) 100%);
    border-color: transparent;
    color: var(--ok-color-token-010);
    box-shadow: 0 6px 16px var(--ok-color-token-032);
  }
  .ok-icon-btn.primary:hover { transform: translateY(-1px) scale(1.03); color: var(--ok-color-token-010); }
  .ok-icon-btn.ghost { background: transparent; }
  .ok-icon-btn.ghost:hover { background: var(--ok-pill-bg); }
  .ok-icon-btn.lg { width: 44px; height: 44px; }
  .ok-icon-btn.sm { width: 32px; height: 32px; }
  .ok-icon-btn[disabled] { opacity: 0.5; cursor: not-allowed; }

  .ok-icon-btn svg { width: 16px; height: 16px; }
  .ok-icon-btn.lg svg { width: 18px; height: 18px; }
  .ok-icon-btn.sm svg { width: 14px; height: 14px; }

  /* Wizard footer Apple */
  .kyc-wizard-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.85rem 1.15rem;
    border-top: 1px solid var(--ok-divider);
    background: var(--ok-glass-tint);
    flex-wrap: wrap;
  }
  .kyc-wizard-progress {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ok-text-muted);
    letter-spacing: 0.02em;
  }
  .kyc-wizard-progress strong { color: var(--ok-purple-vibrant); }
  .kyc-wizard-actions { display: flex; gap: 0.4rem; align-items: center; }

  .ok-btn-apple {
    height: 38px;
    padding: 0 16px;
    border-radius: var(--ok-radius-pill);
    display: inline-flex; align-items: center; justify-content: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
    white-space: nowrap;
  }
  .ok-btn-apple.primary {
    background: linear-gradient(135deg, var(--ok-color-token-008) 0%, var(--ok-color-token-009) 100%);
    color: var(--ok-color-token-010);
    box-shadow: 0 6px 18px var(--ok-color-token-032);
  }
  .ok-btn-apple.primary:hover { transform: translateY(-1px); box-shadow: 0 10px 24px var(--ok-color-token-032); color: var(--ok-color-token-010); }
  .ok-btn-apple.secondary {
    background: var(--ok-pill-bg);
    color: var(--ok-text-primary);
    border: 1px solid var(--ok-border-subtle);
  }
  .ok-btn-apple.secondary:hover {
    background: var(--ok-pill-bg-hover);
    color: var(--ok-purple-vibrant);
    border-color: var(--ok-purple-border);
  }
  .ok-btn-apple.ghost {
    background: transparent;
    color: var(--ok-text-secondary);
  }
  .ok-btn-apple.ghost:hover { color: var(--ok-purple-vibrant); background: var(--ok-pill-bg); }
  .ok-btn-apple[disabled] { opacity: 0.5; cursor: not-allowed; }

  /* Visualizador de documento em tempo real */
  .kyc-viewer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    min-height: 420px;
  }
  .kyc-viewer-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0.55rem 0.75rem;
    background: var(--ok-bg-window-inner);
    border: 1px solid var(--ok-divider);
    border-radius: var(--ok-radius-inner);
  }
  .kyc-viewer-meta {
    display: flex; align-items: center; gap: 0.5rem;
    flex-wrap: wrap;
    min-width: 0;
  }
  .kyc-viewer-filename {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--ok-text-primary);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    max-width: 260px;
  }
  .kyc-viewer-tools { display: flex; gap: 0.35rem; flex-shrink: 0; }
  .kyc-viewer-stage {
    flex: 1;
    min-height: 340px;
    max-height: 60vh;
    display: flex; align-items: center; justify-content: center;
    background:
      radial-gradient(circle at 30% 20%, var(--ok-color-token-057) 0%, transparent 55%),
      radial-gradient(circle at 70% 80%, var(--ok-color-token-058) 0%, transparent 55%),
      var(--ok-bg-window-inner);
    border: 1px solid var(--ok-divider);
    border-radius: var(--ok-radius-inner);
    overflow: hidden;
    position: relative;
  }
  .kyc-viewer-stage img,
  .kyc-viewer-stage iframe {
    max-width: 100%;
    max-height: 100%;
    border: none;
    display: block;
    border-radius: 8px;
    background: var(--ok-color-white);
  }
  .kyc-viewer-stage img {
    object-fit: contain;
    cursor: zoom-in;
    transition: transform 0.3s ease;
  }
  .kyc-viewer-stage img.zoomed {
    cursor: zoom-out;
    transform: scale(1.6);
    z-index: 5;
  }
  .kyc-viewer-stage iframe {
    width: 100%;
    height: 100%;
    min-height: 340px;
  }
  .kyc-viewer-stage .state-hint {
    text-align: center;
    color: var(--ok-text-muted);
    font-size: 0.85rem;
    padding: 2rem 1rem;
  }
  .kyc-viewer-stage .state-hint i {
    display: block;
    font-size: 2.4rem;
    color: var(--ok-purple-vibrant);
    margin-bottom: 0.85rem;
  }

  /* Animações de entrada dos modais */
  .kyc-modal.fade .modal-dialog {
    transform: scale(0.96) translateY(8px);
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.28s ease;
  }
  .kyc-modal.show .modal-dialog {
    transform: scale(1) translateY(0);
  }

  /* Header summary do titular */
  .kyc-header-summary {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    margin-bottom: 0.85rem;
    background: var(--ok-bg-window-inner);
    border: 1px solid var(--ok-divider);
    border-radius: var(--ok-radius-inner);
  }
  .kyc-header-summary .avatar {
    width: 44px; height: 44px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(140deg, var(--ok-color-token-034), var(--ok-color-token-035));
    border: 1px solid var(--ok-purple-border);
    color: var(--ok-color-token-036);
    font-weight: 800;
    font-size: 1rem;
    flex-shrink: 0;
  }
  .kyc-header-summary .info { min-width: 0; flex: 1; }
  .kyc-header-summary .name {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--ok-text-primary);
    margin: 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .kyc-header-summary .sub {
    font-size: 0.72rem;
    color: var(--ok-text-muted);
    margin: 0.15rem 0 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .kyc-header-summary .badges {
    display: flex; gap: 0.35rem; flex-wrap: wrap;
    margin-top: 0.35rem;
  }

  /* Campos de formulário */
  .kyc-pane .form-label {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ok-text-muted);
    margin-bottom: 0.35rem;
  }

  /* Cartão de confirmação final */
  .kyc-confirm-card {
    background: var(--ok-bg-window-inner);
    border: 1px solid var(--ok-divider);
    border-radius: var(--ok-radius-inner);
    padding: 1rem;
    display: flex; flex-direction: column; gap: 0.65rem;
  }
  .kyc-confirm-row {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.82rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--ok-divider);
  }
  .kyc-confirm-row:last-child { border-bottom: 0; }
  .kyc-confirm-row .label {
    color: var(--ok-text-muted);
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }
  .kyc-confirm-row .value {
    color: var(--ok-text-primary);
    font-weight: 600;
    text-align: right;
    overflow-wrap: anywhere;
  }

  /* Alerta inline */
  #kyc-page-alert {
    margin-bottom: 16px;
    border-radius: var(--ok-radius-md);
    font-size: 0.85rem;
  }

  /* =========================================================================
     FOOTER
     ========================================================================= */
  .admin-footer {
    border-top: 1px solid var(--ok-border-subtle);
    background: var(--ok-color-transparent);
    padding: 1rem 1.25rem;
    text-align: center;
    color: var(--ok-text-muted);
    font-size: 0.78rem;
    position: relative;
    z-index: 1;
    margin-top: 2rem;
  }

  /* =========================================================================
     RESPONSIVIDADE
     ========================================================================= */
  @media (max-width: 1200px) {
    .ok-flat-quad-strip { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 991px) {
    .ok-rail-sidebar { transform: translateX(-120%); }
    body.mobile-nav-active .ok-rail-sidebar { transform: translateX(0); }
    .ok-viewport-shell { margin-left: 0; padding: 16px; }
    .ok-page-title-main { font-size: 1.55rem; }
    .kyc-card-footer { flex-direction: column; align-items: flex-start; }
    .kyc-pagination { width: 100%; }
    .kyc-modal .modal-dialog { max-width: calc(100% - 1.5rem); }
    .kyc-viewer-filename { max-width: 160px; }
  }
  @media (max-width: 600px) {
    .ok-flat-quad-strip { grid-template-columns: 1fr; }
    .ok-profile-pill .admin-profile-text { display: none !important; }
    .ok-search-capsule { width: min(100%, 500px); }
    .kyc-field-grid { grid-template-columns: 1fr; }
    .kyc-doc-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  .text-danger { color: var(--ok-accent-rose) !important; }
  .text-muted { color: var(--ok-text-muted) !important; }
  .btn-outline-info { --bs-btn-color: var(--ok-accent-cyan); --bs-btn-border-color: var(--ok-accent-cyan); --bs-btn-hover-color: var(--ok-text-primary); --bs-btn-hover-bg: var(--ok-accent-cyan); --bs-btn-hover-border-color: var(--ok-accent-cyan); }
  .btn-outline-primary { --bs-btn-color: var(--ok-purple-vibrant); --bs-btn-border-color: var(--ok-purple-vibrant); --bs-btn-hover-color: var(--ok-text-primary); --bs-btn-hover-bg: var(--ok-purple-primary); --bs-btn-hover-border-color: var(--ok-purple-primary); }
  .alert-danger { --bs-alert-color: var(--ok-accent-rose); --bs-alert-bg: var(--ok-color-token-045); --bs-alert-border-color: var(--ok-accent-rose); }
  .alert-warning { --bs-alert-color: var(--ok-accent-amber); --bs-alert-bg: var(--ok-color-token-039); --bs-alert-border-color: var(--ok-accent-amber); }
  .alert-success { --bs-alert-color: var(--ok-color-token-017); --bs-alert-bg: var(--ok-color-token-015); --bs-alert-border-color: var(--ok-accent-emerald); }
  .alert-info { --bs-alert-color: var(--ok-accent-cyan); --bs-alert-bg: var(--ok-color-token-026); --bs-alert-border-color: var(--ok-accent-cyan); }
</style>

