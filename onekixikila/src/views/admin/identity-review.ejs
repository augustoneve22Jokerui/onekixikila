  <%- include('../partials/sweet-alert') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  <script src="/js/api-client.js"></script>
  <script>
    (function () {
      'use strict';

      /* ====================================================================
         TEMA CLARO/ESCURO
         ==================================================================== */
      const THEME_KEY = 'ok-theme';
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-btn');
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        if (!btn) return;
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      /* ====================================================================
         AÇÕES GLOBAIS
         ==================================================================== */
      function setupGlobalActions() {
        const sidebarToggle = document.getElementById('sidebar-toggle-btn');
        sidebarToggle?.addEventListener('click', () => {
          const active = document.body.classList.toggle('mobile-nav-active');
          sidebarToggle.setAttribute('aria-expanded', String(active));
        });
        document.querySelectorAll('.ok-rail-link[href]').forEach((link) => {
          link.addEventListener('click', () => {
            if (window.matchMedia('(max-width: 991px)').matches) {
              document.body.classList.remove('mobile-nav-active');
            }
          });
        });
        const search = document.getElementById('global-dashboard-search');
        document.addEventListener('keydown', (event) => {
          if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
            if (search) { event.preventDefault(); search.focus(); }
          }
        });
        document.querySelectorAll('[data-action="logout"]').forEach((button) => {
          button.addEventListener('click', async (event) => {
            event.preventDefault();
            button.disabled = true;
            try {
              if (window.apiClient && typeof window.apiClient.post === 'function') await window.apiClient.post('/auth/logout', {});
              if (window.apiClient && typeof window.apiClient.clearSession === 'function') window.apiClient.clearSession();
            } catch (_) {}
            window.location.href = '/login';
          });
        });
      }

      /* ====================================================================
         ESTADO E HELPERS KYC
         ==================================================================== */
      const role = String(document.body.dataset.adminRole || '').toUpperCase();
      const actorId = String(document.body.dataset.adminUserId || '');
      const canReview = ['ADMIN', 'AUDITOR'].includes(role);

      const el = {
        loading: document.getElementById('kyc-loading'),
        error: document.getElementById('kyc-error'),
        card: document.getElementById('kyc-table-card'),
        body: document.getElementById('kyc-table-body'),
        search: document.getElementById('kyc-search'),
        status: document.getElementById('kyc-status'),
        tier: document.getElementById('kyc-tier'),
        limit: document.getElementById('kyc-limit'),
        pagination: document.getElementById('kyc-pagination'),
        paginationInfo: document.getElementById('kyc-pagination-info'),
        pill: document.getElementById('kyc-total-pill'),
        alert: document.getElementById('kyc-page-alert')
      };

      let page = 1, pages = 1, seq = 0, records = [], currentVerification = null, activeObjectUrl = null;

      function esc(v) {
        return String(v == null ? '' : v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      }
      function errMsg(e, f) { return e && typeof e.message === 'string' && e.message.trim() ? e.message : f; }
      function showAlert(msg, type) {
        el.alert.className = 'alert alert-' + (type || 'danger');
        el.alert.textContent = String(msg || 'Ocorreu um erro.');
        el.alert.classList.remove('d-none');
        el.alert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      function clearAlert() { el.alert.classList.add('d-none'); el.alert.textContent = ''; }
      function dateFmt(v) {
        if (!v) return '—';
        if (window.App && typeof window.App.formatDate === 'function') {
          try { return window.App.formatDate(v, true); } catch (_) {}
        }
        const d = new Date(v);
        return Number.isNaN(d.getTime()) ? '—' : new Intl.DateTimeFormat('pt-PT', { dateStyle: 'medium', timeStyle: 'short' }).format(d);
      }
      function statusBadge(s) {
        const v = String(s || 'UNKNOWN').toUpperCase();
        const labels = { PENDING: 'Pendente', UNDER_REVIEW: 'Em análise', APPROVED: 'Aprovado', REJECTED: 'Rejeitado', NEEDS_REVIEW: 'Requer revisão', EXPIRED: 'Expirado' };
        const cls = { PENDING: 'kyc-state-pending', UNDER_REVIEW: 'kyc-state-review', APPROVED: 'kyc-state-approved', REJECTED: 'kyc-state-rejected', NEEDS_REVIEW: 'kyc-state-pending', EXPIRED: 'kyc-state-other' };
        return '<span class="kyc-badge ' + (cls[v] || 'kyc-state-other') + '" title="' + esc(v) + '">' + esc(labels[v] || v) + '</span>';
      }
      function tierBadge(t) {
        const v = String(t || 'TIER_1_UNVERIFIED').toUpperCase();
        const labels = { TIER_1_UNVERIFIED: 'Nível 1', TIER_2_VERIFIED: 'Nível 2', TIER_3_ENHANCED: 'Nível 3' };
        return '<span class="kyc-badge kyc-tier" title="' + esc(v) + '">' + esc(labels[v] || v) + '</span>';
      }
      function idTypeLabel(t) {
        const m = { NATIONAL_ID: 'Bilhete de Identidade', PASSPORT: 'Passaporte', DRIVING_LICENSE: 'Carta de condução', FACIAL_PHOTO: 'Fotografia facial', PROOF_OF_ADDRESS: 'Comprovativo de residência' };
        return m[String(t || '').toUpperCase()] || String(t || '—');
      }
      function maskId(value) {
        const raw = String(value || '');
        return raw.length <= 4 ? '••••' : '••••••' + raw.slice(-4);
      }
      function allowedDecisions(v) {
        if (!v) return [];
        const status = String(v.status || '').toUpperCase();
        const map = { PENDING: ['REJECTED'], UNDER_REVIEW: ['APPROVED', 'REJECTED', 'NEEDS_REVIEW'], NEEDS_REVIEW: ['REJECTED'], REJECTED: [], APPROVED: ['NEEDS_REVIEW'], EXPIRED: [] };
        return map[status] || [];
      }
      function reviewAllowed(v) {
        return canReview && Boolean(actorId) && v && String(v.user_id || v.userId || '') !== actorId && allowedDecisions(v).length > 0;
      }
      function summary(data, p) {
        const total = Number(p && (p.totalItems ?? p.totalCount));
        document.getElementById('stat-total').textContent = Number.isFinite(total) ? String(total) : String(data.length);
        document.getElementById('stat-review').textContent = String(data.filter(x => String(x.status || '').toUpperCase() === 'UNDER_REVIEW').length);
        document.getElementById('stat-approved').textContent = String(data.filter(x => String(x.status || '').toUpperCase() === 'APPROVED').length);
        document.getElementById('stat-attention').textContent = String(data.filter(x => ['PENDING', 'NEEDS_REVIEW', 'REJECTED', 'EXPIRED'].includes(String(x.status || '').toUpperCase())).length);
        el.pill.textContent = (Number.isFinite(total) ? total : data.length) + ' processo(s)';
      }
      function render(data) {
        if (!data.length) {
          el.body.innerHTML = '<tr><td colspan="7"><div class="kyc-state-box m-3"><i class="bi bi-person-check" aria-hidden="true"></i><strong class="d-block mb-1" style="color:var(--ok-text-primary);">Nenhum processo encontrado</strong><span>Altere os filtros ou tente uma pesquisa diferente.</span></div></td></tr>';
          return;
        }
        el.body.innerHTML = data.map(v => {
          const id = String(v.id || '');
          const name = String(v.full_name_on_document || v.fullNameOnDocument || v.user_full_name || v.user_registered_name || 'Nome não indicado');
          const email = String(v.email || v.user_email || '—');
          const phone = String(v.phone_number || v.phoneNumber || '—');
          const status = String(v.status || '').toUpperCase();
          const canAct = reviewAllowed(v);
          let actions = '<button type="button" class="btn btn-sm btn-outline-info" data-action="details" data-verification-id="' + esc(id) + '" aria-label="Ver processo KYC de ' + esc(name) + '" title="Ficha e documentos"><i class="bi bi-eye" aria-hidden="true"></i></button>';
          if (canAct) actions += '<button type="button" class="btn btn-sm btn-outline-primary" data-action="review" data-verification-id="' + esc(id) + '" aria-label="Emitir parecer KYC de ' + esc(name) + '" title="Emitir parecer"><i class="bi bi-clipboard-check" aria-hidden="true"></i></button>';
          return '<tr>' +
            '<td class="ps-4"><div class="d-flex align-items-center gap-3"><span class="kyc-avatar" aria-hidden="true">' + esc(name.trim().charAt(0).toUpperCase() || 'K') + '</span><div><div class="kyc-name">' + esc(name) + '</div><div class="kyc-subtext kyc-sensitive">Documento: ' + esc(maskId(v.id_number || v.idNumber)) + '</div></div></div></td>' +
            '<td><div class="kyc-name">' + esc(email) + '</div><div class="kyc-subtext">' + esc(phone) + '</div></td>' +
            '<td><span class="small">' + esc(idTypeLabel(v.id_type || v.idType)) + '</span></td>' +
            '<td>' + tierBadge(v.tier) + '</td>' +
            '<td>' + statusBadge(status) + '</td>' +
            '<td><span class="small" style="color:var(--ok-text-muted);">' + esc(dateFmt(v.submitted_at || v.submittedAt)) + '</span></td>' +
            '<td class="text-end pe-4"><div class="kyc-actions">' + actions + '</div></td>' +
            '</tr>';
        }).join('');
      }
      function renderPagination(p) {
        const current = Number(p && (p.currentPage ?? p.page));
        const count = Number(p && (p.totalPages ?? p.total_pages));
        if (Number.isFinite(current) && current > 0) page = current;
        pages = Number.isFinite(count) && count > 0 ? count : 1;
        const total = Number(p && (p.totalItems ?? p.totalCount));
        const limit = Number(el.limit.value) || 15;
        const first = total > 0 ? (page - 1) * limit + 1 : 0;
        const last = total > 0 ? Math.min(page * limit, total) : 0;
        el.paginationInfo.textContent = pages > 1 ? ('A mostrar ' + first + '–' + last + ' de ' + total + ' · Página ' + page + ' de ' + pages) : (total > 0 ? ('A mostrar ' + first + '–' + last + ' de ' + total + ' processo(s)') : 'Sem resultados');
        const nums = Array.from(new Set([1, pages, page - 1, page, page + 1].filter(n => n >= 1 && n <= pages))).sort((a, b) => a - b);
        let html = '<li><button type="button" data-page="' + (page - 1) + '" ' + (page <= 1 ? 'disabled' : '') + ' aria-label="Página anterior"><i class="bi bi-chevron-left" aria-hidden="true"></i></button></li>';
        let lastNum = 0;
        nums.forEach(n => {
          if (lastNum && n - lastNum > 1) html += '<li class="text-muted px-1 align-self-center" aria-hidden="true" style="color:var(--ok-text-muted);">…</li>';
          html += '<li><button type="button" data-page="' + n + '" class="' + (n === page ? 'is-current' : '') + '" ' + (n === page ? 'aria-current="page"' : '') + '>' + n + '</button></li>';
          lastNum = n;
        });
        html += '<li><button type="button" data-page="' + (page + 1) + '" ' + (page >= pages ? 'disabled' : '') + ' aria-label="Página seguinte"><i class="bi bi-chevron-right" aria-hidden="true"></i></button></li>';
        el.pagination.innerHTML = html;
      }

      /* ====================================================================
         CARREGAR FILA
         ==================================================================== */
      async function loadQueue(requestedPage) {
        if (!canReview) {
          el.loading.classList.add('d-none');
          el.card.classList.add('d-none');
          el.error.innerHTML = '<i class="bi bi-shield-lock" aria-hidden="true"></i><strong class="d-block mb-2" style="color:var(--ok-text-primary);">Acesso de revisão restrito</strong><span>A fila de conformidade e os pareceres KYC estão reservados a ADMIN e AUDITOR. O servidor permanece como autoridade de autorização.</span>';
          el.error.classList.remove('d-none');
          return;
        }
        if (!window.apiClient || typeof window.apiClient.get !== 'function') {
          el.loading.classList.add('d-none');
          el.card.classList.add('d-none');
          el.error.innerHTML = '<i class="bi bi-plug" aria-hidden="true"></i><strong class="d-block mb-2" style="color:var(--ok-text-primary);">Cliente da API indisponível</strong><span>Não é seguro carregar documentos ou emitir pareceres sem o cliente da API. Recarregue a página e tente novamente.</span><div class="mt-3"><button type="button" class="btn btn-sm btn-ghost-ok" id="kyc-retry-btn"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Tentar novamente</button></div>';
          el.error.classList.remove('d-none');
          return;
        }
        const thisSeq = ++seq;
        page = requestedPage || 1;
        clearAlert();
        el.error.classList.add('d-none');
        el.card.classList.add('d-none');
        el.loading.classList.remove('d-none');
        el.loading.innerHTML = '<span class="spinner-border spinner-border-sm me-2" style="color:var(--ok-purple-vibrant);" aria-hidden="true"></span>A carregar a fila de conformidade…';
        const q = new URLSearchParams({ page: String(page), limit: String(Number(el.limit.value) || 15) });
        const search = el.search.value.trim();
        if (search) q.set('search', search);
        if (el.status.value) q.set('status', el.status.value);
        if (el.tier.value) q.set('tier', el.tier.value);
        try {
          const response = await window.apiClient.get('/identity/queue?' + q.toString());
          if (thisSeq !== seq) return;
          if (!response || response.success === false) throw new Error('A resposta da API não contém uma fila KYC válida.');
          const payload = response.data && response.data.data ? response.data.data : response.data;
          const pageRows = Array.isArray(payload) ? payload : (payload && (payload.items || payload.verifications || payload.records || payload.results));
          if (!Array.isArray(pageRows)) throw new Error('A resposta da API não contém uma fila KYC válida.');
          records = pageRows;
          const pagination = response.pagination || (payload && payload.pagination) || {};
          render(records);
          renderPagination(pagination);
          summary(records, pagination);
          el.loading.classList.add('d-none');
          el.card.classList.remove('d-none');
        } catch (error) {
          if (thisSeq !== seq) return;
          el.loading.classList.add('d-none');
          el.card.classList.add('d-none');
          el.error.innerHTML = '<i class="bi bi-exclamation-triangle" aria-hidden="true"></i><strong class="d-block mb-2" style="color:var(--ok-text-primary);">Não foi possível carregar a fila KYC</strong><span>' + esc(errMsg(error, 'Falha de comunicação com o servidor.')) + '</span><div class="mt-3"><button type="button" class="btn btn-sm btn-ghost-ok" id="kyc-retry-btn"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Tentar novamente</button></div>';
          el.error.classList.remove('d-none');
        }
      }

      /* ====================================================================
         HELPERS DE MODAL
         ==================================================================== */
      function modal(id) {
        if (!window.bootstrap || !window.bootstrap.Modal) {
          showAlert('Os componentes de interface não foram inicializados. Recarregue a página antes de continuar.', 'warning');
          return null;
        }
        return window.bootstrap.Modal.getOrCreateInstance(document.getElementById(id));
      }
      function field(label, value, opts) {
        const o = opts || {};
        return '<div class="kyc-field"><span class="kyc-field-label">' + esc(label) + '</span><span class="kyc-field-value' + (o.mono ? ' mono' : '') + '">' + esc(value == null || value === '' ? '—' : value) + '</span></div>';
      }
      function detail(label, value) { return field(label, value); }
      function bytesText(value) {
        const n = Number(value);
        if (!Number.isFinite(n) || n < 0) return '—';
        if (n < 1024) return n + ' B';
        if (n < 1048576) return (n / 1024).toFixed(1) + ' KB';
        return (n / 1048576).toFixed(2) + ' MB';
      }

      /* ====================================================================
         WIZARD — CONTROLE DE ETAPAS (DETALHE)
         ==================================================================== */
      let detailStep = 1;
      const detailStepCount = 4;
      function setDetailStep(step) {
        detailStep = Math.max(1, Math.min(detailStepCount, step));
        document.querySelectorAll('#modal-kyc-details .kyc-pane').forEach(p => {
          p.classList.toggle('active', Number(p.dataset.pane) === detailStep);
        });
        const timeline = document.getElementById('details-timeline');
        if (timeline) {
          timeline.querySelectorAll('.kyc-step').forEach(el => {
            const n = Number(el.dataset.step);
            el.classList.toggle('active', n === detailStep);
            el.classList.toggle('done', n < detailStep);
          });
          timeline.querySelectorAll('.kyc-step-sep').forEach(el => {
            const n = Number(el.dataset.sep);
            el.classList.toggle('done', n < detailStep);
          });
        }
        const cur = document.getElementById('details-step-current');
        if (cur) cur.textContent = String(detailStep);
        const prev = document.getElementById('details-prev-btn');
        const next = document.getElementById('details-next-btn');
        const reviewBtn = document.getElementById('detail-review-btn');
        if (prev) prev.disabled = detailStep <= 1;
        if (next) next.classList.toggle('d-none', detailStep >= detailStepCount);
        if (reviewBtn) {
          const showReview = detailStep === detailStepCount && currentVerification && reviewAllowed(currentVerification);
          reviewBtn.classList.toggle('d-none', !showReview);
        }
      }

      /* ====================================================================
         WIZARD — CONTROLE DE ETAPAS (PARECER)
         ==================================================================== */
      let reviewStep = 1;
      const reviewStepCount = 4;
      function setReviewStep(step) {
        reviewStep = Math.max(1, Math.min(reviewStepCount, step));
        document.querySelectorAll('#modal-kyc-review .kyc-pane').forEach(p => {
          p.classList.toggle('active', Number(p.dataset.pane) === reviewStep);
        });
        const timeline = document.getElementById('review-timeline');
        if (timeline) {
          timeline.querySelectorAll('.kyc-step').forEach(el => {
            const n = Number(el.dataset.step);
            el.classList.toggle('active', n === reviewStep);
            el.classList.toggle('done', n < reviewStep);
          });
          timeline.querySelectorAll('.kyc-step-sep').forEach(el => {
            const n = Number(el.dataset.sep);
            el.classList.toggle('done', n < reviewStep);
          });
        }
        const cur = document.getElementById('review-step-current');
        if (cur) cur.textContent = String(reviewStep);
        const prev = document.getElementById('review-prev-btn');
        const next = document.getElementById('review-next-btn');
        const submit = document.getElementById('review-submit-btn');
        if (prev) prev.disabled = reviewStep <= 1;
        if (next) next.classList.toggle('d-none', reviewStep >= reviewStepCount);
        if (submit) submit.classList.toggle('d-none', reviewStep < reviewStepCount);
        if (reviewStep === reviewStepCount) buildConfirmStep();
      }

      function buildConfirmStep() {
        const v = currentVerification || {};
        const name = v.full_name_on_document || v.user_registered_name || '—';
        const id = v.id || '—';
        const decision = document.getElementById('review-decision').value;
        const tier = document.getElementById('review-tier').value;
        const reason = document.getElementById('review-rejection-reason').value.trim();
        document.getElementById('confirm-name').textContent = name;
        document.getElementById('confirm-id').textContent = id;
        const labels = { APPROVED: 'Aprovar identidade', REJECTED: 'Rejeitar processo', NEEDS_REVIEW: 'Solicitar revisão adicional' };
        document.getElementById('confirm-decision').textContent = labels[decision] || decision;
        document.getElementById('confirm-tier').textContent = tier;
        document.getElementById('confirm-tier-row').style.display = decision === 'APPROVED' ? '' : 'none';
        document.getElementById('confirm-reason').textContent = reason || '—';
      }

      /* ====================================================================
         ABRIR PARECER
         ==================================================================== */
      function openReview(v) {
        if (!canReview) return showAlert('A emissão de parecer exige ADMIN ou AUDITOR.', 'warning');
        if (!reviewAllowed(v)) return showAlert('O backend não permite emitir este parecer para o estado atual do processo.', 'warning');
        currentVerification = v;
        document.getElementById('review-verification-id').value = String(v.id);
        const decisionSelect = document.getElementById('review-decision');
        const allowed = allowedDecisions(v);
        Array.from(decisionSelect.options).forEach(option => { option.hidden = !allowed.includes(option.value); });
        decisionSelect.value = allowed.includes('APPROVED') ? 'APPROVED' : allowed[0];
        document.getElementById('review-tier').value = 'TIER_2_VERIFIED';
        document.getElementById('review-rejection-reason').value = '';
        document.getElementById('review-notes').value = '';

        const name = v.full_name_on_document || v.user_registered_name || 'Titular';
        const avatar = document.getElementById('review-avatar');
        if (avatar) avatar.textContent = (String(name).trim().charAt(0).toUpperCase() || 'K');
        document.getElementById('review-name').textContent = name;
        document.getElementById('review-sub').textContent = v.email || v.user_email || '—';
        document.getElementById('review-badges').innerHTML = statusBadge(v.status) + ' ' + tierBadge(v.tier);

        const grid = document.getElementById('review-data-grid');
        if (grid) {
          grid.innerHTML = [
            field('Nome no documento', v.full_name_on_document || v.user_registered_name),
            field('Tipo de documento', idTypeLabel(v.id_type || v.idType)),
            field('Número do documento', maskId(v.id_number || v.idNumber), { mono: true }),
            field('Data de nascimento', dateFmt(v.birth_date_on_document)),
            field('Validade do documento', dateFmt(v.expiration_date)),
            field('E-mail', v.email || v.user_email),
            field('Telefone', v.phone_number || v.phoneNumber),
            field('Submetido em', dateFmt(v.submitted_at || v.submittedAt)),
            field('Processo', v.id, { mono: true })
          ].join('');
        }

        updateReviewFields();
        setReviewStep(1);
        const m = modal('modal-kyc-review');
        if (m) m.show();
      }

      function updateReviewFields() {
        const decision = document.getElementById('review-decision').value;
        const approve = decision === 'APPROVED';
        document.getElementById('review-tier-wrap').classList.toggle('d-none', !approve);
        document.getElementById('review-rejection-reason').required = true;
        document.getElementById('review-notes').required = false;
      }

      /* ====================================================================
         ABRIR DETALHE (WIZARD)
         ==================================================================== */
      async function showDetails(id) {
        const m = modal('modal-kyc-details');
        const body = document.getElementById('modal-kyc-details-body');
        const reviewBtn = document.getElementById('detail-review-btn');
        if (!m || !window.apiClient || typeof window.apiClient.get !== 'function') return;
        currentVerification = null;
        reviewBtn.classList.add('d-none');
        setDetailStep(1);
        body.innerHTML = '<div class="kyc-state-box"><span class="spinner-border spinner-border-sm" role="status" aria-label="A carregar"></span><span class="ms-2">A consultar processo e anexos…</span></div>';
        m.show();
        try {
          const response = await window.apiClient.get('/identity/' + encodeURIComponent(id));
          if (!response || response.success === false) throw new Error(response && response.message || 'Falha ao consultar o processo.');
          const payload = response.data && response.data.data ? response.data.data : response.data;
          const v = payload && (payload.verification || payload.identityVerification || payload);
          if (!v || typeof v !== 'object') throw new Error('A API não devolveu um processo válido.');
          currentVerification = v;
          if (reviewAllowed(v)) reviewBtn.classList.remove('d-none');
          const name = String(v.full_name_on_document || v.user_registered_name || 'Titular');
          const docs = Array.isArray(v.documents) ? v.documents : [];

          const pane1 = '<div class="kyc-header-summary"><div class="avatar">' + esc(name.trim().charAt(0).toUpperCase() || 'K') + '</div><div class="info"><p class="name">' + esc(name) + '</p><p class="sub">' + esc(v.email || v.user_email || '—') + '</p><div class="badges">' + statusBadge(v.status) + ' ' + tierBadge(v.tier) + '</div></div></div>' +
            '<p class="kyc-pane-title">Identificação apresentada</p>' +
            '<div class="kyc-field-grid">' +
              field('Nome no documento', v.full_name_on_document) +
              field('Nome registado na plataforma', v.user_registered_name) +
              field('Número do documento', maskId(v.id_number), { mono: true }) +
              field('Data de nascimento no documento', dateFmt(v.birth_date_on_document)) +
              field('Validade do documento', dateFmt(v.expiration_date)) +
              field('Tipo de documento', idTypeLabel(v.id_type)) +
            '</div>';

          const pane2 = '<p class="kyc-pane-title">Contacto</p>' +
            '<div class="kyc-field-grid">' +
              field('E-mail da conta', v.email) +
              field('Telefone da conta', v.phone_number) +
              field('ID do processo', v.id, { mono: true }) +
              field('Submetido em', dateFmt(v.submitted_at)) +
            '</div>';

          const pane3 = '<p class="kyc-pane-title">Histórico de revisão</p>' +
            '<div class="kyc-field-grid">' +
              field('Estado atual', v.status) +
              field('Nível', v.tier) +
              field('Revisto em', dateFmt(v.reviewed_at)) +
              field('Revisor (ID)', v.reviewed_by, { mono: true }) +
              field('Motivo da rejeição', v.rejection_reason) +
              field('Notas da revisão', v.review_notes) +
            '</div>';

          const pane4 = '<p class="kyc-pane-title">Documentos privados</p>' +
            '<div class="d-flex align-items-center justify-content-between gap-2 mb-2"><span class="small" style="color:var(--ok-text-muted);">Acesso autenticado e auditado</span></div>' +
            (docs.length ? '<div class="kyc-doc-grid">' + docs.map(d => {
              const documentId = d.id || '';
              const filename = d.originalFilename || d.original_filename || 'Documento';
              const mime = d.mimeType || d.mime_type || '';
              return '<div class="kyc-doc-tile"><div class="kyc-doc-thumb"><span class="file-badge">' + esc((mime.split('/')[1] || 'FILE').toUpperCase()) + '</span><i class="bi bi-file-earmark-lock" aria-hidden="true"></i></div><div class="kyc-doc-body"><div class="kyc-doc-name">' + esc(idTypeLabel(d.documentType || d.document_type)) + '</div><div class="kyc-doc-meta">' + esc(filename) + '</div><div class="kyc-doc-meta"><span>' + esc(bytesText(d.fileSizeBytes ?? d.file_size_bytes)) + '</span><span class="dot-sep">•</span><span>' + esc(mime || 'tipo desconhecido') + '</span></div><div class="kyc-doc-meta">Enviado ' + esc(dateFmt(d.createdAt || d.created_at)) + (d.isVerified || d.is_verified ? ' • verificado' : '') + '</div></div><div class="kyc-doc-footer"><button type="button" class="ok-icon-btn primary" data-document-id="' + esc(documentId) + '" data-document-name="' + esc(filename) + '" data-document-mime="' + esc(mime) + '" title="Ver documento"><i class="bi bi-eye" aria-hidden="true"></i></button></div></div>';
            }).join('') + '</div>' : '<div class="kyc-state-box py-4">Não há documentos anexados a este processo.</div>');

          body.innerHTML =
            '<div class="kyc-pane active" data-pane="1">' + pane1 + '</div>' +
            '<div class="kyc-pane" data-pane="2">' + pane2 + '</div>' +
            '<div class="kyc-pane" data-pane="3">' + pane3 + '</div>' +
            '<div class="kyc-pane" data-pane="4">' + pane4 + '</div>';

          setDetailStep(1);
        } catch (error) {
          body.innerHTML = '<div class="alert alert-danger mb-0" role="alert">' + esc(errMsg(error, 'Falha ao consultar o processo KYC.')) + '</div>';
        }
      }

      /* ====================================================================
         VISUALIZADOR DE DOCUMENTO EM TEMPO REAL
         ==================================================================== */
      async function viewDocument(documentId, fileName, declaredMime) {
        if (!window.apiClient || typeof window.apiClient.buildHeaders !== 'function') {
          showAlert('O cliente autenticado da API não está disponível; descarga cancelada.', 'danger');
          return;
        }
        const m = modal('modal-kyc-document');
        const body = document.getElementById('modal-kyc-document-body');
        const link = document.getElementById('kyc-document-download-link');
        if (!m || !documentId) return;
        if (activeObjectUrl) { URL.revokeObjectURL(activeObjectUrl); activeObjectUrl = null; }
        link.classList.add('d-none');
        link.removeAttribute('href');
        body.innerHTML = '<div class="kyc-state-box"><span class="spinner-border spinner-border-sm" role="status" aria-label="A carregar"></span><span class="ms-2">A descarregar o documento com autorização…</span></div>';
        m.show();
        try {
          const headers = window.apiClient.buildHeaders({ Accept: 'application/pdf, image/*, application/octet-stream, application/json' });
          const response = await fetch('/api/v1/identity/documents/' + encodeURIComponent(documentId) + '/download', { method: 'GET', headers, credentials: 'include' });
          const contentType = String(response.headers.get('content-type') || '').toLowerCase();
          if (!response.ok) {
            let message = 'Falha ao descarregar o documento (HTTP ' + response.status + ').';
            try { const errorData = await response.json(); message = errorData && errorData.error && errorData.error.message || errorData.message || message; } catch (_) {}
            throw new Error(message);
          }
          if (contentType.includes('application/json')) {
            const metadata = await response.json();
            if (metadata && metadata.success === false) throw new Error(metadata.error && metadata.error.message || metadata.message || 'Falha ao obter o documento.');
            throw new Error('O armazenamento remoto devolveu apenas metadados, sem ficheiro ou URL temporário. A API atual não disponibiliza a descarga remota.');
          }
          const blob = await response.blob();
          const mime = String(blob.type || declaredMime || '').toLowerCase().split(';')[0];
          if (!blob.size) throw new Error('O documento descarregado está vazio.');
          if (!['application/pdf', 'image/jpeg', 'image/png', 'image/webp', 'image/gif', 'application/octet-stream'].includes(mime)) throw new Error('Tipo de ficheiro não permitido para pré-visualização: ' + (mime || 'desconhecido'));
          activeObjectUrl = URL.createObjectURL(new Blob([blob], { type: mime }));
          const safeName = String(fileName || 'documento').replace(/[\\r\\n"\\\\]/g, '_');
          link.href = activeObjectUrl;
          link.download = safeName;
          link.classList.remove('d-none');

          const viewer =
            '<div class="kyc-viewer">' +
              '<div class="kyc-viewer-toolbar">' +
                '<div class="kyc-viewer-meta">' +
                  '<span class="ok-icon-btn ghost sm" aria-hidden="true"><i class="bi bi-file-earmark-lock"></i></span>' +
                  '<span class="kyc-viewer-filename" title="' + esc(safeName) + '">' + esc(safeName) + '</span>' +
                  '<span class="kyc-badge kyc-tier">' + esc((mime || 'file').toUpperCase()) + '</span>' +
                '</div>' +
                '<div class="kyc-viewer-tools">' +
                  (mime.startsWith('image/') ? '<button type="button" class="ok-icon-btn" id="kyc-viewer-zoom" title="Ampliar"><i class="bi bi-zoom-in" aria-hidden="true"></i></button>' : '') +
                  '<a href="' + esc(activeObjectUrl) + '" download="' + esc(safeName) + '" class="ok-icon-btn" title="Descarregar"><i class="bi bi-download" aria-hidden="true"></i></a>' +
                '</div>' +
              '</div>' +
              '<div class="kyc-viewer-stage" id="kyc-viewer-stage">' +
                (mime === 'application/pdf'
                  ? '<iframe src="' + esc(activeObjectUrl) + '" title="Pré-visualização segura do documento PDF"></iframe>'
                  : (mime.startsWith('image/')
                    ? '<img id="kyc-viewer-img" src="' + esc(activeObjectUrl) + '" alt="Documento confidencial enviado pelo titular">'
                    : '<div class="state-hint"><i class="bi bi-file-earmark-arrow-down" aria-hidden="true"></i><strong style="display:block;color:var(--ok-text-primary);margin-bottom:4px;">Ficheiro autorizado</strong>Este formato não permite pré-visualização. Use o botão de descarga.</div>')) +
              '</div>' +
            '</div>';
          body.innerHTML = viewer;

          const zoomBtn = document.getElementById('kyc-viewer-zoom');
          const viewerImg = document.getElementById('kyc-viewer-img');
          if (zoomBtn && viewerImg) {
            zoomBtn.addEventListener('click', () => {
              viewerImg.classList.toggle('zoomed');
              zoomBtn.innerHTML = viewerImg.classList.contains('zoomed')
                ? '<i class="bi bi-zoom-out" aria-hidden="true"></i>'
                : '<i class="bi bi-zoom-in" aria-hidden="true"></i>';
            });
            viewerImg.addEventListener('click', () => {
              viewerImg.classList.toggle('zoomed');
              zoomBtn.innerHTML = viewerImg.classList.contains('zoomed')
                ? '<i class="bi bi-zoom-out" aria-hidden="true"></i>'
                : '<i class="bi bi-zoom-in" aria-hidden="true"></i>';
            });
          }
        } catch (error) {
          body.innerHTML = '<div class="alert alert-warning mb-0" role="alert"><strong class="d-block mb-1">Documento indisponível</strong>' + esc(errMsg(error, 'Falha ao abrir o documento.')) + '</div>';
        }
      }

      /* ====================================================================
         LIGAÇÕES DE EVENTOS
         ==================================================================== */
      document.getElementById('kyc-filter-form').addEventListener('submit', ev => { ev.preventDefault(); loadQueue(1); });
      document.getElementById('kyc-filter-form').addEventListener('reset', () => window.setTimeout(() => loadQueue(1), 0));
      document.getElementById('kyc-refresh-btn').addEventListener('click', () => loadQueue(page));
      el.pagination.addEventListener('click', ev => {
        const b = ev.target.closest('button[data-page]');
        if (!b || b.disabled) return;
        const n = Number(b.dataset.page);
        if (Number.isInteger(n) && n >= 1 && n <= pages) loadQueue(n);
      });
      el.body.addEventListener('click', ev => {
        const b = ev.target.closest('button[data-action]');
        if (!b) return;
        const v = records.find(x => String(x.id) === String(b.dataset.verificationId));
        if (!v) return;
        if (b.dataset.action === 'details') showDetails(v.id);
        else if (b.dataset.action === 'review') openReview(v);
      });
      el.error.addEventListener('click', ev => { if (ev.target.closest('#kyc-retry-btn')) loadQueue(page); });

      document.getElementById('modal-kyc-details-body').addEventListener('click', ev => {
        const b = ev.target.closest('button[data-document-id]');
        if (b) viewDocument(b.dataset.documentId, b.dataset.documentName, b.dataset.documentMime);
      });

      document.getElementById('detail-review-btn').addEventListener('click', () => {
        const detailModal = window.bootstrap.Modal.getInstance(document.getElementById('modal-kyc-details'));
        if (detailModal) detailModal.hide();
        if (currentVerification) openReview(currentVerification);
      });

      document.getElementById('review-decision').addEventListener('change', () => {
        updateReviewFields();
        if (reviewStep === reviewStepCount) buildConfirmStep();
      });
      document.getElementById('review-tier').addEventListener('change', () => {
        if (reviewStep === reviewStepCount) buildConfirmStep();
      });
      document.getElementById('review-rejection-reason').addEventListener('input', () => {
        if (reviewStep === reviewStepCount) buildConfirmStep();
      });

      document.getElementById('details-prev-btn').addEventListener('click', () => setDetailStep(detailStep - 1));
      document.getElementById('details-next-btn').addEventListener('click', () => setDetailStep(detailStep + 1));

      document.getElementById('review-prev-btn').addEventListener('click', () => setReviewStep(reviewStep - 1));
      document.getElementById('review-next-btn').addEventListener('click', () => {
        if (reviewStep === 2) {
          const decision = document.getElementById('review-decision').value;
          if (!decision) { showAlert('Selecione uma decisão antes de avançar.', 'warning'); return; }
        }
        if (reviewStep === 3) {
          const reason = document.getElementById('review-rejection-reason').value.trim();
          if (reason.length < 10 || reason.length > 500) { showAlert('A fundamentação exige entre 10 e 500 caracteres.', 'warning'); return; }
        }
        setReviewStep(reviewStep + 1);
      });

      document.getElementById('modal-kyc-document').addEventListener('hidden.bs.modal', () => {
        if (activeObjectUrl) { URL.revokeObjectURL(activeObjectUrl); activeObjectUrl = null; }
        const downloadLink = document.getElementById('kyc-document-download-link');
        downloadLink.classList.add('d-none');
        downloadLink.removeAttribute('href');
      });
      document.getElementById('modal-kyc-review').addEventListener('hidden.bs.modal', () => document.getElementById('form-kyc-review').reset());
      document.getElementById('modal-kyc-details').addEventListener('hidden.bs.modal', () => { currentVerification = null; setDetailStep(1); });

      /* ====================================================================
         CONFIRMAÇÃO E SUBMISSÃO DO PARECER
         ==================================================================== */
      async function confirmKycDecision(status) {
        const label = ({ APPROVED: 'aprovar a identidade', REJECTED: 'rejeitar o processo', NEEDS_REVIEW: 'solicitar revisão adicional' })[status] || 'registar esta decisão';
        if (window.Swal && typeof window.Swal.fire === 'function') {
          const first = await window.Swal.fire({ title: 'Confirmar decisão?', text: 'Vai ' + label + '. A ação ficará registada na auditoria.', icon: 'warning', showCancelButton: true, confirmButtonText: 'Continuar', cancelButtonText: 'Cancelar', reverseButtons: true });
          if (!first.isConfirmed) return false;
          const second = await window.Swal.fire({ title: 'Confirmação final', text: 'Confirma definitivamente esta decisão de conformidade?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Confirmar decisão', cancelButtonText: 'Voltar', reverseButtons: true });
          return Boolean(second.isConfirmed);
        }
        return window.confirm('Confirma que pretende ' + label + '?') && window.confirm('Confirmação final: registar a decisão KYC?');
      }

      document.getElementById('form-kyc-review').addEventListener('submit', async ev => {
        ev.preventDefault();
        if (!canReview || !window.apiClient || typeof window.apiClient.post !== 'function') return showAlert('A API ou a autorização de revisão não está disponível. Ação cancelada.', 'danger');
        const id = document.getElementById('review-verification-id').value;
        const v = records.find(x => String(x.id) === String(id)) || currentVerification;
        if (!v || !reviewAllowed(v)) return showAlert('O estado atual do processo não permite este parecer. Atualize a fila.', 'warning');
        const status = document.getElementById('review-decision').value;
        if (!allowedDecisions(v).includes(status)) return showAlert('Esta decisão não é uma transição permitida para o estado atual.', 'warning');
        const tier = document.getElementById('review-tier').value;
        const reason = document.getElementById('review-rejection-reason').value.trim();
        const internalComment = document.getElementById('review-notes').value.trim();
        if (reason.length < 10 || reason.length > 500) return showAlert('A fundamentação exige entre 10 e 500 caracteres.', 'warning');
        if (internalComment.length > 1000) return showAlert('O comentário interno não pode exceder 1000 caracteres.', 'warning');
        if (!await confirmKycDecision(status)) return;
        const payload = { status, tier: status === 'APPROVED' ? tier : 'TIER_1_UNVERIFIED', rejectionReason: status === 'REJECTED' ? reason : null, reviewNotes: status === 'NEEDS_REVIEW' ? reason : (internalComment || reason || null) };
        document.querySelectorAll('#form-kyc-review button[type="submit"]').forEach(b => b.disabled = true);
        try {
          const result = await window.apiClient.post('/identity/' + encodeURIComponent(id) + '/review', payload);
          if (result && result.success === false) throw new Error(result.message || 'A API recusou o parecer.');
          const m = window.bootstrap.Modal.getInstance(document.getElementById('modal-kyc-review'));
          if (m) m.hide();
          if (window.Alerts && typeof window.Alerts.toast === 'function') window.Alerts.toast('Decisão de conformidade registada com sucesso.', 'success');
          else showAlert('Decisão de conformidade registada com sucesso.', 'success');
          await loadQueue(page);
        } catch (error) {
          if (window.Alerts && typeof window.Alerts.error === 'function') window.Alerts.error(errMsg(error, 'Falha ao registar a decisão.'));
          else showAlert(errMsg(error, 'Falha ao registar a decisão.'), 'danger');
        } finally {
          document.querySelectorAll('#form-kyc-review button[type="submit"]').forEach(b => b.disabled = false);
        }
      });
      document.getElementById('modal-kyc-review').addEventListener('hidden.bs.modal', () => document.querySelectorAll('#form-kyc-review button[type="submit"]').forEach(b => b.disabled = false));

      /* ====================================================================
         RELÓGIO UTC
         ==================================================================== */
      const clock = document.getElementById('admin-utc-clock');
      function updateClock() {
        if (clock) clock.textContent = new Intl.DateTimeFormat('pt-PT', { timeZone: 'UTC', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).format(new Date()) + ' UTC';
      }
      updateClock();
      window.setInterval(updateClock, 1000);

      /* ====================================================================
         INICIALIZAÇÃO
         ==================================================================== */
      document.addEventListener('DOMContentLoaded', () => {
        initThemeToggle();
        setupGlobalActions();
        loadQueue(1);
      });
    })();
  </script>
</body>
</html>