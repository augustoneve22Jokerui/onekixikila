<%- include('../partials/head') %>
<% const adminUser = (typeof user !== 'undefined' && user) ? user : {}; const adminUserName = adminUser.fullName || adminUser.full_name || 'Administrador'; const adminRoleForPage = String(adminUser.role || '').toUpperCase(); %>
<style>
  /* =========================================================================
     ONEKIXIKILA ADMIN — TRILHA DE AUDITORIA (design unificado com dashboard)
     Coerente com o dashboard do membro: roxo, Space Grotesk, rail slim tech.
     ========================================================================= */
  :root,
  html[data-theme="dark"] {
    --ok-bg-canvas: #050508;
    --ok-bg-surface: #0a0a10;
    --ok-bg-elevated: #111118;
    --ok-bg-sidebar: #08080e;

    --ok-purple-primary: #7c3aed;
    --ok-purple-vibrant: #8b5cf6;
    --ok-purple-soft: rgba(139, 92, 246, 0.12);
    --ok-purple-border: rgba(139, 92, 246, 0.3);
    --ok-purple-glow: rgba(139, 92, 246, 0.45);

    --ok-accent-cyan: #06b6d4;
    --ok-accent-emerald: #10b981;
    --ok-accent-amber: #f59e0b;
    --ok-accent-rose: #f43f5e;

    --ok-color-card-white: #ffffff;
    --ok-color-card-lime: #bef264;
    --ok-color-card-purple: #7c3aed;

    --ok-text-primary: #ffffff;
    --ok-text-secondary: #cbd5e1;
    --ok-text-muted: #94a3b8;

    --ok-border-subtle: rgba(255, 255, 255, 0.08);
    --ok-border-strong: rgba(255, 255, 255, 0.14);
    --ok-input-bg: rgba(255, 255, 255, 0.04);
    --ok-pill-bg: rgba(255, 255, 255, 0.05);
    --ok-pill-bg-hover: rgba(139, 92, 246, 0.12);
    --ok-chip-bg: rgba(255, 255, 255, 0.04);
    --ok-meter-bg: rgba(255, 255, 255, 0.05);
    --ok-stream-hover: var(--ok-purple-soft);
    --ok-shadow-card: rgba(0, 0, 0, 0.75);
    --ok-shadow-sidebar: rgba(0, 0, 0, 0.6);
    --ok-shadow-navbar: 0 4px 20px rgba(0, 0, 0, 0.4);

    --ok-bg-balance: #0d3b38;
    --ok-accent-green: #a3e635;
    --ok-accent-green-hover: #84cc16;
    --ok-accent-green-light: rgba(163, 230, 53, 0.12);

    --ok-radius-card: 18px;
    --ok-radius-pill: 9999px;
    --ok-radius-md: 12px;
    --ok-sidebar-width: 86px;
    --ok-navbar-height: 80px;
    --ok-content-max: 1440px;
  }

  html[data-theme="light"] {
    --ok-bg-canvas: #f4f5f9;
    --ok-bg-surface: #ffffff;
    --ok-bg-elevated: #ffffff;
    --ok-bg-sidebar: #ffffff;

    --ok-purple-primary: #6d28d9;
    --ok-purple-vibrant: #7c3aed;
    --ok-purple-soft: rgba(124, 58, 237, 0.08);
    --ok-purple-border: rgba(124, 58, 237, 0.25);
    --ok-purple-glow: rgba(124, 58, 237, 0.25);

    --ok-color-card-white: #ffffff;
    --ok-color-card-lime: #bef264;
    --ok-color-card-purple: #7c3aed;

    --ok-text-primary: #0f172a;
    --ok-text-secondary: #334155;
    --ok-text-muted: #64748b;

    --ok-border-subtle: rgba(15, 23, 42, 0.10);
    --ok-border-strong: rgba(15, 23, 42, 0.18);
    --ok-input-bg: #ffffff;
    --ok-pill-bg: rgba(15, 23, 42, 0.04);
    --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
    --ok-chip-bg: #ffffff;
    --ok-meter-bg: rgba(15, 23, 42, 0.06);
    --ok-stream-hover: rgba(124, 58, 237, 0.08);
    --ok-shadow-card: rgba(15, 23, 42, 0.10);
    --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);

    --ok-bg-balance: #0d3b38;
    --ok-accent-green: #a3e635;
    --ok-accent-green-hover: #84cc16;
    --ok-accent-green-light: #eff6e0;
  }

  @media (prefers-color-scheme: light) {
    html:not([data-theme]) {
      --ok-bg-canvas: #f4f5f9;
      --ok-bg-surface: #ffffff;
      --ok-bg-elevated: #ffffff;
      --ok-bg-sidebar: #ffffff;

      --ok-purple-primary: #6d28d9;
      --ok-purple-vibrant: #7c3aed;
      --ok-purple-soft: rgba(124, 58, 237, 0.08);
      --ok-purple-border: rgba(124, 58, 237, 0.25);
      --ok-purple-glow: rgba(124, 58, 237, 0.25);

      --ok-text-primary: #0f172a;
      --ok-text-secondary: #334155;
      --ok-text-muted: #64748b;

      --ok-border-subtle: rgba(15, 23, 42, 0.10);
      --ok-border-strong: rgba(15, 23, 42, 0.18);
      --ok-input-bg: #ffffff;
      --ok-pill-bg: rgba(15, 23, 42, 0.04);
      --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
      --ok-chip-bg: #ffffff;
      --ok-meter-bg: rgba(15, 23, 42, 0.06);
      --ok-stream-hover: rgba(124, 58, 237, 0.08);
      --ok-shadow-card: rgba(15, 23, 42, 0.10);
      --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);

      --ok-bg-balance: #0d3b38;
      --ok-accent-green: #a3e635;
      --ok-accent-green-hover: #84cc16;
      --ok-accent-green-light: #eff6e0;
    }
  }

  * { box-sizing: border-box; -webkit-font-smoothing: antialiased; }

  body.admin-body {
    background-color: var(--ok-bg-canvas) !important;
    color: var(--ok-text-primary);
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 14px;
    letter-spacing: -0.005em;
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .ok-ambient-glow-core {
    position: fixed;
    top: -120px; left: 20%;
    width: 550px; height: 550px;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.14) 0%, rgba(5, 5, 8, 0) 70%);
    pointer-events: none; z-index: 0; filter: blur(90px);
  }
  html[data-theme="light"] .ok-ambient-glow-core {
    background: radial-gradient(circle, rgba(124, 58, 237, 0.10) 0%, rgba(244, 245, 249, 0) 70%);
  }

  /* =========================================================================
     RAIL SIDEBAR — mantém todos os links e badges admin
     ========================================================================= */
  .ok-rail-sidebar {
    position: fixed;
    top: 20px; left: 20px; bottom: 20px;
    width: var(--ok-sidebar-width);
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 20px;
    display: flex; flex-direction: column; align-items: center;
    padding: 22px 0;
    z-index: 1040;
    box-shadow: 0 10px 30px var(--ok-shadow-sidebar);
    backdrop-filter: blur(20px);
    transition: all 0.3s ease;
    overflow-y: auto; overflow-x: hidden;
  }
  .ok-rail-sidebar::-webkit-scrollbar { width: 0; }

  .ok-brand-emblem {
    width: 48px; height: 48px; border-radius: 14px;
    background: linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 20px;
    box-shadow: 0 8px 20px rgba(124, 58, 237, 0.4);
    flex-shrink: 0;
    text-decoration: none;
    transition: transform 0.2s ease;
  }
  .ok-brand-emblem:hover { transform: translateY(-2px); }
  .ok-brand-emblem svg { width: 24px; height: 24px; stroke: #ffffff; }

  .ok-rail-nav {
    flex: 1;
    display: flex; flex-direction: column; align-items: center;
    gap: 10px; width: 100%;
  }

  .ok-rail-group-label {
    font-size: 0.58rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ok-text-muted);
    margin: 10px 0 2px 0;
    text-align: center;
    width: 100%;
    opacity: 0.7;
  }

  .ok-rail-link {
    width: 46px; height: 46px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-muted); text-decoration: none;
    transition: all 0.2s ease; background: transparent;
    position: relative;
    flex-shrink: 0;
  }
  .ok-rail-link:hover {
    color: var(--ok-purple-vibrant);
    background-color: var(--ok-purple-soft);
    transform: translateY(-2px);
  }
  .ok-rail-link.active {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    color: #ffffff;
    box-shadow: 0 8px 20px rgba(139, 92, 246, 0.5);
  }
  .ok-rail-link.active svg { stroke: #ffffff; }
  .ok-rail-link .ok-badge-dot {
    position: absolute; top: 8px; right: 8px;
    width: 8px; height: 8px; border-radius: 50%;
    background-color: #ef4444;
    border: 2px solid var(--ok-bg-surface);
  }
  .ok-rail-link .ok-badge-count {
    position: absolute;
    top: 4px; right: 4px;
    min-width: 16px; height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: #f43f5e;
    color: #fff;
    font-size: 0.58rem;
    font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    border: 2px solid var(--ok-bg-surface);
    line-height: 1;
  }
  .ok-rail-link .ok-badge-count.badge-warn { background: #f59e0b; color: #1a1a1a; }
  .ok-rail-link .ok-badge-count.badge-info { background: #06b6d4; color: #052029; }

  .ok-rail-footer {
    display: flex; flex-direction: column; align-items: center;
    gap: 10px; width: 100%;
    padding-top: 14px;
    margin-top: 8px;
    border-top: 1px solid var(--ok-border-subtle);
  }

  /* =========================================================================
     VIEWPORT SHELL
     ========================================================================= */
  .ok-viewport-shell {
    margin-left: calc(var(--ok-sidebar-width) + 36px);
    padding: 20px 32px 48px 0;
    position: relative; z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .ok-top-nav {
    height: var(--ok-navbar-height);
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 20px;
    gap: 14px;
    flex-wrap: wrap;
  }

  .ok-search-capsule {
    position: relative;
    width: 420px; max-width: 100%;
  }
  .ok-search-capsule input {
    width: 100%; height: 46px;
    border-radius: var(--ok-radius-pill);
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    padding: 0 75px 0 46px;
    font-size: 0.88rem;
    color: var(--ok-text-primary);
    outline: none;
    transition: all 0.25s ease;
  }
  .ok-search-capsule input::placeholder { color: var(--ok-text-muted); }
  .ok-search-capsule input:focus {
    border-color: var(--ok-purple-vibrant);
    box-shadow: 0 0 0 4px var(--ok-purple-soft);
  }
  .ok-search-capsule .search-icon {
    position: absolute; left: 16px; top: 50%;
    transform: translateY(-50%);
    color: var(--ok-text-muted);
    display: flex;
  }
  .ok-search-capsule .shortcut-hint {
    position: absolute; right: 12px; top: 50%;
    transform: translateY(-50%);
    background: var(--ok-pill-bg);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 6px;
    padding: 2px 7px;
    font-size: 0.7rem;
    color: var(--ok-text-muted);
    font-weight: 600;
  }

  .ok-nav-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

  .ok-action-circle {
    width: 44px; height: 44px; border-radius: 14px;
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-primary);
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
    cursor: pointer;
  }
  .ok-action-circle:hover {
    border-color: var(--ok-purple-border);
    color: var(--ok-purple-vibrant);
    transform: translateY(-2px);
  }

  .ok-profile-pill {
    display: flex; align-items: center; gap: 10px;
    padding: 5px 16px 5px 5px;
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    border-radius: var(--ok-radius-pill);
    text-decoration: none; cursor: pointer;
    transition: all 0.2s ease;
  }
  .ok-profile-pill:hover { border-color: var(--ok-purple-border); }

  .ok-profile-avatar-nav {
    width: 36px; height: 36px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    color: #ffffff;
    font-weight: 800;
    font-size: 0.85rem;
    border: 2px solid var(--ok-purple-border);
    flex-shrink: 0;
  }

  .ok-theme-toggle {
    width: 44px; height: 44px; border-radius: 14px;
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-primary); cursor: pointer;
    transition: all 0.2s ease;
  }
  .ok-theme-toggle:hover {
    border-color: var(--ok-purple-border);
    color: var(--ok-purple-vibrant);
    transform: translateY(-2px);
  }

  .ok-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--ok-radius-pill);
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #10b981;
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .ok-status-pill .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
  }
  .ok-clock {
    font-family: 'Space Grotesk', monospace;
    font-size: 0.78rem;
    color: var(--ok-text-muted);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* =========================================================================
     HERO
     ========================================================================= */
  .ok-canvas-hero-title {
    max-width: var(--ok-content-max);
    margin: 0 auto 22px auto;
    display: flex; justify-content: space-between; align-items: flex-end;
    flex-wrap: wrap; gap: 16px;
    width: 100%;
  }
  .ok-page-title-main {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.85rem; font-weight: 800;
    letter-spacing: -0.03em; line-height: 1.15;
    color: var(--ok-text-primary);
    margin: 0;
    display: flex; align-items: center; gap: 12px;
    flex-wrap: wrap;
  }
  .ok-page-title-main .user-highlight {
    background: linear-gradient(135deg, var(--ok-purple-vibrant) 0%, #c084fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .ok-eyebrow {
    color: var(--ok-purple-vibrant);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .ok-live-beacon {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.7rem; font-weight: 800;
    padding: 4px 11px;
    border-radius: var(--ok-radius-pill);
    background: rgba(244, 63, 94, 0.15);
    border: 1px solid rgba(244, 63, 94, 0.3);
    color: #f43f5e;
    letter-spacing: 0.04em; text-transform: uppercase;
  }
  .ok-live-beacon.beacon-cyan {
    background: rgba(6, 182, 212, 0.15);
    border-color: rgba(6, 182, 212, 0.3);
    color: #06b6d4;
  }
  .ok-pulse-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background-color: currentColor;
    box-shadow: 0 0 8px currentColor;
    animation: okPulseDot 1.6s infinite;
  }
  @keyframes okPulseDot {
    0%   { box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.55); }
    70%  { box-shadow: 0 0 0 8px rgba(244, 63, 94, 0); }
    100% { box-shadow: 0 0 0 0 rgba(244, 63, 94, 0); }
  }
  .ok-canvas-sub {
    color: var(--ok-text-muted);
    font-size: 0.88rem; margin-top: 5px; line-height: 1.45;
    display: flex; align-items: center; gap: 8px;
    flex-wrap: wrap;
  }

  /* =========================================================================
     SESSÃO 1: 4 CARDS CHAPADOS (KPIs de auditoria)
     ========================================================================= */
  .ok-flat-quad-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: var(--ok-content-max);
    margin: 0 auto 28px auto;
    border-radius: 0px !important;
    overflow: hidden;
    box-shadow: 0 16px 36px var(--ok-shadow-card);
    border: 1px solid var(--ok-border-subtle);
    width: 100%;
  }
  .ok-flat-card-box {
    padding: 22px 18px 20px 18px;
    display: flex; flex-direction: column; justify-content: space-between;
    min-height: 165px;
    border-radius: 0px !important;
    position: relative;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  .ok-flat-card-box:hover {
    z-index: 2; filter: brightness(1.04);
    transform: translateY(-2px);
  }
  .ok-flat-card-box.theme-white { background-color: #ffffff; color: #0f172a; }
  .ok-flat-card-box.theme-lime { background-color: #bef264; color: #0f172a; }
  .ok-flat-card-box.theme-white-alt {
    background-color: #ffffff; color: #0f172a;
    border-left: 1px solid rgba(0,0,0,0.08);
  }
  .ok-flat-card-box.theme-purple { background-color: #7c3aed; color: #ffffff; }

  .ok-flat-icon-container { width: 36px; height: 36px; margin-bottom: 14px; }
  .ok-flat-icon-container svg { width: 100%; height: 100%; stroke-width: 1.9; }
  .theme-white .ok-flat-icon-container svg,
  .theme-lime .ok-flat-icon-container svg,
  .theme-white-alt .ok-flat-icon-container svg { stroke: #0f172a; }
  .theme-purple .ok-flat-icon-container svg { stroke: #ffffff; }

  .ok-flat-title {
    font-size: 1.02rem; font-weight: 800;
    letter-spacing: -0.02em; line-height: 1.2;
    margin-bottom: 5px;
  }
  .ok-flat-desc {
    font-size: 0.74rem; line-height: 1.4;
    opacity: 0.85; margin-bottom: 8px;
  }
  .ok-flat-metric-data {
    font-size: 1.15rem; font-weight: 800;
    font-family: 'Space Grotesk', sans-serif;
    letter-spacing: -0.02em;
  }
  .ok-flat-trend {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 0.7rem; font-weight: 800;
    padding: 3px 9px;
    border-radius: var(--ok-radius-pill);
    margin-top: 6px;
  }
  .theme-white .ok-flat-trend,
  .theme-lime .ok-flat-trend,
  .theme-white-alt .ok-flat-trend { background: rgba(16, 185, 129, 0.15); color: #10b981; }
  .theme-purple .ok-flat-trend { background: rgba(255,255,255,0.15); color: #ffffff; }

  /* =========================================================================
     SESSÃO 2: GRID (aside KPI + módulo filtros)
     ========================================================================= */
  .ok-canvas-asides-grid {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 28px;
    max-width: var(--ok-content-max);
    margin: 0 auto 30px auto;
    align-items: start;
    width: 100%;
  }

  .ok-balance-vault-card {
    background: linear-gradient(160deg, var(--ok-bg-surface) 0%, var(--ok-bg-canvas) 100%);
    border: 1px solid var(--ok-purple-border);
    border-radius: 20px;
    padding: 1.5rem;
    box-shadow: 0 8px 32px var(--ok-shadow-card), 0 0 30px rgba(124, 58, 237, 0.15);
    color: var(--ok-text-primary);
    display: flex; flex-direction: column; justify-content: space-between;
    position: relative; overflow: hidden;
  }
  .ok-vault-wave-bg {
    position: absolute; inset: 0;
    background: radial-gradient(circle at 10% 20%, rgba(139, 92, 246, 0.18) 0%, transparent 60%);
    pointer-events: none;
  }
  .ok-vault-badge-cluster {
    display: flex; align-items: center; gap: 8px;
    position: relative; z-index: 1;
    flex-wrap: wrap;
  }
  .ok-token-emblem {
    width: 30px; height: 30px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .ok-vault-balance-display {
    margin: 22px 0 16px 0;
    position: relative; z-index: 1;
  }
  .ok-vault-caption {
    font-size: 0.72rem; font-weight: 700;
    color: var(--ok-text-muted);
    text-transform: uppercase; letter-spacing: 0.04em;
    display: flex; align-items: center; justify-content: space-between;
    gap: 8px;
  }
  .ok-vault-sum {
    font-size: 1.85rem; font-weight: 800;
    font-family: 'Space Grotesk', sans-serif;
    letter-spacing: -0.03em;
    margin-top: 6px;
    color: var(--ok-purple-vibrant);
  }
  .ok-vault-action-row {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 10px;
    position: relative; z-index: 1;
    margin-top: 16px;
  }
  .ok-vault-btn {
    height: 44px; border-radius: var(--ok-radius-pill);
    font-size: 0.82rem; font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    gap: 6px; text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    border: none;
    padding: 0 14px;
  }
  .ok-vault-btn.primary {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    color: #ffffff;
    box-shadow: 0 8px 20px rgba(139, 92, 246, 0.45);
  }
  .ok-vault-btn.primary:hover { transform: translateY(-2px); color: #ffffff; }
  .ok-vault-btn.ghost {
    background: var(--ok-pill-bg);
    color: var(--ok-text-primary);
    border: 1px solid var(--ok-border-subtle);
  }
  .ok-vault-btn.ghost:hover { background: var(--ok-pill-bg-hover); color: var(--ok-purple-vibrant); }
  .ok-vault-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  /* Módulo direito (filtros) */
  .ok-config-module-card {
    background: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 20px;
    padding: 1.5rem;
    box-shadow: 0 8px 32px var(--ok-shadow-card);
    display: flex; flex-direction: column; justify-content: flex-start;
    gap: 16px;
  }
  .ok-chart-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 4px; flex-wrap: wrap; gap: 12px;
  }
  .ok-chart-tagline { display: flex; align-items: center; gap: 12px; }
  .ok-chart-tag-emblem {
    width: 42px; height: 42px; border-radius: 12px;
    background: var(--ok-purple-soft); color: var(--ok-purple-vibrant);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .ok-chart-title { font-size: 1.02rem; font-weight: 800; color: var(--ok-text-primary); margin: 0; font-family: 'Space Grotesk', sans-serif; }
  .ok-chart-sub { font-size: 0.75rem; color: var(--ok-text-muted); }

  /* =========================================================================
     BOTÕES E PILLS
     ========================================================================= */
  .admin-btn-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: var(--ok-radius-pill);
    border: 1px solid var(--ok-border-subtle);
    background: var(--ok-pill-bg);
    color: var(--ok-text-primary);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .admin-btn-pill:hover {
    border-color: var(--ok-purple-border);
    color: var(--ok-purple-vibrant);
    background: var(--ok-pill-bg-hover);
    transform: translateY(-1px);
  }
  .admin-btn-pill-outline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: var(--ok-radius-pill);
    border: 1px solid var(--ok-border-subtle);
    background: transparent;
    color: var(--ok-text-primary);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .admin-btn-pill-outline:hover {
    border-color: var(--ok-purple-border);
    color: var(--ok-purple-vibrant);
    transform: translateY(-1px);
  }
  .admin-btn-pill-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: var(--ok-radius-pill);
    border: none;
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(139, 92, 246, 0.35);
  }
  .admin-btn-pill-primary:hover {
    transform: translateY(-2px);
    color: #ffffff;
    box-shadow: 0 12px 24px rgba(139, 92, 246, 0.5);
  }
  .admin-btn-pill-primary:disabled { opacity: 0.5; cursor: not-allowed; box-shadow: none; }

  /* =========================================================================
     FILTROS (aud-filter) — inputs no estilo ok
     ========================================================================= */
  .aud-filter { padding: 0; background: transparent; border: none; box-shadow: none; }
  .aud-filter .form-select,
  .aud-filter .form-control,
  .aud-modal .form-control {
    background: var(--ok-input-bg) !important;
    border: 1px solid var(--ok-border-subtle) !important;
    color: var(--ok-text-primary) !important;
    min-height: 42px;
    border-radius: 12px;
    font-size: 0.84rem;
    padding: 0.5rem 0.85rem;
    transition: all 0.2s ease;
  }
  .aud-filter .form-control:focus,
  .aud-filter .form-select:focus,
  .aud-modal .form-control:focus {
    border-color: var(--ok-purple-vibrant) !important;
    box-shadow: 0 0 0 4px var(--ok-purple-soft) !important;
  }
  .aud-filter .form-label {
    color: var(--ok-text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.35rem;
  }
  .aud-filter .form-select option { background: var(--ok-bg-elevated); color: var(--ok-text-primary); }

  .aud-filter .btn-primary {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    border: none;
    border-radius: 12px;
    font-weight: 800;
    box-shadow: 0 6px 16px rgba(139, 92, 246, 0.35);
    transition: all 0.2s ease;
  }
  .aud-filter .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 10px 20px rgba(139, 92, 246, 0.5); }
  .aud-filter .btn-outline-light {
    border: 1px solid var(--ok-border-subtle);
    background: var(--ok-pill-bg);
    color: var(--ok-text-primary);
    border-radius: 12px;
    transition: all 0.2s ease;
  }
  .aud-filter .btn-outline-light:hover {
    border-color: var(--ok-purple-border);
    color: var(--ok-purple-vibrant);
    background: var(--ok-pill-bg-hover);
  }

  /* =========================================================================
     TABELA DE AUDITORIA
     ========================================================================= */
  .admin-card {
    background: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    border-radius: var(--ok-radius-card);
    box-shadow: 0 8px 32px var(--ok-shadow-card);
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }
  .admin-card:hover { border-color: var(--ok-border-strong); }

  .admin-table-header {
    padding: 1.1rem 1.35rem;
    border-bottom: 1px solid var(--ok-border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .admin-table-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--ok-text-primary);
    margin: 0 0 4px 0;
    display: flex;
    align-items: center;
    gap: 10px;
    letter-spacing: -0.01em;
    font-family: 'Space Grotesk', sans-serif;
  }
  .admin-table-sub {
    font-size: 0.78rem;
    color: var(--ok-text-muted);
    margin: 0;
  }

  .aud-table-wrap { overflow: auto; }
  .aud-table { min-width: 1000px; }
  .aud-table thead th {
    color: var(--ok-text-muted);
    background: rgba(255,255,255,.025);
    border-bottom: 1px solid var(--ok-border-subtle);
    font-size: .65rem;
    font-weight: 800;
    letter-spacing: .095em;
    padding: .95rem .8rem;
    text-transform: uppercase;
    white-space: nowrap;
  }
  html[data-theme="light"] .aud-table thead th { background: rgba(15, 23, 42, 0.03); }
  .aud-table tbody td {
    border-bottom: 1px solid rgba(255,255,255,.055);
    color: var(--ok-text-secondary);
    padding: .85rem .8rem;
    vertical-align: middle;
  }
  html[data-theme="light"] .aud-table tbody td { border-bottom-color: rgba(15, 23, 42, 0.06); }
  .aud-table tbody tr:last-child td { border-bottom: 0; }
  .aud-table tbody tr:hover { background: var(--ok-stream-hover); }

  .aud-code {
    color: var(--ok-text-primary);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: .75rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .aud-muted { color: var(--ok-text-muted); font-size: .7rem; overflow-wrap: anywhere; }
  .aud-badge {
    border: 1px solid rgba(139, 92, 246, .25);
    border-radius: 999px;
    color: #ddd6fe;
    display: inline-flex;
    font-size: .63rem;
    font-weight: 800;
    letter-spacing: .025em;
    padding: .3rem .52rem;
    white-space: nowrap;
  }
  html[data-theme="light"] .aud-badge { color: #6d28d9; }
  .aud-badge-action { background: rgba(124, 58, 237, .12); }
  .aud-badge-resource {
    background: rgba(6, 182, 212, .08);
    border-color: rgba(6, 182, 212, .2);
    color: #a5f3fc;
  }
  html[data-theme="light"] .aud-badge-resource { color: #0e7490; }

  .aud-btn-icon {
    align-items: center;
    display: inline-flex;
    justify-content: center;
    min-height: 34px;
    min-width: 36px;
    border-radius: 10px;
    border: 1px solid var(--ok-border-subtle);
    background: var(--ok-pill-bg);
    color: var(--ok-purple-vibrant);
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .aud-btn-icon:hover {
    background: var(--ok-purple-soft);
    border-color: var(--ok-purple-border);
    transform: translateY(-1px);
  }

  .aud-footer {
    align-items: center;
    border-top: 1px solid var(--ok-border-subtle);
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    justify-content: space-between;
    padding: 1rem 1.2rem;
  }
  .aud-pagination {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .aud-pagination button {
    background: var(--ok-bg-elevated);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 9px;
    color: var(--ok-text-secondary);
    min-width: 36px;
    padding: .4rem .65rem;
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .aud-pagination button:hover:not(:disabled),
  .aud-pagination button.is-current {
    background: var(--ok-purple-soft);
    border-color: var(--ok-purple-border);
    color: var(--ok-text-primary);
  }
  .aud-pagination button.is-current {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    color: #ffffff;
  }
  .aud-pagination button:disabled { cursor: not-allowed; opacity: .4; }

  /* =========================================================================
     ESTADOS E AVISOS
     ========================================================================= */
  .aud-state {
    border: 1px dashed var(--ok-border-strong);
    border-radius: var(--ok-radius-card);
    color: var(--ok-text-muted);
    padding: 2.4rem 1rem;
    text-align: center;
  }
  .aud-state i { color: var(--ok-purple-vibrant); display: block; font-size: 1.6rem; margin-bottom: .6rem; }

  .aud-warning {
    background: rgba(245,158,11,.06);
    border: 1px solid rgba(245,158,11,.2);
    border-radius: 12px;
    color: #fde68a;
    font-size: .77rem;
    line-height: 1.55;
    padding: .85rem 1rem;
  }
  html[data-theme="light"] .aud-warning { color: #92400e; }

  .aud-note {
    background: rgba(6,182,212,.06);
    border: 1px solid rgba(6,182,212,.18);
    border-radius: 12px;
    color: #b6e7ee;
    font-size: .77rem;
    line-height: 1.55;
    padding: .85rem 1rem;
  }
  html[data-theme="light"] .aud-note { color: #0e7490; }

  /* =========================================================================
     MODAL
     ========================================================================= */
  .aud-modal .modal-content {
    background: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-strong);
    border-radius: 18px;
    color: var(--ok-text-primary);
  }
  .aud-modal .modal-header,
  .aud-modal .modal-footer { border-color: var(--ok-border-subtle); }
  .aud-modal .modal-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 800;
  }
  .aud-modal .btn-close-white { filter: var(--ok-bg-canvas) === #050508 ? invert(1) : none; }
  html[data-theme="light"] .aud-modal .btn-close-white { filter: invert(0.5); }

  .aud-detail {
    background: rgba(255,255,255,.025);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 12px;
    height: 100%;
    padding: .8rem .9rem;
  }
  html[data-theme="light"] .aud-detail { background: var(--ok-pill-bg); }
  .aud-detail-label {
    color: var(--ok-text-muted);
    display: block;
    font-size: .65rem;
    font-weight: 750;
    letter-spacing: .06em;
    margin-bottom: .28rem;
    text-transform: uppercase;
  }
  .aud-detail-value {
    color: var(--ok-text-primary);
    font-size: .8rem;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .aud-json {
    background: var(--ok-bg-canvas);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 11px;
    color: #c4b5fd;
    font-size: .72rem;
    max-height: 270px;
    overflow: auto;
    padding: .85rem;
    white-space: pre-wrap;
    word-break: break-word;
  }
  html[data-theme="light"] .aud-json { color: #6d28d9; background: #f8f5ff; }
  .aud-json-empty { color: var(--ok-text-muted); font-size: .75rem; }

  /* =========================================================================
     FOOTER
     ========================================================================= */
  .admin-footer {
    border-top: 1px solid var(--ok-border-subtle);
    background: var(--ok-bg-surface);
    padding: 1rem 1.25rem;
    text-align: center;
    color: var(--ok-text-muted);
    font-size: 0.78rem;
    position: relative;
    z-index: 1;
    margin-top: 2rem;
  }

  /* =========================================================================
     RESPONSIVIDADE
     ========================================================================= */
  @media (max-width: 1200px) {
    .ok-flat-quad-strip { grid-template-columns: repeat(2, 1fr); }
    .ok-canvas-asides-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 991px) {
    .ok-rail-sidebar { transform: translateX(-120%); }
    body.mobile-nav-active .ok-rail-sidebar { transform: translateX(0); }
    .ok-viewport-shell { margin-left: 0; padding: 16px; }
    .ok-page-title-main { font-size: 1.55rem; }
  }
  @media (max-width: 767px) {
    .aud-page-heading { align-items: flex-start; flex-direction: column; }
    .aud-top-actions { width: 100%; }
    .aud-top-actions .btn { flex: 1; }
    .aud-footer { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 600px) {
    .ok-flat-quad-strip { grid-template-columns: 1fr; }
  }
</style>
