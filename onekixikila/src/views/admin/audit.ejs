  <%- include('../partials/sweet-alert') %>
  <script src="/js/api-client.js"></script>
  <script>
    (function(){
      'use strict';
      const role = String(document.body.dataset.adminRole || '').toUpperCase(),
            canView = ['ADMIN','AUDITOR'].includes(role),
            el = {
              loading: document.getElementById('aud-loading'),
              error: document.getElementById('aud-error'),
              card: document.getElementById('aud-table-card'),
              body: document.getElementById('aud-table-body'),
              pagination: document.getElementById('aud-pagination'),
              alert: document.getElementById('aud-alert')
            };
      let page = 1, pages = 1, pageSize = 20, events = [], seq = 0;

      function esc(v) { return String(v==null?'':v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]) }
      function errMsg(e,f) { return e && typeof e.message === 'string' && e.message.trim() ? e.message : f }
      function showAlert(t,type) { el.alert.className='alert alert-'+(type||'danger')+' mb-4'; el.alert.textContent=String(t||'Ocorreu um erro.'); el.alert.classList.remove('d-none'); }
      function clearAlert() { el.alert.classList.add('d-none'); el.alert.textContent=''; }
      function dateTime(v) { if(!v)return'—'; const d=new Date(v); return Number.isNaN(d.getTime())?'—':new Intl.DateTimeFormat('pt-PT',{dateStyle:'medium',timeStyle:'medium'}).format(d); }
      function uuidValid(s) { return /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(s); }
      function nextDay(s) { const d=new Date(s+'T00:00:00Z'); d.setUTCDate(d.getUTCDate()+1); return d.toISOString().slice(0,10); }
      function parseJson(v) { if(v==null||v==='')return null; if(typeof v==='string'){try{return JSON.parse(v)}catch(_){return v}} return v; }
      function pretty(v) { const x=parseJson(v); return x==null?'—':typeof x==='string'?x:JSON.stringify(x,null,2); }

      function requestParams(requestPage) {
        const q = new URLSearchParams({page:String(requestPage),limit:String(pageSize)}),
              action = document.getElementById('aud-action').value,
              resource = document.getElementById('aud-resource').value,
              actor = document.getElementById('aud-actor').value.trim(),
              start = document.getElementById('aud-start').value,
              end = document.getElementById('aud-end').value;
        if(actor && !uuidValid(actor)) throw new Error('O ID do ator deve ser um UUID válido.');
        if(start && end && start > end) throw new Error('A data inicial não pode ser posterior à data final.');
        if(action) q.set('action', action);
        if(resource) q.set('resourceType', resource);
        if(actor) q.set('actorUserId', actor);
        if(start) q.set('startDate', start);
        if(end) q.set('endDate', nextDay(end));
        return q;
      }

      function updateStats(data, p) {
        const total = Number(p && (p.totalItems ?? p.totalCount));
        document.getElementById('aud-stat-events').textContent = String(data.length);
        document.getElementById('aud-stat-actors').textContent = String(new Set(data.map(x => x.actor_user_id).filter(Boolean)).size);
        document.getElementById('aud-stat-actions').textContent = String(new Set(data.map(x => x.action).filter(Boolean)).size);
        document.getElementById('aud-stat-resources').textContent = String(new Set(data.map(x => x.resource_type).filter(Boolean)).size);
        const totalLabel = (Number.isFinite(total) ? new Intl.NumberFormat('pt-PT').format(total) : data.length) + ' evento(s)';
        const lbl1 = document.getElementById('aud-total-label');
        if (lbl1) lbl1.textContent = totalLabel;
        const lbl2 = document.getElementById('aud-total-label-2');
        if (lbl2) lbl2.textContent = totalLabel;
        const vaultTotal = document.getElementById('vault-total');
        if (vaultTotal) vaultTotal.textContent = totalLabel;
      }

      function renderRows(data) {
        if (!data.length) {
          el.body.innerHTML = '<tr><td colspan="7"><div class="aud-state m-3"><i class="bi bi-journal" aria-hidden="true"></i><strong class="d-block text-white mb-1">Nenhum evento encontrado</strong><span>Altere os filtros ou tente novamente mais tarde.</span></div></td></tr>';
          return;
        }
        el.body.innerHTML = data.map((e, i) =>
          '<tr><td class="ps-4"><div class="text-white small fw-semibold" style="color:var(--ok-text-primary)!important;">' + esc(dateTime(e.created_at)) + '</div><div class="aud-muted">Evento ' + esc(e.id||'—') + '</div></td><td><div class="text-white small fw-semibold" style="color:var(--ok-text-primary)!important;">' + esc(e.actor_name||'Ator não identificado') + '</div><div class="aud-muted">' + esc(e.actor_email||e.actor_user_id||'Sistema') + '</div><span class="aud-badge mt-1">' + esc(e.actor_role||'—') + '</span></td><td><span class="aud-badge aud-badge-action">' + esc(e.action||'—') + '</span></td><td><span class="aud-badge aud-badge-resource">' + esc(e.resource_type||'—') + '</span></td><td><span class="aud-code">' + esc(e.resource_id||'—') + '</span></td><td><span class="aud-muted">' + esc(e.ip_address||'—') + '</span></td><td class="text-end pe-4"><button type="button" class="btn btn-sm aud-btn-icon" data-aud-index="' + i + '" aria-label="Ver evento ' + esc(e.id||'') + '" title="Consultar evento"><i class="bi bi-eye" aria-hidden="true"></i></button></td></tr>'
        ).join('');
      }

      function renderPages(meta) {
        const total = Number(meta && (meta.totalItems ?? meta.totalCount)),
              cur = Number(meta && (meta.currentPage ?? meta.page)),
              tp = Number(meta && (meta.totalPages ?? meta.total_pages)),
              lim = Number(meta && (meta.pageSize ?? meta.limit));
        if (Number.isFinite(cur) && cur > 0) page = cur;
        if (Number.isFinite(lim) && lim > 0) pageSize = lim;
        pages = Number.isFinite(tp) && tp > 0 ? tp : 1;
        const start = Number.isFinite(total) && total > 0 ? (page-1)*pageSize+1 : 0,
              last = Number.isFinite(total) && total > 0 ? Math.min(page*pageSize, total) : events.length;
        document.getElementById('aud-page-info').textContent = Number.isFinite(total)
          ? 'A mostrar ' + start + '–' + last + ' de ' + new Intl.NumberFormat('pt-PT').format(total) + ' · Página ' + page + ' de ' + pages
          : 'Página ' + page + ' · ' + events.length + ' evento(s)';
        const nums = Array.from(new Set([1, pages, page-1, page, page+1].filter(n => n>=1 && n<=pages))).sort((a,b)=>a-b);
        let html = '<li><button type="button" data-aud-page="' + (page-1) + '" ' + (page<=1?'disabled':'') + ' aria-label="Página anterior"><i class="bi bi-chevron-left" aria-hidden="true"></i></button></li>', prev = 0;
        nums.forEach(n => {
          if (prev && n - prev > 1) html += '<li class="text-muted px-1 align-self-center" aria-hidden="true">…</li>';
          html += '<li><button type="button" data-aud-page="' + n + '" class="' + (page===n?'is-current':'') + '" ' + (page===n?'aria-current="page"':'') + '>' + n + '</button></li>';
          prev = n;
        });
        html += '<li><button type="button" data-aud-page="' + (page+1) + '" ' + (page>=pages?'disabled':'') + ' aria-label="Página seguinte"><i class="bi bi-chevron-right" aria-hidden="true"></i></button></li>';
        el.pagination.innerHTML = html;
      }

      async function loadAudit(requestPage) {
        if (!canView) {
          el.loading.classList.add('d-none');
          el.card.classList.add('d-none');
          el.error.innerHTML = '<i class="bi bi-shield-lock" aria-hidden="true"></i><strong class="d-block text-white mb-2">Acesso restrito</strong><span>A trilha de auditoria institucional está limitada a ADMIN e AUDITOR.</span>';
          el.error.classList.remove('d-none');
          return;
        }
        if (!window.apiClient || typeof window.apiClient.get !== 'function') {
          el.loading.classList.add('d-none');
          el.card.classList.add('d-none');
          el.error.innerHTML = '<i class="bi bi-plug" aria-hidden="true"></i><strong class="d-block text-white mb-2">Cliente da API indisponível</strong><span>Não é seguro apresentar dados de auditoria sem o cliente autenticado.</span><div class="mt-3"><button type="button" class="btn btn-sm btn-outline-light" id="aud-retry"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Tentar novamente</button></div>';
          el.error.classList.remove('d-none');
          return;
        }
        page = requestPage || 1;
        clearAlert();
        el.error.classList.add('d-none');
        el.card.classList.add('d-none');
        el.loading.classList.remove('d-none');
        events = [];
        document.getElementById('aud-export').disabled = true;
        const current = ++seq;
        let q;
        try {
          pageSize = Number(document.getElementById('aud-limit').value) || 20;
          q = requestParams(page);
        } catch (e) {
          el.loading.classList.add('d-none');
          showAlert(e.message, 'warning');
          return;
        }
        try {
          const response = await window.apiClient.get('/admin/audit-logs?' + q.toString());
          if (current !== seq) return;
          if (!response || response.success === false || !Array.isArray(response.data)) throw new Error('A API não devolveu uma lista de eventos válida.');
          events = response.data;
          renderRows(events);
          updateStats(events, response.pagination || {});
          renderPages(response.pagination || {});
          el.loading.classList.add('d-none');
          el.card.classList.remove('d-none');
          document.getElementById('aud-export').disabled = events.length === 0;
        } catch (e) {
          if (current !== seq) return;
          el.loading.classList.add('d-none');
          el.card.classList.add('d-none');
          el.error.innerHTML = '<i class="bi bi-exclamation-triangle" aria-hidden="true"></i><strong class="d-block text-white mb-2">Não foi possível carregar os registos</strong><span>' + esc(errMsg(e, 'Falha de comunicação com o servidor.')) + '</span><div class="mt-3"><button type="button" class="btn btn-sm btn-outline-light" id="aud-retry"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Tentar novamente</button></div>';
          el.error.classList.remove('d-none');
        }
      }

      function detailField(label, value) {
        return '<div class="col-12 col-md-6"><div class="aud-detail"><span class="aud-detail-label">' + esc(label) + '</span><span class="aud-detail-value">' + esc(value==null||value===''?'—':value) + '</span></div></div>';
      }
      function jsonBlock(label, value) {
        const p = pretty(value);
        return '<div class="col-12"><div class="aud-detail"><span class="aud-detail-label">' + esc(label) + '</span>' + (p==='—'?'<div class="aud-json-empty">Sem valores registados.</div>':'<pre class="aud-json mb-0">' + esc(p) + '</pre>') + '</div></div>';
      }

      function openDetail(e) {
        if (!window.bootstrap || !window.bootstrap.Modal) return showAlert('Os componentes da interface não foram inicializados.', 'warning');
        const modal = window.bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-aud-detail'));
        document.getElementById('aud-detail-body').innerHTML =
          '<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3"><div><div class="h5 fw-bold font-monospace mb-1" style="color:var(--ok-text-primary);">' + esc(e.id||'Evento') + '</div><span class="aud-badge aud-badge-action">' + esc(e.action||'—') + '</span> <span class="aud-badge aud-badge-resource">' + esc(e.resource_type||'—') + '</span></div><span class="small text-muted">' + esc(dateTime(e.created_at)) + '</span></div>' +
          '<div class="row g-2 mb-3">' +
            detailField('Ator', e.actor_name) +
            detailField('E-mail do ator', e.actor_email) +
            detailField('Papel do ator', e.actor_role) +
            detailField('ID do ator', e.actor_user_id) +
            detailField('Endereço IP', e.ip_address) +
            detailField('ID do recurso', e.resource_id) +
            detailField('ID de correlação da requisição', e.request_id) +
          '</div>' +
          '<div class="row g-2">' +
            jsonBlock('Estado anterior (old_values)', e.old_values) +
            jsonBlock('Novo estado (new_values)', e.new_values) +
            jsonBlock('Metadados', e.metadata) +
          '</div>' +
          '<div class="aud-warning mt-3"><i class="bi bi-lock me-2" aria-hidden="true"></i>Registo somente leitura; os eventos de auditoria não podem ser alterados nem eliminados.</div>';
        modal.show();
      }

      function csvCell(v) {
        let s = v==null ? '' : typeof v==='object' ? JSON.stringify(v) : String(v);
        if (/^[=+\-@\t\r]/.test(s)) s = "'" + s;
        return '"' + s.replace(/"/g, '""') + '"';
      }
      function exportPage() {
        if (!events.length) return;
        const head = ['id','created_at','actor_name','actor_email','actor_user_id','actor_role','ip_address','action','resource_type','resource_id','request_id','old_values','new_values','metadata'];
        const rows = [head, ...events.map(e => head.map(k => e[k]))];
        const csv = '\uFEFF' + rows.map(r => r.map(csvCell).join(';')).join('\r\n'),
              url = URL.createObjectURL(new Blob([csv], {type:'text/csv;charset=utf-8'})),
              a = document.createElement('a');
        a.href = url;
        a.download = 'onekixikila-auditoria-pagina-' + page + '-' + new Date().toISOString().slice(0,10) + '.csv';
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      }

      document.getElementById('aud-filter-form').addEventListener('submit', ev => { ev.preventDefault(); loadAudit(1); });
      document.getElementById('aud-filter-form').addEventListener('reset', () => { window.setTimeout(() => loadAudit(1), 0); });
      document.getElementById('aud-refresh').addEventListener('click', () => loadAudit(page));
      const refreshVault = document.getElementById('aud-refresh-vault');
      if (refreshVault) refreshVault.addEventListener('click', () => loadAudit(page));
      document.getElementById('aud-export').addEventListener('click', exportPage);
      el.pagination.addEventListener('click', ev => {
        const b = ev.target.closest('button[data-aud-page]');
        if (!b || b.disabled) return;
        const p = Number(b.dataset.audPage);
        if (Number.isInteger(p) && p >= 1 && p <= pages) loadAudit(p);
      });
      el.body.addEventListener('click', ev => {
        const b = ev.target.closest('button[data-aud-index]');
        if (!b) return;
        const e = events[Number(b.dataset.audIndex)];
        if (e) openDetail(e);
      });
      el.error.addEventListener('click', ev => { if (ev.target.closest('#aud-retry')) loadAudit(page); });

      // ===== Theme toggle =====
      const THEME_KEY = 'ok-theme';
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      const themeBtn = document.getElementById('theme-toggle-btn');
      if (themeBtn) {
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        themeBtn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      // ===== Sidebar mobile toggle =====
      const toggleBtn = document.getElementById('sidebar-toggle-btn');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          document.body.classList.toggle('mobile-nav-active');
        });
      }

      // ===== Mirror badges admin → rail =====
      function mirrorBadges() {
        ['kyc','disputes','withdrawals'].forEach((key) => {
          const original = document.getElementById('sidebar-badge-' + key);
          const mirror = document.getElementById('rail-badge-' + key);
          if (!original || !mirror) return;
          const hidden = original.classList.contains('d-none');
          mirror.classList.toggle('d-none', hidden);
          if (!hidden) {
            const txt = (original.textContent || '').trim();
            if (txt) mirror.textContent = txt;
          }
        });
      }
      mirrorBadges();
      const badgeObserver = new MutationObserver(mirrorBadges);
      ['kyc','disputes','withdrawals'].forEach((key) => {
        const elBadge = document.getElementById('sidebar-badge-' + key);
        if (elBadge) badgeObserver.observe(elBadge, { attributes: true, childList: true, characterData: true, subtree: true });
      });

      // ===== Ctrl+K foca pesquisa =====
      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
          const input = document.getElementById('global-admin-search');
          if (input) { e.preventDefault(); input.focus(); }
        }
      });

      // ===== Relógio UTC =====
      const clock = document.getElementById('admin-utc-clock');
      function tick() {
        if (clock) clock.textContent = new Intl.DateTimeFormat('pt-PT', {timeZone:'UTC',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(new Date()) + ' UTC';
      }
      tick();
      window.setInterval(tick, 1000);

      loadAudit(1);
    })();
  </script>
</body>
</html>