  <footer class="admin-footer">
    <div class="container-fluid">
      <span>&copy; <%= (typeof currentYear !== 'undefined' ? currentYear : new Date().getFullYear()) %> OneKixikila Admin Engine. Parâmetros operacionais em modo de consulta.</span>
    </div>
  </footer>

  <%- include('../partials/sweet-alert') %>
  <script src="/js/api-client.js"></script>
  <script>
    (function(){
      'use strict';
      const role = String(document.body.dataset.adminRole || '').toUpperCase(),
            allowed = ['ADMIN','AUDITOR','FINANCIAL_OPERATOR'].includes(role),
            loading = document.getElementById('settings-loading'),
            errorBox = document.getElementById('settings-error'),
            content = document.getElementById('settings-content'),
            refresh = document.getElementById('settings-refresh');
      const secretKey = /(secret|password|passwd|token|credential|private.?key|api.?key|access.?key|authorization|cookie)/i;
      function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c])}
      function label(v){return String(v||'').replace(/([a-z0-9])([A-Z])/g,'$1 $2').replace(/[_-]+/g,' ').replace(/\s+/g,' ').trim().replace(/^./,m=>m.toUpperCase())}
      function scalar(v){if(v===null||v===undefined||v==='')return'—';if(typeof v==='boolean')return v?'Sim':'Não';if(typeof v==='number')return new Intl.NumberFormat('pt-PT',{maximumFractionDigits:4}).format(v);return String(v)}
      function flatRows(obj,depth){if(obj==null||typeof obj!=='object')return'<div class="set-object-row"><span class="set-object-key">Valor</span><span class="set-object-value">'+esc(scalar(obj))+'</span></div>';if(Array.isArray(obj)){if(!obj.length)return'<div class="set-meta py-2">Sem valores configurados.</div>';return obj.map((v,i)=>'<div class="set-object-row"><span class="set-object-key">'+(i+1)+'</span><span class="set-object-value">'+esc(scalar(v))+'</span></div>').join('')}const entries=Object.entries(obj).filter(([k])=>!secretKey.test(k));if(!entries.length)return'<div class="set-meta py-2">Não há parâmetros seguros para apresentar.</div>';return entries.map(([k,v])=>{const nested=v&&typeof v==='object'?'<div class="mt-2 w-100"><span class="set-object-key">'+esc(label(k))+'</span><div class="set-object mt-2">'+flatRows(v,(depth||0)+1)+'</div></div>':'<span class="set-object-value">'+esc(scalar(v))+'</span>';return'<div class="set-object-row"><span class="set-object-key">'+(v&&typeof v==='object'?'':esc(label(k)))+'</span>'+nested+'</div>'}).join('')}
      function setKpiValue(id, value) {
        const el = document.getElementById(id);
        if (!el) return;
        el.textContent = value && String(value).trim() ? String(value).toUpperCase() : '—';
      }
      function renderSettings(s){
        if(!s||typeof s!=='object')throw new Error('A API não devolveu uma configuração válida.');
        document.getElementById('environment-badge').textContent=String(s.environment||'Ambiente não informado').toUpperCase();
        document.getElementById('environment-badge').className='set-pill '+(['production','prod'].includes(String(s.environment||'').toLowerCase())?'set-pill-on':'set-pill-off');
        document.getElementById('system-values').innerHTML=[['Nome da aplicação',s.appName],['Ambiente',s.environment],['Moeda padrão',s.currency]].map(([k,v])=>'<div class="set-value"><span class="set-value-label">'+esc(k)+'</span><span class="set-value-text">'+esc(scalar(v))+'</span></div>').join('');

        const storage=s.storage||{};
        document.getElementById('storage-values').innerHTML='<div class="row g-3 mb-3"><div class="col-12 col-md-6"><div class="set-value"><span class="set-value-label">Fornecedor</span><span class="set-value-text">'+esc(scalar(storage.provider))+'</span></div></div><div class="col-12"><div class="set-subheading mt-0">Buckets configurados</div></div></div><div class="row g-3"><div class="col-12 col-xl-6"><div class="set-subheading mt-0">Buckets</div>'+objectOrEmpty(storage.buckets)+'</div><div class="col-12 col-xl-6"><div class="set-subheading mt-0">Limites de armazenamento</div>'+objectOrEmpty(storage.limits)+'</div></div>';

        const pay=s.payments||{};
        const providers=Array.isArray(pay.providers)?pay.providers:[];
        document.getElementById('payments-values').innerHTML='<div class="set-value mb-3"><span class="set-value-label">Moeda padrão de pagamentos</span><span class="set-value-text">'+esc(scalar(pay.defaultCurrency))+'</span></div><div class="row g-3">'+(providers.length?providers.map(p=>'<div class="col-12 col-lg-6"><article class="set-provider"><div class="d-flex justify-content-between align-items-start gap-2"><div><div class="set-eyebrow">Prestador integrado</div><h3 class="set-provider-name mt-1 mb-0">'+esc(p.name||p.id||'Prestador')+'</h3><span class="set-meta">'+esc(p.id||'—')+'</span></div><span class="set-pill '+(p.enabled?'set-pill-on':'set-pill-off')+'">'+(p.enabled?'Ativo':'Inativo')+'</span></div><div class="set-subheading">Canais suportados</div>'+(Array.isArray(p.supportedChannels)&&p.supportedChannels.length?'<div class="d-flex flex-wrap gap-2">'+p.supportedChannels.map(c=>'<span class="set-pill set-pill-off">'+esc(c)+'</span>').join('')+'</div>':'<span class="set-meta">Não especificados</span>')+'</article></div>').join(''):'<div class="col-12"><div class="set-status">Nenhum prestador foi devolvido pela configuração.</div></div>')+'</div>';

        const limits=s.limits||{};
        document.getElementById('limits-values').innerHTML='<div class="row g-3"><div class="col-12 col-xl-4"><div class="set-subheading mt-0">Escalões financeiros</div>'+objectOrEmpty(limits.financialTiers)+'</div><div class="col-12 col-xl-4"><div class="set-subheading mt-0">Limites de grupos</div>'+objectOrEmpty(limits.groups)+'</div><div class="col-12 col-xl-4"><div class="set-subheading mt-0">Limites de uploads</div>'+objectOrEmpty(limits.uploads)+'</div></div>';

        document.getElementById('settings-updated').textContent='Consultado em '+new Intl.DateTimeFormat('pt-PT',{dateStyle:'medium',timeStyle:'short'}).format(new Date());
        const lastSeen = document.getElementById('vault-last-seen');
        if (lastSeen) lastSeen.textContent = new Intl.DateTimeFormat('pt-PT',{timeStyle:'short'}).format(new Date());

        setKpiValue('kpi-environment', s.environment);
        setKpiValue('kpi-currency', s.currency);
        setKpiValue('kpi-storage', storage.provider);
        const provCount = providers.length;
        const enabledCount = providers.filter(p => p && p.enabled).length;
        const kpiProv = document.getElementById('kpi-providers');
        if (kpiProv) kpiProv.textContent = provCount ? enabledCount + '/' + provCount : '—';
        const kpiProvTrend = document.getElementById('kpi-providers-trend');
        if (kpiProvTrend) kpiProvTrend.textContent = provCount ? (enabledCount === provCount ? 'Todos Ativos' : enabledCount + ' Ativos') : 'Sem prestadores';

        const accessBadge = document.getElementById('admin-access-badge');
        if (accessBadge) accessBadge.textContent = role || 'ADMIN';
      }
      function objectOrEmpty(v){return v&&typeof v==='object'&&Object.keys(v).length?'<div class="set-object">'+flatRows(v,0)+'</div>':'<div class="set-meta">Sem valores configurados.</div>'}
      async function load(){
        if(!allowed){
          loading.classList.add('d-none');
          content.classList.add('d-none');
          errorBox.innerHTML='<i class="bi bi-shield-lock" aria-hidden="true"></i><strong class="d-block text-white mb-2">Acesso restrito</strong><span>Esta página requer ADMIN, AUDITOR ou FINANCIAL_OPERATOR.</span>';
          errorBox.classList.remove('d-none');
          return;
        }
        if(!window.apiClient||typeof window.apiClient.get!=='function'){
          loading.classList.add('d-none');
          content.classList.add('d-none');
          errorBox.innerHTML='<i class="bi bi-plug" aria-hidden="true"></i><strong class="d-block text-white mb-2">Cliente da API indisponível</strong><span>Não é seguro apresentar parâmetros presumidos. Confirme o carregamento do cliente autenticado e tente novamente.</span><div class="mt-3"><button type="button" class="btn btn-sm btn-outline-light" id="settings-retry"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Tentar novamente</button></div>';
          errorBox.classList.remove('d-none');
          return;
        }
        errorBox.classList.add('d-none');
        content.classList.add('d-none');
        loading.classList.remove('d-none');
        loading.innerHTML='<span class="spinner-border spinner-border-sm text-primary me-2" aria-hidden="true"></span>A carregar configuração segura do sistema…';
        try{
          const response=await window.apiClient.get('/admin/settings');
          if(!response||response.success===false||!response.data||!response.data.settings)throw new Error(response&&response.message||'A API não devolveu configurações.');
          renderSettings(response.data.settings);
          loading.classList.add('d-none');
          content.classList.remove('d-none');
        }catch(e){
          loading.classList.add('d-none');
          content.classList.add('d-none');
          errorBox.innerHTML='<i class="bi bi-exclamation-triangle" aria-hidden="true"></i><strong class="d-block text-white mb-2">Não foi possível carregar as configurações</strong><span>'+esc(e&&e.message?e.message:'Falha de comunicação com o servidor.')+'</span><div class="mt-3"><button type="button" class="btn btn-sm btn-outline-light" id="settings-retry"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Tentar novamente</button></div>';
          errorBox.classList.remove('d-none');
        }
      }
      refresh.addEventListener('click',load);
      const refreshVault = document.getElementById('settings-refresh-vault');
      if (refreshVault) refreshVault.addEventListener('click', load);
      errorBox.addEventListener('click', e => { if(e.target.closest('#settings-retry')) load(); });

      /* ====================================================================
         RELÓGIO UTC
         ==================================================================== */
      const clock=document.getElementById('admin-utc-clock');
      function tick(){if(clock)clock.textContent=new Intl.DateTimeFormat('pt-PT',{timeZone:'UTC',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(new Date())+' UTC'}
      tick();window.setInterval(tick,1000);

      /* ====================================================================
         TEMA CLARO/ESCURO
         ==================================================================== */
      const THEME_KEY = 'ok-theme';
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      const themeBtn = document.getElementById('theme-toggle-btn');
      if (themeBtn) {
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        themeBtn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      /* ====================================================================
         SIDEBAR MOBILE TOGGLE
         ==================================================================== */
      const toggleBtn = document.getElementById('sidebar-toggle-btn');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          document.body.classList.toggle('mobile-nav-active');
        });
      }

      /* ====================================================================
         SINCRONIZA BADGES RAIL
         ==================================================================== */
      function mirrorBadges() {
        ['kyc', 'disputes', 'withdrawals'].forEach((key) => {
          const original = document.getElementById('sidebar-badge-' + key);
          const mirror = document.getElementById('rail-badge-' + key);
          if (!original || !mirror) return;
          const hidden = original.classList.contains('d-none');
          mirror.classList.toggle('d-none', hidden);
          if (!hidden) {
            const txt = (original.textContent || '').trim();
            if (txt) mirror.textContent = txt;
          }
        });
      }
      mirrorBadges();
      const badgeObserver = new MutationObserver(mirrorBadges);
      ['kyc', 'disputes', 'withdrawals'].forEach((key) => {
        const el = document.getElementById('sidebar-badge-' + key);
        if (el) badgeObserver.observe(el, { attributes: true, childList: true, characterData: true, subtree: true });
      });

      /* ====================================================================
         CTRL+K PESQUISA
         ==================================================================== */
      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
          const input = document.getElementById('global-admin-search');
          if (input) { e.preventDefault(); input.focus(); }
        }
      });

      load();
    })();
  </script>
</body>
</html>