<%- include('../partials/head') %>
<% const adminUser = (typeof user !== 'undefined' && user) ? user : {}; const adminUserName = adminUser.fullName || adminUser.full_name || 'Administrador'; const adminRoleForPage = String(adminUser.role || '').toUpperCase(); %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700;800&display=swap" rel="stylesheet">

<style>
  /* =========================================================================
     ONEKIXIKILA ADMIN — SISTEMA DE DESIGN UNIFICADO (dashboard + admin)
     Coerente com o dashboard do membro: roxo, Space Grotesk, rail slim tech.
     Fontes: Plus Jakarta Sans (corpo) + Space Grotesk (títulos)
     ========================================================================= */
  :root,
  html[data-theme="dark"] {
    --ok-bg-canvas: #050508;
    --ok-bg-surface: #0a0a10;
    --ok-bg-elevated: #111118;
    --ok-bg-sidebar: #08080e;

    --ok-purple-primary: #7c3aed;
    --ok-purple-vibrant: #8b5cf6;
    --ok-purple-soft: rgba(139, 92, 246, 0.12);
    --ok-purple-border: rgba(139, 92, 246, 0.3);
    --ok-purple-glow: rgba(139, 92, 246, 0.45);

    --ok-accent-cyan: #06b6d4;
    --ok-accent-emerald: #10b981;
    --ok-accent-amber: #f59e0b;
    --ok-accent-rose: #f43f5e;

    --ok-color-card-white: #ffffff;
    --ok-color-card-lime: #bef264;
    --ok-color-card-purple: #7c3aed;

    --ok-text-primary: #ffffff;
    --ok-text-secondary: #cbd5e1;
    --ok-text-muted: #94a3b8;

    --ok-border-subtle: rgba(255, 255, 255, 0.08);
    --ok-border-strong: rgba(255, 255, 255, 0.14);
    --ok-input-bg: rgba(255, 255, 255, 0.04);
    --ok-pill-bg: rgba(255, 255, 255, 0.05);
    --ok-pill-bg-hover: rgba(139, 92, 246, 0.12);
    --ok-chip-bg: rgba(255, 255, 255, 0.04);
    --ok-meter-bg: rgba(255, 255, 255, 0.05);
    --ok-stream-hover: var(--ok-purple-soft);
    --ok-shadow-card: rgba(0, 0, 0, 0.75);
    --ok-shadow-sidebar: rgba(0, 0, 0, 0.6);
    --ok-shadow-navbar: 0 4px 20px rgba(0, 0, 0, 0.4);

    --ok-bg-balance: #0d3b38;
    --ok-accent-green: #a3e635;
    --ok-accent-green-hover: #84cc16;
    --ok-accent-green-light: rgba(163, 230, 53, 0.12);

    --ok-radius-card: 18px;
    --ok-radius-pill: 9999px;
    --ok-radius-md: 12px;
    --ok-sidebar-width: 86px;
    --ok-sidebar-width-wide: 264px;
    --ok-navbar-height: 80px;
    --ok-content-max: 1440px;
  }

  html[data-theme="light"] {
    --ok-bg-canvas: #f4f5f9;
    --ok-bg-surface: #ffffff;
    --ok-bg-elevated: #ffffff;
    --ok-bg-sidebar: #ffffff;

    --ok-purple-primary: #6d28d9;
    --ok-purple-vibrant: #7c3aed;
    --ok-purple-soft: rgba(124, 58, 237, 0.08);
    --ok-purple-border: rgba(124, 58, 237, 0.25);
    --ok-purple-glow: rgba(124, 58, 237, 0.25);

    --ok-color-card-white: #ffffff;
    --ok-color-card-lime: #bef264;
    --ok-color-card-purple: #7c3aed;

    --ok-text-primary: #0f172a;
    --ok-text-secondary: #334155;
    --ok-text-muted: #64748b;

    --ok-border-subtle: rgba(15, 23, 42, 0.10);
    --ok-border-strong: rgba(15, 23, 42, 0.18);
    --ok-input-bg: #ffffff;
    --ok-pill-bg: rgba(15, 23, 42, 0.04);
    --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
    --ok-chip-bg: #ffffff;
    --ok-meter-bg: rgba(15, 23, 42, 0.06);
    --ok-stream-hover: rgba(124, 58, 237, 0.08);
    --ok-shadow-card: rgba(15, 23, 42, 0.10);
    --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);

    --ok-bg-balance: #0d3b38;
    --ok-accent-green: #a3e635;
    --ok-accent-green-hover: #84cc16;
    --ok-accent-green-light: #eff6e0;
  }

  @media (prefers-color-scheme: light) {
    html:not([data-theme]) {
      --ok-bg-canvas: #f4f5f9;
      --ok-bg-surface: #ffffff;
      --ok-bg-elevated: #ffffff;
      --ok-bg-sidebar: #ffffff;

      --ok-purple-primary: #6d28d9;
      --ok-purple-vibrant: #7c3aed;
      --ok-purple-soft: rgba(124, 58, 237, 0.08);
      --ok-purple-border: rgba(124, 58, 237, 0.25);
      --ok-purple-glow: rgba(124, 58, 237, 0.25);

      --ok-text-primary: #0f172a;
      --ok-text-secondary: #334155;
      --ok-text-muted: #64748b;

      --ok-border-subtle: rgba(15, 23, 42, 0.10);
      --ok-border-strong: rgba(15, 23, 42, 0.18);
      --ok-input-bg: #ffffff;
      --ok-pill-bg: rgba(15, 23, 42, 0.04);
      --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
      --ok-chip-bg: #ffffff;
      --ok-meter-bg: rgba(15, 23, 42, 0.06);
      --ok-stream-hover: rgba(124, 58, 237, 0.08);
      --ok-shadow-card: rgba(15, 23, 42, 0.10);
      --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);

      --ok-bg-balance: #0d3b38;
      --ok-accent-green: #a3e635;
      --ok-accent-green-hover: #84cc16;
      --ok-accent-green-light: #eff6e0;
    }
  }

  * { box-sizing: border-box; -webkit-font-smoothing: antialiased; }

  body.admin-body {
    background-color: var(--ok-bg-canvas) !important;
    color: var(--ok-text-primary);
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 14px;
    letter-spacing: -0.005em;
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .ok-ambient-glow-core {
    position: fixed;
    top: -120px; left: 20%;
    width: 550px; height: 550px;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.14) 0%, rgba(5, 5, 8, 0) 70%);
    pointer-events: none; z-index: 0; filter: blur(90px);
  }
  html[data-theme="light"] .ok-ambient-glow-core {
    background: radial-gradient(circle, rgba(124, 58, 237, 0.10) 0%, rgba(244, 245, 249, 0) 70%);
  }

  /* =========================================================================
     RAIL SIDEBAR
     ========================================================================= */
  .ok-rail-sidebar {
    position: fixed;
    top: 20px; left: 20px; bottom: 20px;
    width: var(--ok-sidebar-width);
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 20px;
    display: flex; flex-direction: column; align-items: center;
    padding: 22px 0;
    z-index: 1040;
    box-shadow: 0 10px 30px var(--ok-shadow-sidebar);
    backdrop-filter: blur(20px);
    transition: all 0.3s ease;
    overflow-y: auto;
    overflow-x: hidden;
  }
  .ok-rail-sidebar::-webkit-scrollbar { width: 0; }

  .ok-brand-emblem {
    width: 48px; height: 48px; border-radius: 14px;
    background: linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 20px;
    box-shadow: 0 8px 20px rgba(124, 58, 237, 0.4);
    flex-shrink: 0;
    text-decoration: none;
  }
  .ok-brand-emblem:hover { transform: translateY(-2px); }
  .ok-brand-emblem svg { width: 24px; height: 24px; stroke: #ffffff; }

  .ok-rail-nav {
    flex: 1;
    display: flex; flex-direction: column; align-items: center;
    gap: 10px; width: 100%;
  }

  .ok-rail-group-label {
    font-size: 0.58rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ok-text-muted);
    margin: 10px 0 2px 0;
    text-align: center;
    width: 100%;
    opacity: 0.7;
  }

  .ok-rail-link {
    width: 46px; height: 46px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-muted); text-decoration: none;
    transition: all 0.2s ease; background: transparent;
    position: relative;
    flex-shrink: 0;
  }
  .ok-rail-link:hover {
    color: var(--ok-purple-vibrant);
    background-color: var(--ok-purple-soft);
    transform: translateY(-2px);
  }
  .ok-rail-link.active {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    color: #ffffff;
    box-shadow: 0 8px 20px rgba(139, 92, 246, 0.5);
  }
  .ok-rail-link.active svg { stroke: #ffffff; }
  .ok-rail-link .ok-badge-dot {
    position: absolute; top: 8px; right: 8px;
    width: 8px; height: 8px; border-radius: 50%;
    background-color: #ef4444;
    border: 2px solid var(--ok-bg-surface);
  }
  .ok-rail-link .ok-badge-count {
    position: absolute;
    top: 4px; right: 4px;
    min-width: 16px; height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: #f43f5e;
    color: #fff;
    font-size: 0.58rem;
    font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    border: 2px solid var(--ok-bg-surface);
    line-height: 1;
  }
  .ok-rail-link .ok-badge-count.badge-warn { background: #f59e0b; color: #1a1a1a; }
  .ok-rail-link .ok-badge-count.badge-info { background: #06b6d4; color: #052029; }

  .ok-rail-footer {
    display: flex; flex-direction: column; align-items: center;
    gap: 10px; width: 100%;
    padding-top: 14px;
    margin-top: 8px;
    border-top: 1px solid var(--ok-border-subtle);
  }

  /* =========================================================================
     VIEWPORT SHELL — CENTRALIZADO
     ========================================================================= */
  .ok-viewport-shell {
    margin-left: calc(var(--ok-sidebar-width) + 20px);
    padding: 20px 20px 48px 0;
    position: relative; z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ok-viewport-shell > * {
    width: 100%;
    max-width: var(--ok-content-max);
    margin-inline: auto;
  }

  .ok-top-nav {
    height: var(--ok-navbar-height);
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 20px;
    gap: 14px;
    flex-wrap: wrap;
    max-width: var(--ok-content-max);
    margin-inline: auto;
    width: 100%;
  }

  .ok-search-capsule {
    position: relative;
    width: 420px; max-width: 100%;
    flex-shrink: 0;
  }
  .ok-search-capsule input {
    width: 100%; height: 46px;
    border-radius: var(--ok-radius-pill);
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    padding: 0 75px 0 46px;
    font-size: 0.88rem;
    color: var(--ok-text-primary);
    outline: none;
    transition: all 0.25s ease;
  }
  .ok-search-capsule input::placeholder { color: var(--ok-text-muted); }
  .ok-search-capsule input:focus {
    border-color: var(--ok-purple-vibrant);
    box-shadow: 0 0 0 4px var(--ok-purple-soft);
  }
  .ok-search-capsule .search-icon {
    position: absolute; left: 16px; top: 50%;
    transform: translateY(-50%);
    color: var(--ok-text-muted);
    display: flex;
  }
  .ok-search-capsule .shortcut-hint {
    position: absolute; right: 12px; top: 50%;
    transform: translateY(-50%);
    background: var(--ok-pill-bg);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 6px;
    padding: 2px 7px;
    font-size: 0.7rem;
    color: var(--ok-text-muted);
    font-weight: 600;
  }

  .ok-nav-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

  .ok-action-circle {
    width: 44px; height: 44px; border-radius: 14px;
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-primary);
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
    cursor: pointer;
  }
  .ok-action-circle:hover {
    border-color: var(--ok-purple-border);
    color: var(--ok-purple-vibrant);
    transform: translateY(-2px);
  }

  .ok-profile-pill {
    display: flex; align-items: center; gap: 10px;
    padding: 5px 16px 5px 5px;
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    border-radius: var(--ok-radius-pill);
    text-decoration: none; cursor: pointer;
    transition: all 0.2s ease;
    color: inherit;
  }
  .ok-profile-pill:hover { border-color: var(--ok-purple-border); }

  .ok-profile-avatar-nav {
    width: 36px; height: 36px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    color: #ffffff;
    font-weight: 800;
    font-size: 0.85rem;
    border: 2px solid var(--ok-purple-border);
    flex-shrink: 0;
  }

  .ok-theme-toggle {
    width: 44px; height: 44px; border-radius: 14px;
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-primary); cursor: pointer;
    transition: all 0.2s ease;
  }
  .ok-theme-toggle:hover {
    border-color: var(--ok-purple-border);
    color: var(--ok-purple-vibrant);
    transform: translateY(-2px);
  }

  .ok-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--ok-radius-pill);
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #10b981;
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .ok-status-pill .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
  }
  .ok-clock {
    font-family: 'Space Grotesk', monospace;
    font-size: 0.78rem;
    color: var(--ok-text-muted);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* =========================================================================
     HERO ADMIN
     ========================================================================= */
  .ok-canvas-hero-title {
    max-width: var(--ok-content-max);
    margin: 0 auto 22px auto;
    display: flex; justify-content: space-between; align-items: flex-end;
    flex-wrap: wrap; gap: 16px;
    width: 100%;
  }
  .ok-page-title-main {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.85rem; font-weight: 800;
    letter-spacing: -0.03em; line-height: 1.15;
    color: var(--ok-text-primary);
    margin: 0;
    display: flex; align-items: center; gap: 12px;
    flex-wrap: wrap;
  }
  .ok-page-title-main .user-highlight {
    background: linear-gradient(135deg, var(--ok-purple-vibrant) 0%, #c084fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .ok-eyebrow {
    color: var(--ok-purple-vibrant);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .ok-live-beacon {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.7rem; font-weight: 800;
    padding: 4px 11px;
    border-radius: var(--ok-radius-pill);
    background: rgba(244, 63, 94, 0.15);
    border: 1px solid rgba(244, 63, 94, 0.3);
    color: #f43f5e;
    letter-spacing: 0.04em; text-transform: uppercase;
  }
  .ok-pulse-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background-color: #f43f5e;
    box-shadow: 0 0 8px #f43f5e;
    animation: okPulseDot 1.6s infinite;
  }
  @keyframes okPulseDot {
    0%   { box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.55); }
    70%  { box-shadow: 0 0 0 8px rgba(244, 63, 94, 0); }
    100% { box-shadow: 0 0 0 0 rgba(244, 63, 94, 0); }
  }
  .ok-canvas-sub {
    color: var(--ok-text-muted);
    font-size: 0.88rem; margin-top: 5px; line-height: 1.45;
    display: flex; align-items: center; gap: 8px;
    flex-wrap: wrap;
  }

  /* =========================================================================
     SESSÃO 1: 4 CARDS RESUMO
     ========================================================================= */
  .ok-flat-quad-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: var(--ok-content-max);
    margin: 0 auto 28px auto;
    border-radius: 0px !important;
    overflow: hidden;
    box-shadow: 0 16px 36px var(--ok-shadow-card);
    border: 1px solid var(--ok-border-subtle);
    width: 100%;
  }
  .ok-flat-card-box {
    padding: 22px 18px 20px 18px;
    display: flex; flex-direction: column; justify-content: space-between;
    min-height: 165px;
    border-radius: 0px !important;
    position: relative;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  .ok-flat-card-box:hover {
    z-index: 2; filter: brightness(1.04);
    transform: translateY(-2px);
  }
  .ok-flat-card-box.theme-white { background-color: #ffffff; color: #0f172a; }
  .ok-flat-card-box.theme-lime { background-color: #bef264; color: #0f172a; }
  .ok-flat-card-box.theme-white-alt {
    background-color: #ffffff; color: #0f172a;
    border-left: 1px solid rgba(0,0,0,0.08);
  }
  .ok-flat-card-box.theme-purple { background-color: #7c3aed; color: #ffffff; }

  .ok-flat-icon-container { width: 36px; height: 36px; margin-bottom: 14px; }
  .ok-flat-icon-container svg { width: 100%; height: 100%; stroke-width: 1.9; }
  .theme-white .ok-flat-icon-container svg,
  .theme-lime .ok-flat-icon-container svg,
  .theme-white-alt .ok-flat-icon-container svg { stroke: #0f172a; }
  .theme-purple .ok-flat-icon-container svg { stroke: #ffffff; }

  .ok-flat-title {
    font-size: 1.02rem; font-weight: 800;
    letter-spacing: -0.02em; line-height: 1.2;
    margin-bottom: 5px;
  }
  .ok-flat-desc {
    font-size: 0.74rem; line-height: 1.4;
    opacity: 0.85; margin-bottom: 8px;
  }
  .ok-flat-metric-data {
    font-size: 1.15rem; font-weight: 800;
    font-family: 'Space Grotesk', sans-serif;
    letter-spacing: -0.02em;
  }
  .ok-flat-trend {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 0.7rem; font-weight: 800;
    padding: 3px 9px;
    border-radius: var(--ok-radius-pill);
    margin-top: 6px;
  }
  .theme-white .ok-flat-trend,
  .theme-lime .ok-flat-trend,
  .theme-white-alt .ok-flat-trend { background: rgba(16, 185, 129, 0.15); color: #10b981; }
  .theme-purple .ok-flat-trend { background: rgba(255,255,255,0.15); color: #ffffff; }

  /* =========================================================================
     SESSÃO 2: ASIDE ESQUERDO (VAULT) + MÓDULO DIREITO (CONFIG)
     ========================================================================= */
  .ok-canvas-asides-grid {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 28px;
    max-width: var(--ok-content-max);
    margin: 0 auto 30px auto;
    align-items: start;
    width: 100%;
  }

  .ok-balance-vault-card {
    background: linear-gradient(160deg, var(--ok-bg-surface) 0%, var(--ok-bg-canvas) 100%);
    border: 1px solid var(--ok-purple-border);
    border-radius: 20px;
    padding: 1.5rem;
    box-shadow: 0 8px 32px var(--ok-shadow-card), 0 0 30px rgba(124, 58, 237, 0.15);
    color: var(--ok-text-primary);
    display: flex; flex-direction: column; justify-content: space-between;
    position: relative; overflow: hidden;
  }
  .ok-vault-wave-bg {
    position: absolute; inset: 0;
    background: radial-gradient(circle at 10% 20%, rgba(139, 92, 246, 0.18) 0%, transparent 60%);
    pointer-events: none;
  }
  .ok-vault-badge-cluster {
    display: flex; align-items: center; gap: 8px;
    position: relative; z-index: 1;
    flex-wrap: wrap;
  }
  .ok-token-emblem {
    width: 30px; height: 30px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .ok-vault-balance-display {
    margin: 22px 0 16px 0;
    position: relative; z-index: 1;
  }
  .ok-vault-caption {
    font-size: 0.72rem; font-weight: 700;
    color: var(--ok-text-muted);
    text-transform: uppercase; letter-spacing: 0.04em;
    display: flex; align-items: center; justify-content: space-between;
    gap: 8px;
  }
  .ok-vault-sum {
    font-size: 1.85rem; font-weight: 800;
    font-family: 'Space Grotesk', sans-serif;
    letter-spacing: -0.03em;
    margin-top: 6px;
    color: var(--ok-purple-vibrant);
  }
  .ok-vault-action-row {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 10px;
    position: relative; z-index: 1;
    margin-top: 16px;
  }
  .ok-vault-btn {
    height: 44px; border-radius: var(--ok-radius-pill);
    font-size: 0.82rem; font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    gap: 6px; text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    border: none;
    padding: 0 14px;
    font-family: inherit;
  }
  .ok-vault-btn.primary {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    color: #ffffff;
    box-shadow: 0 8px 20px rgba(139, 92, 246, 0.45);
  }
  .ok-vault-btn.primary:hover { transform: translateY(-2px); color: #ffffff; }
  .ok-vault-btn.ghost {
    background: var(--ok-pill-bg);
    color: var(--ok-text-primary);
    border: 1px solid var(--ok-border-subtle);
  }
  .ok-vault-btn.ghost:hover { background: var(--ok-pill-bg-hover); color: var(--ok-purple-vibrant); }

  .ok-config-module-card {
    background: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 20px;
    padding: 1.5rem;
    box-shadow: 0 8px 32px var(--ok-shadow-card);
    display: flex; flex-direction: column; justify-content: flex-start;
    gap: 16px;
  }
  .ok-chart-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 4px; flex-wrap: wrap; gap: 12px;
  }
  .ok-chart-tagline { display: flex; align-items: center; gap: 12px; }
  .ok-chart-tag-emblem {
    width: 42px; height: 42px; border-radius: 12px;
    background: var(--ok-purple-soft); color: var(--ok-purple-vibrant);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .ok-chart-title { font-size: 1.02rem; font-weight: 800; color: var(--ok-text-primary); margin: 0; font-family: 'Space Grotesk', sans-serif; }
  .ok-chart-sub { font-size: 0.75rem; color: var(--ok-text-muted); }

  /* =========================================================================
     BOTÕES E PILLS (admin)
     ========================================================================= */
  .admin-btn-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: var(--ok-radius-pill);
    border: 1px solid var(--ok-border-subtle);
    background: var(--ok-pill-bg);
    color: var(--ok-text-primary);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    font-family: inherit;
  }
  .admin-btn-pill:hover {
    border-color: var(--ok-purple-border);
    color: var(--ok-purple-vibrant);
    background: var(--ok-pill-bg-hover);
    transform: translateY(-1px);
  }
  .admin-btn-pill-outline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: var(--ok-radius-pill);
    border: 1px solid var(--ok-border-subtle);
    background: transparent;
    color: var(--ok-text-primary);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    font-family: inherit;
  }
  .admin-btn-pill-outline:hover {
    border-color: var(--ok-purple-border);
    color: var(--ok-purple-vibrant);
    transform: translateY(-1px);
  }

  /* =========================================================================
     CONTEÚDO ADMIN — SECÇÕES (set-*)
     ========================================================================= */
  .set-page-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 1.45rem;
    flex-wrap: wrap;
  }
  .set-eyebrow {
    color: var(--ok-purple-vibrant);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  .set-title {
    color: var(--ok-text-primary);
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.55rem, 2.4vw, 2.15rem);
    font-weight: 800;
    letter-spacing: -.04em;
    margin: .3rem 0 .35rem;
  }
  .set-subtitle {
    color: var(--ok-text-muted);
    margin: 0;
    max-width: 800px;
    line-height: 1.6;
  }
  .set-notice {
    background: rgba(6,182,212,.06);
    border: 1px solid rgba(6,182,212,.18);
    border-radius: 12px;
    color: #b6e7ee;
    font-size: .78rem;
    line-height: 1.6;
    padding: .9rem 1rem;
  }
  html[data-theme="light"] .set-notice { color: #0e7490; }
  .set-status {
    border: 1px dashed var(--ok-border-strong);
    border-radius: var(--ok-radius-card);
    color: var(--ok-text-muted);
    padding: 2.3rem 1rem;
    text-align: center;
  }
  .set-status i {
    color: var(--ok-purple-vibrant);
    display: block;
    font-size: 1.6rem;
    margin-bottom: .55rem;
  }

  .set-section {
    margin-bottom: 1rem;
    overflow: hidden;
    background: var(--ok-bg-elevated);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 16px;
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }
  .set-section:hover {
    border-color: var(--ok-purple-border);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px var(--ok-shadow-card);
  }
  .set-section:last-child { margin-bottom: 0; }
  .set-section-head {
    align-items: center;
    border-bottom: 1px solid var(--ok-border-subtle);
    display: flex;
    gap: .85rem;
    padding: 1.1rem 1.2rem;
  }
  .set-section-icon {
    align-items: center;
    background: var(--ok-purple-soft);
    border: 1px solid var(--ok-purple-border);
    border-radius: 12px;
    color: #c4b5fd;
    display: flex;
    font-size: 1rem;
    height: 40px;
    justify-content: center;
    width: 40px;
    flex-shrink: 0;
  }
  .set-section-title {
    color: var(--ok-text-primary);
    font-family: 'Space Grotesk', sans-serif;
    font-size: .98rem;
    font-weight: 800;
    margin: 0;
  }
  .set-section-subtitle {
    color: var(--ok-text-muted);
    font-size: .72rem;
    margin: .2rem 0 0;
  }
  .set-section-body { padding: 1.2rem; }

  .set-value-grid {
    display: grid;
    gap: .7rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .set-value {
    background: rgba(255,255,255,.025);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 12px;
    min-width: 0;
    padding: .8rem .9rem;
    transition: border-color 0.2s ease;
  }
  .set-value:hover { border-color: var(--ok-purple-border); }
  html[data-theme="light"] .set-value { background: var(--ok-pill-bg); }
  .set-value-label {
    color: var(--ok-text-muted);
    display: block;
    font-size: .65rem;
    font-weight: 750;
    letter-spacing: .07em;
    margin-bottom: .28rem;
    text-transform: uppercase;
  }
  .set-value-text {
    color: var(--ok-text-primary);
    font-size: .84rem;
    font-weight: 650;
    overflow-wrap: anywhere;
    font-family: 'Space Grotesk', sans-serif;
  }

  .set-object {
    border: 1px solid var(--ok-border-subtle);
    border-radius: 12px;
    margin: 0;
    padding: .25rem .9rem;
    background: rgba(255,255,255,.015);
  }
  html[data-theme="light"] .set-object { background: rgba(15, 23, 42, 0.02); }
  .set-object-row {
    align-items: flex-start;
    border-bottom: 1px solid rgba(255,255,255,.055);
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
    justify-content: space-between;
    padding: .7rem 0;
  }
  html[data-theme="light"] .set-object-row { border-bottom-color: rgba(15, 23, 42, 0.06); }
  .set-object-row:last-child { border-bottom: 0; }
  .set-object-key {
    color: var(--ok-text-secondary);
    font-size: .76rem;
    font-weight: 650;
    overflow-wrap: anywhere;
  }
  .set-object-value {
    color: var(--ok-text-primary);
    font-size: .77rem;
    font-weight: 750;
    max-width: 65%;
    overflow-wrap: anywhere;
    text-align: right;
    font-family: 'Space Grotesk', sans-serif;
  }

  .set-pill {
    border: 1px solid transparent;
    border-radius: 999px;
    display: inline-flex;
    font-size: .66rem;
    font-weight: 800;
    padding: .34rem .6rem;
    align-items: center;
    gap: 4px;
  }
  .set-pill-on {
    background: rgba(16,185,129,.1);
    border-color: rgba(16,185,129,.24);
    color: #6ee7b7;
  }
  .set-pill-off {
    background: rgba(148,163,184,.1);
    border-color: rgba(148,163,184,.2);
    color: #cbd5e1;
  }
  html[data-theme="light"] .set-pill-on { color: #047857; }
  html[data-theme="light"] .set-pill-off { color: #475569; }

  .set-provider {
    background: rgba(255,255,255,.02);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 14px;
    height: 100%;
    padding: 1rem;
    transition: border-color 0.2s ease;
  }
  .set-provider:hover { border-color: var(--ok-purple-border); }
  html[data-theme="light"] .set-provider { background: var(--ok-pill-bg); }
  .set-provider-name {
    color: var(--ok-text-primary);
    font-family: 'Space Grotesk', sans-serif;
    font-size: .9rem;
    font-weight: 800;
  }

  .set-subheading {
    color: var(--ok-text-muted);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .09em;
    margin: 1.15rem 0 .6rem;
    text-transform: uppercase;
  }
  .set-subheading.mt-0 { margin-top: 0; }

  .set-sensitive { color: var(--ok-text-muted); font-size: .68rem; }
  .set-meta { color: var(--ok-text-muted); font-size: .72rem; }
  .set-updated { color: var(--ok-text-muted); font-size: .7rem; }
  .set-hidden { display: none !important; }

  /* =========================================================================
     FOOTER ADMIN
     ========================================================================= */
  .admin-footer {
    border-top: 1px solid var(--ok-border-subtle);
    background: var(--ok-bg-surface);
    padding: 1rem 1.25rem;
    text-align: center;
    color: var(--ok-text-muted);
    font-size: 0.78rem;
    position: relative;
    z-index: 1;
    margin-top: 2rem;
    max-width: var(--ok-content-max);
    margin-inline: auto;
    width: 100%;
  }

  /* =========================================================================
     RESPONSIVIDADE
     ========================================================================= */
  @media (max-width: 1200px) {
    .ok-flat-quad-strip { grid-template-columns: repeat(2, 1fr); }
    .ok-canvas-asides-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 991px) {
    .ok-rail-sidebar { transform: translateX(-120%); }
    body.mobile-nav-active .ok-rail-sidebar { transform: translateX(0); }
    .ok-viewport-shell { margin-left: 0; padding: 16px; }
    .ok-page-title-main { font-size: 1.55rem; }
    .set-page-heading { align-items: flex-start; flex-direction: column; }
    .set-page-heading .btn { width: 100%; }
  }
  @media (max-width: 767px) {
    .set-value-grid { grid-template-columns: 1fr; }
    .set-section-head, .set-section-body { padding: 1rem; }
    .set-object-value { max-width: 100%; text-align: left; }
  }
  @media (max-width: 600px) {
    .ok-flat-quad-strip { grid-template-columns: 1fr; }
    .ok-profile-pill .admin-profile-text { display: none !important; }
    .ok-search-capsule { width: min(100%, 500px); }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

