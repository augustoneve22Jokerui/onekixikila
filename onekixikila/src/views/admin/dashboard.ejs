  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    (function () {
      'use strict';

      const CAN_VIEW_AUDIT = <%- JSON.stringify(canViewAuditTrail) %>;
      const loadingScreen = document.getElementById('admin-loading-screen');
      const dashboardView = document.getElementById('admin-dashboard-view');
      const THEME_KEY = 'ok-theme';

      /* ====================================================================
         TEMA CLARO/ESCURO (mesma lógica do dashboard)
         ==================================================================== */
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-btn');
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        if (!btn) return;
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      /* ====================================================================
         AÇÕES GLOBAIS (mesma lógica do dashboard)
         ==================================================================== */
      function setupGlobalActions() {
        const sidebarToggle = document.getElementById('sidebar-toggle-btn');
        sidebarToggle?.addEventListener('click', () => {
          const active = document.body.classList.toggle('mobile-nav-active');
          sidebarToggle.setAttribute('aria-expanded', String(active));
        });
        document.querySelectorAll('.ok-rail-link[href]').forEach((link) => {
          link.addEventListener('click', () => {
            if (window.matchMedia('(max-width: 991px)').matches) {
              document.body.classList.remove('mobile-nav-active');
            }
          });
        });

        const search = document.getElementById('global-dashboard-search');
        const navLinks = Array.from(document.querySelectorAll('.ok-rail-link[data-search-label]'));
        const empty = document.getElementById('admin-empty-nav-search');
        search?.addEventListener('input', () => {
          const term = search.value.trim().toLocaleLowerCase('pt');
          let visible = 0;
          navLinks.forEach((link) => {
            const match = !term || `${link.dataset.searchLabel || ''} ${link.title || ''}`.toLocaleLowerCase('pt').includes(term);
            link.classList.toggle('d-none', !match);
            if (match) visible += 1;
          });
          empty?.classList.toggle('d-none', visible !== 0);
        });

        document.addEventListener('keydown', (event) => {
          if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
            if (search) { event.preventDefault(); search.focus(); }
          }
        });

        document.querySelectorAll('[data-action="logout"]').forEach((button) => {
          button.addEventListener('click', async (event) => {
            event.preventDefault();
            button.disabled = true;
            try {
              if (window.apiClient && typeof window.apiClient.post === 'function') await window.apiClient.post('/auth/logout', {});
              if (window.apiClient && typeof window.apiClient.clearSession === 'function') window.apiClient.clearSession();
            } catch (_) { /* A sessão é encerrada localmente mesmo se a rede falhar. */ }
            window.location.href = '/login';
          });
        });
      }

      /* ====================================================================
         HELPERS (idênticos ao dashboard)
         ==================================================================== */
      const refreshButtons = [
        document.getElementById('admin-refresh-btn'),
        document.getElementById('admin-refresh-btn-main')
      ].filter(Boolean);
      let hasLoaded = false;
      let refreshInFlight = false;

      function escapeHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, (char) => ({
          '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        }[char]));
      }

      function setRefreshState(isRefreshing) {
        refreshButtons.forEach((button) => {
          button.disabled = isRefreshing;
          const icon = button.querySelector('.bi-arrow-clockwise');
          if (icon) icon.classList.toggle('admin-spin', isRefreshing);
        });
      }

      function writeMetric(id, value, fallback = '0') {
        const element = document.getElementById(id);
        if (element) element.textContent = value == null || value === '' ? fallback : String(value);
      }

      function setQueueBadge(id, value) {
        const badge = document.getElementById(id);
        if (!badge) return;
        const count = Math.max(0, Number(value) || 0);
        badge.textContent = count > 99 ? '99+' : String(count);
        badge.classList.toggle('d-none', count === 0);
      }

      function formatMoney(value) {
        const amount = Number(value);
        if (!Number.isFinite(amount)) return '0 Kz';
        if (window.App && typeof window.App.formatMoney === 'function') return window.App.formatMoney(amount);
        return `${new Intl.NumberFormat('pt-AO', { maximumFractionDigits: 0 }).format(amount)} Kz`;
      }

      function updateLastRefreshed() {
        const label = document.getElementById('admin-last-updated');
        const status = document.getElementById('admin-live-status');
        if (label) label.textContent = new Intl.DateTimeFormat('pt-AO', { hour: '2-digit', minute: '2-digit', second: '2-digit' }).format(new Date());
        if (status) status.textContent = 'Dados sincronizados';
      }

      /* ====================================================================
         CARREGAMENTO PRINCIPAL DO DASHBOARD
         ==================================================================== */
      async function loadDashboardData() {
        if (refreshInFlight) return;
        refreshInFlight = true;
        setRefreshState(true);
        try {
          if (!window.apiClient || typeof window.apiClient.get !== 'function') {
            throw new Error('O cliente da API não foi inicializado. Recarregue a página.');
          }

          const response = await window.apiClient.get('/admin/dashboard');
          const overview = response && response.data && response.data.overview
            ? response.data.overview
            : (response && response.data);
          if (!overview || typeof overview !== 'object') {
            throw new Error('A API não devolveu métricas válidas para o painel.');
          }

          const queues = overview.pendingQueues || {};
          writeMetric('stat-pending-kyc', queues.pendingKycReviews);
          writeMetric('stat-pending-withdrawals', queues.pendingWithdrawals);
          writeMetric('stat-active-disputes', queues.activeDisputes);
          writeMetric('stat-payment-discrepancies', queues.discrepancyReconciliations);
          writeMetric('stat-severe-risks', queues.severeUnreviewedRisks);
          setQueueBadge('sidebar-badge-kyc', queues.pendingKycReviews);
          setQueueBadge('sidebar-badge-disputes', queues.activeDisputes);
          setQueueBadge('sidebar-badge-withdrawals', queues.pendingWithdrawals);

          const finances = overview.finances || {};
          writeMetric('fin-total-ledger', formatMoney(finances.totalLedgerBalance));
          writeMetric('fin-total-ledger-kpi', formatMoney(finances.totalLedgerBalance));
          writeMetric('fin-total-available', formatMoney(finances.totalAvailableBalance));
          writeMetric('fin-total-available-inline', formatMoney(finances.totalAvailableBalance));
          writeMetric('fin-total-locked', formatMoney(finances.totalLockedBalance));
          writeMetric('fin-total-locked-inline', formatMoney(finances.totalLockedBalance));
          writeMetric('fin-total-payouts', formatMoney(finances.totalPayoutsVolume));
          writeMetric('fin-total-deposits', formatMoney(finances.totalDepositedVolume));

          const users = overview.users || {};
          writeMetric('users-stat-total', users.total);
          writeMetric('users-stat-active', users.active);
          writeMetric('users-stat-restricted', users.restricted);

          const groups = overview.groups || {};
          writeMetric('groups-stat-total', groups.total);
          writeMetric('groups-stat-active', groups.active);
          writeMetric('groups-stat-formation', groups.formation);
          writeMetric('groups-stat-completed', groups.completed);
          writeMetric('groups-stat-paused', groups.pausedOrSuspended);

          if (CAN_VIEW_AUDIT) await loadRecentAuditLogs();
          updateLastRefreshed();
          loadingScreen?.classList.add('d-none');
          dashboardView?.classList.remove('d-none');
          hasLoaded = true;
        } catch (error) {
          const message = error && error.message ? error.message : 'Falha de comunicação com os serviços administrativos.';
          const status = document.getElementById('admin-live-status');
          if (status) status.textContent = hasLoaded ? 'Atualização indisponível' : 'Sem ligação';
          if (hasLoaded) {
            const label = document.getElementById('admin-last-updated');
            if (label) label.textContent = 'A mostrar os últimos dados carregados';
            if (window.Alerts && typeof window.Alerts.toast === 'function') window.Alerts.toast(message, 'warning');
          } else if (loadingScreen) {
            loadingScreen.innerHTML = `
              <div class="alert alert-danger mx-auto text-start" style="max-width:520px;">
                <h5 class="fw-bold mb-2"><i class="bi bi-x-octagon-fill me-2"></i>Não foi possível carregar o painel</h5>
                <p class="small mb-3">${escapeHtml(message)}</p>
                <button type="button" id="admin-retry-btn" class="btn btn-sm btn-outline-danger"><i class="bi bi-arrow-clockwise me-1"></i>Tentar novamente</button>
              </div>`;
            document.getElementById('admin-retry-btn')?.addEventListener('click', loadDashboardData, { once: true });
          }
        } finally {
          refreshInFlight = false;
          setRefreshState(false);
        }
      }

      /* ====================================================================
         TABELA DE AUDITORIA (STREAM FLAT LIST)
         ==================================================================== */
      async function loadRecentAuditLogs() {
        const tbody = document.getElementById('audit-table-body');
        if (!tbody || !CAN_VIEW_AUDIT) return;
        try {
          const response = await window.apiClient.get('/admin/audit-logs?limit=6');
          const logs = Array.isArray(response && response.data) ? response.data : [];

          const headerRow = `
            <div class="ok-stream-flat-row header">
              <div>Ação</div>
              <div>Recurso</div>
              <div>Ator</div>
              <div>IP / Origem</div>
              <div>Data & Hora (UTC)</div>
            </div>`;

          if (logs.length === 0) {
            tbody.innerHTML = headerRow + `
              <div class="ok-empty-state">
                <p class="small mb-0">Nenhum evento registado na trilha.</p>
              </div>`;
            return;
          }

          const rows = logs.map((log) => {
            const time = window.App && typeof window.App.formatDate === 'function'
              ? window.App.formatDate(log.created_at, true)
              : (log.created_at ? new Date(log.created_at).toLocaleString('pt-AO', { timeZone: 'UTC' }) : '—');
            const actor = log.actor_name || log.actor_email || 'Sistema / Automático';
            const actionBadge = getActionBadge(log.action);
            return `
              <div class="ok-stream-flat-row">
                <div class="ok-stream-tx-meta">
                  <div class="ok-stream-tx-icon info">
                    <i class="bi bi-activity"></i>
                  </div>
                  <span>${actionBadge}</span>
                </div>
                <div>
                  <span class="ok-stream-badge neutral">${escapeHtml(log.resource_type || '—')}</span>
                </div>
                <div class="ok-stream-actor">
                  <p class="ok-stream-tx-desc">${escapeHtml(actor)}</p>
                </div>
                <div class="ok-stream-tx-date">${escapeHtml(log.ip_address || '—')}</div>
                <div class="ok-stream-tx-date">${escapeHtml(time)}</div>
              </div>`;
          }).join('');

          tbody.innerHTML = headerRow + rows;
        } catch (error) {
          tbody.innerHTML = `
            <div class="ok-stream-flat-row header">
              <div>Ação</div>
              <div>Recurso</div>
              <div>Ator</div>
              <div>IP / Origem</div>
              <div>Data & Hora (UTC)</div>
            </div>
            <div class="ok-empty-state">
              <p class="small mb-0" style="color: #f59e0b;">Não foi possível carregar os eventos recentes. Tente atualizar o painel.</p>
            </div>`;
        }
      }

      function getActionBadge(action) {
        const value = String(action || '').toUpperCase();
        const known = {
          LOGIN: 'credit',
          FINANCIAL_TRANSACTION: 'info',
          STATUS_CHANGE: 'warning',
          ROLE_CHANGE: 'warning',
          KYC_REVIEW: 'info',
          DELETE: 'debit'
        };
        const cls = known[value] || 'neutral';
        return `<span class="ok-stream-badge ${cls}">${escapeHtml(value || 'AÇÃO')}</span>`;
      }

      /* ====================================================================
         INICIALIZAÇÃO
         ==================================================================== */
      refreshButtons.forEach((button) => button.addEventListener('click', loadDashboardData));

      document.addEventListener('DOMContentLoaded', () => {
        initThemeToggle();
        setupGlobalActions();
        loadDashboardData();
        window.setInterval(() => { if (!document.hidden) loadDashboardData(); }, 60000);
      });
    })();
  </script>
</body>
</html>