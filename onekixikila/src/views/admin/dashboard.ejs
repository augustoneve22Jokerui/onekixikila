<%
  const adminRole = String((typeof user !== 'undefined' && user && user.role) || '').toUpperCase();
  const canAccessAdminPage = (...roles) => roles.includes(adminRole);
  const canViewAuditTrail = canAccessAdminPage('ADMIN', 'AUDITOR');
  const adminDisplayName = (typeof user !== 'undefined' && user && (user.fullName || user.full_name || user.email)) || 'Administrador';
%>
<%- include('../partials/head') %>

<!-- Fontes do dashboard normal — identidade visual preservada. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700;800&display=swap" rel="stylesheet">

<style>
  /* =========================================================================
     SISTEMA DE DESIGN — ONEKIXIKILA ADMIN (TEMA ESCURO PADRÃO + TEMA CLARO)
     Coerente com dashboard/index.ejs: paleta, cards chapados, sidebar slim tech.
     ========================================================================= */
  :root,
  html[data-theme="dark"] {
    --ok-bg-canvas: #050508;
    --ok-bg-surface: #0a0a10;
    --ok-bg-elevated: #111118;

    --ok-purple-primary: #7c3aed;
    --ok-purple-vibrant: #8b5cf6;
    --ok-purple-soft: rgba(139, 92, 246, 0.12);
    --ok-purple-border: rgba(139, 92, 246, 0.3);
    --ok-purple-glow: rgba(139, 92, 246, 0.45);

    --ok-accent-cyan: #06b6d4;
    --ok-accent-emerald: #10b981;
    --ok-accent-amber: #f59e0b;
    --ok-accent-rose: #f43f5e;

    --ok-color-card-white: #ffffff;
    --ok-color-card-lime: #bef264;
    --ok-color-card-purple: #7c3aed;

    --ok-text-primary: #ffffff;
    --ok-text-secondary: #cbd5e1;
    --ok-text-muted: #94a3b8;

    --ok-border-subtle: rgba(255, 255, 255, 0.08);
    --ok-border-strong: rgba(255, 255, 255, 0.14);
    --ok-input-bg: rgba(255, 255, 255, 0.04);
    --ok-pill-bg: rgba(255, 255, 255, 0.05);
    --ok-pill-bg-hover: rgba(139, 92, 246, 0.12);
    --ok-chip-bg: rgba(255, 255, 255, 0.04);
    --ok-meter-bg: rgba(255, 255, 255, 0.05);
    --ok-stream-hover: var(--ok-purple-soft);
    --ok-shadow-card: rgba(0, 0, 0, 0.75);
    --ok-shadow-sidebar: rgba(0, 0, 0, 0.6);

    --ok-bg-balance: #0d3b38;
    --ok-accent-green: #a3e635;
    --ok-accent-green-hover: #84cc16;
    --ok-accent-green-light: rgba(163, 230, 53, 0.12);

    --ok-radius-pill: 9999px;
    --ok-radius-card: 20px;
    --ok-radius-md: 12px;
    --ok-sidebar-width: 86px;
    --ok-navbar-height: 80px;
    --ok-content-max: 1080px;
  }

  html[data-theme="light"] {
    --ok-bg-canvas: #f4f5f9;
    --ok-bg-surface: #ffffff;
    --ok-bg-elevated: #ffffff;

    --ok-purple-primary: #6d28d9;
    --ok-purple-vibrant: #7c3aed;
    --ok-purple-soft: rgba(124, 58, 237, 0.08);
    --ok-purple-border: rgba(124, 58, 237, 0.25);
    --ok-purple-glow: rgba(124, 58, 237, 0.25);

    --ok-color-card-white: #ffffff;
    --ok-color-card-lime: #bef264;
    --ok-color-card-purple: #7c3aed;

    --ok-text-primary: #0f172a;
    --ok-text-secondary: #334155;
    --ok-text-muted: #64748b;

    --ok-border-subtle: rgba(15, 23, 42, 0.10);
    --ok-border-strong: rgba(15, 23, 42, 0.18);
    --ok-input-bg: #ffffff;
    --ok-pill-bg: rgba(15, 23, 42, 0.04);
    --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
    --ok-chip-bg: #ffffff;
    --ok-meter-bg: rgba(15, 23, 42, 0.06);
    --ok-stream-hover: rgba(124, 58, 237, 0.08);
    --ok-shadow-card: rgba(15, 23, 42, 0.10);
    --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);

    --ok-bg-balance: #0d3b38;
    --ok-accent-green: #a3e635;
    --ok-accent-green-hover: #84cc16;
    --ok-accent-green-light: #eff6e0;
  }

  @media (prefers-color-scheme: light) {
    html:not([data-theme]) {
      --ok-bg-canvas: #f4f5f9;
      --ok-bg-surface: #ffffff;
      --ok-bg-elevated: #ffffff;

      --ok-purple-primary: #6d28d9;
      --ok-purple-vibrant: #7c3aed;
      --ok-purple-soft: rgba(124, 58, 237, 0.08);
      --ok-purple-border: rgba(124, 58, 237, 0.25);
      --ok-purple-glow: rgba(124, 58, 237, 0.25);

      --ok-text-primary: #0f172a;
      --ok-text-secondary: #334155;
      --ok-text-muted: #64748b;

      --ok-border-subtle: rgba(15, 23, 42, 0.10);
      --ok-border-strong: rgba(15, 23, 42, 0.18);
      --ok-input-bg: #ffffff;
      --ok-pill-bg: rgba(15, 23, 42, 0.04);
      --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
      --ok-chip-bg: #ffffff;
      --ok-meter-bg: rgba(15, 23, 42, 0.06);
      --ok-stream-hover: rgba(124, 58, 237, 0.08);
      --ok-shadow-card: rgba(15, 23, 42, 0.10);
      --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);

      --ok-bg-balance: #0d3b38;
      --ok-accent-green: #a3e635;
      --ok-accent-green-hover: #84cc16;
      --ok-accent-green-light: #eff6e0;
    }
  }

  * { box-sizing: border-box; -webkit-font-smoothing: antialiased; }

  body {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--ok-bg-canvas);
    color: var(--ok-text-primary);
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .ok-ambient-glow-core {
    position: fixed;
    top: -120px; left: 20%;
    width: 550px; height: 550px;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.14) 0%, rgba(5, 5, 8, 0) 70%);
    pointer-events: none; z-index: 0; filter: blur(90px);
  }
  html[data-theme="light"] .ok-ambient-glow-core {
    background: radial-gradient(circle, rgba(124, 58, 237, 0.10) 0%, rgba(244, 245, 249, 0) 70%);
  }

  /* =========================================================================
     BARRA LATERAL SLIM TECH (mesma do dashboard normal)
     ========================================================================= */
  .ok-rail-sidebar {
    position: fixed;
    top: 20px; left: 20px; bottom: 20px;
    width: var(--ok-sidebar-width);
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 20px;
    display: flex; flex-direction: column; align-items: center;
    padding: 22px 0;
    z-index: 1040;
    box-shadow: 0 10px 30px var(--ok-shadow-sidebar);
    backdrop-filter: blur(20px);
    transition: all 0.3s ease;
  }

  .ok-brand-emblem {
    width: 48px; height: 48px; border-radius: 14px;
    background: linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 28px;
    box-shadow: 0 8px 20px rgba(124, 58, 237, 0.4);
    text-decoration: none;
  }

  .ok-rail-nav {
    flex: 1;
    display: flex; flex-direction: column; align-items: center;
    gap: 14px; width: 100%;
    overflow-y: auto; overflow-x: hidden; scrollbar-width: thin;
  }
  .ok-rail-nav::-webkit-scrollbar { width: 3px; }
  .ok-rail-nav::-webkit-scrollbar-thumb { background: var(--ok-border-subtle); border-radius: 5px; }

  .ok-rail-link {
    width: 46px; height: 46px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-muted); text-decoration: none;
    transition: all 0.2s ease; background: transparent;
    position: relative;
  }
  .ok-rail-link:hover {
    color: var(--ok-purple-vibrant);
    background-color: var(--ok-purple-soft);
    transform: translateY(-2px);
  }
  .ok-rail-link.active {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    color: #ffffff;
    box-shadow: 0 8px 20px rgba(139, 92, 246, 0.5);
  }
  .ok-rail-link svg { width: 20px; height: 20px; }

  .ok-rail-link .ok-badge-dot {
    position: absolute; top: 8px; right: 8px;
    width: 8px; height: 8px; border-radius: 50%;
    background-color: #ef4444;
    border: 2px solid var(--ok-bg-surface);
  }

  .admin-rail-count {
    position: absolute; top: 2px; right: 1px;
    min-width: 18px; height: 18px; padding: 0 4px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 999px;
    background: #ef4444; color: #fff;
    border: 2px solid var(--ok-bg-surface);
    font-size: 9px; font-weight: 800;
  }

  .ok-rail-footer {
    display: flex; flex-direction: column; align-items: center;
    gap: 10px; width: 100%;
  }

  .admin-empty-nav-search {
    color: var(--ok-text-muted);
    font-size: 0.68rem;
    text-align: center;
    padding: 0.5rem 0.2rem;
  }

  /* =========================================================================
     VIEWPORT SHELL — CENTRALIZADO (corrigido)
     ========================================================================= */
  .ok-viewport-shell {
    margin-left: calc(var(--ok-sidebar-width) + 20px);
    padding: 20px 20px 48px 0;
    position: relative; z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ok-viewport-shell > * {
    width: 100%;
    max-width: var(--ok-content-max);
    margin-inline: auto;
  }

  /* Top nav — alinhado ao centro do conteúdo (mesmo padrão do ficheiro de utilizadores) */
  .ok-top-nav {
    height: var(--ok-navbar-height);
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 20px;
    gap: 14px;
    flex-wrap: wrap;
    max-width: var(--ok-content-max);
    margin-inline: auto;
    width: 100%;
  }

  /* Barra de pesquisa — alinhada ao início do conteúdo */
  .ok-search-capsule {
    position: relative;
    width: 420px; max-width: 100%;
    flex-shrink: 0;
  }
  .ok-search-capsule input {
    width: 100%; height: 46px;
    border-radius: var(--ok-radius-pill);
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    padding: 0 75px 0 46px;
    font-size: 0.88rem;
    color: var(--ok-text-primary);
    outline: none;
    transition: all 0.25s ease;
  }
  .ok-search-capsule input::placeholder { color: var(--ok-text-muted); }
  .ok-search-capsule input:focus {
    border-color: var(--ok-purple-vibrant);
    box-shadow: 0 0 0 4px var(--ok-purple-soft);
  }
  .ok-search-capsule .search-icon {
    position: absolute; left: 16px; top: 50%;
    transform: translateY(-50%);
    color: var(--ok-text-muted);
    display: flex; align-items: center;
  }
  .ok-search-capsule .shortcut-hint {
    position: absolute; right: 12px; top: 50%;
    transform: translateY(-50%);
    background: var(--ok-pill-bg);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 6px;
    padding: 2px 7px;
    font-size: 0.7rem;
    color: var(--ok-text-muted);
    font-weight: 600;
  }

  .ok-nav-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

  .ok-action-circle {
    width: 44px; height: 44px; border-radius: 14px;
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-primary);
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
    cursor: pointer;
  }
  .ok-action-circle:hover {
    border-color: var(--ok-purple-border);
    color: var(--ok-purple-vibrant);
    transform: translateY(-2px);
  }
  .ok-action-circle[disabled] { opacity: 0.65; cursor: wait; }

  .ok-action-circle .admin-spin { animation: adminSpin 0.8s linear infinite; display: inline-block; }
  @keyframes adminSpin { to { transform: rotate(360deg); } }

  .ok-profile-pill {
    display: flex; align-items: center; gap: 10px;
    padding: 5px 16px 5px 5px;
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    border-radius: var(--ok-radius-pill);
    text-decoration: none; cursor: pointer;
    color: inherit;
  }
  .ok-profile-avatar-nav {
    width: 36px; height: 36px;
    border-radius: 50%; object-fit: cover;
    background: var(--ok-purple-soft);
    border: 2px solid var(--ok-purple-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-primary); font-weight: 800; font-size: 0.9rem;
  }

  .ok-theme-toggle {
    width: 44px; height: 44px; border-radius: 14px;
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-primary); cursor: pointer;
    transition: all 0.2s ease;
  }
  .ok-theme-toggle:hover {
    border-color: var(--ok-purple-border);
    color: var(--ok-purple-vibrant);
    transform: translateY(-2px);
  }

  /* =========================================================================
     HERO
     ========================================================================= */
  .ok-canvas-hero-title {
    max-width: var(--ok-content-max);
    margin: 0 auto 22px auto;
    display: flex; justify-content: space-between; align-items: flex-end;
    flex-wrap: wrap; gap: 16px;
    width: 100%;
  }

  .ok-page-title-main {
    font-size: 1.85rem; font-weight: 800;
    letter-spacing: -0.03em; line-height: 1.15;
    color: var(--ok-text-primary);
    margin: 0;
    display: flex; align-items: center; gap: 12px;
    flex-wrap: wrap;
  }
  .ok-page-title-main .user-highlight {
    background: linear-gradient(135deg, var(--ok-purple-vibrant) 0%, #c084fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .ok-live-beacon {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.7rem; font-weight: 800;
    padding: 4px 11px;
    border-radius: var(--ok-radius-pill);
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #10b981;
    letter-spacing: 0.04em; text-transform: uppercase;
  }
  .ok-pulse-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .ok-canvas-sub {
    color: var(--ok-text-muted);
    font-size: 0.88rem; margin-top: 5px; line-height: 1.45;
    display: flex; align-items: center; gap: 8px;
  }

  .admin-hero-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

  .ok-btn-pill-soft {
    background: var(--ok-purple-soft);
    color: var(--ok-purple-vibrant);
    font-weight: 700;
    border-radius: var(--ok-radius-pill);
    padding: 8px 16px;
    font-size: 0.82rem;
    border: 1px solid transparent;
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-flex; align-items: center; gap: 6px;
    cursor: pointer;
    font-family: inherit;
  }
  .ok-btn-pill-soft:hover {
    background: var(--ok-purple-vibrant);
    color: #ffffff;
  }
  .ok-btn-pill-soft[disabled] { opacity: 0.65; cursor: wait; }

  .admin-currency-badge {
    display: inline-flex; align-items: center;
    padding: 5px 12px;
    border-radius: var(--ok-radius-pill);
    background: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    color: var(--ok-text-muted);
    font-size: 0.72rem; font-weight: 800;
    letter-spacing: 0.06em; text-transform: uppercase;
  }

  .admin-content-section-title {
    max-width: var(--ok-content-max);
    margin: 0 auto 12px;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 10px;
  }
  .admin-content-section-title h5 {
    font-size: 1.05rem; font-weight: 800;
    color: var(--ok-text-primary);
    margin: 0; display: flex; align-items: center; gap: 8px;
    font-family: 'Space Grotesk', sans-serif;
  }

  /* =========================================================================
     SESSÃO 1: FAIXA DE 4 CARDS CHAPADOS (ALERTAS + MÉTRICAS)
     ========================================================================= */
  .ok-flat-quad-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: var(--ok-content-max);
    margin: 0 auto 28px auto;
    border-radius: 0px !important;
    overflow: hidden;
    box-shadow: 0 16px 36px var(--ok-shadow-card);
    border: 1px solid var(--ok-border-subtle);
  }

  .ok-flat-card-box {
    padding: 22px 18px 20px 18px;
    display: flex; flex-direction: column; justify-content: space-between;
    min-height: 165px;
    border-radius: 0px !important;
    position: relative;
    transition: transform 0.2s ease, filter 0.2s ease;
    text-decoration: none;
    color: inherit;
  }
  .ok-flat-card-box:hover {
    z-index: 2; filter: brightness(1.04);
    transform: translateY(-2px);
    color: inherit;
  }

  .ok-flat-card-box.theme-white { background-color: #ffffff; color: #0f172a; }
  .ok-flat-card-box.theme-lime { background-color: #bef264; color: #0f172a; }
  .ok-flat-card-box.theme-white-alt {
    background-color: #ffffff; color: #0f172a;
    border-left: 1px solid rgba(0,0,0,0.08);
  }
  .ok-flat-card-box.theme-purple { background-color: #7c3aed; color: #ffffff; }

  .ok-flat-icon-container { width: 36px; height: 36px; margin-bottom: 14px; }
  .ok-flat-icon-container svg { width: 100%; height: 100%; stroke-width: 1.9; }
  .theme-white .ok-flat-icon-container svg,
  .theme-lime .ok-flat-icon-container svg,
  .theme-white-alt .ok-flat-icon-container svg { stroke: #0f172a; }
  .theme-purple .ok-flat-icon-container svg { stroke: #ffffff; }

  .ok-flat-title {
    font-size: 1.02rem; font-weight: 800;
    letter-spacing: -0.02em; line-height: 1.2;
    margin-bottom: 5px;
  }
  .ok-flat-desc {
    font-size: 0.74rem; line-height: 1.4;
    opacity: 0.85; margin-bottom: 8px;
  }
  .ok-flat-metric-data {
    font-size: 1.15rem; font-weight: 800;
    font-family: 'Space Grotesk', sans-serif;
    letter-spacing: -0.02em;
  }
  .ok-flat-trend {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 0.7rem; font-weight: 800;
    padding: 3px 9px;
    border-radius: var(--ok-radius-pill);
    margin-top: 6px;
  }
  .theme-white .ok-flat-trend,
  .theme-lime .ok-flat-trend,
  .theme-white-alt .ok-flat-trend { background: rgba(16, 185, 129, 0.15); color: #10b981; }
  .theme-purple .ok-flat-trend { background: rgba(255,255,255,0.15); color: #ffffff; }

  .ok-flat-trend.danger { background: rgba(244, 63, 94, 0.15); color: #f43f5e; }
  .ok-flat-trend.warning { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
  .ok-flat-trend.info { background: rgba(6, 182, 212, 0.15); color: #06b6d4; }

  .stat-badge-pulse {
    animation: okPulseGlow 2.2s infinite;
  }
  @keyframes okPulseGlow {
    0%   { box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.35); }
    70%  { box-shadow: 0 0 0 10px rgba(244, 63, 94, 0); }
    100% { box-shadow: 0 0 0 0 rgba(244, 63, 94, 0); }
  }

  /* =========================================================================
     SESSÃO 2: VAULT LATERAL EM LARGURA TOTAL (sem redundância)
     ========================================================================= */
  .ok-balance-vault-card {
    background: linear-gradient(160deg, var(--ok-bg-surface) 0%, var(--ok-bg-canvas) 100%);
    border: 1px solid var(--ok-purple-border);
    border-radius: var(--ok-radius-card);
    padding: 1.5rem;
    box-shadow: 0 8px 32px var(--ok-shadow-card), 0 0 30px rgba(124, 58, 237, 0.15);
    color: var(--ok-text-primary);
    display: flex; flex-direction: column; justify-content: space-between;
    position: relative; overflow: hidden;
    max-width: var(--ok-content-max);
    margin: 0 auto 30px auto;
    width: 100%;
  }
  .ok-vault-wave-bg {
    position: absolute; inset: 0;
    background: radial-gradient(circle at 10% 20%, rgba(139, 92, 246, 0.18) 0%, transparent 60%);
    pointer-events: none;
  }
  .ok-vault-badge-cluster {
    display: flex; align-items: center; gap: 8px;
    position: relative; z-index: 1;
  }
  .ok-token-emblem {
    width: 30px; height: 30px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #7c3aed, #4c1d95);
  }
  .ok-vault-balance-display {
    margin: 22px 0 16px 0;
    position: relative; z-index: 1;
  }
  .ok-vault-caption {
    font-size: 0.72rem; font-weight: 700;
    color: var(--ok-text-muted);
    text-transform: uppercase; letter-spacing: 0.04em;
    display: flex; align-items: center; justify-content: space-between;
  }
  .ok-vault-sum {
    font-size: 1.85rem; font-weight: 800;
    font-family: 'Space Grotesk', sans-serif;
    letter-spacing: -0.03em;
    margin-top: 6px;
    color: var(--ok-purple-vibrant);
  }
  .ok-vault-action-row {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 10px;
    position: relative; z-index: 1;
    margin-top: 16px;
  }
  .ok-vault-btn {
    height: 44px; border-radius: var(--ok-radius-pill);
    font-size: 0.82rem; font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    gap: 6px; text-decoration: none;
    transition: all 0.2s ease;
  }
  .ok-vault-btn.primary {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    color: #ffffff;
    border: none;
    box-shadow: 0 8px 20px rgba(139, 92, 246, 0.45);
  }
  .ok-vault-btn.primary:hover { transform: translateY(-2px); color: #ffffff; }
  .ok-vault-btn.ghost {
    background: var(--ok-pill-bg);
    color: var(--ok-text-primary);
    border: 1px solid var(--ok-border-subtle);
  }
  .ok-vault-btn.ghost:hover { background: var(--ok-pill-bg-hover); color: var(--ok-purple-vibrant); }

  /* =========================================================================
     SESSÃO 3: GRUPOS + UTILIZADORES (2 CARDS LADO A LADO)
     ========================================================================= */
  .ok-bottom-insights-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    max-width: var(--ok-content-max);
    margin: 0 auto 30px auto;
  }

  .ok-groups-roster-card,
  .ok-users-roster-card {
    background: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    border-radius: var(--ok-radius-card);
    padding: 1.5rem;
    box-shadow: 0 8px 32px var(--ok-shadow-card);
  }

  .ok-card-title-row {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 16px; flex-wrap: wrap; gap: 8px;
  }
  .ok-card-title-row h4 {
    font-size: 1.05rem; font-weight: 800;
    color: var(--ok-text-primary);
    margin: 0; display: flex; align-items: center; gap: 8px;
    font-family: 'Space Grotesk', sans-serif;
  }
  .ok-card-title-sub {
    display: block;
    font-size: 0.78rem; color: var(--ok-text-muted);
    margin-top: 2px;
  }

  .admin-substat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .admin-substat-grid.cols-5 {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .admin-substat-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }

  .admin-substat {
    border-radius: var(--ok-radius-md);
    background: var(--ok-bg-elevated);
    border: 1px solid var(--ok-border-subtle);
    padding: 0.9rem 0.65rem;
    text-align: center;
    transition: all 0.2s ease;
  }
  .admin-substat:hover {
    border-color: var(--ok-border-strong);
    transform: translateY(-1px);
  }
  .admin-substat-label {
    font-size: 0.66rem; color: var(--ok-text-muted);
    font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; display: block;
  }
  .admin-substat-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.3rem; font-weight: 800;
    color: var(--ok-text-primary);
    line-height: 1.1; margin-top: 6px;
  }
  .admin-substat-value.text-success { color: var(--ok-accent-emerald) !important; }
  .admin-substat-value.text-danger  { color: var(--ok-accent-rose) !important; }
  .admin-substat-value.text-warning { color: var(--ok-accent-amber) !important; }
  .admin-substat-value.text-info    { color: var(--ok-accent-cyan) !important; }

  /* =========================================================================
     SESSÃO 4: TABELA DE AUDITORIA (STREAM FLAT LIST DO DASHBOARD)
     ========================================================================= */
  .ok-recent-transactions-section {
    max-width: var(--ok-content-max);
    margin: 0 auto;
    width: 100%;
  }

  .ok-stream-flat-list {
    display: flex; flex-direction: column;
    background: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    border-radius: var(--ok-radius-card);
    overflow: hidden;
    box-shadow: 0 8px 32px var(--ok-shadow-card);
  }

  .ok-stream-flat-row {
    display: grid;
    grid-template-columns: 1.2fr 1.2fr 1.4fr 1fr 1.2fr;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--ok-border-subtle);
    transition: all 0.2s ease;
  }
  .ok-stream-flat-row.header {
    background: rgba(255, 255, 255, 0.02);
    font-size: 0.7rem; font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ok-text-muted);
    padding-top: 12px; padding-bottom: 12px;
  }
  .ok-stream-flat-row:last-child { border-bottom: none; }
  .ok-stream-flat-row:hover:not(.header) {
    background: var(--ok-stream-hover);
  }

  .ok-stream-tx-meta {
    display: flex; align-items: center; gap: 10px; min-width: 0;
  }
  .ok-stream-tx-icon {
    width: 34px; height: 34px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; font-size: 0.85rem;
  }
  .ok-stream-tx-icon.credit { background: rgba(16,185,129,0.15); color: #10b981; }
  .ok-stream-tx-icon.debit { background: rgba(244,63,94,0.15); color: #f43f5e; }
  .ok-stream-tx-icon.info { background: var(--ok-purple-soft); color: var(--ok-purple-vibrant); }
  .ok-stream-tx-icon.warning { background: rgba(245,158,11,0.15); color: #f59e0b; }

  .ok-stream-tx-desc {
    font-size: 0.85rem; font-weight: 700;
    color: var(--ok-text-primary);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    margin: 0;
  }
  .ok-stream-tx-meta-line {
    font-size: 0.72rem; color: var(--ok-text-muted);
    margin: 0;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .ok-stream-tx-date {
    font-size: 0.8rem;
    color: var(--ok-text-muted);
    font-family: 'Space Grotesk', monospace;
  }
  .ok-stream-badge {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 0.7rem; font-weight: 800;
    padding: 4px 10px;
    border-radius: var(--ok-radius-pill);
    width: fit-content;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .ok-stream-badge.credit  { background: rgba(16,185,129,0.15); color: #10b981; }
  .ok-stream-badge.debit   { background: rgba(244,63,94,0.15); color: #f43f5e; }
  .ok-stream-badge.info    { background: var(--ok-purple-soft); color: var(--ok-purple-vibrant); }
  .ok-stream-badge.warning { background: rgba(245,158,11,0.15); color: #f59e0b; }
  .ok-stream-badge.neutral { background: var(--ok-pill-bg); color: var(--ok-text-muted); }

  /* Empty state (idêntico ao dashboard) */
  .ok-empty-state {
    text-align: center; padding: 3rem 1rem;
    color: var(--ok-text-muted);
    grid-column: 1 / -1;
  }
  .ok-empty-state svg {
    font-size: 2.5rem; opacity: 0.4;
    margin-bottom: 0.5rem;
    display: block; margin-inline: auto;
  }
  .ok-empty-state h6 {
    font-weight: 700;
    color: var(--ok-text-primary);
    margin-bottom: 4px;
  }

  /* Loading + erro */
  .admin-loading-shell {
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 5rem 1rem; text-align: center;
    max-width: var(--ok-content-max);
    margin: 0 auto;
    width: 100%;
  }
  .admin-loading-shell .spinner-border {
    width: 2.75rem; height: 2.75rem;
    color: var(--ok-purple-vibrant) !important;
    border-width: 0.22em;
  }

  .admin-footer {
    border-top: 1px solid var(--ok-border-subtle);
    background: transparent;
    padding: 1rem 1.25rem;
    text-align: center;
    color: var(--ok-text-muted);
    font-size: 0.78rem;
    position: relative;
    z-index: 1;
    max-width: var(--ok-content-max);
    margin: 2rem auto 0;
    width: 100%;
  }

  /* =========================================================================
     RESPONSIVIDADE — IGUAL AO DASHBOARD NORMAL
     ========================================================================= */
  @media (max-width: 1200px) {
    .ok-flat-quad-strip { grid-template-columns: repeat(2, 1fr); }
    .ok-bottom-insights-grid { grid-template-columns: 1fr; }
    .admin-substat-grid.cols-5 { grid-template-columns: repeat(3, 1fr); }
    .ok-stream-flat-row {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "meta badge"
        "date actor";
    }
    .ok-stream-tx-meta { grid-area: meta; }
    .ok-stream-badge   { grid-area: badge; justify-self: end; }
    .ok-stream-tx-date { grid-area: date; }
    .ok-stream-actor   { grid-area: actor; justify-self: end; text-align: right; }
  }
  @media (max-width: 991px) {
    .ok-rail-sidebar { transform: translateX(-120%); }
    body.mobile-nav-active .ok-rail-sidebar { transform: translateX(0); }
    .ok-viewport-shell { margin-left: 0; padding: 16px; }
    .ok-page-title-main { font-size: 1.55rem; }
  }
  @media (max-width: 767px) {
    .admin-substat-grid.cols-5 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .ok-flat-quad-strip { grid-template-columns: 1fr; }
    .admin-substat-grid,
    .admin-substat-grid.cols-5,
    .admin-substat-grid.cols-3 { grid-template-columns: repeat(2, 1fr); }
    .ok-stream-flat-row {
      grid-template-columns: 1fr;
      grid-template-areas: "meta" "date" "badge" "actor";
    }
    .ok-stream-badge, .ok-stream-actor { justify-self: start; text-align: left; }
    .ok-profile-pill .admin-profile-text { display: none !important; }
    .ok-search-capsule { width: min(100%, 500px); }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<body>
  <div class="ok-ambient-glow-core" aria-hidden="true"></div>

  <!-- ======================================================================
       SIDEBAR SLIM TECH — mesmas cápsulas do dashboard normal,
       com a navegação administrativa filtrada por permissões.
       ====================================================================== -->
  <aside class="ok-rail-sidebar" id="app-rail-sidebar" aria-label="Navegação Administrativa">
    <a href="/admin" class="ok-brand-emblem" title="OneKixikila — Administração" aria-label="Painel administrativo OneKixikila">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
        <polyline points="2 17 12 22 22 17"></polyline>
        <polyline points="2 12 12 17 22 12"></polyline>
      </svg>
    </a>

    <nav class="ok-rail-nav" aria-label="Ferramentas de administração">
      <a href="/admin" class="ok-rail-link active" title="Dashboard executivo" aria-label="Dashboard executivo" data-search-label="dashboard visão geral">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
      </a>
      <% if (canAccessAdminPage('ADMIN', 'AUDITOR', 'SUPPORT_AGENT')) { %>
