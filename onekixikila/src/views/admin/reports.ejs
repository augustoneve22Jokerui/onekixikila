<%- include('../partials/head') %>
<%
  const adminUser = (typeof user !== 'undefined' && user) ? user : {};
  const adminUserName = adminUser.fullName || adminUser.full_name || 'Administrador';
  const adminRoleForPage = String(adminUser.role || '').toUpperCase();
  const canAccessAdminPage = (...roles) => roles.includes(adminRoleForPage);
  const canViewAuditTrail = canAccessAdminPage('ADMIN', 'AUDITOR');
  const adminDisplayName = adminUserName || 'Administrador';
%>

<!-- Fontes do dashboard normal — identidade visual preservada. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700;800&display=swap" rel="stylesheet">

<style>
  /* =========================================================================
     SISTEMA DE DESIGN — ONEKIXIKILA ADMIN (TEMA ESCURO PADRÃO + TEMA CLARO)
     Fontes: Plus Jakarta Sans (corpo) + Space Grotesk (títulos)
     ========================================================================= */
  :root,
  html[data-theme="dark"] {
    --ok-bg-canvas: #050508;
    --ok-bg-surface: #0a0a10;
    --ok-bg-elevated: #111118;

    --ok-purple-primary: #7c3aed;
    --ok-purple-vibrant: #8b5cf6;
    --ok-purple-soft: rgba(139, 92, 246, 0.12);
    --ok-purple-border: rgba(139, 92, 246, 0.3);
    --ok-purple-glow: rgba(139, 92, 246, 0.45);

    --ok-accent-cyan: #06b6d4;
    --ok-accent-emerald: #10b981;
    --ok-accent-amber: #f59e0b;
    --ok-accent-rose: #f43f5e;

    --ok-color-card-white: #ffffff;
    --ok-color-card-lime: #bef264;
    --ok-color-card-purple: #7c3aed;

    --ok-text-primary: #ffffff;
    --ok-text-secondary: #cbd5e1;
    --ok-text-muted: #94a3b8;

    --ok-border-subtle: rgba(255, 255, 255, 0.08);
    --ok-border-strong: rgba(255, 255, 255, 0.14);
    --ok-input-bg: rgba(255, 255, 255, 0.04);
    --ok-pill-bg: rgba(255, 255, 255, 0.05);
    --ok-pill-bg-hover: rgba(139, 92, 246, 0.12);
    --ok-chip-bg: rgba(255, 255, 255, 0.04);
    --ok-meter-bg: rgba(255, 255, 255, 0.05);
    --ok-stream-hover: var(--ok-purple-soft);
    --ok-shadow-card: rgba(0, 0, 0, 0.75);
    --ok-shadow-sidebar: rgba(0, 0, 0, 0.6);

    --ok-bg-balance: #0d3b38;
    --ok-accent-green: #a3e635;
    --ok-accent-green-hover: #84cc16;
    --ok-accent-green-light: rgba(163, 230, 53, 0.12);

    --ok-radius-pill: 9999px;
    --ok-radius-card: 20px;
    --ok-radius-md: 12px;
    --ok-sidebar-width: 86px;
    --ok-navbar-height: 80px;
    --ok-content-max: 1180px;
  }

  html[data-theme="light"] {
    --ok-bg-canvas: #f4f5f9;
    --ok-bg-surface: #ffffff;
    --ok-bg-elevated: #ffffff;

    --ok-purple-primary: #6d28d9;
    --ok-purple-vibrant: #7c3aed;
    --ok-purple-soft: rgba(124, 58, 237, 0.08);
    --ok-purple-border: rgba(124, 58, 237, 0.25);
    --ok-purple-glow: rgba(124, 58, 237, 0.25);

    --ok-color-card-white: #ffffff;
    --ok-color-card-lime: #bef264;
    --ok-color-card-purple: #7c3aed;

    --ok-text-primary: #0f172a;
    --ok-text-secondary: #334155;
    --ok-text-muted: #64748b;

    --ok-border-subtle: rgba(15, 23, 42, 0.10);
    --ok-border-strong: rgba(15, 23, 42, 0.18);
    --ok-input-bg: #ffffff;
    --ok-pill-bg: rgba(15, 23, 42, 0.04);
    --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
    --ok-chip-bg: #ffffff;
    --ok-meter-bg: rgba(15, 23, 42, 0.06);
    --ok-stream-hover: rgba(124, 58, 237, 0.08);
    --ok-shadow-card: rgba(15, 23, 42, 0.10);
    --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);

    --ok-bg-balance: #0d3b38;
    --ok-accent-green: #a3e635;
    --ok-accent-green-hover: #84cc16;
    --ok-accent-green-light: #eff6e0;
  }

  @media (prefers-color-scheme: light) {
    html:not([data-theme]) {
      --ok-bg-canvas: #f4f5f9;
      --ok-bg-surface: #ffffff;
      --ok-bg-elevated: #ffffff;

      --ok-purple-primary: #6d28d9;
      --ok-purple-vibrant: #7c3aed;
      --ok-purple-soft: rgba(124, 58, 237, 0.08);
      --ok-purple-border: rgba(124, 58, 237, 0.25);
      --ok-purple-glow: rgba(124, 58, 237, 0.25);

      --ok-text-primary: #0f172a;
      --ok-text-secondary: #334155;
      --ok-text-muted: #64748b;

      --ok-border-subtle: rgba(15, 23, 42, 0.10);
      --ok-border-strong: rgba(15, 23, 42, 0.18);
      --ok-input-bg: #ffffff;
      --ok-pill-bg: rgba(15, 23, 42, 0.04);
      --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
      --ok-chip-bg: #ffffff;
      --ok-meter-bg: rgba(15, 23, 42, 0.06);
      --ok-stream-hover: rgba(124, 58, 237, 0.08);
      --ok-shadow-card: rgba(15, 23, 42, 0.10);
      --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);

      --ok-bg-balance: #0d3b38;
      --ok-accent-green: #a3e635;
      --ok-accent-green-hover: #84cc16;
      --ok-accent-green-light: #eff6e0;
    }
  }

  * { box-sizing: border-box; -webkit-font-smoothing: antialiased; }

  body {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--ok-bg-canvas);
    color: var(--ok-text-primary);
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .ok-ambient-glow-core {
    position: fixed;
    top: -120px; left: 20%;
    width: 550px; height: 550px;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.14) 0%, rgba(5, 5, 8, 0) 70%);
    pointer-events: none; z-index: 0; filter: blur(90px);
  }
  html[data-theme="light"] .ok-ambient-glow-core {
    background: radial-gradient(circle, rgba(124, 58, 237, 0.10) 0%, rgba(244, 245, 249, 0) 70%);
  }

  /* =========================================================================
     SIDEBAR SLIM TECH
     ========================================================================= */
  .ok-rail-sidebar {
    position: fixed;
    top: 20px; left: 20px; bottom: 20px;
    width: var(--ok-sidebar-width);
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 20px;
    display: flex; flex-direction: column; align-items: center;
    padding: 22px 0;
    z-index: 1040;
    box-shadow: 0 10px 30px var(--ok-shadow-sidebar);
    backdrop-filter: blur(20px);
    transition: all 0.3s ease;
  }

  .ok-brand-emblem {
    width: 48px; height: 48px; border-radius: 14px;
    background: linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 28px;
    box-shadow: 0 8px 20px rgba(124, 58, 237, 0.4);
    text-decoration: none;
  }

  .ok-rail-nav {
    flex: 1;
    display: flex; flex-direction: column; align-items: center;
    gap: 14px; width: 100%;
    overflow-y: auto; overflow-x: hidden; scrollbar-width: thin;
  }
  .ok-rail-nav::-webkit-scrollbar { width: 3px; }
  .ok-rail-nav::-webkit-scrollbar-thumb { background: var(--ok-border-subtle); border-radius: 5px; }

  .ok-rail-link {
    width: 46px; height: 46px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-muted); text-decoration: none;
    transition: all 0.2s ease; background: transparent;
    position: relative;
  }
  .ok-rail-link:hover {
    color: var(--ok-purple-vibrant);
    background-color: var(--ok-purple-soft);
    transform: translateY(-2px);
  }
  .ok-rail-link.active {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    color: #ffffff;
    box-shadow: 0 8px 20px rgba(139, 92, 246, 0.5);
  }
  .ok-rail-link svg { width: 20px; height: 20px; }

  .admin-rail-count {
    position: absolute; top: 2px; right: 1px;
    min-width: 18px; height: 18px; padding: 0 4px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 999px;
    background: #ef4444; color: #fff;
    border: 2px solid var(--ok-bg-surface);
    font-size: 9px; font-weight: 800;
  }

  .ok-rail-footer {
    display: flex; flex-direction: column; align-items: center;
    gap: 10px; width: 100%;
  }

  /* =========================================================================
     VIEWPORT SHELL — CENTRALIZADO
     ========================================================================= */
  .ok-viewport-shell {
    margin-left: calc(var(--ok-sidebar-width) + 20px);
    padding: 20px 20px 48px 0;
    position: relative; z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ok-viewport-shell > * {
    width: 100%;
    max-width: var(--ok-content-max);
    margin-inline: auto;
  }

  .ok-top-nav {
    height: var(--ok-navbar-height);
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 20px;
    gap: 14px;
    flex-wrap: wrap;
    max-width: var(--ok-content-max);
    margin-inline: auto;
    width: 100%;
  }

  .ok-search-capsule {
    position: relative;
    width: 420px; max-width: 100%;
    flex-shrink: 0;
  }
  .ok-search-capsule input {
    width: 100%; height: 46px;
    border-radius: var(--ok-radius-pill);
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    padding: 0 75px 0 46px;
    font-size: 0.88rem;
    color: var(--ok-text-primary);
    outline: none;
    transition: all 0.25s ease;
  }
  .ok-search-capsule input::placeholder { color: var(--ok-text-muted); }
  .ok-search-capsule input:focus {
    border-color: var(--ok-purple-vibrant);
    box-shadow: 0 0 0 4px var(--ok-purple-soft);
  }
  .ok-search-capsule .search-icon {
    position: absolute; left: 16px; top: 50%;
    transform: translateY(-50%);
    color: var(--ok-text-muted);
    display: flex; align-items: center;
  }
  .ok-search-capsule .shortcut-hint {
    position: absolute; right: 12px; top: 50%;
    transform: translateY(-50%);
    background: var(--ok-pill-bg);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 6px;
    padding: 2px 7px;
    font-size: 0.7rem;
    color: var(--ok-text-muted);
    font-weight: 600;
  }

  .ok-nav-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

  .ok-action-circle {
    width: 44px; height: 44px; border-radius: 14px;
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-primary);
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
    cursor: pointer;
  }
  .ok-action-circle:hover {
    border-color: var(--ok-purple-border);
    color: var(--ok-purple-vibrant);
    transform: translateY(-2px);
  }

  .ok-profile-pill {
    display: flex; align-items: center; gap: 10px;
    padding: 5px 16px 5px 5px;
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    border-radius: var(--ok-radius-pill);
    text-decoration: none; cursor: pointer;
    color: inherit;
  }
  .ok-profile-avatar-nav {
    width: 36px; height: 36px;
    border-radius: 50%; object-fit: cover;
    background: var(--ok-purple-soft);
    border: 2px solid var(--ok-purple-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-primary); font-weight: 800; font-size: 0.9rem;
  }

  .ok-theme-toggle {
    width: 44px; height: 44px; border-radius: 14px;
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-primary); cursor: pointer;
    transition: all 0.2s ease;
  }
  .ok-theme-toggle:hover {
    border-color: var(--ok-purple-border);
    color: var(--ok-purple-vibrant);
    transform: translateY(-2px);
  }

  /* =========================================================================
     HERO
     ========================================================================= */
  .ok-canvas-hero-title {
    max-width: var(--ok-content-max);
    margin: 0 auto 22px auto;
    display: flex; justify-content: space-between; align-items: flex-end;
    flex-wrap: wrap; gap: 16px;
    width: 100%;
  }

  .ok-page-title-main {
    font-size: 1.85rem; font-weight: 800;
    letter-spacing: -0.03em; line-height: 1.15;
    color: var(--ok-text-primary);
    margin: 0;
    display: flex; align-items: center; gap: 12px;
    flex-wrap: wrap;
    font-family: 'Space Grotesk', sans-serif;
  }
  .ok-page-title-main .user-highlight {
    background: linear-gradient(135deg, var(--ok-purple-vibrant) 0%, #c084fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .ok-live-beacon {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.7rem; font-weight: 800;
    padding: 4px 11px;
    border-radius: var(--ok-radius-pill);
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #10b981;
    letter-spacing: 0.04em; text-transform: uppercase;
  }
  .ok-pulse-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .ok-canvas-sub {
    color: var(--ok-text-muted);
    font-size: 0.88rem; margin-top: 5px; line-height: 1.45;
    display: flex; align-items: center; gap: 8px;
    max-width: 820px;
  }

  .admin-hero-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

  .ok-btn-pill-soft {
    background: var(--ok-purple-soft);
    color: var(--ok-purple-vibrant);
    font-weight: 700;
    border-radius: var(--ok-radius-pill);
    padding: 8px 16px;
    font-size: 0.82rem;
    border: 1px solid transparent;
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-flex; align-items: center; gap: 6px;
    cursor: pointer;
    font-family: inherit;
  }
  .ok-btn-pill-soft:hover {
    background: var(--ok-purple-vibrant);
    color: #ffffff;
  }
  .ok-btn-pill-soft[disabled] { opacity: 0.65; cursor: wait; }

  .ok-btn-pill-primary {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    color: #ffffff;
    font-weight: 700;
    border-radius: var(--ok-radius-pill);
    padding: 8px 18px;
    font-size: 0.82rem;
    border: 1px solid transparent;
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-flex; align-items: center; gap: 6px;
    cursor: pointer;
    font-family: inherit;
    box-shadow: 0 8px 20px rgba(139, 92, 246, 0.35);
  }
  .ok-btn-pill-primary:hover { transform: translateY(-1px); color: #ffffff; }
  .ok-btn-pill-primary[disabled] { opacity: 0.65; cursor: wait; }

  .admin-currency-badge {
    display: inline-flex; align-items: center;
    padding: 5px 12px;
    border-radius: var(--ok-radius-pill);
    background: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    color: var(--ok-text-muted);
    font-size: 0.72rem; font-weight: 800;
    letter-spacing: 0.06em; text-transform: uppercase;
  }

  /* =========================================================================
     CARDS BASE
     ========================================================================= */
  .admin-card {
    background: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    border-radius: var(--ok-radius-card);
    box-shadow: 0 8px 32px var(--ok-shadow-card);
    max-width: var(--ok-content-max);
    margin: 0 auto 20px auto;
    overflow: hidden;
    width: 100%;
  }

  .admin-note {
    background: var(--ok-purple-soft);
    border: 1px solid var(--ok-purple-border);
    border-radius: var(--ok-radius-md);
    color: var(--ok-text-secondary);
    font-size: 0.82rem;
    line-height: 1.55;
    padding: 0.85rem 1rem;
    display: flex; align-items: flex-start; gap: 8px;
    max-width: var(--ok-content-max);
    margin-inline: auto;
  }
  .admin-note i { color: var(--ok-purple-vibrant); flex-shrink: 0; }
  .admin-note.warning {
    background: rgba(6, 182, 212, 0.08);
    border-color: rgba(6, 182, 212, 0.22);
    color: #b6e7ee;
  }
  .admin-note.warning i { color: #67e8f9; }

  .rep-panel-head {
    align-items: center;
    border-bottom: 1px solid var(--ok-border-subtle);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    padding: 1.1rem 1.25rem;
  }
  .rep-panel-title {
    color: var(--ok-text-primary);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    font-weight: 800;
    margin: 0;
    display: flex; align-items: center; gap: 8px;
  }
  .rep-panel-title i { color: var(--ok-purple-vibrant); }
  .rep-panel-description {
    color: var(--ok-text-muted);
    font-size: 0.76rem;
    margin: 0.28rem 0 0;
  }
  .rep-panel-body { padding: 1.15rem 1.25rem; }

  .rep-filter {
    align-items: end;
    background: var(--ok-bg-elevated);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    padding: 0.85rem;
  }
  .rep-filter .form-label {
    font-size: 0.72rem;
    color: var(--ok-text-muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.2rem;
  }
  .rep-filter .form-control {
    background: var(--ok-bg-surface) !important;
    border: 1px solid var(--ok-border-strong) !important;
    color: var(--ok-text-primary) !important;
    min-height: 40px;
    border-radius: var(--ok-radius-md);
  }
  .rep-filter .form-control:focus {
    border-color: var(--ok-purple-vibrant) !important;
    box-shadow: 0 0 0 3px var(--ok-purple-soft) !important;
  }

  /* =========================================================================
     KPI CARDS INTERNOS
     ========================================================================= */
  .rep-kpi {
    height: 100%;
    padding: 1rem 1.1rem;
    background: var(--ok-bg-elevated);
    border: 1px solid var(--ok-border-subtle);
    border-radius: var(--ok-radius-md);
    transition: all 0.2s ease;
  }
  .rep-kpi:hover { border-color: var(--ok-border-strong); transform: translateY(-1px); }
  .rep-kpi-label {
    color: var(--ok-text-muted);
    font-size: 0.69rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .rep-kpi-value {
    color: var(--ok-text-primary);
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.12rem, 1.7vw, 1.45rem);
    font-weight: 800;
    margin: 0.35rem 0 0;
    overflow-wrap: anywhere;
  }
  .rep-kpi-meta { color: var(--ok-text-muted); font-size: 0.72rem; margin-top: 0.25rem; }
  .rep-kpi-icon {
    align-items: center;
    background: var(--ok-purple-soft);
    border: 1px solid var(--ok-purple-border);
    border-radius: 11px;
    color: var(--ok-purple-vibrant);
    display: flex;
    height: 34px;
    justify-content: center;
    width: 34px;
    flex-shrink: 0;
  }

  /* =========================================================================
     GRÁFICO DE BARRAS
     ========================================================================= */
  .rep-chart-scroll { overflow-x: auto; padding-bottom: 0.4rem; }
  .rep-chart {
    align-items: flex-end;
    display: flex;
    gap: 0.55rem;
    min-height: 230px;
    min-width: max-content;
    padding: 0.4rem 0.25rem 0;
  }
  .rep-chart-col {
    align-items: center;
    display: flex;
    flex: 0 0 28px;
    flex-direction: column;
    gap: 0.4rem;
    height: 215px;
    justify-content: flex-end;
  }
  .rep-chart-bars {
    align-items: flex-end;
    display: flex;
    gap: 3px;
    height: 180px;
    justify-content: center;
    width: 100%;
  }
  .rep-bar {
    border-radius: 5px 5px 2px 2px;
    min-height: 2px;
    min-width: 9px;
    transition: height 0.25s ease;
  }
  .rep-bar-deposit { background: linear-gradient(180deg, #a78bfa, #7c3aed); }
  .rep-bar-payout { background: linear-gradient(180deg, #67e8f9, #0891b2); }
  .rep-chart-date {
    color: var(--ok-text-muted);
    font-size: 0.61rem;
    white-space: nowrap;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
  .rep-legend {
    color: var(--ok-text-secondary);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.72rem;
    gap: 1rem;
    margin-bottom: 0.65rem;
  }
  .rep-legend i {
    border-radius: 3px;
    display: inline-block;
    height: 9px;
    margin-right: 0.35rem;
    width: 9px;
  }
  .rep-legend .rep-bar-deposit { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
  .rep-legend .rep-bar-payout { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }

  /* =========================================================================
     PROGRESS BARS
     ========================================================================= */
  .rep-progress-row { margin-bottom: 1rem; }
  .rep-progress-row:last-child { margin-bottom: 0; }
  .rep-progress-top {
    align-items: center;
    display: flex;
    gap: 0.75rem;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }
  .rep-progress-label { color: var(--ok-text-secondary); font-size: 0.78rem; }
  .rep-progress-value { color: var(--ok-text-primary); font-size: 0.78rem; font-weight: 800; }
  .rep-track {
    background: var(--ok-meter-bg);
    border-radius: 999px;
    height: 8px;
    overflow: hidden;
  }
  .rep-track-fill {
    background: linear-gradient(90deg, #7c3aed, #22d3ee);
    border-radius: 999px;
    height: 100%;
    min-width: 0;
    transition: width 0.3s ease;
  }
  .rep-track-fill.good { background: linear-gradient(90deg, #059669, #34d399); }
  .rep-track-fill.warn { background: linear-gradient(90deg, #d97706, #fbbf24); }
  .rep-track-fill.bad  { background: linear-gradient(90deg, #e11d48, #fb7185); }

  /* =========================================================================
     PROVIDERS
     ========================================================================= */
  .rep-provider {
    background: var(--ok-bg-elevated);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 14px;
    height: 100%;
    padding: 1rem;
    transition: all 0.2s ease;
  }
  .rep-provider:hover { border-color: var(--ok-border-strong); }
  .rep-provider-name {
    color: var(--ok-text-primary);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.92rem;
    font-weight: 800;
  }
  .rep-provider-rate {
    color: var(--ok-purple-vibrant);
    font-size: 1.5rem;
    font-weight: 800;
    font-family: 'Space Grotesk', sans-serif;
  }

  /* =========================================================================
     TABELA
     ========================================================================= */
  .rep-table {
    color: var(--ok-text-secondary);
    font-size: 0.75rem;
    --bs-table-bg: transparent;
    --bs-table-color: var(--ok-text-secondary);
  }
  .rep-table th {
    border-color: var(--ok-border-subtle);
    color: var(--ok-text-muted);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 800;
    background: rgba(255, 255, 255, 0.02);
    padding: 0.7rem 0.6rem;
  }
  .rep-table td {
    border-color: var(--ok-border-subtle);
    padding: 0.6rem;
    vertical-align: middle;
  }
  .rep-table tbody tr:hover { background: var(--ok-stream-hover); }

  /* =========================================================================
     ESTADOS
     ========================================================================= */
  .rep-state {
    border: 1px dashed var(--ok-border-strong);
    border-radius: var(--ok-radius-md);
    color: var(--ok-text-muted);
    padding: 1.5rem;
    text-align: center;
  }
  .rep-state i {
    color: var(--ok-purple-vibrant);
    font-size: 1.35rem;
    margin-bottom: 0.4rem;
    display: block;
  }
  .rep-state-error {
    border-color: rgba(244, 63, 94, 0.35);
    color: #fecdd3;
    background: rgba(244, 63, 94, 0.06);
  }

  .rep-updated { color: var(--ok-text-muted); font-size: 0.7rem; }

  /* Botão primário genérico */
  .btn-primary-ok {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    border: none;
    color: #ffffff;
    border-radius: var(--ok-radius-md);
    min-height: 40px;
    font-weight: 700;
    padding: 0 1rem;
    box-shadow: 0 6px 18px rgba(139, 92, 246, 0.35);
    transition: all 0.2s ease;
    display: inline-flex; align-items: center; gap: 4px;
  }
  .btn-primary-ok:hover { transform: translateY(-1px); color: #fff; }
  .btn-primary-ok[disabled] { opacity: 0.65; cursor: wait; }

  /* =========================================================================
     RESPONSIVIDADE
     ========================================================================= */
  @media (max-width: 1200px) {
    .ok-flat-quad-strip { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 991px) {
    .ok-rail-sidebar { transform: translateX(-120%); }
    body.mobile-nav-active .ok-rail-sidebar { transform: translateX(0); }
    .ok-viewport-shell { margin-left: 0; padding: 16px; }
    .ok-page-title-main { font-size: 1.55rem; }
    .admin-hero-actions { width: 100%; justify-content: space-between; }
    .admin-hero-actions .ok-btn-pill-soft,
    .admin-hero-actions .ok-btn-pill-primary { flex: 1; justify-content: center; }
  }
  @media (max-width: 767px) {
    .rep-panel-head, .rep-panel-body { padding: 1rem; }
    .rep-filter > * { flex: 1 1 42%; }
  }
  @media (max-width: 600px) {
    .ok-flat-quad-strip { grid-template-columns: 1fr; }
    .ok-profile-pill .admin-profile-text { display: none !important; }
    .ok-search-capsule { width: min(100%, 500px); }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

