      <div class="rep-panel-body">
        <div id="kyc-error" class="rep-state rep-state-error d-none" role="alert"></div>
        <div id="kyc-loading" class="rep-state" role="status">
          <span class="spinner-border spinner-border-sm me-2" style="color:var(--ok-purple-vibrant);" aria-hidden="true"></span>
          A carregar KYC…
        </div>
        <div id="kyc-content" class="d-none"></div>
      </div>
    </section>

    <!-- ====================================================================
         PAINEL PRESTADORES
         ==================================================================== -->
    <section class="admin-card" id="panel-providers">
      <div class="rep-panel-head">
        <div>
          <h2 class="rep-panel-title"><i class="bi bi-diagram-3" aria-hidden="true"></i> Desempenho dos prestadores</h2>
          <p class="rep-panel-description">Pedidos totais, taxa de sucesso, falhas e volume concluído por gateway.</p>
        </div>
        <span class="rep-updated" id="providers-updated"></span>
      </div>
      <div class="rep-panel-body">
        <div id="providers-error" class="rep-state rep-state-error d-none" role="alert"></div>
        <div id="providers-loading" class="rep-state" role="status">
          <span class="spinner-border spinner-border-sm me-2" style="color:var(--ok-purple-vibrant);" aria-hidden="true"></span>
          A carregar prestadores…
        </div>
        <div id="providers-content" class="row g-3 d-none"></div>
      </div>
    </section>

    <!-- ====================================================================
         PAINEL RISCO
         ==================================================================== -->
    <section class="admin-card d-none" id="panel-risk">
      <div class="rep-panel-head">
        <div>
          <h2 class="rep-panel-title"><i class="bi bi-shield-exclamation" aria-hidden="true"></i> Disputas e eventos de risco</h2>
          <p class="rep-panel-description">Distribuição agregada de decisões sobre disputas e níveis de risco.</p>
        </div>
        <span class="rep-updated" id="risk-updated"></span>
      </div>
      <div class="rep-panel-body">
        <div id="risk-error" class="rep-state rep-state-error d-none" role="alert"></div>
        <div id="risk-loading" class="rep-state" role="status">
          <span class="spinner-border spinner-border-sm me-2" style="color:var(--ok-purple-vibrant);" aria-hidden="true"></span>
          A carregar indicadores de risco…
        </div>
        <div id="risk-content" class="d-none"></div>
      </div>
    </section>

    <footer class="admin-footer" style="border-top:1px solid var(--ok-border-subtle);background:transparent;padding:1rem 1.25rem;text-align:center;color:var(--ok-text-muted);font-size:0.78rem;max-width:var(--ok-content-max);margin:2rem auto 0;width:100%;">
      <span>&copy; <%= (typeof currentYear !== 'undefined' ? currentYear : new Date().getFullYear()) %> OneKixikila Admin Engine. Relatórios agregados para supervisão e decisão informada.</span>
    </footer>

  </div>

  <%- include('../partials/sweet-alert') %>
  <script src="/js/api-client.js"></script>
  <script>
    (function () {
      'use strict';

      /* ====================================================================
         TEMA CLARO/ESCURO
         ==================================================================== */
      const THEME_KEY = 'ok-theme';
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-btn');
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        if (!btn) return;
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      /* ====================================================================
         AÇÕES GLOBAIS
         ==================================================================== */
      function setupGlobalActions() {
        const sidebarToggle = document.getElementById('sidebar-toggle-btn');
        sidebarToggle?.addEventListener('click', () => {
          const active = document.body.classList.toggle('mobile-nav-active');
          sidebarToggle.setAttribute('aria-expanded', String(active));
        });
        document.querySelectorAll('.ok-rail-link[href]').forEach((link) => {
          link.addEventListener('click', () => {
            if (window.matchMedia('(max-width: 991px)').matches) {
              document.body.classList.remove('mobile-nav-active');
            }
          });
        });
        const search = document.getElementById('global-dashboard-search');
        document.addEventListener('keydown', (event) => {
          if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
            if (search) { event.preventDefault(); search.focus(); }
          }
        });
        document.querySelectorAll('[data-action="logout"]').forEach((button) => {
          button.addEventListener('click', async (event) => {
            event.preventDefault();
            button.disabled = true;
            try {
              if (window.apiClient && typeof window.apiClient.post === 'function') await window.apiClient.post('/auth/logout', {});
              if (window.apiClient && typeof window.apiClient.clearSession === 'function') window.apiClient.clearSession();
            } catch (_) {}
            window.location.href = '/login';
          });
        });
      }

      /* ====================================================================
         ESTADO E HELPERS
         ==================================================================== */
      const role = String(document.body.dataset.adminRole || '').toUpperCase();
      const canFinancial = ['ADMIN', 'AUDITOR', 'FINANCIAL_OPERATOR'].includes(role);
      const canAdmin = ['ADMIN', 'AUDITOR'].includes(role);
      const loaded = {};
      const apiReady = () => window.apiClient && typeof window.apiClient.get === 'function';

      const fmtMoney = n => {
        const v = Number(n);
        if (!Number.isFinite(v)) return '—';
        try { return new Intl.NumberFormat('pt-AO', { style: 'currency', currency: 'AOA', maximumFractionDigits: 2 }).format(v); }
        catch (_) { return new Intl.NumberFormat('pt-PT', { maximumFractionDigits: 2 }).format(v) + ' AOA'; }
      };
      const fmtInt = n => {
        const v = Number(n);
        return Number.isFinite(v) ? new Intl.NumberFormat('pt-PT', { maximumFractionDigits: 0 }).format(v) : '—';
      };
      const esc = v => String(v == null ? '' : v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      function nval(v) { const n = Number(v); return Number.isFinite(n) ? n : 0; }
      function pct(v) { return Math.max(0, Math.min(100, nval(v))); }

      function showError(id, error) {
        const x = document.getElementById(id);
        x.textContent = error && error.message ? error.message : 'Não foi possível carregar este relatório.';
        x.classList.remove('d-none');
      }
      function setLoading(prefix, on) {
        const l = document.getElementById(prefix + '-loading');
        const c = document.getElementById(prefix + '-content');
        if (l) l.classList.toggle('d-none', !on);
        if (c && on) c.classList.add('d-none');
      }
      function stamp(id) {
        const x = document.getElementById(id);
        if (x) x.textContent = 'Atualizado ' + new Intl.DateTimeFormat('pt-PT', { dateStyle: 'short', timeStyle: 'short' }).format(new Date());
      }

      function kpi(label, value, meta, icon) {
        return '<div class="col-12 col-sm-6 col-xl-4"><div class="rep-kpi"><div class="d-flex justify-content-between align-items-start"><div><div class="rep-kpi-label">' + esc(label) + '</div><div class="rep-kpi-value">' + esc(value) + '</div><div class="rep-kpi-meta">' + esc(meta || '') + '</div></div><span class="rep-kpi-icon"><i class="bi ' + esc(icon || 'bi-graph-up') + '" aria-hidden="true"></i></span></div></div></div>';
      }
      function progress(label, value, max, color) {
        const val = nval(value);
        const width = max > 0 ? pct(val / max * 100) : 0;
        return '<div class="rep-progress-row"><div class="rep-progress-top"><span class="rep-progress-label">' + esc(label) + '</span><span class="rep-progress-value">' + fmtInt(val) + '</span></div><div class="rep-track"><div class="rep-track-fill ' + (color || '') + '" style="width:' + width + '%"></div></div></div>';
      }
      function checkResponse(r, key) {
        if (!r || r.success === false || !r.data) throw new Error(r && r.message || 'O backend devolveu uma resposta inválida.');
        return key ? r.data[key] : r.data;
      }
      function localDate(d) { const x = new Date(d.getTime() - d.getTimezoneOffset() * 60000); return x.toISOString().slice(0, 10); }
      function buildPeriod() {
        const start = document.getElementById('rep-start').value;
        const end = document.getElementById('rep-end').value;
        if (!start || !end || start > end) throw new Error('Selecione um intervalo válido: a data inicial deve ser anterior ou igual à final.');
        return new URLSearchParams({ startDate: start, endDate: end }).toString();
      }

      /* ====================================================================
         FINANCEIRO + TIMELINE
         ==================================================================== */
      async function loadFinancial() {
        if (!canFinancial) return;
        delete loaded.financial;
        delete loaded.timeline;
        updateExport();
        if (!apiReady()) {
          showError('financial-error', new Error('Cliente da API indisponível. Não serão apresentados valores presumidos.'));
          document.getElementById('financial-loading').classList.add('d-none');
          showError('timeline-error', new Error('Cliente da API indisponível.'));
          document.getElementById('timeline-loading').classList.add('d-none');
          return;
        }
        let query;
        try { query = buildPeriod(); }
        catch (e) {
          return window.Alerts && window.Alerts.error ? window.Alerts.error(e.message) : alert(e.message);
        }
        document.getElementById('financial-error').classList.add('d-none');
        document.getElementById('timeline-error').classList.add('d-none');
        setLoading('financial', true);
        setLoading('timeline', true);
        try {
          const response = await window.apiClient.get('/reports/financial?' + query);
          const report = checkResponse(response);
          if (!report.metrics) throw new Error('O relatório financeiro não contém métricas.');
          loaded.financial = report;
          const m = report.metrics;
          document.getElementById('financial-content').innerHTML =
            kpi('Depósitos confirmados', fmtMoney(m.deposits && m.deposits.volume), fmtInt(m.deposits && m.deposits.count) + ' operação(ões)', 'bi-box-arrow-in-down') +
            kpi('Levantamentos liquidados', fmtMoney(m.withdrawals && m.withdrawals.volume), fmtInt(m.withdrawals && m.withdrawals.count) + ' operação(ões)', 'bi-box-arrow-up-right') +
            kpi('Transferências concluídas', fmtMoney(m.transfers && m.transfers.volume), fmtInt(m.transfers && m.transfers.count) + ' operação(ões)', 'bi-arrow-left-right') +
            kpi('Contribuições confirmadas', fmtMoney(m.contributions && m.contributions.volume), fmtInt(m.contributions && m.contributions.count) + ' quota(s)', 'bi-people') +
            kpi('Desembolsos pagos', fmtMoney(m.payouts && m.payouts.volume), fmtInt(m.payouts && m.payouts.count) + ' pagamento(s)', 'bi-send-check') +
            kpi('Taxas cobradas', fmtMoney(m.feesCollected && m.feesCollected.volume), 'Conforme agregação financeira do backend', 'bi-receipt');
          setLoading('financial', false);
          document.getElementById('financial-content').classList.remove('d-none');
          stamp('financial-updated');

          try {
            const tResponse = await window.apiClient.get('/reports/financial/timeline?' + query);
            const entries = checkResponse(tResponse, 'timeline');
            if (!Array.isArray(entries)) throw new Error('A API não devolveu uma série temporal válida.');
            loaded.timeline = entries;
            renderTimeline(entries);
            setLoading('timeline', false);
            document.getElementById('timeline-content').classList.remove('d-none');
            document.getElementById('timeline-period').textContent = document.getElementById('rep-start').value + ' — ' + document.getElementById('rep-end').value;
            stamp('financial-updated');
          } catch (e) {
            document.getElementById('timeline-loading').classList.add('d-none');
            showError('timeline-error', e);
          }
        } catch (e) {
          document.getElementById('financial-loading').classList.add('d-none');
          showError('financial-error', e);
        }
        updateExport();
      }

      function renderTimeline(entries) {
        const max = Math.max(0, ...entries.flatMap(x => [nval(x.deposits), nval(x.payouts)]));
        const chart = document.getElementById('timeline-chart');
        const table = document.getElementById('timeline-table');
        chart.innerHTML = entries.map(x => {
          const d = nval(x.deposits), p = nval(x.payouts);
          const dh = max ? Math.max(d ? 3 : 0, d / max * 100) : 0;
          const ph = max ? Math.max(p ? 3 : 0, p / max * 100) : 0;
          const date = String(x.date || '');
          return '<div class="rep-chart-col" title="' + esc(date) + ' · Depósitos: ' + esc(fmtMoney(d)) + ' · Desembolsos: ' + esc(fmtMoney(p)) + '"><div class="rep-chart-bars"><span class="rep-bar rep-bar-deposit" style="height:' + dh + '%" aria-hidden="true"></span><span class="rep-bar rep-bar-payout" style="height:' + ph + '%" aria-hidden="true"></span></div><span class="rep-chart-date">' + esc(date.slice(5)) + '</span></div>';
        }).join('');
        table.innerHTML = entries.map(x => '<tr><td>' + esc(x.date || '—') + '</td><td class="text-end">' + esc(fmtMoney(x.deposits)) + '</td><td class="text-end">' + esc(fmtMoney(x.payouts)) + '</td></tr>').join('');
      }

      /* ====================================================================
         RELATÓRIOS ADMIN
         ==================================================================== */
      async function loadAdminReports() {
        if (!canAdmin) return;
        ['compliance', 'kyc', 'risk'].forEach(p => {
          delete loaded[p];
          document.getElementById(p + '-content').classList.add('d-none');
          document.getElementById(p + '-error').classList.add('d-none');
          document.getElementById(p + '-loading').classList.remove('d-none');
        });
        updateExport();
        const jobs = [
          ['compliance', '/reports/compliance/groups', 'compliance', renderCompliance, 'compliance-updated'],
          ['kyc', '/reports/compliance/kyc', 'kyc', renderKyc, 'kyc-updated'],
          ['risk', '/reports/disputes-risk', null, renderRisk, 'risk-updated']
        ];
        await Promise.all(jobs.map(async ([prefix, path, key, render, stampId]) => {
          if (!apiReady()) {
            document.getElementById(prefix + '-loading').classList.add('d-none');
            showError(prefix + '-error', new Error('Cliente da API indisponível.'));
            return;
          }
          try {
            const r = await window.apiClient.get(path);
            const data = checkResponse(r, key);
            loaded[prefix] = data;
            render(data);
            setLoading(prefix, false);
            document.getElementById(prefix + '-content').classList.remove('d-none');
            stamp(stampId);
          } catch (e) {
            document.getElementById(prefix + '-loading').classList.add('d-none');
            showError(prefix + '-error', e);
          }
        }));
        updateExport();
      }

      function renderCompliance(data) {
        const c = data && data.compliance;
        if (!c) throw new Error('Dados de adimplência incompletos.');
        const total = nval(c.totalObligations);
        const rate = pct(c.onTimeRatePercentage);
        document.getElementById('compliance-content').innerHTML =
          '<div class="row g-3 mb-4">' +
            kpi('Obrigações totais', fmtInt(total), 'Total global reportado', 'bi-list-check') +
            kpi('Pagas dentro do prazo', fmtInt(c.paidOnTime), rate.toFixed(2) + '% de pontualidade', 'bi-check-circle') +
            kpi('Pagas em atraso', fmtInt(c.paidLate), 'Liquidadas após a data-limite', 'bi-clock-history') +
            kpi('Em atraso atualmente', fmtInt(c.currentlyLate), 'Obrigações pendentes fora do prazo', 'bi-hourglass-split') +
            kpi('Em incumprimento', fmtInt(c.defaulted), 'Obrigações classificadas como incumpridas', 'bi-exclamation-triangle') +
          '</div>' +
          '<div class="rep-progress-row"><div class="rep-progress-top"><span class="rep-progress-label">Taxa de pagamento pontual</span><span class="rep-progress-value">' + rate.toFixed(2) + '%</span></div><div class="rep-track" style="height:12px"><div class="rep-track-fill good" style="height:12px;width:' + rate + '%"></div></div></div>';
      }

      function renderKyc(data) {
        const t = (data && data.tierDistribution) || {};
        const arr = [
          ['Não verificado · nível 1', t.tier1Unverified],
          ['Verificado · nível 2', t.tier2Verified],
          ['Verificação reforçada · nível 3', t.tier3Enhanced]
        ];
        const max = Math.max(1, ...arr.map(x => nval(x[1])));
        document.getElementById('kyc-content').innerHTML =
          '<div class="row g-3">' +
            '<div class="col-12 col-xl-7"><div class="row g-3">' +
              kpi('Submissões totais', fmtInt(data.totalSubmissions), 'Processos na esteira KYC', 'bi-person-vcard') +
              kpi('Aprovadas', fmtInt(data.approvedCount), 'Estado APPROVED', 'bi-patch-check') +
              kpi('Rejeitadas', fmtInt(data.rejectedCount), 'Estado REJECTED', 'bi-x-circle') +
              kpi('Em revisão', fmtInt(data.underReviewCount), 'Estado UNDER_REVIEW', 'bi-hourglass') +
              kpi('Requerem revisão', fmtInt(data.needsReviewCount), 'Estado NEEDS_REVIEW', 'bi-clipboard2-pulse') +
            '</div></div>' +
            '<div class="col-12 col-xl-5"><div class="rep-kpi h-100"><div class="rep-kpi-label mb-3">Distribuição de níveis</div>' +
              arr.map(x => progress(x[0], x[1], max, '')).join('') +
            '</div></div>' +
          '</div>';
      }

      function providerLabel(p) {
        return ({ MULTICAIXA_EXPRESS: 'Multicaixa Express', UNITEL_MONEY: 'Unitel Money', E_KWANZA: 'e-Kwanza' })[String(p || '').toUpperCase()] || String(p || 'Prestador');
      }
      function renderProviders(arr) {
        if (!Array.isArray(arr)) throw new Error('A API não devolveu uma lista de prestadores válida.');
        if (!arr.length) {
          document.getElementById('providers-content').innerHTML = '<div class="col-12"><div class="rep-state">Não há pedidos de pagamento agregados para apresentar.</div></div>';
          return;
        }
        document.getElementById('providers-content').innerHTML = arr.map(x => {
          const rate = pct(x.successRatePercentage);
          const total = nval(x.totalRequests);
          const failed = nval(x.failedCount);
          const success = nval(x.succeededCount);
          return '<div class="col-12 col-lg-6"><article class="rep-provider">' +
            '<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">' +
              '<div><div style="color:var(--ok-purple-vibrant);font-size:0.68rem;font-weight:800;letter-spacing:0.15em;text-transform:uppercase;">Gateway integrado</div><h3 class="rep-provider-name mt-1 mb-0">' + esc(providerLabel(x.provider)) + '</h3></div>' +
              '<div class="text-end"><div class="rep-provider-rate">' + rate.toFixed(2) + '%</div><div class="rep-kpi-meta">taxa de sucesso</div></div>' +
            '</div>' +
            '<div class="rep-progress-row"><div class="rep-progress-top"><span class="rep-progress-label">Conversão de pedidos</span><span class="rep-progress-value">' + rate.toFixed(2) + '%</span></div><div class="rep-track"><div class="rep-track-fill ' + (rate >= 90 ? 'good' : rate >= 70 ? 'warn' : 'bad') + '" style="width:' + rate + '%"></div></div></div>' +
            '<div class="row g-2 mt-3">' +
              '<div class="col-4"><div class="rep-kpi-label">Pedidos</div><div class="fw-bold" style="color:var(--ok-text-primary);">' + fmtInt(total) + '</div></div>' +
              '<div class="col-4"><div class="rep-kpi-label">Sucesso</div><div class="fw-bold text-success">' + fmtInt(success) + '</div></div>' +
              '<div class="col-4"><div class="rep-kpi-label">Falhados</div><div class="fw-bold text-warning">' + fmtInt(failed) + '</div></div>' +
              '<div class="col-12 mt-3"><div class="rep-kpi-label">Volume de pagamentos concluídos</div><div class="fw-bold mt-1" style="color:var(--ok-text-primary);">' + esc(fmtMoney(x.totalVolume)) + '</div></div>' +
            '</div>' +
          '</article></div>';
        }).join('');
      }

      function renderRisk(data) {
        const dist = (data && data.riskEventsDistribution) || {};
        const risks = [
          ['Baixo', dist.low, 'good'],
          ['Médio', dist.medium, 'warn'],
          ['Alto', dist.high, 'bad'],
          ['Crítico', dist.critical, 'bad']
        ];
        const maxRisk = Math.max(1, ...risks.map(x => nval(x[1])));
        const disputes = [
          ['Abertas', data.openDisputes, 'warn'],
          ['A favor do requerente', data.resolvedFavorInitiator, 'good'],
          ['A favor da parte reclamada', data.resolvedFavorRespondent, ''],
          ['Encerradas sem provimento', data.dismissed, '']
        ];
        const maxD = Math.max(1, ...disputes.map(x => nval(x[1])));
        document.getElementById('risk-content').innerHTML =
          '<div class="row g-3 mb-4">' +
            kpi('Disputas totais', fmtInt(data.totalDisputes), 'Volume global de contestações', 'bi-shield-exclamation') +
            kpi('Eventos de risco', fmtInt(risks.reduce((a, x) => a + nval(x[1]), 0)), 'Distribuição por nível de risco', 'bi-exclamation-diamond') +
            kpi('Eventos críticos', fmtInt(dist.critical), 'Nível CRITICAL', 'bi-shield-fill-exclamation') +
          '</div>' +
          '<div class="row g-4">' +
            '<div class="col-12 col-xl-6"><div class="rep-kpi h-100"><div class="rep-kpi-label mb-3">Decisões de contestação</div>' +
              disputes.map(x => progress(x[0], x[1], maxD, x[2])).join('') +
            '</div></div>' +
            '<div class="col-12 col-xl-6"><div class="rep-kpi h-100"><div class="rep-kpi-label mb-3">Eventos por nível de risco</div>' +
              risks.map(x => progress(x[0], x[1], maxRisk, x[2])).join('') +
            '</div></div>' +
          '</div>';
      }

      /* ====================================================================
         CSV
         ==================================================================== */
      function csvCell(v) {
        let s = String(v == null ? '' : v);
        if (/^[=+\-@\t\r]/.test(s)) s = "'" + s;
        return '"' + s.replace(/"/g, '""') + '"';
      }
      function updateExport() {
        const b = document.getElementById('rep-export');
        b.disabled = !Object.keys(loaded).length;
      }
      function exportCsv() {
        const rows = [['Secção', 'Indicador', 'Valor', 'Unidade']];
        const add = (section, label, value, unit = '') => rows.push([section, label, value, unit]);
        if (loaded.financial && loaded.financial.metrics) {
          const m = loaded.financial.metrics;
          add('Financeiro', 'Período inicial', document.getElementById('rep-start').value);
          add('Financeiro', 'Período final', document.getElementById('rep-end').value);
          for (const [key, label] of [['deposits', 'Depósitos'], ['withdrawals', 'Levantamentos'], ['transfers', 'Transferências'], ['contributions', 'Contribuições'], ['payouts', 'Desembolsos']]) {
            const x = m[key] || {};
            add('Financeiro', label + ' volume', x.volume, 'AOA');
            add('Financeiro', label + ' operações', x.count, 'unidades');
          }
          add('Financeiro', 'Taxas cobradas', m.feesCollected && m.feesCollected.volume, 'AOA');
        }
        if (Array.isArray(loaded.timeline)) loaded.timeline.forEach(x => {
          add('Série diária ' + x.date, 'Depósitos', x.deposits, 'AOA');
          add('Série diária ' + x.date, 'Desembolsos', x.payouts, 'AOA');
        });
        if (loaded.compliance && loaded.compliance.compliance) {
          const x = loaded.compliance.compliance;
          for (const k of ['totalObligations', 'paidOnTime', 'paidLate', 'currentlyLate', 'defaulted', 'onTimeRatePercentage']) add('Adimplência', k, x[k], k === 'onTimeRatePercentage' ? '%' : 'unidades');
        }
        if (loaded.kyc) {
          const x = loaded.kyc;
          for (const k of ['totalSubmissions', 'approvedCount', 'rejectedCount', 'underReviewCount', 'needsReviewCount']) add('KYC', k, x[k], 'submissões');
          for (const [k, v] of Object.entries(x.tierDistribution || {})) add('KYC', 'Nível ' + k, v, 'contas');
        }
        if (Array.isArray(loaded.providers)) loaded.providers.forEach(x => {
          add('Prestadores', x.provider + ' pedidos', x.totalRequests, 'unidades');
          add('Prestadores', x.provider + ' taxa de sucesso', x.successRatePercentage, '%');
          add('Prestadores', x.provider + ' volume concluído', x.totalVolume, 'AOA');
        });
        if (loaded.risk) {
          const x = loaded.risk;
          for (const k of ['totalDisputes', 'openDisputes', 'resolvedFavorInitiator', 'resolvedFavorRespondent', 'dismissed']) add('Disputas', k, x[k], 'unidades');
          for (const [k, v] of Object.entries(x.riskEventsDistribution || {})) add('Risco', k, v, 'eventos');
        }
        const csv = '\uFEFF' + rows.map(r => r.map(csvCell).join(';')).join('\r\n');
        const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
        const a = document.createElement('a');
        a.href = url;
        a.download = 'onekixikila-relatorios-' + localDate(new Date()) + '.csv';
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      }

      /* ====================================================================
         PRESTADORES
         ==================================================================== */
      async function loadProviders() {
        if (!canFinancial) return;
        delete loaded.providers;
        updateExport();
        document.getElementById('providers-content').classList.add('d-none');
        document.getElementById('providers-error').classList.add('d-none');
        const load = document.getElementById('providers-loading');
        if (!apiReady()) {
          load.classList.add('d-none');
          showError('providers-error', new Error('Cliente da API indisponível.'));
          return;
        }
        try {
          const r = await window.apiClient.get('/reports/providers');
          const data = checkResponse(r, 'providers');
          loaded.providers = data;
          renderProviders(data);
          setLoading('providers', false);
          document.getElementById('providers-content').classList.remove('d-none');
          stamp('providers-updated');
        } catch (e) {
          load.classList.add('d-none');
          showError('providers-error', e);
        }
        updateExport();
      }

      /* ====================================================================
         PERMISSÕES
         ==================================================================== */
      function setupRole() {
        if (!canAdmin) {
          ['panel-compliance', 'panel-kyc', 'panel-risk'].forEach(id => document.getElementById(id).classList.add('d-none'));
        }
        if (!canFinancial) {
          ['panel-financial', 'panel-providers'].forEach(id => document.getElementById(id).classList.add('d-none'));
        }
        if (!canAdmin && !canFinancial) {
          const warn = document.querySelector('.admin-note.warning');
          if (warn) warn.innerHTML = '<i class="bi bi-shield-lock" aria-hidden="true"></i><span>Acesso restrito: os relatórios exigem ADMIN, AUDITOR ou FINANCIAL_OPERATOR.</span>';
          document.getElementById('rep-refresh').disabled = true;
        }
      }

      /* ====================================================================
         EVENTOS
         ==================================================================== */
      document.getElementById('rep-apply-dates').addEventListener('click', loadFinancial);
      document.getElementById('rep-refresh').addEventListener('click', () => {
        if (canFinancial) { loadFinancial(); loadProviders(); }
        if (canAdmin) loadAdminReports();
      });
      document.getElementById('rep-export').addEventListener('click', exportCsv);

      /* ====================================================================
         DATAS + RELÓGIO
         ==================================================================== */
      const today = localDate(new Date());
      const startDateObj = new Date();
      startDateObj.setDate(startDateObj.getDate() - 29);
      const start = localDate(startDateObj);
      document.getElementById('rep-start').value = start;
      document.getElementById('rep-end').value = today;
      document.getElementById('rep-start').max = today;
      document.getElementById('rep-end').max = today;

      const clock = document.getElementById('admin-utc-clock');
      function updateClock() {
        if (clock) clock.textContent = new Intl.DateTimeFormat('pt-PT', { timeZone: 'UTC', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).format(new Date()) + ' UTC';
      }
      updateClock();
      window.setInterval(updateClock, 1000);

      /* ====================================================================
         INICIALIZAÇÃO
         ==================================================================== */
      document.addEventListener('DOMContentLoaded', () => {
        initThemeToggle();
        setupGlobalActions();
        setupRole();
        if (!apiReady()) {
          ['financial-loading', 'timeline-loading', 'providers-loading', 'compliance-loading', 'kyc-loading', 'risk-loading'].forEach(id => {
            const x = document.getElementById(id);
            if (x) x.classList.add('d-none');
          });
          if (canFinancial) {
            showError('financial-error', new Error('Cliente da API indisponível.'));
            showError('timeline-error', new Error('Cliente da API indisponível.'));
            showError('providers-error', new Error('Cliente da API indisponível.'));
          }
          if (canAdmin) {
            ['compliance', 'kyc', 'risk'].forEach(p => showError(p + '-error', new Error('Cliente da API indisponível.')));
          }
        } else {
          if (canFinancial) { loadFinancial(); loadProviders(); }
          if (canAdmin) loadAdminReports();
        }
      });
    })();
  </script>
</body>
</html>