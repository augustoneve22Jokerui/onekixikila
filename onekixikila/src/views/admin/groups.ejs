        Atualizar lista
      </button>
    </section>

    <!-- Alerta dinâmico -->
    <div id="groups-page-alert" class="alert d-none mb-4" role="alert" aria-live="polite"></div>

    <!-- SESSÃO 1: 4 CARDS KPI -->
    <div class="ok-flat-quad-strip" aria-label="Resumo dos resultados carregados">
      <div class="ok-flat-card-box theme-white">
        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
