              <line x1="8" y1="18" x2="40" y2="18" stroke="currentColor"/>
              <line x1="14" y1="26" x2="34" y2="26" stroke="currentColor"/>
              <line x1="14" y1="32" x2="28" y2="32" stroke="currentColor"/>
            </svg>
          </div>
