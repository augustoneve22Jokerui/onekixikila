          <p class="ok-flat-desc">No diretório, conforme os filtros.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" id="stat-total">—</span>
          <div class="ok-flat-trend info">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            Diretório
          </div>
        </div>
      </div>

      <div class="ok-flat-card-box theme-lime">
        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="18" stroke="currentColor" stroke-linecap="square"/>
              <path d="M16 24L22 30L32 18" stroke="currentColor" stroke-linecap="square"/>
            </svg>
          </div>
          <h5 class="ok-flat-title">Ativos nesta página</h5>
          <p class="ok-flat-desc">Grupos com estado ACTIVE.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" id="stat-active">—</span>
          <div class="ok-flat-trend info">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            Operacionais
          </div>
        </div>
      </div>

      <div class="ok-flat-card-box theme-white-alt">
        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="18" stroke="currentColor" stroke-linecap="square"/>
              <line x1="16" y1="24" x2="20" y2="24" stroke="currentColor"/>
              <line x1="28" y1="24" x2="32" y2="24" stroke="currentColor"/>
            </svg>
          </div>
          <h5 class="ok-flat-title">Pausados nesta página</h5>
          <p class="ok-flat-desc">Grupos temporariamente em pausa.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" id="stat-paused">—</span>
          <div class="ok-flat-trend warning">Atenção</div>
        </div>
      </div>

      <div class="ok-flat-card-box theme-purple">
        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 6L8 14V24C8 34 24 42 24 42C24 42 40 34 40 24V14L24 6Z" stroke="currentColor" stroke-linejoin="round"/>
              <line x1="24" y1="18" x2="24" y2="26" stroke="currentColor"/>
              <circle cx="24" cy="32" r="1.5" fill="currentColor"/>
            </svg>
          </div>
