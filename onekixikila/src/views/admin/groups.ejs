  .groups-modal .btn-close:hover::before { color: var(--ok-text-primary); }
  html[data-theme="light"] .groups-modal .btn-close { filter: none; }
  html[data-theme="light"] .groups-modal .btn-close::before { color: var(--ok-text-muted); }
  html[data-theme="light"] .groups-modal .btn-close:hover::before { color: var(--ok-text-primary); }

  .groups-modal .modal-body {
    padding: 1.15rem 1.2rem;
    background: var(--ok-bg-window);
  }

  /* Timeline multi-etapa */
  .groups-timeline {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.85rem;
    background: var(--ok-bg-window-inner);
    border-bottom: 1px solid var(--ok-divider);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .groups-timeline::-webkit-scrollbar { display: none; }

  .groups-step {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.65rem 0.35rem 0.35rem;
    border-radius: var(--ok-radius-pill);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ok-text-muted);
    white-space: nowrap;
    transition: all 0.25s ease;
    border: 1px solid transparent;
    flex-shrink: 0;
  }
  .groups-step .dot {
    width: 22px; height: 22px;
    border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--ok-pill-bg);
    border: 1px solid var(--ok-border-subtle);
    font-size: 0.62rem;
    font-weight: 800;
    color: var(--ok-text-muted);
    transition: all 0.25s ease;
    flex-shrink: 0;
  }
  .groups-step.active {
    background: var(--ok-purple-soft);
    color: var(--ok-purple-vibrant);
    border-color: var(--ok-purple-border);
  }
  .groups-step.active .dot {
    background: var(--ok-purple-vibrant);
    color: var(--ok-color-token-010);
    border-color: var(--ok-purple-vibrant);
    box-shadow: 0 4px 12px var(--ok-color-token-011);
  }
  .groups-step.done { color: var(--ok-color-token-017); }
  .groups-step.done .dot {
    background: var(--ok-color-token-015);
    border-color: var(--ok-color-token-016);
    color: var(--ok-color-token-017);
  }
  .groups-step.done .dot::before { content: '✓'; }
  .groups-step.done .dot span { display: none; }

  .groups-step-sep {
    width: 14px; height: 1.5px;
    background: var(--ok-border-subtle);
    flex-shrink: 0;
  }
  .groups-step-sep.done { background: var(--ok-color-token-016); }

  /* Painéis de etapa */
  .groups-pane {
    display: none;
    animation: groupsFadeIn 0.3s ease;
  }
  .groups-pane.active { display: block; }
  @keyframes groupsFadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .groups-pane-title {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ok-purple-vibrant);
    margin: 0 0 0.75rem;
  }

  .groups-field-grid {
    display: grid;
    gap: 0.65rem;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
  .group-detail-box {
    background: var(--ok-bg-window-inner);
    border: 1px solid var(--ok-divider);
    border-radius: var(--ok-radius-inner);
    padding: 0.7rem 0.85rem;
    transition: all 0.15s ease;
  }
  .group-detail-box:hover { border-color: var(--ok-border-strong); }
  .group-detail-label {
    color: var(--ok-text-muted);
    display: block;
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .06em;
    margin-bottom: .28rem;
    text-transform: uppercase;
  }
  .group-detail-value {
    color: var(--ok-text-primary);
    font-size: .85rem;
    font-weight: 600;
    overflow-wrap: anywhere;
    line-height: 1.4;
  }
  .group-detail-value.mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.02em;
  }

  /* Header summary do grupo */
  .groups-header-summary {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    margin-bottom: 0.85rem;
    background: var(--ok-bg-window-inner);
    border: 1px solid var(--ok-divider);
    border-radius: var(--ok-radius-inner);
  }
  .groups-header-summary .avatar {
    width: 44px; height: 44px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(140deg, var(--ok-color-token-034), var(--ok-color-token-035));
    border: 1px solid var(--ok-purple-border);
    color: var(--ok-color-token-036);
    font-weight: 800;
    font-size: 1rem;
    flex-shrink: 0;
  }
  .groups-header-summary .info { min-width: 0; flex: 1; }
  .groups-header-summary .name {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--ok-text-primary);
    margin: 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .groups-header-summary .sub {
    font-size: 0.72rem;
    color: var(--ok-text-muted);
    margin: 0.15rem 0 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .groups-header-summary .badges {
    display: flex; gap: 0.35rem; flex-wrap: wrap;
    margin-top: 0.35rem;
  }

  /* Confirm card */
  .groups-confirm-card {
    background: var(--ok-bg-window-inner);
    border: 1px solid var(--ok-divider);
    border-radius: var(--ok-radius-inner);
    padding: 1rem;
    display: flex; flex-direction: column; gap: 0.65rem;
  }
  .groups-confirm-row {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.82rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--ok-divider);
  }
  .groups-confirm-row:last-child { border-bottom: 0; }
  .groups-confirm-row .label {
    color: var(--ok-text-muted);
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }
  .groups-confirm-row .value {
    color: var(--ok-text-primary);
    font-weight: 600;
    text-align: right;
    overflow-wrap: anywhere;
  }

  /* Wizard footer */
  .groups-wizard-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.85rem 1.15rem;
    border-top: 1px solid var(--ok-divider);
    background: var(--ok-glass-tint);
    flex-wrap: wrap;
  }
  .groups-wizard-progress {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ok-text-muted);
    letter-spacing: 0.02em;
  }
  .groups-wizard-progress strong { color: var(--ok-purple-vibrant); }
  .groups-wizard-actions { display: flex; gap: 0.4rem; align-items: center; }

  /* Alertas inline */
  #groups-page-alert {
    max-width: var(--ok-content-max);
    margin: 0 auto 16px auto;
    border-radius: var(--ok-radius-md);
    font-size: 0.85rem;
  }

  .groups-modal .alert-warning {
    background: var(--ok-color-token-039);
    border: 1px solid var(--ok-color-token-040);
    color: var(--ok-color-token-041);
  }
  html[data-theme="light"] .groups-modal .alert-warning { color: var(--ok-color-token-023); }

  .groups-modal textarea.form-control {
    background: var(--ok-input-bg) !important;
    border: 1px solid var(--ok-border-subtle) !important;
    color: var(--ok-text-primary) !important;
    border-radius: var(--ok-radius-md);
    font-size: 0.84rem;
    padding: 0.6rem 0.85rem;
  }
  .groups-modal textarea.form-control:focus {
    border-color: var(--ok-purple-vibrant) !important;
    box-shadow: 0 0 0 4px var(--ok-purple-soft) !important;
  }
  .groups-modal .form-text { color: var(--ok-text-muted); font-size: 0.72rem; }

  /* Animações de entrada dos modais */
  .groups-modal.fade .modal-dialog {
    transform: scale(0.96) translateY(8px);
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 0.1), opacity 0.28s ease;
  }
  .groups-modal.show .modal-dialog {
    transform: scale(1) translateY(0);
  }

  /* Footer */
  .admin-footer {
    border-top: 1px solid var(--ok-border-subtle);
    background: var(--ok-color-transparent);
    padding: 1rem 1.25rem;
    text-align: center;
    color: var(--ok-text-muted);
    font-size: 0.78rem;
    position: relative;
    z-index: 1;
    margin-top: 2rem;
    max-width: var(--ok-content-max);
    margin-inline: auto;
    width: 100%;
  }

  /* =========================================================================
     RESPONSIVIDADE
     ========================================================================= */
  @media (max-width: 1200px) {
    .ok-flat-quad-strip { grid-template-columns: repeat(2, 1fr); }
    .ok-canvas-asides-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 991px) {
    .ok-rail-sidebar { transform: translateX(-120%); }
    body.mobile-nav-active .ok-rail-sidebar { transform: translateX(0); }
    .ok-viewport-shell { margin-left: 0; padding: 16px; }
    .ok-page-title-main { font-size: 1.55rem; }
    .groups-card-footer { align-items: flex-start; flex-direction: column; }
    .groups-pagination { width: 100%; }
    .groups-modal .modal-dialog { max-width: calc(100% - 1.5rem); }
  }
  @media (max-width: 600px) {
    .ok-flat-quad-strip { grid-template-columns: 1fr; }
    .groups-field-grid { grid-template-columns: 1fr; }
    .ok-profile-pill .admin-profile-text { display: none !important; }
    .ok-search-capsule { width: min(100%, 500px); }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  .text-danger { color: var(--ok-accent-rose) !important; }
  .text-muted { color: var(--ok-text-muted) !important; }
  .btn-outline-info { --bs-btn-color: var(--ok-accent-cyan); --bs-btn-border-color: var(--ok-accent-cyan); --bs-btn-hover-color: var(--ok-text-primary); --bs-btn-hover-bg: var(--ok-accent-cyan); --bs-btn-hover-border-color: var(--ok-accent-cyan); }
  .btn-outline-primary { --bs-btn-color: var(--ok-purple-vibrant); --bs-btn-border-color: var(--ok-purple-vibrant); --bs-btn-hover-color: var(--ok-text-primary); --bs-btn-hover-bg: var(--ok-purple-primary); --bs-btn-hover-border-color: var(--ok-purple-primary); }
  .alert-danger { --bs-alert-color: var(--ok-accent-rose); --bs-alert-bg: var(--ok-color-token-045); --bs-alert-border-color: var(--ok-accent-rose); }
  .alert-warning { --bs-alert-color: var(--ok-accent-amber); --bs-alert-bg: var(--ok-color-token-039); --bs-alert-border-color: var(--ok-accent-amber); }
  .alert-success { --bs-alert-color: var(--ok-color-token-017); --bs-alert-bg: var(--ok-color-token-015); --bs-alert-border-color: var(--ok-accent-emerald); }
  .alert-info { --bs-alert-color: var(--ok-accent-cyan); --bs-alert-bg: var(--ok-color-token-026); --bs-alert-border-color: var(--ok-accent-cyan); }
</style>

