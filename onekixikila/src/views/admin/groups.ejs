          <p class="ok-flat-desc">Grupos sob intervenção preventiva.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" id="stat-suspended">—</span>
          <div class="ok-flat-trend danger">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
            Crítico
          </div>
        </div>
      </div>
    </div>

    <!-- SESSÃO 2: VAULT + FILTROS -->
    <div class="ok-canvas-asides-grid">
      <div class="ok-balance-vault-card">
        <div class="ok-vault-wave-bg"></div>
        <div>
          <div class="ok-vault-badge-cluster">
            <div class="ok-token-emblem" style="background: linear-gradient(135deg, var(--ok-color-token-005), var(--ok-color-token-006));">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--ok-color-token-010)" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            </div>
            <span class="fw-bold" style="font-size: 0.78rem; color: var(--ok-text-primary);">Sessão de Supervisão</span>
            <span class="badge ms-auto" style="background: var(--ok-purple-soft); color: var(--ok-purple-vibrant); font-size: 0.7rem; font-weight: 800; padding: 4px 10px; border-radius: 999px;" id="admin-access-badge"><%= adminRoleForPage || 'ADMIN' %></span>
          </div>

          <div class="ok-vault-balance-display">
            <span class="ok-vault-caption">
              Operador
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </span>
            <div class="ok-vault-sum" style="font-size: 1.15rem;"><%= adminUserName %></div>
            <div class="d-flex justify-content-between align-items-center mt-2" style="font-size: 0.78rem; color: var(--ok-text-muted);">
              <span>Pode intervir:</span>
