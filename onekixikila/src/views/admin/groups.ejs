            </div>
            <div class="d-flex justify-content-between align-items-center mt-1" style="font-size: 0.78rem; color: var(--ok-text-muted);">
              <span>Página atual:</span>
              <strong style="color: var(--ok-purple-vibrant);" id="vault-page-info">—</strong>
            </div>
          </div>
        </div>

        <div class="ok-vault-action-row">
          <button type="button" class="ok-vault-btn primary" id="groups-refresh-vault">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
            Recarregar
          </button>
          <a href="/admin" class="ok-vault-btn ghost">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
            Dashboard
          </a>
        </div>
      </div>

      <div class="ok-config-module-card">
        <div class="ok-chart-header">
          <div class="ok-chart-tagline">
            <div class="ok-chart-tag-emblem">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
            </div>
            <div>
              <h5 class="ok-chart-title">Pesquisa e filtros</h5>
              <span class="ok-chart-sub">Combine pesquisa, estado, periodicidade e tamanho de página</span>
            </div>
          </div>
          <span class="ok-eyebrow" id="groups-total-pill"></span>
        </div>

        <section class="groups-filter-card" aria-labelledby="groups-filter-title">
          <form id="groups-filter-form" class="row g-2 align-items-end" role="search">
            <div class="col-12 col-lg-5">
              <label for="filter-search" class="form-label">Pesquisa por nome ou slug</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                <input type="search" class="form-control" id="filter-search" name="search" maxlength="100" autocomplete="off" placeholder="Nome do grupo ou identificador">
              </div>
            </div>
            <div class="col-6 col-lg-3">
              <label for="filter-status" class="form-label">Estado</label>
              <select class="form-select" id="filter-status" name="status">
                <option value="">Todos os estados</option>
                <option value="DRAFT">Rascunho</option>
                <option value="FORMATION">Em formação</option>
                <option value="ACTIVE">Ativo</option>
                <option value="PAUSED">Pausado</option>
                <option value="SUSPENDED">Suspenso</option>
                <option value="COMPLETED">Concluído</option>
                <option value="CANCELLED">Cancelado</option>
              </select>
            </div>
            <div class="col-6 col-lg-2">
              <label for="filter-frequency" class="form-label">Periodicidade</label>
              <select class="form-select" id="filter-frequency" name="frequency">
                <option value="">Todas</option>
                <option value="DAILY">Diária</option>
                <option value="WEEKLY">Semanal</option>
                <option value="BIWEEKLY">Quinzenal</option>
                <option value="MONTHLY">Mensal</option>
              </select>
            </div>
            <div class="col-6 col-lg-1">
              <label for="filter-limit" class="form-label">Por pág.</label>
              <select class="form-select" id="filter-limit" name="limit">
                <option value="15">15</option>
                <option value="30">30</option>
                <option value="50">50</option>
                <option value="100">100</option>
              </select>
            </div>
            <div class="col-6 col-lg-1 d-flex gap-2">
              <button type="submit" class="btn btn-primary flex-grow-1" aria-label="Pesquisar">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              </button>
              <button type="reset" class="btn btn-outline-light" id="groups-reset-btn" aria-label="Limpar filtros" title="Limpar filtros">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </button>
            </div>
          </form>
        </section>
      </div>
    </div>

    <!-- Loading e erro -->
    <div id="groups-loading" class="admin-card groups-state-box mb-4" role="status" aria-live="polite">
      <span class="spinner-border spinner-border-sm me-2" style="color:var(--ok-purple-vibrant);" aria-hidden="true"></span>
      A carregar esteira de grupos…
    </div>
    <div id="groups-error" class="admin-card groups-state-box d-none mb-4" role="alert"></div>

    <!-- SESSÃO 3: TABELA -->
    <section class="admin-card mb-4 d-none" id="groups-table-card" aria-labelledby="groups-table-title">
      <div class="admin-table-header">
        <div>
          <h2 class="admin-table-title" id="groups-table-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ok-purple-vibrant)" stroke-width="2.2" style="margin-right:8px;vertical-align:-3px;">
              <rect width="18" height="18" x="3" y="3" rx="2"></rect>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
            Grupos de Kixikila
          </h2>
          <p class="admin-table-sub mb-0">Dados operacionais fornecidos pelo módulo administrativo.</p>
        </div>
      </div>
      <div class="groups-table-wrap">
        <table class="table groups-table mb-0">
          <thead>
            <tr>
              <th class="ps-4">Grupo</th>
              <th>Liderança</th>
              <th>Membros</th>
              <th>Contribuição</th>
              <th>Periodicidade</th>
              <th>Estado</th>
              <th>Criado em</th>
              <th class="text-end pe-4">Ações</th>
            </tr>
          </thead>
          <tbody id="groups-table-body"></tbody>
        </table>
      </div>
      <div class="groups-card-footer">
        <span class="small text-muted" id="groups-pagination-info">—</span>
        <ul class="groups-pagination" id="groups-pagination" aria-label="Paginação"></ul>
      </div>
    </section>

    <div class="groups-note mb-4">
      <i class="bi bi-shield-check me-2" aria-hidden="true"></i>
      Intervenções de estado exigem uma justificação formal (5–255 caracteres). Grupos concluídos ou cancelados não podem ser alterados. A substituição de liderança é reservada a ADMIN e só é aceite pelo servidor quando o novo líder tem uma filiação ativa no grupo.
    </div>

  </div>

  <footer class="admin-footer">
    <div class="container-fluid">
      <span>&copy; <%= (typeof currentYear !== 'undefined' ? currentYear : new Date().getFullYear()) %> OneKixikila Admin Engine. Supervisão sujeita aos controlos de acesso e à trilha de auditoria.</span>
    </div>
  </footer>

  <!-- ======================================================================
       MODAL 1 — FICHA OPERACIONAL (WIZARD 4 ETAPAS)
       ====================================================================== -->
  <div class="modal fade groups-modal" id="modal-group-details" tabindex="-1" aria-labelledby="modalGroupDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title" id="modalGroupDetailsLabel">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ok-purple-vibrant)" stroke-width="2.2" style="margin-right:8px;vertical-align:-3px;">
              <rect width="18" height="18" x="3" y="3" rx="2"></rect>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
            Ficha operacional do grupo
          </h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>

        <div class="groups-timeline" id="details-timeline">
          <span class="groups-step active" data-step="1"><span class="dot"><span>1</span></span>Identificação</span>
          <span class="groups-step-sep" data-sep="1"></span>
          <span class="groups-step" data-step="2"><span class="dot"><span>2</span></span>Operação</span>
          <span class="groups-step-sep" data-sep="2"></span>
          <span class="groups-step" data-step="3"><span class="dot"><span>3</span></span>Regras</span>
          <span class="groups-step-sep" data-sep="3"></span>
          <span class="groups-step" data-step="4"><span class="dot"><span>4</span></span>Auditoria</span>
        </div>

        <div class="modal-body" id="modal-group-details-body">
          <div class="groups-state-box">
            <span class="spinner-border spinner-border-sm" role="status" aria-label="A carregar"></span>
          </div>
        </div>

        <div class="groups-wizard-footer" id="details-wizard-footer">
          <span class="groups-wizard-progress">Etapa <strong id="details-step-current">1</strong> de 4</span>
          <div class="groups-wizard-actions">
            <button type="button" class="ok-btn-apple secondary" id="details-prev-btn" disabled>
              <i class="bi bi-chevron-left" aria-hidden="true"></i> Anterior
            </button>
            <button type="button" class="ok-btn-apple primary" id="details-next-btn">
              Próximo <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </button>
            <button type="button" class="ok-btn-apple secondary" data-bs-dismiss="modal">Fechar</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ======================================================================
       MODAL 2 — INTERVENÇÃO NO ESTADO (WIZARD 3 ETAPAS)
       ====================================================================== -->
  <div class="modal fade groups-modal" id="modal-change-group-status" tabindex="-1" aria-labelledby="modalChangeGroupStatusLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title" id="modalChangeGroupStatusLabel">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ok-accent-amber)" stroke-width="2.2" style="margin-right:8px;vertical-align:-3px;">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            Intervenção no grupo
          </h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>

        <div class="groups-timeline" id="status-timeline">
          <span class="groups-step active" data-step="1"><span class="dot"><span>1</span></span>Estado</span>
          <span class="groups-step-sep" data-sep="1"></span>
          <span class="groups-step" data-step="2"><span class="dot"><span>2</span></span>Fundamentação</span>
          <span class="groups-step-sep" data-sep="2"></span>
          <span class="groups-step" data-step="3"><span class="dot"><span>3</span></span>Confirmar</span>
        </div>

        <form id="form-change-group-status">
          <input type="hidden" id="status-target-group-id">
          <div class="modal-body">
            <div class="groups-pane active" data-pane="1">
              <div class="admin-note" style="margin-bottom:0.85rem;background:var(--ok-color-token-039);border-color:var(--ok-color-token-040);color:var(--ok-color-token-041);">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <span>A alteração de estado é auditada. Verifique o estado atual e escolha a nova situação operacional.</span>
              </div>
              <label for="group-status-select" class="form-label">Novo estado</label>
              <select class="form-select" id="group-status-select" required>
                <option value="ACTIVE">ACTIVE — Ativo / reativar</option>
                <option value="PAUSED">PAUSED — Pausar temporariamente</option>
                <option value="SUSPENDED">SUSPENDED — Suspensão preventiva</option>
              </select>
              <div class="groups-field-grid mt-3" id="status-current-fields"></div>
            </div>

            <div class="groups-pane" data-pane="2">
              <p class="groups-pane-title">Fundamentação obrigatória</p>
              <label for="group-status-reason" class="form-label">Justificação formal <span class="text-danger">*</span></label>
              <textarea class="form-control" id="group-status-reason" rows="4" minlength="5" maxlength="255" required placeholder="Descreva o motivo da intervenção (5–255 caracteres)."></textarea>
              <div class="form-text">A justificação é enviada ao servidor e incluída na trilha de auditoria.</div>
            </div>

            <div class="groups-pane" data-pane="3">
              <p class="groups-pane-title">Confirmação final</p>
              <div class="groups-confirm-card">
                <div class="groups-confirm-row">
                  <span class="label">Grupo</span>
                  <span class="value" id="confirm-status-group">—</span>
                </div>
                <div class="groups-confirm-row">
                  <span class="label">Estado atual</span>
                  <span class="value" id="confirm-status-from">—</span>
                </div>
                <div class="groups-confirm-row">
                  <span class="label">Novo estado</span>
                  <span class="value" id="confirm-status-to">—</span>
                </div>
                <div class="groups-confirm-row">
                  <span class="label">Fundamentação</span>
                  <span class="value" id="confirm-status-reason">—</span>
                </div>
              </div>
            </div>
          </div>
          <div class="groups-wizard-footer">
            <span class="groups-wizard-progress">Etapa <strong id="status-step-current">1</strong> de 3</span>
            <div class="groups-wizard-actions">
              <button type="button" class="ok-btn-apple secondary" id="status-prev-btn" disabled>
                <i class="bi bi-chevron-left" aria-hidden="true"></i> Anterior
              </button>
              <button type="button" class="ok-btn-apple primary" id="status-next-btn">
                Próximo <i class="bi bi-chevron-right" aria-hidden="true"></i>
              </button>
              <button type="button" class="ok-btn-apple secondary" data-bs-dismiss="modal">Cancelar</button>
              <button type="submit" class="ok-btn-apple primary d-none" id="group-status-submit">
                <i class="bi bi-check2" aria-hidden="true"></i> Confirmar intervenção
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ======================================================================
       MODAL 3 — SUBSTITUIÇÃO DE LIDERANÇA (WIZARD 3 ETAPAS)
       ====================================================================== -->
  <div class="modal fade groups-modal" id="modal-force-leader" tabindex="-1" aria-labelledby="modalForceLeaderLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title" id="modalForceLeaderLabel">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ok-purple-vibrant)" stroke-width="2.2" style="margin-right:8px;vertical-align:-3px;">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            Substituir liderança
          </h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>

        <div class="groups-timeline" id="leader-timeline">
          <span class="groups-step active" data-step="1"><span class="dot"><span>1</span></span>Novo líder</span>
          <span class="groups-step-sep" data-sep="1"></span>
          <span class="groups-step" data-step="2"><span class="dot"><span>2</span></span>Fundamentação</span>
          <span class="groups-step-sep" data-sep="2"></span>
          <span class="groups-step" data-step="3"><span class="dot"><span>3</span></span>Confirmar</span>
        </div>

        <form id="form-force-leader">
          <input type="hidden" id="leader-target-group-id">
          <div class="modal-body">
            <div class="groups-pane active" data-pane="1">
              <div class="alert alert-warning py-2 small">Intervenção restrita a ADMIN. O novo líder tem de ser membro ativo deste grupo; a API valida essa condição.</div>
              <label for="new-leader-id" class="form-label">ID do novo líder (UUID)</label>
              <input type="text" class="form-control font-monospace" id="new-leader-id" required maxlength="36" pattern="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" autocomplete="off">
            </div>

            <div class="groups-pane" data-pane="2">
              <p class="groups-pane-title">Fundamentação obrigatória</p>
              <label for="force-leader-reason" class="form-label">Justificação formal <span class="text-danger">*</span></label>
              <textarea class="form-control" id="force-leader-reason" rows="4" minlength="5" maxlength="255" required placeholder="Registe o motivo da substituição (5–255 caracteres)."></textarea>
            </div>

            <div class="groups-pane" data-pane="3">
              <p class="groups-pane-title">Confirmação final</p>
              <div class="groups-confirm-card">
                <div class="groups-confirm-row">
                  <span class="label">Grupo</span>
                  <span class="value" id="confirm-leader-group">—</span>
                </div>
                <div class="groups-confirm-row">
                  <span class="label">Novo líder (UUID)</span>
                  <span class="value" id="confirm-leader-id" style="font-family:ui-monospace,monospace;">—</span>
                </div>
                <div class="groups-confirm-row">
                  <span class="label">Fundamentação</span>
                  <span class="value" id="confirm-leader-reason">—</span>
                </div>
              </div>
            </div>
          </div>
          <div class="groups-wizard-footer">
            <span class="groups-wizard-progress">Etapa <strong id="leader-step-current">1</strong> de 3</span>
            <div class="groups-wizard-actions">
              <button type="button" class="ok-btn-apple secondary" id="leader-prev-btn" disabled>
                <i class="bi bi-chevron-left" aria-hidden="true"></i> Anterior
              </button>
              <button type="button" class="ok-btn-apple primary" id="leader-next-btn">
                Próximo <i class="bi bi-chevron-right" aria-hidden="true"></i>
              </button>
              <button type="button" class="ok-btn-apple secondary" data-bs-dismiss="modal">Cancelar</button>
              <button type="submit" class="ok-btn-apple primary d-none" id="force-leader-submit">
                <i class="bi bi-check2" aria-hidden="true"></i> Submeter substituição
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <%- include('../partials/sweet-alert') %>
  <!-- Bootstrap bundle precisa de ser carregado ANTES do api-client para que
       window.bootstrap.Modal exista quando os handlers de detalhes forem chamados. -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  <script src="/js/api-client.js"></script>
  <script>
    (function(){
      'use strict';
      const page = document.body;
      const actorRole = String(page.dataset.adminRole || '').toUpperCase();
      const canSupervise = ['ADMIN','AUDITOR'].includes(actorRole);
      const canChangeLeader = actorRole === 'ADMIN';
      const e = {
        loading: document.getElementById('groups-loading'),
        error: document.getElementById('groups-error'),
        card: document.getElementById('groups-table-card'),
        body: document.getElementById('groups-table-body'),
        form: document.getElementById('groups-filter-form'),
        search: document.getElementById('filter-search'),
        status: document.getElementById('filter-status'),
        frequency: document.getElementById('filter-frequency'),
        limit: document.getElementById('filter-limit'),
        pagination: document.getElementById('groups-pagination'),
        paginationInfo: document.getElementById('groups-pagination-info'),
        totalPill: document.getElementById('groups-total-pill'),
        alert: document.getElementById('groups-page-alert')
      };
      let currentPage = 1, totalPages = 1, requestSequence = 0, activeGroups = [];

      function esc(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function(c) {
          return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c];
        });
      }
      function errMessage(error, fallback) {
        return error && typeof error.message === 'string' && error.message.trim() ? error.message : fallback;
      }
      function alertPage(message, type) {
        e.alert.className = 'alert alert-' + (type || 'danger') + ' mb-4';
        e.alert.textContent = String(message || 'Ocorreu um erro inesperado.');
        e.alert.classList.remove('d-none');
        e.alert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      function clearAlert() {
        e.alert.classList.add('d-none');
        e.alert.textContent = '';
      }
      function dateText(value) {
        if (!value) return '—';
        if (window.App && typeof window.App.formatDate === 'function') {
          try { return window.App.formatDate(value, false); } catch(_) {}
        }
        const d = new Date(value);
        return Number.isNaN(d.getTime()) ? '—' : new Intl.DateTimeFormat('pt-PT', { dateStyle: 'medium' }).format(d);
      }
      function moneyText(value, currency) {
        const n = Number(value);
        if (!Number.isFinite(n)) return '—';
        const code = String(currency || 'AOA').toUpperCase();
        try { return new Intl.NumberFormat('pt-AO', { style: 'currency', currency: code, maximumFractionDigits: 2 }).format(n); }
        catch(_) { return new Intl.NumberFormat('pt-PT', { maximumFractionDigits: 2 }).format(n) + ' ' + code; }
      }
      function statusBadge(status) {
        const value = String(status || 'UNKNOWN').toUpperCase();
        const labels = { DRAFT: 'Rascunho', FORMATION: 'Em formação', ACTIVE: 'Ativo', PAUSED: 'Pausado', SUSPENDED: 'Suspenso', COMPLETED: 'Concluído', CANCELLED: 'Cancelado' };
        const classes = { DRAFT: 'group-status-other', FORMATION: 'group-status-formation', ACTIVE: 'group-status-active', PAUSED: 'group-status-paused', SUSPENDED: 'group-status-suspended', COMPLETED: 'group-status-terminal', CANCELLED: 'group-status-terminal' };
        return '<span class="group-badge ' + (classes[value] || 'group-status-other') + '" title="' + esc(value) + '">' + esc(labels[value] || value) + '</span>';
      }
      function frequencyLabel(value) {
        const labels = { DAILY: 'Diária', WEEKLY: 'Semanal', BIWEEKLY: 'Quinzenal', MONTHLY: 'Mensal' };
        return labels[String(value || '').toUpperCase()] || String(value || '—');
      }

      function updateSummary(groups, pagination) {
        const total = Number(pagination && (pagination.totalItems ?? pagination.totalCount));
        document.getElementById('stat-total').textContent = Number.isFinite(total) ? String(total) : String(groups.length);
        document.getElementById('stat-active').textContent = String(groups.filter(g => g.status === 'ACTIVE').length);
        document.getElementById('stat-paused').textContent = String(groups.filter(g => g.status === 'PAUSED').length);
        document.getElementById('stat-suspended').textContent = String(groups.filter(g => g.status === 'SUSPENDED').length);
        e.totalPill.textContent = (Number.isFinite(total) ? total : groups.length) + ' resultado(s)';
        const vaultPage = document.getElementById('vault-page-info');
        if (vaultPage) {
          const cur = Number(pagination && (pagination.currentPage ?? pagination.page));
          const tp = Number(pagination && (pagination.totalPages ?? pagination.total_pages));
          if (Number.isFinite(cur) && Number.isFinite(tp)) vaultPage.textContent = 'Página ' + cur + ' / ' + tp;
          else vaultPage.textContent = '—';
        }
      }

      function renderGroups(groups) {
        if (!Array.isArray(groups) || groups.length === 0) {
          e.body.innerHTML = '<tr><td colspan="8"><div class="groups-state-box m-3"><i class="bi bi-diagram-3" aria-hidden="true"></i><strong class="d-block mb-1" style="color:var(--ok-text-primary);">Nenhum grupo encontrado</strong><span>Altere os filtros ou limpe a pesquisa para tentar novamente.</span></div></td></tr>';
          return;
        }
        e.body.innerHTML = groups.map(function(g) {
          const id = String(g.id || ''),
                name = String(g.name || 'Grupo sem nome'),
                slug = String(g.slug || ''),
                leader = String(g.leader_name || 'Liderança não definida'),
                members = Number(g.active_members_count || 0),
                min = Number(g.min_members || 0),
                max = Number(g.max_members || 0),
                terminal = ['COMPLETED','CANCELLED'].includes(String(g.status || '').toUpperCase());
          let actions = '<button type="button" class="btn btn-sm btn-outline-info" data-action="details" data-group-id="' + esc(id) + '" aria-label="Ver detalhes de ' + esc(name) + '" title="Ficha operacional"><i class="bi bi-eye" aria-hidden="true"></i></button>';
          if (canSupervise && !terminal) actions += '<button type="button" class="btn btn-sm btn-outline-warning" data-action="status" data-group-id="' + esc(id) + '" data-group-status="' + esc(g.status || 'ACTIVE') + '" aria-label="Alterar estado de ' + esc(name) + '" title="Intervir no estado"><i class="bi bi-shield-exclamation" aria-hidden="true"></i></button>';
          if (canChangeLeader && !terminal) actions += '<button type="button" class="btn btn-sm btn-outline-primary" data-action="leader" data-group-id="' + esc(id) + '" aria-label="Substituir liderança de ' + esc(name) + '" title="Substituir liderança"><i class="bi bi-person-gear" aria-hidden="true"></i></button>';
          return '<tr>' +
            '<td class="ps-4"><div class="d-flex align-items-center gap-3"><span class="group-avatar" aria-hidden="true">' + esc(name.trim().charAt(0).toUpperCase() || 'G') + '</span><div><div class="group-name">' + esc(name) + '</div><div class="group-subtext">' + (slug ? '@' + esc(slug) : 'ID ' + esc(id)) + '</div></div></div></td>' +
            '<td><div class="group-name">' + esc(leader) + '</div><div class="group-subtext">' + esc(g.leader_email || '') + '</div></td>' +
            '<td><span class="fw-semibold" style="color:var(--ok-text-primary);">' + (Number.isFinite(members) ? members : 0) + '</span><span class="group-subtext d-block">' + (min || '—') + '–' + (max || '—') + ' membros</span></td>' +
            '<td><span class="small" style="color:var(--ok-text-primary);">' + esc(moneyText(g.contribution_amount, g.currency)) + '</span></td>' +
            '<td><span class="small">' + esc(frequencyLabel(g.frequency)) + '</span></td>' +
            '<td>' + statusBadge(g.status) + '</td>' +
            '<td><span class="small text-muted">' + esc(dateText(g.created_at)) + '</span></td>' +
            '<td class="text-end pe-4"><div class="groups-actions">' + actions + '</div></td>' +
          '</tr>';
        }).join('');
      }

      function renderPagination(pagination) {
        const p = Number(pagination && (pagination.currentPage ?? pagination.page));
        const pages = Number(pagination && (pagination.totalPages ?? pagination.total_pages));
        if (Number.isFinite(p) && p > 0) currentPage = p;
        totalPages = Number.isFinite(pages) && pages > 0 ? pages : 1;
        const total = Number(pagination && (pagination.totalItems ?? pagination.totalCount));
        const limit = Number(e.limit.value) || 15;
        const first = total > 0 ? (currentPage - 1) * limit + 1 : 0,
              last = total > 0 ? Math.min(currentPage * limit, total) : 0;
        e.paginationInfo.textContent = totalPages > 1
          ? 'A mostrar ' + first + '–' + last + ' de ' + total + ' · Página ' + currentPage + ' de ' + totalPages
          : (total > 0 ? 'A mostrar ' + first + '–' + last + ' de ' + total + ' grupo(s)' : 'Sem resultados');
        const pagesList = Array.from(new Set([1, totalPages, currentPage-1, currentPage, currentPage+1].filter(n => n>=1 && n<=totalPages))).sort((a,b)=>a-b);
        let html = '<li><button type="button" data-page="' + (currentPage-1) + '" ' + (currentPage<=1?'disabled':'') + ' aria-label="Página anterior"><i class="bi bi-chevron-left" aria-hidden="true"></i></button></li>', prev = 0;
        pagesList.forEach(n => {
          if (prev && n - prev > 1) html += '<li class="text-muted px-1 align-self-center" aria-hidden="true">…</li>';
          html += '<li><button type="button" data-page="' + n + '" class="' + (n===currentPage?'is-current':'') + '" ' + (n===currentPage?'aria-current="page"':'') + '>' + n + '</button></li>';
          prev = n;
        });
        html += '<li><button type="button" data-page="' + (currentPage+1) + '" ' + (currentPage>=totalPages?'disabled':'') + ' aria-label="Página seguinte"><i class="bi bi-chevron-right" aria-hidden="true"></i></button></li>';
        e.pagination.innerHTML = html;
      }

      async function loadGroups(pageNumber) {
        if (!window.apiClient || typeof window.apiClient.get !== 'function') {
          e.loading.classList.add('d-none');
          e.card.classList.add('d-none');
          e.error.innerHTML = '<i class="bi bi-plug" aria-hidden="true"></i><strong class="d-block mb-2" style="color:var(--ok-text-primary);">Cliente da API indisponível</strong><span>Não é seguro carregar nem intervir em grupos sem o cliente da API. Recarregue a página; se o problema persistir, contacte o suporte técnico.</span><div class="mt-3"><button type="button" class="btn btn-sm btn-ghost-ok" id="groups-retry-btn"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Tentar novamente</button></div>';
          e.error.classList.remove('d-none');
          return;
        }
        const seq = ++requestSequence;
        currentPage = pageNumber || 1;
        clearAlert();
        e.error.classList.add('d-none');
        e.card.classList.add('d-none');
        e.loading.classList.remove('d-none');
        e.loading.innerHTML = '<span class="spinner-border spinner-border-sm me-2" style="color:var(--ok-purple-vibrant);" aria-hidden="true"></span>A carregar esteira de grupos…';
        const params = new URLSearchParams({ page: String(currentPage), limit: String(Number(e.limit.value) || 15) });
        const search = e.search.value.trim();
        if (search) params.set('search', search);
        if (e.status.value) params.set('status', e.status.value);
        if (e.frequency.value) params.set('frequency', e.frequency.value);
        try {
          const response = await window.apiClient.get('/admin/groups?' + params.toString());
          if (seq !== requestSequence) return;
          if (!response || response.success === false || !Array.isArray(response.data)) throw new Error('A resposta da API não contém uma lista válida de grupos.');
          activeGroups = response.data;
          renderGroups(activeGroups);
          renderPagination(response.pagination || {});
          updateSummary(activeGroups, response.pagination || {});
          e.loading.classList.add('d-none');
          e.card.classList.remove('d-none');
        } catch (error) {
          if (seq !== requestSequence) return;
          e.loading.classList.add('d-none');
          e.card.classList.add('d-none');
          e.error.innerHTML = '<i class="bi bi-exclamation-triangle" aria-hidden="true"></i><strong class="d-block mb-2" style="color:var(--ok-text-primary);">Não foi possível carregar os grupos</strong><span>' + esc(errMessage(error, 'Falha de comunicação com o servidor.')) + '</span><div class="mt-3"><button type="button" class="btn btn-sm btn-ghost-ok" id="groups-retry-btn"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Tentar novamente</button></div>';
          e.error.classList.remove('d-none');
        }
      }

      function modal(id) {
        if (!window.bootstrap || !window.bootstrap.Modal) {
          alertPage('Os componentes de interface não foram inicializados. Recarregue antes de continuar.', 'warning');
          return null;
        }
        return window.bootstrap.Modal.getOrCreateInstance(document.getElementById(id));
      }
      function fieldItem(label, value, opts) {
        const o = opts || {};
        return '<div class="group-detail-box"><span class="group-detail-label">' + esc(label) + '</span><span class="group-detail-value' + (o.mono ? ' mono' : '') + '">' + esc(value==null||value===''?'—':value) + '</span></div>';
      }

      // ============ WIZARDS ============
      let detailStep = 1; const detailStepCount = 4;
      function setDetailStep(step) {
        detailStep = Math.max(1, Math.min(detailStepCount, step));
        document.querySelectorAll('#modal-group-details .groups-pane').forEach(p => {
          p.classList.toggle('active', Number(p.dataset.pane) === detailStep);
        });
        const timeline = document.getElementById('details-timeline');
        if (timeline) {
          timeline.querySelectorAll('.groups-step').forEach(el => {
            const n = Number(el.dataset.step);
            el.classList.toggle('active', n === detailStep);
            el.classList.toggle('done', n < detailStep);
          });
          timeline.querySelectorAll('.groups-step-sep').forEach(el => {
            const n = Number(el.dataset.sep);
            el.classList.toggle('done', n < detailStep);
          });
        }
        const cur = document.getElementById('details-step-current');
        if (cur) cur.textContent = String(detailStep);
        const prev = document.getElementById('details-prev-btn');
        const next = document.getElementById('details-next-btn');
        if (prev) prev.disabled = detailStep <= 1;
        if (next) next.classList.toggle('d-none', detailStep >= detailStepCount);
      }

      let statusStep = 1; const statusStepCount = 3;
      function setStatusStep(step) {
        statusStep = Math.max(1, Math.min(statusStepCount, step));
        document.querySelectorAll('#modal-change-group-status .groups-pane').forEach(p => {
          p.classList.toggle('active', Number(p.dataset.pane) === statusStep);
        });
        const timeline = document.getElementById('status-timeline');
        if (timeline) {
          timeline.querySelectorAll('.groups-step').forEach(el => {
            const n = Number(el.dataset.step);
            el.classList.toggle('active', n === statusStep);
            el.classList.toggle('done', n < statusStep);
          });
          timeline.querySelectorAll('.groups-step-sep').forEach(el => {
            const n = Number(el.dataset.sep);
            el.classList.toggle('done', n < statusStep);
          });
        }
        const cur = document.getElementById('status-step-current');
        if (cur) cur.textContent = String(statusStep);
        const prev = document.getElementById('status-prev-btn');
        const next = document.getElementById('status-next-btn');
        const submit = document.getElementById('group-status-submit');
        if (prev) prev.disabled = statusStep <= 1;
        if (next) next.classList.toggle('d-none', statusStep >= statusStepCount);
        if (submit) submit.classList.toggle('d-none', statusStep < statusStepCount);
        if (statusStep === statusStepCount) buildStatusConfirm();
      }

      let leaderStep = 1; const leaderStepCount = 3;
      function setLeaderStep(step) {
        leaderStep = Math.max(1, Math.min(leaderStepCount, step));
        document.querySelectorAll('#modal-force-leader .groups-pane').forEach(p => {
          p.classList.toggle('active', Number(p.dataset.pane) === leaderStep);
        });
        const timeline = document.getElementById('leader-timeline');
        if (timeline) {
          timeline.querySelectorAll('.groups-step').forEach(el => {
            const n = Number(el.dataset.step);
            el.classList.toggle('active', n === leaderStep);
            el.classList.toggle('done', n < leaderStep);
          });
          timeline.querySelectorAll('.groups-step-sep').forEach(el => {
            const n = Number(el.dataset.sep);
            el.classList.toggle('done', n < leaderStep);
          });
        }
        const cur = document.getElementById('leader-step-current');
        if (cur) cur.textContent = String(leaderStep);
        const prev = document.getElementById('leader-prev-btn');
        const next = document.getElementById('leader-next-btn');
        const submit = document.getElementById('force-leader-submit');
        if (prev) prev.disabled = leaderStep <= 1;
        if (next) next.classList.toggle('d-none', leaderStep >= leaderStepCount);
        if (submit) submit.classList.toggle('d-none', leaderStep < leaderStepCount);
        if (leaderStep === leaderStepCount) buildLeaderConfirm();
      }

      function buildStatusConfirm() {
        const id = document.getElementById('status-target-group-id').value;
        const g = activeGroups.find(x => String(x.id) === String(id));
        const newStatus = document.getElementById('group-status-select').value;
        document.getElementById('confirm-status-group').textContent = g ? g.name : id;
        document.getElementById('confirm-status-from').textContent = g ? g.status : '—';
        document.getElementById('confirm-status-to').textContent = newStatus;
        document.getElementById('confirm-status-reason').textContent = document.getElementById('group-status-reason').value.trim() || '—';
      }

      function buildLeaderConfirm() {
        const id = document.getElementById('leader-target-group-id').value;
        const g = activeGroups.find(x => String(x.id) === String(id));
        document.getElementById('confirm-leader-group').textContent = g ? g.name : id;
        document.getElementById('confirm-leader-id').textContent = document.getElementById('new-leader-id').value.trim() || '—';
        document.getElementById('confirm-leader-reason').textContent = document.getElementById('force-leader-reason').value.trim() || '—';
      }

      // ============ SHOW GROUP DETAILS (dados reais do backend) ============
      async function showGroupDetails(id) {
        const m = modal('modal-group-details'), body = document.getElementById('modal-group-details-body');
        if (!m || !window.apiClient || typeof window.apiClient.get !== 'function') return;
        setDetailStep(1);
        body.innerHTML = '<div class="groups-state-box"><span class="spinner-border spinner-border-sm" role="status" aria-label="A carregar"></span><span class="ms-2">A consultar ficha operacional…</span></div>';
        m.show();
        try {
          const response = await window.apiClient.get('/admin/groups/' + encodeURIComponent(id));
          const g = response && response.data ? (response.data.group || response.data) : null;
          if (!g || typeof g !== 'object') throw new Error('A API não devolveu uma ficha de grupo válida.');
          const name = g.name || 'Grupo';

          const pane1 = '<div class="groups-header-summary"><div class="avatar">' + esc(String(name).trim().charAt(0).toUpperCase() || 'G') + '</div><div class="info"><p class="name">' + esc(name) + '</p><p class="sub">' + esc(g.slug ? '@' + g.slug : (g.id || '—')) + '</p><div class="badges">' + statusBadge(g.status) + '<span class="group-badge group-status-other">' + esc(frequencyLabel(g.frequency)) + '</span></div></div></div>' +
            '<p class="groups-pane-title">Identificação</p>' +
            '<div class="groups-field-grid">' +
              fieldItem('Descrição', g.description) +
              fieldItem('Identificador / slug', g.slug, { mono: true }) +
              fieldItem('Líder', g.leader_name) +
              fieldItem('E-mail do líder', g.leader_email) +
              fieldItem('Contacto do líder', g.leader_phone) +
              fieldItem('Localização', [(g.neighborhood||''),(g.municipality||''),(g.province||'')].filter(Boolean).join(', ')) +
            '</div>';

          const pane2 = '<p class="groups-pane-title">Operação</p>' +
            '<div class="groups-field-grid">' +
              fieldItem('Membros ativos', g.active_members_count) +
              fieldItem('Limites de membros', String(g.min_members ?? '—') + '–' + String(g.max_members ?? '—')) +
              fieldItem('Contribuição', moneyText(g.contribution_amount, g.currency)) +
              fieldItem('Ciclo atual', String(g.current_cycle ?? '—') + ' / ' + String(g.total_cycles ?? '—')) +
              fieldItem('Rotação', g.rotation_type) +
              fieldItem('Período de tolerância (dias)', g.grace_period_days) +
              fieldItem('Contribuições confirmadas', moneyText(g.total_contributions_collected, g.currency)) +
              fieldItem('Início', dateText(g.start_date)) +
              fieldItem('Fim', dateText(g.end_date)) +
            '</div>';

          const pane3 = '<p class="groups-pane-title">Regras</p>' +
            '<div class="groups-field-grid">' +
              fieldItem('Regra de multa', g.late_fee_type ? String(g.late_fee_type) + ' · ' + String(g.late_fee_value ?? '—') : '—') +
              fieldItem('Verificação de identidade obrigatória', g.require_identity_verification ? 'Sim' : 'Não') +
              fieldItem('Débito automático permitido', g.allow_auto_debit ? 'Sim' : 'Não') +
              fieldItem('Grupo privado', g.is_private ? 'Sim' : 'Não') +
              fieldItem('Visível publicamente', g.is_publicly_discoverable ? 'Sim' : 'Não') +
            '</div>';

          const pane4 = '<p class="groups-pane-title">Auditoria</p>' +
            '<div class="groups-field-grid">' +
              fieldItem('ID do grupo', g.id, { mono: true }) +
              fieldItem('Criado em', dateText(g.created_at)) +
              fieldItem('Atualizado em', dateText(g.updated_at)) +
              fieldItem('Estado', g.status) +
            '</div>' +
            '<div class="groups-note mt-3"><i class="bi bi-shield-check me-2" aria-hidden="true"></i>A ficha é fornecida pelo endpoint administrativo e está limitada às funções autorizadas no servidor.</div>';

          body.innerHTML =
            '<div class="groups-pane active" data-pane="1">' + pane1 + '</div>' +
            '<div class="groups-pane" data-pane="2">' + pane2 + '</div>' +
            '<div class="groups-pane" data-pane="3">' + pane3 + '</div>' +
            '<div class="groups-pane" data-pane="4">' + pane4 + '</div>';

          setDetailStep(1);
        } catch (error) {
          body.innerHTML = '<div class="alert alert-danger mb-0" role="alert">' + esc(errMessage(error, 'Falha ao consultar os detalhes do grupo.')) + '</div>';
        }
      }

      // ============ OPEN STATUS ============
      function openStatus(id, status) {
        if (!canSupervise) return alertPage('A supervisão de grupos exige privilégios de ADMIN ou AUDITOR.', 'warning');
        if (['COMPLETED','CANCELLED'].includes(String(status).toUpperCase())) return alertPage('Grupos concluídos ou cancelados não podem sofrer intervenções operacionais.', 'warning');
        document.getElementById('status-target-group-id').value = id;
        document.getElementById('group-status-select').value = ['ACTIVE','PAUSED','SUSPENDED'].includes(status) ? status : 'ACTIVE';
        document.getElementById('group-status-reason').value = '';
        const g = activeGroups.find(x => String(x.id) === String(id));
        const currentFields = document.getElementById('status-current-fields');
        if (currentFields) {
          currentFields.innerHTML = g ? [
            fieldItem('Grupo', g.name),
            fieldItem('Estado atual', g.status),
            fieldItem('Líder', g.leader_name),
            fieldItem('Membros ativos', String(g.active_members_count || 0))
          ].join('') : '<div class="group-detail-box"><span class="group-detail-label">Grupo</span><span class="group-detail-value">' + esc(id) + '</span></div>';
        }
        setStatusStep(1);
        const m = modal('modal-change-group-status');
        if (m) m.show();
      }

      function openLeader(id) {
        if (!canChangeLeader) return alertPage('A substituição compulsória da liderança é reservada a ADMIN.', 'warning');
        document.getElementById('leader-target-group-id').value = id;
        document.getElementById('new-leader-id').value = '';
        document.getElementById('force-leader-reason').value = '';
        setLeaderStep(1);
        const m = modal('modal-force-leader');
        if (m) m.show();
      }

      function setBusy(b) {
        document.querySelectorAll('#form-change-group-status button[type="submit"],#form-force-leader button[type="submit"],#groups-refresh-btn,#groups-filter-form button[type="submit"]').forEach(x => x.disabled = Boolean(b));
      }
      function success(message) {
        if (window.Alerts && typeof window.Alerts.toast === 'function') window.Alerts.toast(message, 'success');
        else if (window.Swal && typeof window.Swal.fire === 'function') window.Swal.fire({ icon: 'success', title: 'Concluído', text: message, timer: 2200, showConfirmButton: false });
        else alertPage(message, 'success');
      }
      function failure(message) {
        if (window.Alerts && typeof window.Alerts.error === 'function') window.Alerts.error(message);
        else if (window.Swal && typeof window.Swal.fire === 'function') window.Swal.fire({ icon: 'error', title: 'Não foi possível concluir', text: message });
        else alertPage(message, 'danger');
      }
      async function confirmAction(options) {
        if (window.Swal && typeof window.Swal.fire === 'function') {
          const result = await window.Swal.fire(options);
          return Boolean(result.isConfirmed);
        }
        return window.confirm(options.text || options.title || 'Confirmar ação?');
      }

      // ============ EVENTOS ============
      document.getElementById('groups-filter-form').addEventListener('submit', function(ev) { ev.preventDefault(); loadGroups(1); });
      document.getElementById('groups-filter-form').addEventListener('reset', function() { window.setTimeout(() => loadGroups(1), 0); });
      document.getElementById('groups-refresh-btn').addEventListener('click', () => loadGroups(currentPage));
      const refreshVault = document.getElementById('groups-refresh-vault');
      if (refreshVault) refreshVault.addEventListener('click', () => loadGroups(currentPage));
      e.pagination.addEventListener('click', function(ev) {
        const b = ev.target.closest('button[data-page]');
        if (!b || b.disabled) return;
        const p = Number(b.dataset.page);
        if (Number.isInteger(p) && p >= 1 && p <= totalPages) loadGroups(p);
      });
      e.body.addEventListener('click', function(ev) {
        const b = ev.target.closest('button[data-action]');
        if (!b) return;
        const id = b.dataset.groupId, g = activeGroups.find(x => String(x.id) === String(id));
        if (!id || !g) return;
        if (b.dataset.action === 'details') showGroupDetails(id);
        else if (b.dataset.action === 'status') openStatus(id, b.dataset.groupStatus);
        else if (b.dataset.action === 'leader') openLeader(id);
      });
      e.error.addEventListener('click', ev => { if (ev.target.closest('#groups-retry-btn')) loadGroups(currentPage); });

      document.getElementById('details-prev-btn').addEventListener('click', () => setDetailStep(detailStep - 1));
      document.getElementById('details-next-btn').addEventListener('click', () => setDetailStep(detailStep + 1));

      document.getElementById('status-prev-btn').addEventListener('click', () => setStatusStep(statusStep - 1));
      document.getElementById('status-next-btn').addEventListener('click', () => {
        if (statusStep === 1) {
          const s = document.getElementById('group-status-select').value;
          if (!s) { alertPage('Selecione um novo estado antes de avançar.', 'warning'); return; }
        }
        if (statusStep === 2) {
          const r = document.getElementById('group-status-reason').value.trim();
          if (r.length < 5 || r.length > 255) { alertPage('Indique uma justificação entre 5 e 255 caracteres.', 'warning'); return; }
        }
        setStatusStep(statusStep + 1);
      });
      document.getElementById('group-status-reason').addEventListener('input', () => { if (statusStep === 3) buildStatusConfirm(); });
      document.getElementById('group-status-select').addEventListener('change', () => { if (statusStep === 3) buildStatusConfirm(); });

      document.getElementById('leader-prev-btn').addEventListener('click', () => setLeaderStep(leaderStep - 1));
      document.getElementById('leader-next-btn').addEventListener('click', () => {
        if (leaderStep === 1) {
          const v = document.getElementById('new-leader-id').value.trim();
          if (!v) { alertPage('Indique o UUID do novo líder antes de avançar.', 'warning'); return; }
        }
        if (leaderStep === 2) {
          const r = document.getElementById('force-leader-reason').value.trim();
          if (r.length < 5 || r.length > 255) { alertPage('Indique uma justificação entre 5 e 255 caracteres.', 'warning'); return; }
        }
        setLeaderStep(leaderStep + 1);
      });
      document.getElementById('new-leader-id').addEventListener('input', () => { if (leaderStep === 3) buildLeaderConfirm(); });
      document.getElementById('force-leader-reason').addEventListener('input', () => { if (leaderStep === 3) buildLeaderConfirm(); });

      document.getElementById('form-change-group-status').addEventListener('submit', async function(ev) {
        ev.preventDefault();
        if (!canSupervise || !window.apiClient || typeof window.apiClient.patch !== 'function') return alertPage('A API ou as permissões necessárias não estão disponíveis. Ação cancelada.', 'danger');
        const id = document.getElementById('status-target-group-id').value,
              status = document.getElementById('group-status-select').value,
              reason = document.getElementById('group-status-reason').value.trim();
        if (!id || reason.length < 5 || reason.length > 255) return alertPage('Indique uma justificação entre 5 e 255 caracteres.', 'warning');
        if (!await confirmAction({ icon: 'warning', title: 'Confirmar intervenção?', text: 'O estado do grupo será alterado e a ação registada na auditoria.', showCancelButton: true, confirmButtonText: 'Confirmar', cancelButtonText: 'Cancelar', confirmButtonColor: '#7c3aed' })) return;
        setBusy(true);
        try {
          const result = await window.apiClient.patch('/admin/groups/' + encodeURIComponent(id) + '/status', { status, reason });
          if (result && result.success === false) throw new Error(result.message || 'A API recusou a alteração.');
          const m = window.bootstrap.Modal.getInstance(document.getElementById('modal-change-group-status'));
          if (m) m.hide();
          success('Estado do grupo atualizado com sucesso.');
          await loadGroups(currentPage);
        } catch (error) {
          failure(errMessage(error, 'Falha ao atualizar o estado do grupo.'));
        } finally {
          setBusy(false);
        }
      });

      document.getElementById('form-force-leader').addEventListener('submit', async function(ev) {
        ev.preventDefault();
        if (!canChangeLeader || !window.apiClient || typeof window.apiClient.post !== 'function') return alertPage('A API ou a autorização ADMIN não está disponível. Ação cancelada.', 'danger');
        const id = document.getElementById('leader-target-group-id').value,
              newLeaderId = document.getElementById('new-leader-id').value.trim(),
              reason = document.getElementById('force-leader-reason').value.trim();
        if (!id || !newLeaderId || reason.length < 5 || reason.length > 255) return alertPage('Indique o UUID do novo líder e uma justificação entre 5 e 255 caracteres.', 'warning');
        if (!await confirmAction({ icon: 'warning', title: 'Substituir liderança?', text: 'A ação é administrativa, será auditada e só será aceite se o utilizador for membro ativo do grupo.', showCancelButton: true, confirmButtonText: 'Submeter intervenção', cancelButtonText: 'Cancelar', confirmButtonColor: '#7c3aed' })) return;
        setBusy(true);
        try {
          const result = await window.apiClient.post('/admin/groups/' + encodeURIComponent(id) + '/force-leader', { newLeaderId, reason });
          if (result && result.success === false) throw new Error(result.message || 'A API recusou a substituição.');
          const m = window.bootstrap.Modal.getInstance(document.getElementById('modal-force-leader'));
          if (m) m.hide();
          success('Substituição de liderança concluída.');
          await loadGroups(currentPage);
        } catch (error) {
          failure(errMessage(error, 'Falha ao substituir a liderança.'));
        } finally {
          setBusy(false);
        }
      });

      document.getElementById('modal-change-group-status').addEventListener('hidden.bs.modal', () => { document.getElementById('form-change-group-status').reset(); setStatusStep(1); });
      document.getElementById('modal-force-leader').addEventListener('hidden.bs.modal', () => { document.getElementById('form-force-leader').reset(); setLeaderStep(1); });
      document.getElementById('modal-group-details').addEventListener('hidden.bs.modal', () => setDetailStep(1));

      // ===== Theme toggle =====
      const THEME_KEY = 'ok-theme';
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      const themeBtn = document.getElementById('theme-toggle-btn');
      if (themeBtn) {
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        themeBtn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      // ===== Sidebar mobile toggle =====
      const toggleBtn = document.getElementById('sidebar-toggle-btn');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          document.body.classList.toggle('mobile-nav-active');
        });
      }

      // ===== Mirror badges admin → rail =====
      function mirrorBadges() {
        ['kyc','disputes','withdrawals'].forEach((key) => {
          const original = document.getElementById('sidebar-badge-' + key);
          const mirror = document.getElementById('rail-badge-' + key);
          if (!original || !mirror) return;
          const hidden = original.classList.contains('d-none');
          mirror.classList.toggle('d-none', hidden);
          if (!hidden) {
            const txt = (original.textContent || '').trim();
            if (txt) mirror.textContent = txt;
          }
        });
      }
      mirrorBadges();
      const badgeObserver = new MutationObserver(mirrorBadges);
      ['kyc','disputes','withdrawals'].forEach((key) => {
        const elBadge = document.getElementById('sidebar-badge-' + key);
        if (elBadge) badgeObserver.observe(elBadge, { attributes: true, childList: true, characterData: true, subtree: true });
      });

      // ===== Ctrl+K foca pesquisa =====
      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
          const input = document.getElementById('global-admin-search');
          if (input) { e.preventDefault(); input.focus(); }
        }
      });

      function updateClock() {
        const clock = document.getElementById('admin-utc-clock');
        if (clock) clock.textContent = new Intl.DateTimeFormat('pt-AO', { timeZone: 'UTC', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).format(new Date()) + ' UTC';
      }
      updateClock();
      window.setInterval(updateClock, 1000);

      loadGroups(1);
    })();
  </script>
</body>
</html>