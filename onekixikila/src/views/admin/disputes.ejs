        </div>
        <div>
          <span class="ok-flat-metric-data" id="stat-open">—</span>
          <div class="ok-flat-trend warning">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            Em fila
          </div>
        </div>
      </div>

      <div class="ok-flat-card-box theme-white-alt">
        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="18" stroke="currentColor" stroke-linecap="square"/>
              <path d="M24 14v12m0 6h.01" stroke="currentColor" stroke-linecap="square"/>
            </svg>
          </div>
          <h5 class="ok-flat-title">Em investigação</h5>
          <p class="ok-flat-desc">Processos sob análise aprofundada.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" id="stat-investigation">—</span>
          <div class="ok-flat-trend info">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            Em análise
          </div>
        </div>
      </div>

      <div class="ok-flat-card-box theme-purple">
        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M14 8h20v32H14z" stroke="currentColor" stroke-linecap="square"/>
              <path d="M18 16h12M18 22h12M18 28h8" stroke="currentColor" stroke-linecap="square"/>
            </svg>
          </div>
          <h5 class="ok-flat-title">Encerradas</h5>
          <p class="ok-flat-desc">Decisão final ou arquivamento.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" id="stat-closed">—</span>
          <div class="ok-flat-trend">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Concluídas
          </div>
        </div>
      </div>

    </div>

    <!-- ====================================================================
         FILTROS
         ==================================================================== -->
    <section class="admin-card disp-filter" aria-labelledby="disp-filter-title">
      <div class="d-flex align-items-center gap-2 mb-3">
        <i class="bi bi-funnel" style="color:var(--ok-purple-vibrant);" aria-hidden="true"></i>
        <h2 id="disp-filter-title">Filtros da fila</h2>
      </div>
      <form id="disp-filter-form" class="row g-2 align-items-end">
        <div class="col-12 col-md-5">
          <label for="disp-status" class="form-label">Estado</label>
          <select id="disp-status" class="form-select">
            <option value="">Todos os estados</option>
            <option value="OPEN">Aberta</option>
            <option value="UNDER_INVESTIGATION">Em investigação</option>
            <option value="RESOLVED_FAVOR_INITIATOR">Resolvida a favor do requerente</option>
            <option value="RESOLVED_FAVOR_RESPONDENT">Resolvida a favor da parte reclamada</option>
            <option value="CLOSED_DISMISSED">Encerrada sem provimento</option>
          </select>
        </div>
        <div class="col-12 col-md-5">
          <label for="disp-category" class="form-label">Categoria</label>
          <select id="disp-category" class="form-select">
            <option value="">Todas as categorias</option>
            <option value="CONTRIBUTION_UNACKNOWLEDGED">Contribuição não reconhecida</option>
            <option value="ROTATION_ORDER_DISPUTE">Ordem de rotação contestada</option>
            <option value="UNAUTHORIZED_TRANSACTION">Transação não autorizada</option>
            <option value="WALLET_DISCREPANCY">Divergência de carteira</option>
            <option value="LEADERSHIP_ABUSE">Abuso de liderança</option>
            <option value="OTHER">Outra</option>
          </select>
        </div>
        <div class="col-6 col-md-1">
          <label for="disp-limit" class="form-label">Por pág.</label>
          <select id="disp-limit" class="form-select">
            <option value="15">15</option>
            <option value="30">30</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
        </div>
        <div class="col-6 col-md-1 d-flex gap-2">
          <button type="submit" class="btn btn-primary-ok flex-grow-1" aria-label="Aplicar filtros">
            <i class="bi bi-search" aria-hidden="true"></i>
          </button>
          <button type="reset" class="btn btn-ghost-ok" aria-label="Limpar filtros" title="Limpar filtros">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
          </button>
        </div>
      </form>
    </section>

    <!-- Loading / Erro -->
    <div id="disp-loading" class="admin-card disp-state-box mb-4" role="status" aria-live="polite">
      <span class="spinner-border spinner-border-sm me-2" style="color:var(--ok-purple-vibrant);" aria-hidden="true"></span>
      A carregar a fila de contestações…
    </div>
    <div id="disp-error" class="admin-card disp-state-box d-none mb-4" role="alert"></div>

    <!-- ====================================================================
         TABELA
         ==================================================================== -->
    <section class="admin-card mb-4 d-none" id="disp-table-card" aria-labelledby="disp-table-title">
      <div class="p-3 d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-bottom:1px solid var(--ok-border-subtle);">
        <div>
          <h2 id="disp-table-title" style="font-size:1.05rem;font-weight:800;color:var(--ok-text-primary);margin:0;display:flex;align-items:center;gap:10px;font-family:'Space Grotesk',sans-serif;">
            <i class="bi bi-shield-exclamation" style="color:var(--ok-purple-vibrant);" aria-hidden="true"></i>
            Fila de mediação
          </h2>
          <p class="mb-0" style="font-size:0.78rem;color:var(--ok-text-muted);">As ações disponíveis dependem do estado da contestação e da ausência de conflito.</p>
        </div>
        <span class="admin-currency-badge" id="disp-total-pill"></span>
      </div>

      <div class="disp-table-wrap">
        <table class="table disp-table">
          <thead>
            <tr>
              <th class="ps-4">Contestação</th>
              <th>Requerente</th>
              <th>Parte reclamada</th>
              <th>Categoria</th>
              <th>Montante</th>
              <th>Estado</th>
              <th>Aberta em</th>
              <th class="text-end pe-4">Ações</th>
            </tr>
          </thead>
          <tbody id="disp-table-body"></tbody>
        </table>
      </div>

      <div class="disp-footer">
        <span class="small" style="color:var(--ok-text-muted);" id="disp-pagination-info">—</span>
        <ul class="disp-pagination" id="disp-pagination" aria-label="Paginação"></ul>
      </div>
    </section>

    <div class="admin-note alert" style="max-width:var(--ok-content-max);margin:0 auto 20px auto;">
      <i class="bi bi-info-circle" aria-hidden="true"></i>
      <span>As decisões finais são irreversíveis no fluxo atual. Reveja descrição, evidências e partes antes de deliberar; o servidor rejeitará transições inválidas.</span>
    </div>

    <footer class="admin-footer" style="border-top:1px solid var(--ok-border-subtle);background:transparent;padding:1rem 1.25rem;text-align:center;color:var(--ok-text-muted);font-size:0.78rem;max-width:var(--ok-content-max);margin:2rem auto 0;width:100%;">
      <span>&copy; <%= (typeof currentYear !== 'undefined' ? currentYear : new Date().getFullYear()) %> OneKixikila Admin Engine. Mediação sujeita à imparcialidade e auditoria.</span>
    </footer>

  </div>

  <!-- ======================================================================
       MODAL — Autos da contestação
       ====================================================================== -->
  <div class="modal fade disp-modal" id="modal-disp-details" tabindex="-1" aria-labelledby="modalDispDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="modalDispDetailsLabel"><i class="bi bi-folder2-open me-2" style="color:var(--ok-purple-vibrant);" aria-hidden="true"></i>Autos da contestação</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body" id="disp-details-body">
          <div class="disp-state-box"><span class="spinner-border spinner-border-sm" role="status" aria-label="A carregar"></span></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-ghost-ok" data-bs-dismiss="modal">Fechar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ======================================================================
       MODAL — Deliberação de arbitragem
       ====================================================================== -->
  <div class="modal fade disp-modal" id="modal-disp-resolve" tabindex="-1" aria-labelledby="modalDispResolveLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="modalDispResolveLabel"><i class="bi bi-gavel me-2" style="color:var(--ok-accent-amber);" aria-hidden="true"></i>Deliberação de arbitragem</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <form id="form-disp-resolve">
          <input type="hidden" id="resolve-dispute-id">
          <div class="modal-body">
            <div class="admin-note alert mb-3">
              <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
              <span>A decisão encerrará definitivamente a disputa. Registe um parecer fundamentado e imparcial.</span>
            </div>
            <label for="resolve-status" class="form-label small fw-semibold">Decisão final</label>
            <select id="resolve-status" class="form-select" required>
              <option value="" selected disabled>Selecione uma decisão…</option>
              <option value="RESOLVED_FAVOR_INITIATOR">A favor do requerente</option>
              <option value="RESOLVED_FAVOR_RESPONDENT">A favor da parte reclamada</option>
              <option value="CLOSED_DISMISSED">Encerrar sem provimento</option>
            </select>
            <label for="resolve-notes" class="form-label small fw-semibold mt-3">Parecer fundamentado <span class="text-danger">*</span></label>
            <textarea id="resolve-notes" class="form-control" rows="5" minlength="10" maxlength="2000" required placeholder="Registe os factos considerados, evidências avaliadas e fundamentação da decisão (10–2000 caracteres)."></textarea>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-ghost-ok" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-warning-ok" id="resolve-submit">Confirmar decisão final</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <%- include('../partials/sweet-alert') %>
  <script src="/js/api-client.js"></script>
  <script>
    (function () {
      'use strict';

      /* ====================================================================
         TEMA CLARO/ESCURO
         ==================================================================== */
      const THEME_KEY = 'ok-theme';
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-btn');
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        if (!btn) return;
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      /* ====================================================================
         AÇÕES GLOBAIS
         ==================================================================== */
      function setupGlobalActions() {
        const sidebarToggle = document.getElementById('sidebar-toggle-btn');
        sidebarToggle?.addEventListener('click', () => {
          const active = document.body.classList.toggle('mobile-nav-active');
          sidebarToggle.setAttribute('aria-expanded', String(active));
        });
        document.querySelectorAll('.ok-rail-link[href]').forEach((link) => {
          link.addEventListener('click', () => {
            if (window.matchMedia('(max-width: 991px)').matches) {
              document.body.classList.remove('mobile-nav-active');
            }
          });
        });
        const search = document.getElementById('global-dashboard-search');
        document.addEventListener('keydown', (event) => {
          if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
            if (search) { event.preventDefault(); search.focus(); }
          }
        });
        document.querySelectorAll('[data-action="logout"]').forEach((button) => {
          button.addEventListener('click', async (event) => {
            event.preventDefault();
            button.disabled = true;
            try {
              if (window.apiClient && typeof window.apiClient.post === 'function') await window.apiClient.post('/auth/logout', {});
              if (window.apiClient && typeof window.apiClient.clearSession === 'function') window.apiClient.clearSession();
            } catch (_) {}
            window.location.href = '/login';
          });
        });
      }

      /* ====================================================================
         ESTADO E HELPERS
         ==================================================================== */
      const role = String(document.body.dataset.adminRole || '').toUpperCase();
      const actorId = String(document.body.dataset.adminUserId || '');
      const canArbitrate = ['ADMIN', 'AUDITOR'].includes(role);

      const el = {
        loading: document.getElementById('disp-loading'),
        error: document.getElementById('disp-error'),
        card: document.getElementById('disp-table-card'),
        body: document.getElementById('disp-table-body'),
        pagination: document.getElementById('disp-pagination'),
        alert: document.getElementById('disp-alert'),
        status: document.getElementById('disp-status'),
        category: document.getElementById('disp-category'),
        limit: document.getElementById('disp-limit')
      };
      let page = 1, pages = 1, seq = 0, records = [];

      function esc(v) { return String(v == null ? '' : v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
      function errMsg(e, f) { return e && typeof e.message === 'string' && e.message.trim() ? e.message : f; }
      function alertPage(text, type) {
        el.alert.className = 'alert alert-' + (type || 'danger');
        el.alert.textContent = String(text || 'Ocorreu um erro.');
        el.alert.classList.remove('d-none');
        el.alert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      function clearAlert() { el.alert.classList.add('d-none'); el.alert.textContent = ''; }
      function dateFmt(v) {
        if (!v) return '—';
        const d = new Date(v);
        return Number.isNaN(d.getTime()) ? '—' : new Intl.DateTimeFormat('pt-PT', { dateStyle: 'medium', timeStyle: 'short' }).format(d);
      }
      function money(v, c) {
        const n = Number(v);
        if (!Number.isFinite(n)) return '—';
        try { return new Intl.NumberFormat('pt-AO', { style: 'currency', currency: String(c || 'AOA'), maximumFractionDigits: 2 }).format(n); }
        catch (_) { return new Intl.NumberFormat('pt-PT', { maximumFractionDigits: 2 }).format(n) + ' ' + String(c || 'AOA'); }
      }

      function statusBadge(s) {
        const v = String(s || 'UNKNOWN').toUpperCase();
        const labels = { OPEN: 'Aberta', UNDER_INVESTIGATION: 'Em investigação', RESOLVED_FAVOR_INITIATOR: 'A favor do requerente', RESOLVED_FAVOR_RESPONDENT: 'A favor da parte reclamada', CLOSED_DISMISSED: 'Encerrada sem provimento' };
        const cls = { OPEN: 'disp-state-open', UNDER_INVESTIGATION: 'disp-state-investigation', RESOLVED_FAVOR_INITIATOR: 'disp-state-initiator', RESOLVED_FAVOR_RESPONDENT: 'disp-state-respondent', CLOSED_DISMISSED: 'disp-state-dismissed' };
        return '<span class="disp-badge ' + (cls[v] || 'disp-state-dismissed') + '" title="' + esc(v) + '">' + esc(labels[v] || v) + '</span>';
      }
      function categoryLabel(c) {
        return ({ CONTRIBUTION_UNACKNOWLEDGED: 'Contribuição não reconhecida', ROTATION_ORDER_DISPUTE: 'Ordem de rotação', UNAUTHORIZED_TRANSACTION: 'Transação não autorizada', WALLET_DISCREPANCY: 'Divergência de carteira', LEADERSHIP_ABUSE: 'Abuso de liderança', OTHER: 'Outra' })[String(c || '').toUpperCase()] || String(c || '—');
      }

      function conflict(d) { return !actorId || String(d.initiator_user_id || '') === actorId || String(d.respondent_user_id || '') === actorId; }
      function closed(d) { return ['RESOLVED_FAVOR_INITIATOR', 'RESOLVED_FAVOR_RESPONDENT', 'CLOSED_DISMISSED'].includes(String(d.status || '').toUpperCase()); }
      function mayAct(d) { return canArbitrate && !conflict(d) && !closed(d); }

      function updateSummary(data, p) {
        const total = Number(p && (p.totalItems ?? p.totalCount));
        document.getElementById('stat-total').textContent = Number.isFinite(total) ? String(total) : String(data.length);
        document.getElementById('stat-open').textContent = String(data.filter(x => x.status === 'OPEN').length);
        document.getElementById('stat-investigation').textContent = String(data.filter(x => x.status === 'UNDER_INVESTIGATION').length);
        document.getElementById('stat-closed').textContent = String(data.filter(x => closed(x)).length);
        document.getElementById('disp-total-pill').textContent = (Number.isFinite(total) ? total : data.length) + ' contestação(ões)';
      }

      function render(data) {
        if (!data.length) {
          el.body.innerHTML = '<tr><td colspan="8"><div class="disp-state-box m-3"><i class="bi bi-inbox" aria-hidden="true"></i><strong class="d-block mb-1" style="color:var(--ok-text-primary);">Nenhuma contestação encontrada</strong><span>Altere os filtros ou tente novamente mais tarde.</span></div></td></tr>';
          return;
        }
        el.body.innerHTML = data.map(d => {
          const id = String(d.id || '');
          const code = String(d.dispute_code || '');
          const name = String(d.initiator_name || 'Requerente não identificado');
          const respondent = String(d.respondent_name || 'Não indicado');
          const st = String(d.status || '').toUpperCase();
          const act = mayAct(d);
          let actions = '<button type="button" class="btn btn-sm btn-outline-info" data-action="details" data-dispute-id="' + esc(id) + '" aria-label="Ver autos de ' + esc(code) + '" title="Consultar autos"><i class="bi bi-eye" aria-hidden="true"></i></button>';
          if (act && st === 'OPEN') actions += '<button type="button" class="btn btn-sm btn-outline-primary" data-action="investigate" data-dispute-id="' + esc(id) + '" aria-label="Iniciar investigação de ' + esc(code) + '" title="Iniciar investigação"><i class="bi bi-search" aria-hidden="true"></i></button>';
          if (act && (st === 'OPEN' || st === 'UNDER_INVESTIGATION')) actions += '<button type="button" class="btn btn-sm btn-outline-warning" data-action="resolve" data-dispute-id="' + esc(id) + '" aria-label="Deliberar disputa ' + esc(code) + '" title="Deliberação final"><i class="bi bi-gavel" aria-hidden="true"></i></button>';
          return '<tr>' +
            '<td class="ps-4"><div class="disp-name font-monospace">' + esc(code || '—') + '</div><div class="disp-sub">ID ' + esc(id) + '</div></td>' +
            '<td><div class="disp-name">' + esc(name) + '</div></td>' +
            '<td><div class="disp-sub">' + esc(respondent) + '</div></td>' +
            '<td><span class="small">' + esc(categoryLabel(d.category)) + '</span></td>' +
            '<td><span class="small" style="color:var(--ok-text-primary);">' + esc(d.amount_contested == null ? '—' : money(d.amount_contested, d.currency)) + '</span></td>' +
            '<td>' + statusBadge(st) + '</td>' +
            '<td><span class="small" style="color:var(--ok-text-muted);">' + esc(dateFmt(d.created_at)) + '</span></td>' +
            '<td class="text-end pe-4"><div class="disp-actions">' + actions + '</div></td></tr>';
        }).join('');
      }

      function renderPagination(p) {
        const total = Number(p && (p.totalItems ?? p.totalCount));
        const cur = Number(p && (p.currentPage ?? p.page));
        const tp = Number(p && (p.totalPages ?? p.total_pages));
        if (Number.isFinite(cur) && cur > 0) page = cur;
        pages = Number.isFinite(tp) && tp > 0 ? tp : 1;
        const size = Number(p && (p.pageSize ?? p.limit)) || Number(el.limit.value) || 15;
        const first = Number.isFinite(total) && total > 0 ? (page - 1) * size + 1 : 0;
        const last = Number.isFinite(total) && total > 0 ? Math.min(page * size, total) : records.length;
        document.getElementById('disp-pagination-info').textContent = Number.isFinite(total)
          ? 'A mostrar ' + first + '–' + last + ' de ' + total + ' · Página ' + page + ' de ' + pages
          : 'Página ' + page + ' · ' + records.length + ' resultado(s)';
        const nums = Array.from(new Set([1, pages, page - 1, page, page + 1].filter(n => n >= 1 && n <= pages))).sort((a, b) => a - b);
        let html = '<li><button type="button" data-page="' + (page - 1) + '" ' + (page <= 1 ? 'disabled' : '') + ' aria-label="Página anterior"><i class="bi bi-chevron-left" aria-hidden="true"></i></button></li>';
        let prev = 0;
        nums.forEach(n => {
          if (prev && n - prev > 1) html += '<li class="text-muted px-1 align-self-center" aria-hidden="true" style="color:var(--ok-text-muted);">…</li>';
          html += '<li><button type="button" data-page="' + n + '" class="' + (n === page ? 'is-current' : '') + '" ' + (n === page ? 'aria-current="page"' : '') + '>' + n + '</button></li>';
          prev = n;
        });
        html += '<li><button type="button" data-page="' + (page + 1) + '" ' + (page >= pages ? 'disabled' : '') + ' aria-label="Página seguinte"><i class="bi bi-chevron-right" aria-hidden="true"></i></button></li>';
        el.pagination.innerHTML = html;
      }

      /* ====================================================================
         CARREGAR FILA
         ==================================================================== */
      async function loadQueue(requestPage) {
        if (!canArbitrate) {
          el.loading.classList.add('d-none');
          el.card.classList.add('d-none');
          el.error.innerHTML = '<i class="bi bi-shield-lock" aria-hidden="true"></i><strong class="d-block mb-2" style="color:var(--ok-text-primary);">Acesso reservado</strong><span>A fila de contestações está limitada a ADMIN e AUDITOR. A API aplica a mesma autorização.</span>';
          el.error.classList.remove('d-none');
          return;
        }
        if (!window.apiClient || typeof window.apiClient.get !== 'function') {
          el.loading.classList.add('d-none');
          el.card.classList.add('d-none');
          el.error.innerHTML = '<i class="bi bi-plug" aria-hidden="true"></i><strong class="d-block mb-2" style="color:var(--ok-text-primary);">Cliente da API indisponível</strong><span>Não é seguro consultar nem deliberar contestações sem o cliente autenticado da API.</span><div class="mt-3"><button type="button" class="btn btn-sm btn-ghost-ok" id="disp-retry"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Tentar novamente</button></div>';
          el.error.classList.remove('d-none');
          return;
        }
        page = requestPage || 1;
        const thisSeq = ++seq;
        clearAlert();
        el.error.classList.add('d-none');
        el.card.classList.add('d-none');
        el.loading.classList.remove('d-none');
        el.loading.innerHTML = '<span class="spinner-border spinner-border-sm me-2" style="color:var(--ok-purple-vibrant);" aria-hidden="true"></span>A carregar a fila de contestações…';
        const q = new URLSearchParams({ page: String(page), limit: String(Number(el.limit.value) || 15) });
        if (el.status.value) q.set('status', el.status.value);
        if (el.category.value) q.set('category', el.category.value);
        try {
          const response = await window.apiClient.get('/disputes/queue?' + q.toString());
          if (thisSeq !== seq) return;
          if (!response || response.success === false || !Array.isArray(response.data)) throw new Error('A API não devolveu uma fila válida.');
          records = response.data;
          render(records);
          renderPagination(response.pagination || {});
          updateSummary(records, response.pagination || {});
          el.loading.classList.add('d-none');
          el.card.classList.remove('d-none');
        } catch (error) {
          if (thisSeq !== seq) return;
          el.loading.classList.add('d-none');
          el.card.classList.add('d-none');
          el.error.innerHTML = '<i class="bi bi-exclamation-triangle" aria-hidden="true"></i><strong class="d-block mb-2" style="color:var(--ok-text-primary);">Não foi possível carregar a fila</strong><span>' + esc(errMsg(error, 'Falha de comunicação com o servidor.')) + '</span><div class="mt-3"><button type="button" class="btn btn-sm btn-ghost-ok" id="disp-retry"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Tentar novamente</button></div>';
          el.error.classList.remove('d-none');
        }
      }

      /* ====================================================================
         MODAIS
         ==================================================================== */
      function modal(id) {
        if (!window.bootstrap || !window.bootstrap.Modal) {
          alertPage('Os componentes de interface não foram inicializados. Recarregue a página antes de continuar.', 'warning');
          return null;
        }
        return window.bootstrap.Modal.getOrCreateInstance(document.getElementById(id));
      }
      function detailItem(label, value) {
        return '<div class="col-12 col-md-6"><div class="disp-detail"><span class="disp-detail-label">' + esc(label) + '</span><span class="disp-detail-value">' + esc(value == null || value === '' ? '—' : value) + '</span></div></div>';
      }

      async function showDetails(id) {
        const m = modal('modal-disp-details');
        const body = document.getElementById('disp-details-body');
        if (!m || !window.apiClient || typeof window.apiClient.get !== 'function') return;
        body.innerHTML = '<div class="disp-state-box"><span class="spinner-border spinner-border-sm" role="status" aria-label="A carregar"></span><span class="ms-2">A consultar os autos…</span></div>';
        m.show();
        try {
          const response = await window.apiClient.get('/disputes/' + encodeURIComponent(id));
          const d = response && response.data ? (response.data.dispute || response.data) : null;
          if (!d || typeof d !== 'object') throw new Error('A API não devolveu os autos da disputa.');
          const partiesConflict = conflict(d);
          const resolution = d.resolution_notes
            ? '<div class="admin-note mt-3"><i class="bi bi-journal-check" aria-hidden="true"></i><span><strong>Parecer final</strong><br>' + esc(d.resolution_notes) + '<br><span class="small">Resolvido por ' + esc(d.resolver_name || '—') + ' · ' + esc(dateFmt(d.resolved_at)) + '</span></span></div>'
            : '';
          let workflow = '';
          if (mayAct(d) && String(d.status).toUpperCase() === 'OPEN') {
            workflow = '<div class="admin-note warning mt-3"><i class="bi bi-info-circle" aria-hidden="true"></i><span>O processo pode ser colocado em investigação ou deliberado diretamente, conforme as regras da API.</span></div>';
          } else if (canArbitrate && partiesConflict) {
            workflow = '<div class="admin-note alert mt-3"><i class="bi bi-person-exclamation" aria-hidden="true"></i><span>Conflito de interesses: como membro envolvido nesta disputa, não pode conduzir a investigação nem a arbitragem.</span></div>';
          } else if (closed(d)) {
            workflow = '<div class="admin-note mt-3"><i class="bi bi-lock" aria-hidden="true"></i><span>Esta disputa está encerrada e não admite novas deliberações.</span></div>';
          }
          body.innerHTML = '<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><div class="h5 fw-bold font-monospace mb-1" style="color:var(--ok-text-primary);">' + esc(d.dispute_code || 'Contestação') + '</div><div class="d-flex flex-wrap gap-2">' + statusBadge(d.status) + '<span class="disp-badge disp-state-dismissed">' + esc(categoryLabel(d.category)) + '</span></div></div><span class="small" style="color:var(--ok-text-muted);">Aberta ' + esc(dateFmt(d.created_at)) + '</span></div>' +
            '<h3 class="mb-3" style="font-size:0.7rem;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;color:var(--ok-purple-vibrant);">Partes e referência</h3><div class="row g-2 mb-4">' +
            detailItem('Requerente', d.initiator_name) + detailItem('E-mail do requerente', d.initiator_email) + detailItem('Parte reclamada', d.respondent_name) + detailItem('E-mail da parte reclamada', d.respondent_email) + detailItem('Grupo relacionado', d.group_name) + detailItem('Montante contestado', d.amount_contested == null ? '—' : money(d.amount_contested, d.currency)) + detailItem('ID da contribuição', d.contribution_id) + detailItem('ID da transação contabilística', d.ledger_transaction_id) + detailItem('ID do processo', d.id) + '</div>' +
            '<h3 class="mb-3" style="font-size:0.7rem;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;color:var(--ok-purple-vibrant);">Relato e evidências</h3>' +
            '<div class="disp-detail mb-2"><span class="disp-detail-label">Descrição dos factos</span><div class="disp-detail-value" style="white-space:pre-wrap">' + esc(d.description || '—') + '</div></div>' +
            '<div class="disp-detail"><span class="disp-detail-label">Notas probatórias</span><div class="disp-detail-value" style="white-space:pre-wrap">' + esc(d.evidence_notes || '—') + '</div></div>' +
            workflow + resolution;
        } catch (error) {
          body.innerHTML = '<div class="alert alert-danger mb-0" role="alert">' + esc(errMsg(error, 'Falha ao consultar os autos.')) + '</div>';
        }
      }

      async function investigate(d) {
        if (!mayAct(d) || String(d.status).toUpperCase() !== 'OPEN') return alertPage('A investigação não está disponível para este utilizador ou estado.', 'warning');
        if (!await confirmAction('Iniciar investigação?', 'A contestação passará de OPEN para UNDER_INVESTIGATION.')) return;
        try {
          const res = await window.apiClient.post('/disputes/' + encodeURIComponent(d.id) + '/investigate', {});
          if (res && res.success === false) throw new Error(res.message || 'A API recusou a transição.');
          toast('Contestação encaminhada para investigação.');
          await loadQueue(page);
        } catch (e) { fail(e, 'Não foi possível iniciar a investigação.'); }
      }

      function openResolve(d) {
        if (!mayAct(d) || !['OPEN', 'UNDER_INVESTIGATION'].includes(String(d.status).toUpperCase())) return alertPage('A arbitragem não está disponível para este utilizador ou estado.', 'warning');
        document.getElementById('resolve-dispute-id').value = String(d.id);
        document.getElementById('resolve-status').value = '';
        document.getElementById('resolve-notes').value = '';
        const m = modal('modal-disp-resolve');
        if (m) m.show();
      }

      async function confirmAction(title, text) {
        if (window.Swal && typeof window.Swal.fire === 'function') {
          const r = await window.Swal.fire({ icon: 'warning', title, text, showCancelButton: true, confirmButtonText: 'Confirmar', cancelButtonText: 'Cancelar', confirmButtonColor: '#7c3aed' });
          return Boolean(r.isConfirmed);
        }
        return window.confirm(title + '\n' + text);
      }
      function toast(t) {
        if (window.Alerts && typeof window.Alerts.toast === 'function') window.Alerts.toast(t, 'success');
        else alertPage(t, 'success');
      }
      function fail(e, f) {
        const m = errMsg(e, f);
        if (window.Alerts && typeof window.Alerts.error === 'function') window.Alerts.error(m);
        else alertPage(m, 'danger');
      }

      /* ====================================================================
         EVENTOS
         ==================================================================== */
      document.getElementById('disp-filter-form').addEventListener('submit', ev => { ev.preventDefault(); loadQueue(1); });
      document.getElementById('disp-filter-form').addEventListener('reset', () => window.setTimeout(() => loadQueue(1), 0));
      document.getElementById('disp-refresh').addEventListener('click', () => loadQueue(page));
      el.pagination.addEventListener('click', ev => {
        const b = ev.target.closest('button[data-page]');
        if (!b || b.disabled) return;
        const n = Number(b.dataset.page);
        if (Number.isInteger(n) && n >= 1 && n <= pages) loadQueue(n);
      });
      el.error.addEventListener('click', ev => { if (ev.target.closest('#disp-retry')) loadQueue(page); });
      el.body.addEventListener('click', ev => {
        const b = ev.target.closest('button[data-action]');
        if (!b) return;
        const d = records.find(x => String(x.id) === String(b.dataset.disputeId));
        if (!d) return;
        if (b.dataset.action === 'details') showDetails(d.id);
        else if (b.dataset.action === 'investigate') investigate(d);
        else if (b.dataset.action === 'resolve') openResolve(d);
      });

      document.getElementById('form-disp-resolve').addEventListener('submit', async ev => {
        ev.preventDefault();
        if (!canArbitrate || !window.apiClient || typeof window.apiClient.post !== 'function') return alertPage('A API ou as permissões de arbitragem não estão disponíveis.', 'danger');
        const id = document.getElementById('resolve-dispute-id').value;
        const status = document.getElementById('resolve-status').value;
        const notes = document.getElementById('resolve-notes').value.trim();
        const d = records.find(x => String(x.id) === String(id));
        if (!d || !mayAct(d) || !['OPEN', 'UNDER_INVESTIGATION'].includes(String(d.status).toUpperCase())) return alertPage('O estado atual ou as partes envolvidas não permitem esta deliberação. Atualize a fila.', 'warning');
        if (!status || notes.length < 10 || notes.length > 2000) return alertPage('Selecione uma decisão e introduza um parecer entre 10 e 2000 caracteres.', 'warning');
        const title = status === 'RESOLVED_FAVOR_INITIATOR' ? 'Resolver a favor do requerente?' : status === 'RESOLVED_FAVOR_RESPONDENT' ? 'Resolver a favor da parte reclamada?' : 'Encerrar sem provimento?';
        if (!await confirmAction(title, 'A decisão é final e será registada com a fundamentação apresentada.')) return;
        const button = document.getElementById('resolve-submit');
        button.disabled = true;
        try {
          const res = await window.apiClient.post('/disputes/' + encodeURIComponent(id) + '/resolve', { status, resolutionNotes: notes });
          if (res && res.success === false) throw new Error(res.message || 'A API recusou a deliberação.');
          const m = window.bootstrap.Modal.getInstance(document.getElementById('modal-disp-resolve'));
          if (m) m.hide();
          toast('Deliberação registada com sucesso.');
          await loadQueue(page);
        } catch (error) {
          fail(error, 'Falha ao registar a deliberação.');
        } finally {
          button.disabled = false;
        }
      });

      document.getElementById('modal-disp-resolve').addEventListener('hidden.bs.modal', () => {
        document.getElementById('form-disp-resolve').reset();
        document.getElementById('resolve-submit').disabled = false;
      });

      /* ====================================================================
         RELÓGIO UTC + INICIALIZAÇÃO
         ==================================================================== */
      const clock = document.getElementById('admin-utc-clock');
      function updateClock() {
        if (clock) clock.textContent = new Intl.DateTimeFormat('pt-PT', { timeZone: 'UTC', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).format(new Date()) + ' UTC';
      }
      updateClock();
      window.setInterval(updateClock, 1000);

      document.addEventListener('DOMContentLoaded', () => {
        initThemeToggle();
        setupGlobalActions();
        loadQueue(1);
      });
    })();
  </script>
</body>
</html>