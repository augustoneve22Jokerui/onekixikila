  <%- include('../partials/sweet-alert') %>
  <!-- Bootstrap bundle precisa ser carregado ANTES do api-client para que
       window.bootstrap.Modal exista quando os handlers forem chamados. -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  <script src="/js/api-client.js"></script>
  <script>
    (function () {
      'use strict';

      /* ====================================================================
         TEMA CLARO/ESCURO
         ==================================================================== */
      const THEME_KEY = 'ok-theme';
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-btn');
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        if (!btn) return;
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      /* ====================================================================
         AÇÕES GLOBAIS
         ==================================================================== */
      function setupGlobalActions() {
        const sidebarToggle = document.getElementById('sidebar-toggle-btn');
        sidebarToggle?.addEventListener('click', () => {
          const active = document.body.classList.toggle('mobile-nav-active');
          sidebarToggle.setAttribute('aria-expanded', String(active));
        });
        document.querySelectorAll('.ok-rail-link[href]').forEach((link) => {
          link.addEventListener('click', () => {
            if (window.matchMedia('(max-width: 991px)').matches) {
              document.body.classList.remove('mobile-nav-active');
            }
          });
        });
        const search = document.getElementById('global-dashboard-search');
        document.addEventListener('keydown', (event) => {
          if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
            if (search) { event.preventDefault(); search.focus(); }
          }
        });
        document.querySelectorAll('[data-action="logout"]').forEach((button) => {
          button.addEventListener('click', async (event) => {
            event.preventDefault();
            button.disabled = true;
            try {
              if (window.apiClient && typeof window.apiClient.post === 'function') await window.apiClient.post('/auth/logout', {});
              if (window.apiClient && typeof window.apiClient.clearSession === 'function') window.apiClient.clearSession();
            } catch (_) {}
            window.location.href = '/login';
          });
        });
      }

      /* ====================================================================
         ESTADO E HELPERS
         ==================================================================== */
      const page = document.body;
      const actorRole = String(page.dataset.adminRole || '').toUpperCase();
      const actorId = String(page.dataset.adminUserId || '');
      const canManageRoles = actorRole === 'ADMIN';
      const canManageStatuses = actorRole === 'ADMIN' || actorRole === 'AUDITOR';

      const els = {
        loading: document.getElementById('users-loading'),
        error: document.getElementById('users-error'),
        card: document.getElementById('users-table-card'),
        body: document.getElementById('users-table-body'),
        form: document.getElementById('users-filter-form'),
        search: document.getElementById('filter-search'),
        role: document.getElementById('filter-role'),
        status: document.getElementById('filter-status'),
        limit: document.getElementById('filter-limit'),
        pagination: document.getElementById('users-pagination'),
        paginationInfo: document.getElementById('users-pagination-info'),
        totalPill: document.getElementById('users-total-pill'),
        alert: document.getElementById('users-page-alert')
      };
      let currentPage = 1;
      let totalPages = 1;
      let requestSequence = 0;
      let activeUsers = [];

      function escapeHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
      }
      function showPageAlert(message, type) {
        els.alert.className = 'alert alert-' + (type || 'danger') + ' mb-4';
        els.alert.textContent = String(message || 'Ocorreu um erro inesperado.');
        els.alert.classList.remove('d-none');
        els.alert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      function hidePageAlert() { els.alert.classList.add('d-none'); els.alert.textContent = ''; }
      function getErrorMessage(error, fallback) {
        return error && typeof error.message === 'string' && error.message.trim() ? error.message : fallback;
      }
      function setBusy(isBusy) {
        document.querySelectorAll('#form-change-role button[type="submit"], #form-change-status button[type="submit"], #users-refresh-btn, #users-filter-form button[type="submit"]').forEach(button => {
          button.disabled = Boolean(isBusy);
        });
      }
      function formatDate(value) {
        if (!value) return '—';
        if (window.App && typeof window.App.formatDate === 'function') {
          try { return window.App.formatDate(value, false); } catch (_) {}
        }
        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? '—' : new Intl.DateTimeFormat('pt-PT', { dateStyle: 'medium' }).format(date);
      }
      function formatMoney(value) {
        const number = Number(value || 0);
        if (!Number.isFinite(number)) return '—';
        if (window.App && typeof window.App.formatMoney === 'function') {
          try { return window.App.formatMoney(number); } catch (_) {}
        }
        return new Intl.NumberFormat('pt-PT', { style: 'currency', currency: 'AOA', maximumFractionDigits: 2 }).format(number);
      }

      const roleNames = {
        ADMIN: 'Administrador', AUDITOR: 'Auditor', SUPPORT_AGENT: 'Suporte',
        FINANCIAL_OPERATOR: 'Operador financeiro', GROUP_LEADER: 'Líder de grupo',
        MODERATOR: 'Moderador', MEMBER: 'Membro', USER: 'Utilizador'
      };
      function roleBadge(role) {
        const value = String(role || 'USER').toUpperCase();
        let kind = 'role-neutral';
        if (value === 'ADMIN') kind = 'role-admin';
        else if (value === 'AUDITOR') kind = 'role-auditor';
        else if (value === 'SUPPORT_AGENT') kind = 'role-support';
        else if (value === 'FINANCIAL_OPERATOR') kind = 'role-finance';
        else if (value === 'GROUP_LEADER') kind = 'role-leader';
        else if (value === 'MEMBER') kind = 'role-member';
        return '<span class="user-badge ' + kind + '" title="' + escapeHtml(value) + '">' + escapeHtml(roleNames[value] || value) + '</span>';
      }
      function statusBadge(status) {
        const value = String(status || 'UNKNOWN').toUpperCase();
        const labels = { ACTIVE: 'Ativa', PENDING_VERIFICATION: 'Pendente', SUSPENDED: 'Suspensa', BLOCKED: 'Bloqueada', DEACTIVATED: 'Desativada' };
        const kinds = { ACTIVE: 'state-active', PENDING_VERIFICATION: 'state-pending', SUSPENDED: 'state-suspended', BLOCKED: 'state-blocked', DEACTIVATED: 'state-other' };
        return '<span class="user-badge ' + (kinds[value] || 'state-other') + '" title="' + escapeHtml(value) + '">' + escapeHtml(labels[value] || value) + '</span>';
      }
      function kycBadge(tier) {
        const value = String(tier || 'TIER_1_UNVERIFIED').toUpperCase();
        let label = 'Nível básico';
        let kind = 'kyc-neutral';
        if (value === 'TIER_2_VERIFIED') { label = 'Nível 2 · Verificado'; kind = 'kyc-verified'; }
        else if (value === 'TIER_3_ENHANCED') { label = 'Nível 3 · Avançado'; kind = 'kyc-verified'; }
        else if (value !== 'TIER_1_UNVERIFIED') label = value;
        return '<span class="user-badge ' + kind + '" title="' + escapeHtml(value) + '">' + escapeHtml(label) + '</span>';
      }

      function updateSummary(users, pagination) {
        const total = Number(pagination && (pagination.totalItems ?? pagination.totalCount));
        document.getElementById('stat-total').textContent = Number.isFinite(total) ? String(total) : String(users.length);
        document.getElementById('stat-pending').textContent = String(users.filter(u => u.status === 'PENDING_VERIFICATION').length);
        document.getElementById('stat-active').textContent = String(users.filter(u => u.status === 'ACTIVE').length);
        document.getElementById('stat-restricted').textContent = String(users.filter(u => ['SUSPENDED', 'BLOCKED', 'DEACTIVATED'].includes(u.status)).length);
        els.totalPill.textContent = (Number.isFinite(total) ? total : users.length) + ' resultado(s)';
      }

      function renderUsers(users) {
        if (!Array.isArray(users) || users.length === 0) {
          els.body.innerHTML = '<tr><td colspan="7"><div class="users-state-box m-3"><i class="bi bi-person-x" aria-hidden="true"></i><strong class="d-block mb-1" style="color:var(--ok-text-primary);">Nenhuma conta encontrada</strong><span>Altere os filtros ou limpe a pesquisa para tentar novamente.</span></div></td></tr>';
          return;
        }
        els.body.innerHTML = users.map(u => {
          const id = String(u.id || '');
          const name = String(u.full_name || u.preferred_name || 'Utilizador sem nome');
          const email = String(u.email || '—');
          const phone = String(u.phone_number || '—');
          const isSelf = Boolean(actorId && id === actorId);
          let actions = '<button type="button" class="btn btn-sm btn-outline-info" data-action="details" data-user-id="' + escapeHtml(id) + '" aria-label="Ver ficha de ' + escapeHtml(name) + '" title="Ver ficha técnica"><i class="bi bi-person-lines-fill" aria-hidden="true"></i></button>';
          if (canManageRoles && !isSelf) actions += '<button type="button" class="btn btn-sm btn-outline-primary" data-action="role" data-user-id="' + escapeHtml(id) + '" data-user-role="' + escapeHtml(u.role || 'USER') + '" aria-label="Alterar papel de ' + escapeHtml(name) + '" title="Alterar papel"><i class="bi bi-award" aria-hidden="true"></i></button>';
          if (canManageStatuses && !isSelf && u.status === 'PENDING_VERIFICATION') actions += '<button type="button" class="btn btn-sm btn-outline-success" data-action="approve" data-user-id="' + escapeHtml(id) + '" aria-label="Ativar conta pendente de ' + escapeHtml(name) + '" title="Ativar conta pendente"><i class="bi bi-check-lg" aria-hidden="true"></i></button>';
          if (canManageStatuses && !isSelf) actions += '<button type="button" class="btn btn-sm btn-outline-warning" data-action="status" data-user-id="' + escapeHtml(id) + '" data-user-status="' + escapeHtml(u.status || 'ACTIVE') + '" aria-label="Alterar estado de ' + escapeHtml(name) + '" title="Alterar estado operacional"><i class="bi bi-shield-exclamation" aria-hidden="true"></i></button>';
          return '<tr>' +
            '<td class="ps-4"><div class="d-flex align-items-center gap-3"><span class="user-avatar" aria-hidden="true">' + escapeHtml(name.trim().charAt(0).toUpperCase() || 'U') + '</span><div><div class="user-name">' + escapeHtml(name) + (isSelf ? ' <span class="text-muted small">(a sua conta)</span>' : '') + '</div><div class="user-subtext">' + escapeHtml(email) + '</div></div></div></td>' +
            '<td><span class="small font-monospace">' + escapeHtml(phone) + '</span><div class="user-subtext">' + (u.is_email_verified ? '<span style="color:var(--ok-accent-emerald);">E-mail verificado</span>' : '<span>E-mail não verificado</span>') + '</div></td>' +
            '<td>' + kycBadge(u.identity_tier) + '</td><td>' + roleBadge(u.role) + '</td><td>' + statusBadge(u.status) + '</td>' +
            '<td><span class="small" style="color:var(--ok-text-muted);">' + escapeHtml(formatDate(u.created_at)) + '</span></td>' +
            '<td class="text-end pe-4"><div class="users-actions">' + actions + '</div></td></tr>';
        }).join('');
      }

      function renderPagination(pagination) {
        const pageValue = Number(pagination && pagination.page);
        const pagesValue = Number(pagination && (pagination.totalPages ?? pagination.total_pages));
        currentPage = Number.isFinite(pageValue) && pageValue > 0 ? pageValue : currentPage;
        totalPages = Number.isFinite(pagesValue) && pagesValue > 0 ? pagesValue : 1;
        const total = Number(pagination && (pagination.totalItems ?? pagination.totalCount));
        const limit = Number(els.limit.value) || 15;
        const first = total > 0 ? (currentPage - 1) * limit + 1 : 0;
        const last = total > 0 ? Math.min(currentPage * limit, total) : 0;
        els.paginationInfo.textContent = totalPages > 1 ? ('A mostrar ' + first + '–' + last + ' de ' + total + ' · Página ' + currentPage + ' de ' + totalPages) : (total > 0 ? ('A mostrar ' + first + '–' + last + ' de ' + total + ' conta(s)') : 'Sem resultados');
        const pages = new Set([1, totalPages, currentPage - 1, currentPage, currentPage + 1].filter(n => n >= 1 && n <= totalPages));
        const sorted = Array.from(pages).sort((a, b) => a - b);
        let html = '<li><button type="button" data-page="' + (currentPage - 1) + '" ' + (currentPage <= 1 ? 'disabled' : '') + ' aria-label="Página anterior"><i class="bi bi-chevron-left" aria-hidden="true"></i></button></li>';
        let previous = 0;
        sorted.forEach(p => {
          if (previous && p - previous > 1) html += '<li class="text-muted px-1 align-self-center" aria-hidden="true" style="color:var(--ok-text-muted);">…</li>';
          html += '<li><button type="button" data-page="' + p + '" class="' + (p === currentPage ? 'is-current' : '') + '" ' + (p === currentPage ? 'aria-current="page"' : '') + '>' + p + '</button></li>';
          previous = p;
        });
        html += '<li><button type="button" data-page="' + (currentPage + 1) + '" ' + (currentPage >= totalPages ? 'disabled' : '') + ' aria-label="Página seguinte"><i class="bi bi-chevron-right" aria-hidden="true"></i></button></li>';
        els.pagination.innerHTML = html;
      }

      async function loadUsers(pageNumber) {
        if (!window.apiClient || typeof window.apiClient.get !== 'function') {
          els.loading.classList.add('d-none');
          els.card.classList.add('d-none');
          els.error.innerHTML = '<i class="bi bi-plug" aria-hidden="true"></i><strong class="d-block mb-2" style="color:var(--ok-text-primary);">Cliente da API indisponível</strong><span>Não é seguro carregar ou alterar contas sem o cliente da API. Recarregue a página; se o problema persistir, contacte o suporte técnico.</span><div class="mt-3"><button type="button" class="btn btn-sm btn-ghost-ok" id="users-retry-btn"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Tentar novamente</button></div>';
          els.error.classList.remove('d-none');
          return;
        }
        const sequence = ++requestSequence;
        currentPage = pageNumber || 1;
        hidePageAlert();
        els.error.classList.add('d-none');
        els.card.classList.add('d-none');
        els.loading.classList.remove('d-none');
        els.loading.innerHTML = '<span class="spinner-border spinner-border-sm me-2" style="color:var(--ok-purple-vibrant);" aria-hidden="true"></span>A carregar diretório de utilizadores…';
        const params = new URLSearchParams({ page: String(currentPage), limit: String(Number(els.limit.value) || 15) });
        const search = els.search.value.trim();
        if (search) params.set('search', search);
        if (els.role.value) params.set('role', els.role.value);
        if (els.status.value) params.set('status', els.status.value);
        try {
          const response = await window.apiClient.get('/users?' + params.toString());
          if (sequence !== requestSequence) return;
          if (!response || response.success === false || !Array.isArray(response.data)) throw new Error('A resposta da API não contém uma lista válida de utilizadores.');
          const users = response.data;
          const pagination = response.pagination || {};
          activeUsers = users;
          renderUsers(users);
          renderPagination(pagination);
          updateSummary(users, pagination);
          els.loading.classList.add('d-none');
          els.error.classList.add('d-none');
          els.card.classList.remove('d-none');
        } catch (error) {
          if (sequence !== requestSequence) return;
          els.loading.classList.add('d-none');
          els.card.classList.add('d-none');
          els.error.innerHTML = '<i class="bi bi-exclamation-triangle" aria-hidden="true"></i><strong class="d-block mb-2" style="color:var(--ok-text-primary);">Não foi possível carregar as contas</strong><span>' + escapeHtml(getErrorMessage(error, 'Falha de comunicação com o servidor.')) + '</span><div class="mt-3"><button type="button" class="btn btn-sm btn-ghost-ok" id="users-retry-btn"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Tentar novamente</button></div>';
          els.error.classList.remove('d-none');
        }
      }

      function getModal(id) {
        if (!window.bootstrap || !window.bootstrap.Modal) {
          showPageAlert('Os componentes de interface não foram inicializados. Recarregue a página antes de continuar.', 'warning');
          return null;
        }
        const node = document.getElementById(id);
        return node ? window.bootstrap.Modal.getOrCreateInstance(node) : null;
      }
      function fieldItem(label, value, opts) {
        const o = opts || {};
        return '<div class="user-detail-box"><span class="user-detail-label">' + escapeHtml(label) + '</span><span class="user-detail-value' + (o.mono ? ' mono' : '') + '">' + escapeHtml(value == null || value === '' ? '—' : value) + '</span></div>';
      }
      function detailItem(label, value) { return '<div class="col-12 col-md-6">' + fieldItem(label, value) + '</div>'; }

      /* ====================================================================
         WIZARDS — CONTROLE DE ETAPAS
         ==================================================================== */
      let detailStep = 1; const detailStepCount = 3;
      function setDetailStep(step) {
        detailStep = Math.max(1, Math.min(detailStepCount, step));
        document.querySelectorAll('#modal-user-details .users-pane').forEach(p => {
          p.classList.toggle('active', Number(p.dataset.pane) === detailStep);
        });
        const timeline = document.getElementById('details-timeline');
        if (timeline) {
          timeline.querySelectorAll('.users-step').forEach(el => {
            const n = Number(el.dataset.step);
            el.classList.toggle('active', n === detailStep);
            el.classList.toggle('done', n < detailStep);
          });
          timeline.querySelectorAll('.users-step-sep').forEach(el => {
            const n = Number(el.dataset.sep);
            el.classList.toggle('done', n < detailStep);
          });
        }
        const cur = document.getElementById('details-step-current');
        if (cur) cur.textContent = String(detailStep);
        const prev = document.getElementById('details-prev-btn');
        const next = document.getElementById('details-next-btn');
        if (prev) prev.disabled = detailStep <= 1;
        if (next) next.classList.toggle('d-none', detailStep >= detailStepCount);
      }

      let roleStep = 1; const roleStepCount = 3;
      function setRoleStep(step) {
        roleStep = Math.max(1, Math.min(roleStepCount, step));
        document.querySelectorAll('#modal-change-role .users-pane').forEach(p => {
          p.classList.toggle('active', Number(p.dataset.pane) === roleStep);
        });
        const timeline = document.getElementById('role-timeline');
        if (timeline) {
          timeline.querySelectorAll('.users-step').forEach(el => {
            const n = Number(el.dataset.step);
            el.classList.toggle('active', n === roleStep);
            el.classList.toggle('done', n < roleStep);
          });
          timeline.querySelectorAll('.users-step-sep').forEach(el => {
            const n = Number(el.dataset.sep);
            el.classList.toggle('done', n < roleStep);
          });
        }
        const cur = document.getElementById('role-step-current');
        if (cur) cur.textContent = String(roleStep);
        const prev = document.getElementById('role-prev-btn');
        const next = document.getElementById('role-next-btn');
        const submit = document.getElementById('role-submit-btn');
        if (prev) prev.disabled = roleStep <= 1;
        if (next) next.classList.toggle('d-none', roleStep >= roleStepCount);
        if (submit) submit.classList.toggle('d-none', roleStep < roleStepCount);
        if (roleStep === 2) buildRoleContext();
        if (roleStep === 3) buildRoleConfirm();
      }
      function buildRoleContext() {
        const id = document.getElementById('role-target-user-id').value;
        const u = activeUsers.find(x => String(x.id) === String(id));
        const newRole = document.getElementById('role-select').value;
        document.getElementById('role-context-name').textContent = u ? (u.full_name || u.preferred_name || u.email || id) : id;
        document.getElementById('role-context-current').textContent = u ? (roleNames[u.role] || u.role || '—') : '—';
        document.getElementById('role-context-new').textContent = roleNames[newRole] || newRole;
      }
      function buildRoleConfirm() {
        const id = document.getElementById('role-target-user-id').value;
        const u = activeUsers.find(x => String(x.id) === String(id));
        const newRole = document.getElementById('role-select').value;
        document.getElementById('role-confirm-name').textContent = u ? (u.full_name || u.preferred_name || u.email || id) : id;
        document.getElementById('role-confirm-role').textContent = roleNames[newRole] || newRole;
      }

      let statusStep = 1; const statusStepCount = 3;
      function setStatusStep(step) {
        statusStep = Math.max(1, Math.min(statusStepCount, step));
        document.querySelectorAll('#modal-change-status .users-pane').forEach(p => {
          p.classList.toggle('active', Number(p.dataset.pane) === statusStep);
        });
        const timeline = document.getElementById('status-timeline');
        if (timeline) {
          timeline.querySelectorAll('.users-step').forEach(el => {
            const n = Number(el.dataset.step);
            el.classList.toggle('active', n === statusStep);
            el.classList.toggle('done', n < statusStep);
          });
          timeline.querySelectorAll('.users-step-sep').forEach(el => {
            const n = Number(el.dataset.sep);
            el.classList.toggle('done', n < statusStep);
          });
        }
        const cur = document.getElementById('status-step-current');
        if (cur) cur.textContent = String(statusStep);
        const prev = document.getElementById('status-prev-btn');
        const next = document.getElementById('status-next-btn');
        const submit = document.getElementById('status-submit-btn');
        if (prev) prev.disabled = statusStep <= 1;
        if (next) next.classList.toggle('d-none', statusStep >= statusStepCount);
        if (submit) submit.classList.toggle('d-none', statusStep < statusStepCount);
        if (statusStep === statusStepCount) buildStatusConfirm();
      }
      function buildStatusConfirm() {
        const id = document.getElementById('status-target-user-id').value;
        const u = activeUsers.find(x => String(x.id) === String(id));
        const newStatus = document.getElementById('status-select').value;
        const labels = { ACTIVE: 'Ativa', PENDING_VERIFICATION: 'Pendente', SUSPENDED: 'Suspensa', BLOCKED: 'Bloqueada', DEACTIVATED: 'Desativada' };
        document.getElementById('status-confirm-name').textContent = u ? (u.full_name || u.preferred_name || u.email || id) : id;
        document.getElementById('status-confirm-from').textContent = u ? (labels[u.status] || u.status || '—') : '—';
        document.getElementById('status-confirm-to').textContent = labels[newStatus] || newStatus;
        document.getElementById('status-confirm-reason').textContent = document.getElementById('status-reason-text').value.trim() || '—';
      }

      /* ====================================================================
         ABRIR DETALHES
         ==================================================================== */
      async function showUserDetails(userId) {
        const modal = getModal('modal-user-details');
        const body = document.getElementById('modal-user-details-body');
        if (!modal || !window.apiClient || typeof window.apiClient.get !== 'function') return;
        setDetailStep(1);
        body.innerHTML = '<div class="users-state-box"><span class="spinner-border spinner-border-sm" role="status" aria-label="A carregar"></span><span class="ms-2">A consultar ficha técnica…</span></div>';
        modal.show();
        try {
          const response = await window.apiClient.get('/admin/users/' + encodeURIComponent(userId));
          const u = response && response.data ? (response.data.user || response.data) : null;
          if (!u || typeof u !== 'object') throw new Error('A API não devolveu uma ficha de utilizador válida.');
          const name = u.full_name || u.fullName || u.preferred_name || 'Utilizador';

          const pane1 = '<div class="users-header-summary"><div class="avatar">' + escapeHtml(String(name).trim().charAt(0).toUpperCase() || 'U') + '</div><div class="info"><p class="name">' + escapeHtml(name) + '</p><p class="sub">' + escapeHtml(u.email || '—') + '</p><div class="badges">' + roleBadge(u.role) + statusBadge(u.status) + kycBadge(u.identity_tier) + '</div></div></div>' +
            '<p class="users-pane-title">Identificação</p>' +
            '<div class="users-field-grid">' +
              fieldItem('Nome completo', u.full_name) +
              fieldItem('Nome preferido', u.preferred_name) +
              fieldItem('E-mail', u.email) +
              fieldItem('E-mail verificado', u.is_email_verified ? 'Sim' : 'Não') +
              fieldItem('Telefone', u.phone_number || u.phoneNumber) +
              fieldItem('Telefone verificado', u.is_phone_verified ? 'Sim' : 'Não') +
              fieldItem('Género', u.gender) +
              fieldItem('Data de nascimento', formatDate(u.date_of_birth)) +
            '</div>';

          const pane2 = '<p class="users-pane-title">Contacto e localização</p>' +
            '<div class="users-field-grid">' +
              fieldItem('Província', u.province) +
              fieldItem('Município', u.municipality) +
              fieldItem('Bairro', u.neighborhood) +
              fieldItem('Endereço', u.address_line) +
              fieldItem('Código postal', u.postal_code) +
              fieldItem('Idioma preferido', u.preferred_language) +
            '</div>' +
            '<p class="users-pane-title" style="margin-top:1rem;">Segurança e sessões</p>' +
            '<div class="users-field-grid">' +
              fieldItem('Tentativas falhadas', u.failed_login_attempts ?? 0) +
              fieldItem('Bloqueio até', formatDate(u.locked_until)) +
              fieldItem('Último acesso', formatDate(u.last_login_at)) +
              fieldItem('Último IP', u.last_login_ip) +
              fieldItem('Sessões ativas', u.active_sessions_count ?? 0) +
              fieldItem('Dispositivos registados', u.registered_devices_count ?? 0) +
            '</div>';

          const pane3 = '<p class="users-pane-title">Estado operacional e financeiro</p>' +
            '<div class="users-field-grid">' +
              fieldItem('Estado da conta', u.status) +
              fieldItem('Papel global', u.role) +
              fieldItem('Identidade (KYC)', u.identity_status || u.identity_tier) +
              fieldItem('Grupos ativos', u.active_groups_count ?? 0) +
              fieldItem('Estado da carteira', u.wallet_status) +
              fieldItem('Saldo contabilístico', formatMoney(u.ledger_balance)) +
              fieldItem('Saldo disponível', formatMoney(u.available_balance)) +
              fieldItem('Saldo retido', formatMoney(u.locked_balance)) +
              fieldItem('Criada em', formatDate(u.created_at)) +
              fieldItem('Atualizada em', formatDate(u.updated_at)) +
              fieldItem('Termos aceites em', formatDate(u.terms_accepted_at)) +
              fieldItem('ID do utilizador', u.id, { mono: true }) +
            '</div>';

          body.innerHTML =
            '<div class="users-pane active" data-pane="1">' + pane1 + '</div>' +
            '<div class="users-pane" data-pane="2">' + pane2 + '</div>' +
            '<div class="users-pane" data-pane="3">' + pane3 + '</div>';
          setDetailStep(1);
        } catch (error) {
          body.innerHTML = '<div class="alert alert-danger mb-0" role="alert">' + escapeHtml(getErrorMessage(error, 'Falha ao consultar a ficha técnica.')) + '</div>';
        }
      }

      /* ====================================================================
         ABRIR PAPEL / ESTADO
         ==================================================================== */
      function openRoleModal(userId, currentRole) {
        if (!canManageRoles) return showPageAlert('A alteração de papéis globais está reservada a ADMIN.', 'warning');
        document.getElementById('role-target-user-id').value = userId;
        document.getElementById('role-select').value = currentRole || 'USER';
        const u = activeUsers.find(x => String(x.id) === String(userId));
        const grid = document.getElementById('role-context-grid');
        if (grid) {
          grid.innerHTML = u ? [
            fieldItem('Utilizador', u.full_name || u.preferred_name || u.email),
            fieldItem('Papel atual', roleNames[u.role] || u.role || '—'),
            fieldItem('Estado da conta', u.status),
            fieldItem('Identidade', u.identity_tier)
          ].join('') : fieldItem('Utilizador', userId);
        }
        setRoleStep(1);
        const modal = getModal('modal-change-role');
        if (modal) modal.show();
      }
      function openStatusModal(userId, currentStatus, approve) {
        if (!canManageStatuses) return showPageAlert('A alteração do estado exige privilégios de ADMIN ou AUDITOR.', 'warning');
        document.getElementById('status-target-user-id').value = userId;
        document.getElementById('status-select').value = approve ? 'ACTIVE' : (currentStatus || 'ACTIVE');
        document.getElementById('status-reason-text').value = '';
        document.getElementById('status-approval-note').classList.toggle('d-none', !approve);
        const u = activeUsers.find(x => String(x.id) === String(userId));
        const grid = document.getElementById('status-current-grid');
        if (grid) {
          const labels = { ACTIVE: 'Ativa', PENDING_VERIFICATION: 'Pendente', SUSPENDED: 'Suspensa', BLOCKED: 'Bloqueada', DEACTIVATED: 'Desativada' };
          grid.innerHTML = u ? [
            fieldItem('Utilizador', u.full_name || u.preferred_name || u.email),
            fieldItem('Estado atual', labels[u.status] || u.status || '—'),
            fieldItem('Papel', roleNames[u.role] || u.role || '—'),
            fieldItem('Identidade', u.identity_tier)
          ].join('') : fieldItem('Utilizador', userId);
        }
        setStatusStep(1);
        const modal = getModal('modal-change-status');
        if (modal) modal.show();
      }

      function notifySuccess(message) {
        if (window.Alerts && typeof window.Alerts.toast === 'function') window.Alerts.toast(message, 'success');
        else if (window.Swal && typeof window.Swal.fire === 'function') window.Swal.fire({ icon: 'success', title: 'Concluído', text: message, timer: 2200, showConfirmButton: false });
        else showPageAlert(message, 'success');
      }
      function notifyError(message) {
        if (window.Alerts && typeof window.Alerts.error === 'function') window.Alerts.error(message);
        else if (window.Swal && typeof window.Swal.fire === 'function') window.Swal.fire({ icon: 'error', title: 'Não foi possível concluir', text: message });
        else showPageAlert(message, 'danger');
      }

      /* ====================================================================
         EVENTOS
         ==================================================================== */
      document.getElementById('users-filter-form').addEventListener('submit', ev => { ev.preventDefault(); loadUsers(1); });
      document.getElementById('users-filter-form').addEventListener('reset', () => window.setTimeout(() => loadUsers(1), 0));
      document.getElementById('users-refresh-btn').addEventListener('click', () => loadUsers(currentPage));
      document.getElementById('users-pagination').addEventListener('click', ev => {
        const button = ev.target.closest('button[data-page]');
        if (!button || button.disabled) return;
        const requestedPage = Number(button.dataset.page);
        if (Number.isInteger(requestedPage) && requestedPage >= 1 && requestedPage <= totalPages) loadUsers(requestedPage);
      });
      document.getElementById('users-table-body').addEventListener('click', ev => {
        const button = ev.target.closest('button[data-action]');
        if (!button) return;
        const id = button.dataset.userId;
        const user = activeUsers.find(entry => String(entry.id) === String(id));
        if (!id || !user) return;
        if (button.dataset.action === 'details') showUserDetails(id);
        else if (button.dataset.action === 'role') openRoleModal(id, button.dataset.userRole);
        else if (button.dataset.action === 'status') openStatusModal(id, button.dataset.userStatus, false);
        else if (button.dataset.action === 'approve') openStatusModal(id, 'ACTIVE', true);
      });
      document.getElementById('users-error').addEventListener('click', ev => { if (ev.target.closest('#users-retry-btn')) loadUsers(currentPage); });

      document.getElementById('details-prev-btn').addEventListener('click', () => setDetailStep(detailStep - 1));
      document.getElementById('details-next-btn').addEventListener('click', () => setDetailStep(detailStep + 1));

      document.getElementById('role-prev-btn').addEventListener('click', () => setRoleStep(roleStep - 1));
      document.getElementById('role-next-btn').addEventListener('click', () => {
        if (roleStep === 1) {
          const r = document.getElementById('role-select').value;
          if (!r) { showPageAlert('Selecione um novo papel antes de avançar.', 'warning'); return; }
        }
        setRoleStep(roleStep + 1);
      });
      document.getElementById('role-select').addEventListener('change', () => {
        if (roleStep === 2) buildRoleContext();
        if (roleStep === 3) buildRoleConfirm();
      });

      document.getElementById('status-prev-btn').addEventListener('click', () => setStatusStep(statusStep - 1));
      document.getElementById('status-next-btn').addEventListener('click', () => {
        if (statusStep === 1) {
          const s = document.getElementById('status-select').value;
          if (!s) { showPageAlert('Selecione um novo estado antes de avançar.', 'warning'); return; }
        }
        if (statusStep === 2) {
          const r = document.getElementById('status-reason-text').value.trim();
          if (r.length < 5 || r.length > 255) { showPageAlert('Indique uma justificação entre 5 e 255 caracteres.', 'warning'); return; }
        }
        setStatusStep(statusStep + 1);
      });
      document.getElementById('status-reason-text').addEventListener('input', () => {
        if (statusStep === 3) buildStatusConfirm();
      });
      document.getElementById('status-select').addEventListener('change', () => {
        if (statusStep === 3) buildStatusConfirm();
      });

      document.getElementById('modal-change-role').addEventListener('hidden.bs.modal', () => { document.getElementById('form-change-role').reset(); setRoleStep(1); });
      document.getElementById('modal-change-status').addEventListener('hidden.bs.modal', () => { document.getElementById('form-change-status').reset(); document.getElementById('status-approval-note').classList.add('d-none'); setStatusStep(1); });
      document.getElementById('modal-user-details').addEventListener('hidden.bs.modal', () => setDetailStep(1));

      document.getElementById('form-change-role').addEventListener('submit', async ev => {
        ev.preventDefault();
        if (!canManageRoles || !window.apiClient || typeof window.apiClient.patch !== 'function') return showPageAlert('A API ou a permissão necessária não está disponível. Ação cancelada.', 'danger');
        const userId = document.getElementById('role-target-user-id').value;
        const role = document.getElementById('role-select').value;
        if (!userId || !role) return;
        setBusy(true);
        try {
          const result = await window.apiClient.patch('/admin/users/' + encodeURIComponent(userId) + '/role', { role });
          if (result && result.success === false) throw new Error(result.message || 'A API recusou a alteração do papel.');
          const modal = window.bootstrap.Modal.getInstance(document.getElementById('modal-change-role'));
          if (modal) modal.hide();
          notifySuccess('Papel global atualizado com sucesso.');
          await loadUsers(currentPage);
        } catch (error) { notifyError(getErrorMessage(error, 'Falha ao alterar o papel.')); }
        finally { setBusy(false); }
      });

      document.getElementById('form-change-status').addEventListener('submit', async ev => {
        ev.preventDefault();
        if (!canManageStatuses || !window.apiClient || typeof window.apiClient.patch !== 'function') return showPageAlert('A API ou a permissão necessária não está disponível. Ação cancelada.', 'danger');
        const userId = document.getElementById('status-target-user-id').value;
        const status = document.getElementById('status-select').value;
        const reason = document.getElementById('status-reason-text').value.trim();
        if (!userId || !status || reason.length < 5 || reason.length > 255) return showPageAlert('Indique uma justificação entre 5 e 255 caracteres.', 'warning');
        const pendingApproval = activeUsers.some(u => String(u.id) === String(userId) && u.status === 'PENDING_VERIFICATION');
        if (pendingApproval && status === 'ACTIVE' && window.Swal && typeof window.Swal.fire === 'function') {
          const confirmation = await window.Swal.fire({ icon: 'question', title: 'Ativar esta conta?', text: 'Apenas o estado operacional será alterado. Esta ação não aprova a verificação KYC.', showCancelButton: true, confirmButtonText: 'Sim, ativar', cancelButtonText: 'Cancelar', confirmButtonColor: '#7c3aed' });
          if (!confirmation.isConfirmed) return;
        }
        setBusy(true);
        try {
          const result = await window.apiClient.patch('/admin/users/' + encodeURIComponent(userId) + '/status', { status, reason });
          if (result && result.success === false) throw new Error(result.message || 'A API recusou a alteração do estado.');
          const modal = window.bootstrap.Modal.getInstance(document.getElementById('modal-change-status'));
          if (modal) modal.hide();
          notifySuccess(status === 'ACTIVE' && pendingApproval ? 'Conta ativada. A revisão de identidade KYC permanece independente.' : 'Estado operacional atualizado com sucesso.');
          await loadUsers(currentPage);
        } catch (error) { notifyError(getErrorMessage(error, 'Falha ao alterar o estado operacional.')); }
        finally { setBusy(false); }
      });

      /* ====================================================================
         RELÓGIO UTC + INICIALIZAÇÃO
         ==================================================================== */
      function updateUtcClock() {
        const clock = document.getElementById('admin-utc-clock');
        if (clock) clock.textContent = new Intl.DateTimeFormat('pt-PT', { timeZone: 'UTC', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).format(new Date()) + ' UTC';
      }
      updateUtcClock();
      window.setInterval(updateUtcClock, 1000);

      document.addEventListener('DOMContentLoaded', () => {
        initThemeToggle();
        setupGlobalActions();
        loadUsers(1);
      });
    })();
  </script>
</body>
</html>