  .users-modal .btn-close:hover { opacity: 1; background: var(--ok-pill-bg); }
  .users-modal .btn-close:hover::before { color: var(--ok-text-primary); }
  html[data-theme="light"] .users-modal .btn-close { filter: none; }
  html[data-theme="light"] .users-modal .btn-close::before { color: var(--ok-text-muted); }
  html[data-theme="light"] .users-modal .btn-close:hover::before { color: var(--ok-text-primary); }

  .users-modal .modal-body {
