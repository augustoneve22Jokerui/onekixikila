<%- include('../partials/head') %>
<%
  const adminUser = (typeof user !== 'undefined' && user) ? user : {};
  const adminUserName = adminUser.fullName || adminUser.full_name || 'Administrador';
  const adminRoleForPage = String(adminUser.role || '').toUpperCase();
  const adminIdForPage = String(adminUser.id || '');
  const canAccessAdminPage = (...roles) => roles.includes(adminRoleForPage);
  const canViewAuditTrail = canAccessAdminPage('ADMIN', 'AUDITOR');
  const adminDisplayName = adminUserName || 'Administrador';
%>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700;800&display=swap" rel="stylesheet">

<style>
  /* =========================================================================
     ONEKIXIKILA ADMIN — UTILIZADORES · ULTRA APPLE LIGHT EDITION
     Paleta dupla (dark/light), superfícies em camadas, sombras difusas,
     cantos suaves, timeline multi-etapa nos modais, conteúdo centralizado.
     ========================================================================= */
  :root,
  html[data-theme="dark"] {
    --ok-color-token-001: rgba(124, 58, 237, 0.14);
    --ok-color-token-002: rgba(5, 5, 8, 0);
    --ok-color-token-003: rgba(124, 58, 237, 0.10);
    --ok-color-token-004: rgba(244, 245, 249, 0);
    --ok-color-token-005: #7c3aed;
    --ok-color-token-006: #4c1d95;
    --ok-color-token-007: rgba(124, 58, 237, 0.4);
    --ok-color-token-008: #8b5cf6;
    --ok-color-token-009: #6d28d9;
    --ok-color-token-010: #ffffff;
    --ok-color-token-011: rgba(139, 92, 246, 0.5);
    --ok-color-token-012: #ef4444;
    --ok-color-token-013: #fff;
    --ok-color-token-014: #c084fc;
    --ok-color-token-015: rgba(16, 185, 129, 0.15);
    --ok-color-token-016: rgba(16, 185, 129, 0.3);
    --ok-color-token-017: #10b981;
    --ok-color-token-018: #0f172a;
    --ok-color-token-019: #bef264;
    --ok-color-token-020: rgba(0,0,0,0.08);
    --ok-color-token-021: rgba(255,255,255,0.15);
    --ok-color-token-022: rgba(245, 158, 11, 0.15);
    --ok-color-token-023: #f59e0b;
    --ok-color-token-024: rgba(244, 63, 94, 0.15);
    --ok-color-token-025: #f43f5e;
    --ok-color-token-026: rgba(6, 182, 212, 0.15);
    --ok-color-token-027: #06b6d4;
    --ok-color-token-028: rgba(6, 182, 212, 0.08);
    --ok-color-token-029: rgba(6, 182, 212, 0.22);
    --ok-color-token-030: #b6e7ee;
    --ok-color-token-031: #67e8f9;
    --ok-color-token-032: rgba(139, 92, 246, 0.35);
    --ok-color-token-033: rgba(255, 255, 255, 0.02);
    --ok-color-token-034: rgba(139, 92, 246, 0.28);
    --ok-color-token-035: rgba(6, 182, 212, 0.14);
    --ok-color-token-036: #ddd6fe;
    --ok-color-token-037: rgba(6, 182, 212, 0.12);
    --ok-color-token-038: rgba(6, 182, 212, 0.25);
    --ok-color-token-039: rgba(245, 158, 11, 0.12);
    --ok-color-token-040: rgba(245, 158, 11, 0.25);
    --ok-color-token-041: #fcd34d;
    --ok-color-token-042: rgba(16, 185, 129, 0.12);
    --ok-color-token-043: rgba(16, 185, 129, 0.25);
    --ok-color-token-044: #6ee7b7;
    --ok-color-token-045: rgba(244, 63, 94, 0.12);
    --ok-color-token-046: rgba(244, 63, 94, 0.25);
    --ok-color-token-047: #fda4af;
    --ok-color-token-048: #08080e;
    --ok-color-token-049: #101018;
    --ok-color-token-050: rgba(255, 255, 255, 0.06);
    --ok-color-token-051: rgba(255, 255, 255, 0.03);
    --ok-color-token-052: rgba(255, 255, 255, 0.09);
    --ok-color-token-053: #e2e8f0;
    --ok-color-token-054: #f1f5f9;
    --ok-color-token-055: rgba(0, 0, 0, 0.55);
    --ok-color-token-056: rgba(0, 0, 0, 0.35);
    --ok-color-token-057: rgba(124, 58, 237, 0.18);
    --ok-color-token-058: rgba(124, 58, 237, 0.06);
    --ok-color-token-059: rgba(255, 255, 255, 0.02);
    --ok-color-token-060: rgba(255, 255, 255, 0.005);
    --ok-color-transparent: transparent;
    --ok-color-white: #ffffff;
    --ok-color-black: #000000;

    --ok-bg-canvas: #050508;
    --ok-bg-surface: #0a0a10;
    --ok-bg-elevated: #111118;
    --ok-bg-window: #0f0f16;
    --ok-bg-window-inner: #14141c;

    --ok-purple-primary: #7c3aed;
    --ok-purple-vibrant: #8b5cf6;
    --ok-purple-soft: rgba(139, 92, 246, 0.12);
    --ok-purple-border: rgba(139, 92, 246, 0.3);
    --ok-purple-glow: rgba(139, 92, 246, 0.45);

    --ok-accent-cyan: #06b6d4;
    --ok-accent-emerald: #10b981;
    --ok-accent-amber: #f59e0b;
    --ok-accent-rose: #f43f5e;

    --ok-text-primary: #ffffff;
    --ok-text-secondary: #cbd5e1;
    --ok-text-muted: #94a3b8;

    --ok-border-subtle: rgba(255, 255, 255, 0.08);
    --ok-border-strong: rgba(255, 255, 255, 0.14);
    --ok-input-bg: rgba(255, 255, 255, 0.04);
    --ok-pill-bg: rgba(255, 255, 255, 0.05);
    --ok-pill-bg-hover: rgba(139, 92, 246, 0.12);
    --ok-chip-bg: rgba(255, 255, 255, 0.04);
    --ok-meter-bg: rgba(255, 255, 255, 0.05);
    --ok-stream-hover: var(--ok-purple-soft);
    --ok-shadow-card: rgba(0, 0, 0, 0.75);
    --ok-shadow-sidebar: rgba(0, 0, 0, 0.6);
    --ok-shadow-window: 0 40px 120px rgba(0, 0, 0, 0.75), 0 12px 36px rgba(0, 0, 0, 0.55);
    --ok-shadow-inner: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    --ok-glass-tint: rgba(15, 15, 22, 0.72);
    --ok-glass-tint-strong: rgba(15, 15, 22, 0.92);
    --ok-divider: rgba(255, 255, 255, 0.06);

    --ok-bg-balance: #0d3b38;
    --ok-accent-green: #a3e635;
    --ok-accent-green-hover: #84cc16;
    --ok-accent-green-light: rgba(163, 230, 53, 0.12);

    --ok-radius-pill: 9999px;
    --ok-radius-card: 12px;
    --ok-radius-md: 12px;
    --ok-radius-window: 18px;
    --ok-radius-inner: 12px;
    --ok-radius-circle: 50%;
    --ok-sidebar-width: 86px;
    --ok-navbar-height: 80px;
    --ok-content-max: 1180px;
  }

  html[data-theme="light"] {
    --ok-bg-canvas: #f4f5f9;
    --ok-bg-surface: #ffffff;
    --ok-bg-elevated: #ffffff;
    --ok-bg-window: #ffffff;
    --ok-bg-window-inner: #fafafa;

    --ok-purple-primary: #6d28d9;
    --ok-purple-vibrant: #7c3aed;
    --ok-purple-soft: rgba(124, 58, 237, 0.08);
    --ok-purple-border: rgba(124, 58, 237, 0.22);
    --ok-purple-glow: rgba(124, 58, 237, 0.22);

    --ok-text-primary: #0f172a;
    --ok-text-secondary: #334155;
    --ok-text-muted: #64748b;

    --ok-border-subtle: rgba(15, 23, 42, 0.08);
    --ok-border-strong: rgba(15, 23, 42, 0.14);
    --ok-input-bg: #ffffff;
    --ok-pill-bg: rgba(15, 23, 42, 0.04);
    --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
    --ok-chip-bg: #ffffff;
    --ok-meter-bg: rgba(15, 23, 42, 0.06);
    --ok-stream-hover: rgba(124, 58, 237, 0.06);
    --ok-shadow-card: rgba(15, 23, 42, 0.08);
    --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);
    --ok-shadow-window: 0 24px 70px rgba(15, 23, 42, 0.16), 0 4px 14px rgba(15, 23, 42, 0.06);
    --ok-shadow-inner: inset 0 1px 0 rgba(255, 255, 255, 0.9);
    --ok-glass-tint: rgba(255, 255, 255, 0.72);
    --ok-glass-tint-strong: rgba(255, 255, 255, 0.94);
    --ok-divider: rgba(15, 23, 42, 0.06);

    --ok-bg-balance: #0d3b38;
    --ok-accent-green: #a3e635;
    --ok-accent-green-hover: #84cc16;
    --ok-accent-green-light: #eff6e0;
  }

  @media (prefers-color-scheme: light) {
    html:not([data-theme]) {
      --ok-bg-canvas: #f4f5f9;
      --ok-bg-surface: #ffffff;
      --ok-bg-elevated: #ffffff;
      --ok-bg-window: #ffffff;
      --ok-bg-window-inner: #fafafa;

      --ok-purple-primary: #6d28d9;
      --ok-purple-vibrant: #7c3aed;
      --ok-purple-soft: rgba(124, 58, 237, 0.08);
      --ok-purple-border: rgba(124, 58, 237, 0.22);
      --ok-purple-glow: rgba(124, 58, 237, 0.22);

      --ok-text-primary: #0f172a;
      --ok-text-secondary: #334155;
      --ok-text-muted: #64748b;

      --ok-border-subtle: rgba(15, 23, 42, 0.08);
      --ok-border-strong: rgba(15, 23, 42, 0.14);
      --ok-input-bg: #ffffff;
      --ok-pill-bg: rgba(15, 23, 42, 0.04);
      --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
      --ok-chip-bg: #ffffff;
      --ok-meter-bg: rgba(15, 23, 42, 0.06);
      --ok-stream-hover: rgba(124, 58, 237, 0.06);
      --ok-shadow-card: rgba(15, 23, 42, 0.08);
      --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);
      --ok-shadow-window: 0 24px 70px rgba(15, 23, 42, 0.16), 0 4px 14px rgba(15, 23, 42, 0.06);
      --ok-shadow-inner: inset 0 1px 0 rgba(255, 255, 255, 0.9);
      --ok-glass-tint: rgba(255, 255, 255, 0.72);
      --ok-glass-tint-strong: rgba(255, 255, 255, 0.94);
      --ok-divider: rgba(15, 23, 42, 0.06);

      --ok-bg-balance: #0d3b38;
      --ok-accent-green: #a3e635;
      --ok-accent-green-hover: #84cc16;
      --ok-accent-green-light: #eff6e0;
    }
  }

  * { box-sizing: border-box; -webkit-font-smoothing: antialiased; }

  body {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--ok-bg-canvas);
    color: var(--ok-text-primary);
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .ok-ambient-glow-core {
    position: fixed;
    top: -120px; left: 20%;
    width: 550px; height: 550px;
    background: radial-gradient(circle, var(--ok-color-token-001) 0%, var(--ok-color-token-002) 70%);
    pointer-events: none; z-index: 0; filter: blur(90px);
  }
  html[data-theme="light"] .ok-ambient-glow-core {
    background: radial-gradient(circle, var(--ok-color-token-003) 0%, var(--ok-color-token-004) 70%);
  }

  /* =========================================================================
     RAIL SIDEBAR SLIM TECH
     ========================================================================= */
  .ok-rail-sidebar {
    position: fixed;
    top: 20px; left: 20px; bottom: 20px;
    width: var(--ok-sidebar-width);
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    border-radius: var(--ok-radius-md);
    display: flex; flex-direction: column; align-items: center;
    padding: 22px 0;
    z-index: 1040;
    box-shadow: 0 10px 30px var(--ok-shadow-sidebar);
    backdrop-filter: blur(20px);
    transition: all 0.3s ease;
    overflow-y: auto; overflow-x: hidden;
  }
  .ok-rail-sidebar::-webkit-scrollbar { width: 0; }

  .ok-brand-emblem {
    width: 48px; height: 48px; border-radius: var(--ok-radius-md);
    background: linear-gradient(135deg, var(--ok-color-token-005) 0%, var(--ok-color-token-006) 100%);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 20px;
    box-shadow: 0 8px 20px var(--ok-color-token-007);
    flex-shrink: 0;
    text-decoration: none;
  }
  .ok-brand-emblem svg { width: 24px; height: 24px; stroke: var(--ok-color-token-010); }

  .ok-rail-nav {
    flex: 1;
    display: flex; flex-direction: column; align-items: center;
    gap: 10px; width: 100%;
  }

  .ok-rail-group-label {
    font-size: 0.58rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ok-text-muted);
    margin: 10px 0 2px 0;
    text-align: center;
    width: 100%;
    opacity: 0.7;
  }

  .ok-rail-link {
    width: 46px; height: 46px; border-radius: var(--ok-radius-md);
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-muted); text-decoration: none;
    transition: all 0.2s ease; background: var(--ok-color-transparent);
    position: relative;
    flex-shrink: 0;
  }
  .ok-rail-link:hover {
    color: var(--ok-purple-vibrant);
    background-color: var(--ok-purple-soft);
    transform: translateY(-2px);
  }
  .ok-rail-link.active {
    background: linear-gradient(135deg, var(--ok-color-token-008) 0%, var(--ok-color-token-009) 100%);
    color: var(--ok-color-token-010);
    box-shadow: 0 8px 20px var(--ok-color-token-011);
  }
  .ok-rail-link.active svg { stroke: var(--ok-color-token-010); }
  .ok-rail-link svg { width: 20px; height: 20px; }

  .admin-rail-count {
    position: absolute; top: 2px; right: 1px;
    min-width: 18px; height: 18px; padding: 0 4px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 999px;
    background: var(--ok-color-token-012); color: var(--ok-color-token-013);
    border: 2px solid var(--ok-bg-surface);
    font-size: 9px; font-weight: 800;
  }

  .ok-rail-footer {
    display: flex; flex-direction: column; align-items: center;
    gap: 10px; width: 100%;
    padding-top: 14px;
    margin-top: 8px;
    border-top: 1px solid var(--ok-border-subtle);
  }

  /* =========================================================================
     VIEWPORT SHELL — CENTRALIZADO (corrigido)
     ========================================================================= */
  .ok-viewport-shell {
    margin-left: calc(var(--ok-sidebar-width) + 20px);
    padding: 20px 20px 48px 0;
    position: relative; z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ok-viewport-shell > * {
    width: 100%;
    max-width: var(--ok-content-max);
    margin-inline: auto;
  }

  /* Top nav — alinhado ao centro do conteúdo */
  .ok-top-nav {
    height: var(--ok-navbar-height);
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 20px;
    gap: 14px;
    flex-wrap: wrap;
    max-width: var(--ok-content-max);
    margin-inline: auto;
    width: 100%;
  }

  /* Barra de pesquisa — alinhada ao início do conteúdo */
  .ok-search-capsule {
    position: relative;
    width: 420px; max-width: 100%;
    flex-shrink: 0;
  }
  .ok-search-capsule input {
    width: 100%; height: 46px;
    border-radius: var(--ok-radius-pill);
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    padding: 0 75px 0 46px;
    font-size: 0.88rem;
    color: var(--ok-text-primary);
    outline: none;
    transition: all 0.25s ease;
  }
  .ok-search-capsule input::placeholder { color: var(--ok-text-muted); }
  .ok-search-capsule input:focus {
    border-color: var(--ok-purple-vibrant);
    box-shadow: 0 0 0 4px var(--ok-purple-soft);
  }
  .ok-search-capsule .search-icon {
    position: absolute; left: 16px; top: 50%;
    transform: translateY(-50%);
    color: var(--ok-text-muted);
    display: flex; align-items: center;
  }
  .ok-search-capsule .shortcut-hint {
    position: absolute; right: 12px; top: 50%;
    transform: translateY(-50%);
    background: var(--ok-pill-bg);
    border: 1px solid var(--ok-border-subtle);
    border-radius: 6px;
    padding: 2px 7px;
    font-size: 0.7rem;
    color: var(--ok-text-muted);
    font-weight: 600;
  }

  .ok-nav-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

  .ok-action-circle {
    width: 44px; height: 44px; border-radius: var(--ok-radius-md);
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-primary);
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
    cursor: pointer;
  }
  .ok-action-circle:hover {
    border-color: var(--ok-purple-border);
    color: var(--ok-purple-vibrant);
    transform: translateY(-2px);
  }

  .ok-profile-pill {
    display: flex; align-items: center; gap: 10px;
    padding: 5px 16px 5px 5px;
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    border-radius: var(--ok-radius-pill);
    text-decoration: none; cursor: pointer;
    color: inherit;
  }
  .ok-profile-avatar-nav {
    width: 36px; height: 36px;
    border-radius: 50%; object-fit: cover;
    background: var(--ok-purple-soft);
    border: 2px solid var(--ok-purple-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-primary); font-weight: 800; font-size: 0.9rem;
  }

  .ok-theme-toggle {
    width: 44px; height: 44px; border-radius: var(--ok-radius-md);
    background-color: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    display: flex; align-items: center; justify-content: center;
    color: var(--ok-text-primary); cursor: pointer;
    transition: all 0.2s ease;
  }
  .ok-theme-toggle:hover {
    border-color: var(--ok-purple-border);
    color: var(--ok-purple-vibrant);
    transform: translateY(-2px);
  }

  /* =========================================================================
     HERO
     ========================================================================= */
  .ok-canvas-hero-title {
    max-width: var(--ok-content-max);
    margin: 0 auto 22px auto;
    display: flex; justify-content: space-between; align-items: flex-end;
    flex-wrap: wrap; gap: 16px;
    width: 100%;
  }

  .ok-page-title-main {
    font-size: 1.85rem; font-weight: 800;
    letter-spacing: -0.03em; line-height: 1.15;
    color: var(--ok-text-primary);
    margin: 0;
    display: flex; align-items: center; gap: 12px;
    flex-wrap: wrap;
    font-family: 'Space Grotesk', sans-serif;
  }
  .ok-page-title-main .user-highlight {
    background: linear-gradient(135deg, var(--ok-purple-vibrant) 0%, var(--ok-color-token-014) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .ok-live-beacon {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.7rem; font-weight: 800;
    padding: 4px 11px;
    border-radius: var(--ok-radius-pill);
    background: var(--ok-color-token-015);
    border: 1px solid var(--ok-color-token-016);
    color: var(--ok-color-token-017);
    letter-spacing: 0.04em; text-transform: uppercase;
  }
  .ok-pulse-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background-color: var(--ok-color-token-017);
    box-shadow: 0 0 8px var(--ok-color-token-017);
  }

  .ok-canvas-sub {
    color: var(--ok-text-muted);
    font-size: 0.88rem; margin-top: 5px; line-height: 1.45;
    display: flex; align-items: center; gap: 8px;
    max-width: 780px;
  }

  .admin-hero-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

  .ok-btn-pill-soft {
    background: var(--ok-purple-soft);
    color: var(--ok-purple-vibrant);
    font-weight: 700;
    border-radius: var(--ok-radius-pill);
    padding: 8px 16px;
    font-size: 0.82rem;
    border: 1px solid transparent;
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-flex; align-items: center; gap: 6px;
    cursor: pointer;
    font-family: inherit;
  }
  .ok-btn-pill-soft:hover {
    background: var(--ok-purple-vibrant);
    color: var(--ok-color-token-010);
  }
  .ok-btn-pill-soft[disabled] { opacity: 0.65; cursor: wait; }

  .admin-currency-badge {
    display: inline-flex; align-items: center;
    padding: 5px 12px;
    border-radius: var(--ok-radius-pill);
    background: var(--ok-bg-surface);
    border: 1px solid var(--ok-border-subtle);
    color: var(--ok-text-muted);
    font-size: 0.72rem; font-weight: 800;
    letter-spacing: 0.06em; text-transform: uppercase;
  }

  /* =========================================================================
     FAIXA DE 4 CARDS CHAPADOS (KPIs)
     ========================================================================= */
  .ok-flat-quad-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: var(--ok-content-max);
    margin: 0 auto 24px auto;
    border-radius: 0px !important;
    overflow: hidden;
    box-shadow: 0 16px 36px var(--ok-shadow-card);
    border: 1px solid var(--ok-border-subtle);
    width: 100%;
  }
  .ok-flat-card-box {
    padding: 22px 18px 20px 18px;
    display: flex; flex-direction: column; justify-content: space-between;
    min-height: 165px;
    border-radius: 0px !important;
    position: relative;
    transition: transform 0.2s ease, filter 0.2s ease;
