  /* Confirm card */
  .users-confirm-card {
    background: var(--ok-bg-window-inner);
    border: 1px solid var(--ok-divider);
    border-radius: var(--ok-radius-inner);
    padding: 1rem;
    display: flex; flex-direction: column; gap: 0.65rem;
  }
  .users-confirm-row {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.82rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--ok-divider);
  }
  .users-confirm-row:last-child { border-bottom: 0; }
  .users-confirm-row .label {
    color: var(--ok-text-muted);
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }
  .users-confirm-row .value {
    color: var(--ok-text-primary);
    font-weight: 600;
    text-align: right;
    overflow-wrap: anywhere;
  }

  /* Wizard footer */
  .users-wizard-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.85rem 1.15rem;
    border-top: 1px solid var(--ok-divider);
    background: var(--ok-glass-tint);
    flex-wrap: wrap;
  }
  .users-wizard-progress {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ok-text-muted);
    letter-spacing: 0.02em;
  }
  .users-wizard-progress strong { color: var(--ok-purple-vibrant); }
  .users-wizard-actions { display: flex; gap: 0.4rem; align-items: center; }

  .ok-btn-apple {
    height: 38px;
    padding: 0 16px;
    border-radius: var(--ok-radius-pill);
    display: inline-flex; align-items: center; justify-content: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
    white-space: nowrap;
  }
  .ok-btn-apple.primary {
    background: linear-gradient(135deg, var(--ok-color-token-008) 0%, var(--ok-color-token-009) 100%);
    color: var(--ok-color-token-010);
    box-shadow: 0 6px 18px var(--ok-color-token-032);
  }
  .ok-btn-apple.primary:hover { transform: translateY(-1px); box-shadow: 0 10px 24px var(--ok-color-token-032); color: var(--ok-color-token-010); }
  .ok-btn-apple.secondary {
    background: var(--ok-pill-bg);
    color: var(--ok-text-primary);
    border: 1px solid var(--ok-border-subtle);
  }
  .ok-btn-apple.secondary:hover {
    background: var(--ok-pill-bg-hover);
    color: var(--ok-purple-vibrant);
    border-color: var(--ok-purple-border);
  }
  .ok-btn-apple[disabled] { opacity: 0.5; cursor: not-allowed; }

  /* Alertas inline */
  #users-page-alert {
    max-width: var(--ok-content-max);
    margin: 0 auto 16px auto;
    border-radius: var(--ok-radius-md);
    font-size: 0.85rem;
  }

  .users-modal .alert-warning {
    background: var(--ok-color-token-039);
    border: 1px solid var(--ok-color-token-040);
    color: var(--ok-color-token-041);
  }
  html[data-theme="light"] .users-modal .alert-warning { color: var(--ok-color-token-023); }

  .users-modal textarea.form-control {
    background: var(--ok-input-bg) !important;
    border: 1px solid var(--ok-border-subtle) !important;
    color: var(--ok-text-primary) !important;
    border-radius: var(--ok-radius-md);
    font-size: 0.84rem;
    padding: 0.6rem 0.85rem;
  }
  .users-modal textarea.form-control:focus {
    border-color: var(--ok-purple-vibrant) !important;
    box-shadow: 0 0 0 4px var(--ok-purple-soft) !important;
  }
  .users-modal .form-text { color: var(--ok-text-muted); font-size: 0.72rem; }

  /* Animações */
  .users-modal.fade .modal-dialog {
    transform: scale(0.96) translateY(8px);
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 0.1), opacity 0.28s ease;
  }
  .users-modal.show .modal-dialog {
    transform: scale(1) translateY(0);
  }

  /* Footer */
  .admin-footer {
    border-top: 1px solid var(--ok-border-subtle);
    background: var(--ok-color-transparent);
    padding: 1rem 1.25rem;
    text-align: center;
    color: var(--ok-text-muted);
    font-size: 0.78rem;
    position: relative;
    z-index: 1;
    margin-top: 2rem;
    max-width: var(--ok-content-max);
    margin-inline: auto;
    width: 100%;
  }

  /* =========================================================================
     RESPONSIVIDADE
     ========================================================================= */
  @media (max-width: 1200px) {
    .ok-flat-quad-strip { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 991px) {
    .ok-rail-sidebar { transform: translateX(-120%); }
    body.mobile-nav-active .ok-rail-sidebar { transform: translateX(0); }
    .ok-viewport-shell { margin-left: 0; padding: 16px; }
    .ok-page-title-main { font-size: 1.55rem; }
    .admin-hero-actions { width: 100%; justify-content: space-between; }
    .users-card-footer { flex-direction: column; align-items: flex-start; }
    .users-pagination { width: 100%; }
    .users-modal .modal-dialog { max-width: calc(100% - 1.5rem); }
  }
  @media (max-width: 600px) {
    .ok-flat-quad-strip { grid-template-columns: 1fr; }
    .ok-profile-pill .admin-profile-text { display: none !important; }
    .ok-search-capsule { width: min(100%, 500px); }
    .users-field-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  .text-danger { color: var(--ok-accent-rose) !important; }
  .text-muted { color: var(--ok-text-muted) !important; }
  .btn-outline-info { --bs-btn-color: var(--ok-accent-cyan); --bs-btn-border-color: var(--ok-accent-cyan); --bs-btn-hover-color: var(--ok-text-primary); --bs-btn-hover-bg: var(--ok-accent-cyan); --bs-btn-hover-border-color: var(--ok-accent-cyan); }
  .btn-outline-primary { --bs-btn-color: var(--ok-purple-vibrant); --bs-btn-border-color: var(--ok-purple-vibrant); --bs-btn-hover-color: var(--ok-text-primary); --bs-btn-hover-bg: var(--ok-purple-primary); --bs-btn-hover-border-color: var(--ok-purple-primary); }
  .alert-danger { --bs-alert-color: var(--ok-accent-rose); --bs-alert-bg: var(--ok-color-token-045); --bs-alert-border-color: var(--ok-accent-rose); }
  .alert-warning { --bs-alert-color: var(--ok-color-token-023); --bs-alert-bg: var(--ok-color-token-039); --bs-alert-border-color: var(--ok-color-token-023); }
  .alert-success { --bs-alert-color: var(--ok-color-token-017); --bs-alert-bg: var(--ok-color-token-015); --bs-alert-border-color: var(--ok-accent-emerald); }
  .alert-info { --bs-alert-color: var(--ok-accent-cyan); --bs-alert-bg: var(--ok-color-token-026); --bs-alert-border-color: var(--ok-accent-cyan); }
</style>

