    overflow-x: auto;
    scrollbar-width: none;
  }
  .users-timeline::-webkit-scrollbar { display: none; }

  .users-step {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.65rem 0.35rem 0.35rem;
    border-radius: var(--ok-radius-pill);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ok-text-muted);
