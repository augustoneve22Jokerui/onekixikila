  .users-actions .btn:hover { transform: translateY(-1px); }
  .users-actions .btn-outline-info {
    border-color: var(--ok-color-token-038);
    color: var(--ok-color-token-027);
    background: var(--ok-color-token-028);
  }
  .users-actions .btn-outline-info:hover {
    background: var(--ok-color-token-026);
    border-color: var(--ok-color-token-027);
    color: var(--ok-color-token-027);
  }
  .users-actions .btn-outline-primary {
    border-color: var(--ok-purple-border);
