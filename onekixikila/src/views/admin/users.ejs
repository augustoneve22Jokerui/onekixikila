  /* =========================================================================
     PAGINAÇÃO
     ========================================================================= */
  .users-card-footer {
    align-items: center;
    border-top: 1px solid var(--ok-border-subtle);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
