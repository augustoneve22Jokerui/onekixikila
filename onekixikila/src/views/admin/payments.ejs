              <circle cx="24" cy="24" r="18" stroke="currentColor" stroke-linecap="square"/>
              <path d="M16 24L22 30L32 18" stroke="currentColor" stroke-linecap="square"/>
            </svg>
          </div>
          <h5 class="ok-flat-title">Correspondentes</h5>
          <p class="ok-flat-desc">Sem divergências reportadas.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" id="stat-matched">—</span>
          <div class="ok-flat-trend">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Conciliados
          </div>
        </div>
      </div>

      <div class="ok-flat-card-box theme-white-alt">
        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="18" stroke="currentColor" stroke-linecap="square"/>
              <path d="M24 14v12m0 6h.01" stroke="currentColor" stroke-linecap="square"/>
            </svg>
          </div>
          <h5 class="ok-flat-title">Com discrepâncias</h5>
          <p class="ok-flat-desc">Aguardam análise ou resolução.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" id="stat-issues">—</span>
          <div class="ok-flat-trend warning">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2 1 21h22L12 2zm0 6v6m0 3h.01"/></svg>
            A rever
          </div>
        </div>
      </div>

      <div class="ok-flat-card-box theme-purple">
        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M14 8h20v32H14z" stroke="currentColor" stroke-linecap="square"/>
              <path d="M18 16h12M18 22h12M18 28h8" stroke="currentColor" stroke-linecap="square"/>
            </svg>
          </div>
          <h5 class="ok-flat-title">Resolvidos manualmente</h5>
          <p class="ok-flat-desc">Intervenção registada.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" id="stat-resolved">—</span>
          <div class="ok-flat-trend">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Registados
          </div>
        </div>
      </div>

    </div>

    <!-- ====================================================================
         RESULTADO DA ÚLTIMA EXECUÇÃO
         ==================================================================== -->
    <section id="fin-last-run" class="fin-run-result mb-4 d-none" aria-live="polite">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
          <div style="color:var(--ok-purple-vibrant);font-size:0.68rem;font-weight:800;letter-spacing:0.15em;text-transform:uppercase;">Resultado da execução</div>
          <h2 class="h5 fw-bold mb-0" style="color:var(--ok-text-primary);font-family:'Space Grotesk',sans-serif;" id="run-title">Conciliação concluída</h2>
        </div>
        <button type="button" class="btn btn-ghost-ok" id="run-hide">Fechar</button>
      </div>
      <div id="run-summary" class="row g-2"></div>
      <div id="run-discrepancies" class="mt-3"></div>
    </section>

    <!-- Loading / Erro -->
    <div id="fin-loading" class="admin-card fin-state-box mb-4" role="status" aria-live="polite">
      <span class="spinner-border spinner-border-sm me-2" style="color:var(--ok-purple-vibrant);" aria-hidden="true"></span>
      A carregar o histórico de conciliações…
    </div>
    <div id="fin-error" class="admin-card fin-state-box d-none mb-4" role="alert"></div>

    <!-- ====================================================================
         TABELA DE LOTES
         ==================================================================== -->
    <section class="admin-card mb-4 d-none" id="fin-table-card" aria-labelledby="fin-table-title">
      <div class="p-3 d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-bottom:1px solid var(--ok-border-subtle);">
        <div>
          <h2 id="fin-table-title" style="font-size:1.05rem;font-weight:800;color:var(--ok-text-primary);margin:0;display:flex;align-items:center;gap:10px;font-family:'Space Grotesk',sans-serif;">
            <i class="bi bi-bank" style="color:var(--ok-purple-vibrant);" aria-hidden="true"></i>
            Lotes de conciliação
          </h2>
          <p class="mb-0" style="font-size:0.78rem;color:var(--ok-text-muted);">Histórico de auditoria financeira retornado pelo backend.</p>
        </div>
        <span class="admin-currency-badge" id="fin-page-label"></span>
      </div>

      <div class="fin-table-wrap">
        <table class="table fin-table">
          <thead>
            <tr>
              <th class="ps-4">Referência</th>
              <th>Prestador</th>
              <th>Período</th>
              <th>Registos</th>
              <th>Discrepâncias</th>
              <th>Estado</th>
              <th>Executado em</th>
              <th class="text-end pe-4">Ações</th>
            </tr>
          </thead>
          <tbody id="fin-table-body"></tbody>
        </table>
      </div>

      <div class="fin-footer">
        <span class="small" style="color:var(--ok-text-muted);" id="fin-page-info">—</span>
        <div class="fin-pager">
          <button type="button" id="fin-prev" aria-label="Página anterior">
            <i class="bi bi-chevron-left" aria-hidden="true"></i> Anterior
          </button>
          <button type="button" id="fin-next" aria-label="Página seguinte">
            Seguinte <i class="bi bi-chevron-right" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </section>

    <!-- Aviso crítico -->
    <div class="admin-note critical" style="max-width:var(--ok-content-max);margin:0 auto 20px auto;">
      <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
      <span>Antes de resolver um lote, investigue todas as divergências. A confirmação marca o lote como <strong>MANUALLY_RESOLVED</strong>, mas não corrige nem reverte transações subjacentes.</span>
    </div>

    <footer class="admin-footer" style="border-top:1px solid var(--ok-border-subtle);background:transparent;padding:1rem 1.25rem;text-align:center;color:var(--ok-text-muted);font-size:0.78rem;max-width:var(--ok-content-max);margin:2rem auto 0;width:100%;">
      <span>&copy; <%= (typeof currentYear !== 'undefined' ? currentYear : new Date().getFullYear()) %> OneKixikila Admin Engine. Operações de tesouraria com controlo e trilha de auditoria.</span>
    </footer>

  </div>

  <!-- ======================================================================
       MODAL — Executar conciliação
       ====================================================================== -->
  <div class="modal fade fin-modal" id="modal-fin-run" tabindex="-1" aria-labelledby="modalFinRunLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="modalFinRunLabel"><i class="bi bi-arrow-left-right me-2" style="color:var(--ok-purple-vibrant);" aria-hidden="true"></i>Executar conciliação</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <form id="form-fin-run">
          <div class="modal-body">
            <div class="admin-note warning mb-3">
              <i class="bi bi-info-circle" aria-hidden="true"></i>
              <span>A operação consulta o extrato externo do prestador e grava um novo lote de conciliação. Escolha período e prestador com cuidado.</span>
            </div>
            <label for="run-provider" class="form-label small fw-semibold">Prestador de pagamento</label>
            <select id="run-provider" class="form-select" required>
              <option value="MULTICAIXA_EXPRESS">Multicaixa Express (EMIS)</option>
              <option value="UNITEL_MONEY">Unitel Money</option>
              <option value="E_KWANZA">e-Kwanza (BAI)</option>
            </select>
            <div class="row g-3 mt-1">
              <div class="col-6">
                <label for="run-start-date" class="form-label small fw-semibold">Data inicial</label>
                <input id="run-start-date" type="date" class="form-control" required>
              </div>
              <div class="col-6">
                <label for="run-end-date" class="form-label small fw-semibold">Data final</label>
                <input id="run-end-date" type="date" class="form-control" required>
              </div>
            </div>
            <div class="form-text mt-2" style="color:var(--ok-text-muted);">O servidor interpreta as datas como dias UTC completos.</div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-ghost-ok" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-primary-ok" id="fin-run-submit">Executar e registar lote</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ======================================================================
       MODAL — Detalhe de lote
       ====================================================================== -->
  <div class="modal fade fin-modal" id="modal-fin-detail" tabindex="-1" aria-labelledby="modalFinDetailLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="modalFinDetailLabel"><i class="bi bi-receipt-cutoff me-2" style="color:var(--ok-purple-vibrant);" aria-hidden="true"></i>Detalhe da conciliação</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body" id="fin-detail-body">
          <div class="fin-state-box"><span class="spinner-border spinner-border-sm" role="status" aria-label="A carregar"></span></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-ghost-ok" data-bs-dismiss="modal">Fechar</button>
          <button type="button" class="btn btn-warning-ok d-none" id="fin-detail-resolve"><i class="bi bi-journal-check me-1" aria-hidden="true"></i>Registar resolução</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ======================================================================
       MODAL — Resolver lote
       ====================================================================== -->
  <div class="modal fade fin-modal" id="modal-fin-resolve" tabindex="-1" aria-labelledby="modalFinResolveLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="modalFinResolveLabel"><i class="bi bi-journal-check me-2" style="color:var(--ok-accent-amber);" aria-hidden="true"></i>Resolver discrepância</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <form id="form-fin-resolve">
          <input type="hidden" id="resolve-batch-reference">
          <div class="modal-body">
            <div class="admin-note critical mb-3">
              <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
              <span>Esta ação consolida o lote como resolvido manualmente. Não efetua ajustes automáticos no razão nem junto do prestador.</span>
            </div>
            <label for="resolve-notes" class="form-label small fw-semibold">Parecer técnico de resolução <span class="text-danger">*</span></label>
            <textarea id="resolve-notes" class="form-control" rows="5" minlength="10" maxlength="1000" required placeholder="Registe as verificações realizadas, evidências consideradas e decisão (10–1000 caracteres)."></textarea>
            <div class="form-text mt-2" style="color:var(--ok-text-muted);">O parecer será guardado no histórico do lote e na trilha de auditoria.</div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-ghost-ok" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-warning-ok" id="fin-resolve-submit">Confirmar resolução</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <%- include('../partials/sweet-alert') %>
  <script src="/js/api-client.js"></script>
  <script>
    (function () {
      'use strict';

      /* ====================================================================
         TEMA CLARO/ESCURO
         ==================================================================== */
      const THEME_KEY = 'ok-theme';
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-btn');
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        if (!btn) return;
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      /* ====================================================================
         AÇÕES GLOBAIS
         ==================================================================== */
      function setupGlobalActions() {
        const sidebarToggle = document.getElementById('sidebar-toggle-btn');
        sidebarToggle?.addEventListener('click', () => {
          const active = document.body.classList.toggle('mobile-nav-active');
          sidebarToggle.setAttribute('aria-expanded', String(active));
        });
        document.querySelectorAll('.ok-rail-link[href]').forEach((link) => {
          link.addEventListener('click', () => {
            if (window.matchMedia('(max-width: 991px)').matches) {
              document.body.classList.remove('mobile-nav-active');
            }
          });
        });
        const search = document.getElementById('global-dashboard-search');
        document.addEventListener('keydown', (event) => {
          if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
            if (search) { event.preventDefault(); search.focus(); }
          }
        });
        document.querySelectorAll('[data-action="logout"]').forEach((button) => {
          button.addEventListener('click', async (event) => {
            event.preventDefault();
            button.disabled = true;
            try {
              if (window.apiClient && typeof window.apiClient.post === 'function') await window.apiClient.post('/auth/logout', {});
              if (window.apiClient && typeof window.apiClient.clearSession === 'function') window.apiClient.clearSession();
            } catch (_) {}
            window.location.href = '/login';
          });
        });
      }

      /* ====================================================================
         ESTADO E HELPERS
         ==================================================================== */
      const role = String(document.body.dataset.adminRole || '').toUpperCase();
      const canView = ['ADMIN', 'AUDITOR', 'FINANCIAL_OPERATOR'].includes(role);
      const canRun = canView;
      const canResolve = ['ADMIN', 'AUDITOR'].includes(role);
      document.getElementById('fin-open-run').classList.toggle('d-none', !canRun);
      document.getElementById('fin-refresh').classList.toggle('d-none', !canView);

      const el = {
        loading: document.getElementById('fin-loading'),
        error: document.getElementById('fin-error'),
        card: document.getElementById('fin-table-card'),
        body: document.getElementById('fin-table-body'),
        alert: document.getElementById('fin-alert'),
        prev: document.getElementById('fin-prev'),
        next: document.getElementById('fin-next')
      };
      let page = 1, pageSize = 20, records = [], currentBatch = null, seq = 0;

      function esc(v) { return String(v == null ? '' : v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
      function msg(e, f) { return e && typeof e.message === 'string' && e.message.trim() ? e.message : f; }
      function showAlert(text, type) {
        el.alert.className = 'alert alert-' + (type || 'danger');
        el.alert.textContent = String(text || 'Ocorreu um erro.');
        el.alert.classList.remove('d-none');
        el.alert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      function clearAlert() { el.alert.classList.add('d-none'); el.alert.textContent = ''; }

      function dateFmt(v, withTime) {
        if (!v) return '—';
        const d = new Date(v);
        return Number.isNaN(d.getTime()) ? '—' : new Intl.DateTimeFormat('pt-PT', withTime ? { dateStyle: 'medium', timeStyle: 'short' } : { dateStyle: 'medium', timeZone: 'UTC' }).format(d);
      }
      function dateOnly(v) {
        if (!v) return '—';
        const d = new Date(v);
        return Number.isNaN(d.getTime()) ? '—' : new Intl.DateTimeFormat('pt-PT', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }).format(d);
      }
      function money(v, c) {
        const n = Number(v);
        if (!Number.isFinite(n)) return '—';
        try { return new Intl.NumberFormat('pt-AO', { style: 'currency', currency: String(c || 'AOA'), maximumFractionDigits: 2 }).format(n); }
        catch (_) { return new Intl.NumberFormat('pt-PT', { maximumFractionDigits: 2 }).format(n) + ' ' + String(c || 'AOA'); }
      }
      function fmtCount(v) {
        const n = Number(v);
        return Number.isFinite(n) ? new Intl.NumberFormat('pt-PT').format(n) : '—';
      }

      function statusBadge(s) {
        const v = String(s || 'UNKNOWN').toUpperCase();
        const labels = { MATCHED: 'Correspondente', DISCREPANCY_AMOUNT: 'Divergência de montante', DISCREPANCY_STATUS: 'Divergência de estado', MANUALLY_RESOLVED: 'Resolvido manualmente' };
        const cls = { MATCHED: 'fin-state-match', DISCREPANCY_AMOUNT: 'fin-state-amount', DISCREPANCY_STATUS: 'fin-state-status', MANUALLY_RESOLVED: 'fin-state-resolved' };
        return '<span class="fin-badge ' + (cls[v] || 'fin-state-other') + '" title="' + esc(v) + '">' + esc(labels[v] || v) + '</span>';
      }
      function providerName(p) {
        return ({ MULTICAIXA_EXPRESS: 'Multicaixa Express', UNITEL_MONEY: 'Unitel Money', E_KWANZA: 'e-Kwanza' })[String(p || '').toUpperCase()] || String(p || '—');
      }

      function summary(rows) {
        document.getElementById('stat-total').textContent = String(rows.length);
        document.getElementById('stat-matched').textContent = String(rows.filter(x => x.status === 'MATCHED').length);
        document.getElementById('stat-issues').textContent = String(rows.filter(x => !['MATCHED', 'MANUALLY_RESOLVED'].includes(x.status)).length);
        document.getElementById('stat-resolved').textContent = String(rows.filter(x => x.status === 'MANUALLY_RESOLVED').length);
        document.getElementById('fin-page-label').textContent = 'Página ' + page;
      }

      function render(rows) {
        if (!rows.length) {
          el.body.innerHTML = '<tr><td colspan="8"><div class="fin-state-box m-3"><i class="bi bi-bank" aria-hidden="true"></i><strong class="d-block mb-1" style="color:var(--ok-text-primary);">Ainda não há lotes nesta página</strong><span>Execute uma conciliação autorizada ou regresse à página anterior.</span></div></td></tr>';
          return;
        }
        el.body.innerHTML = rows.map(x => {
          const ref = String(x.batch_reference || '');
          const eligible = canResolve && !['MATCHED', 'MANUALLY_RESOLVED'].includes(String(x.status || '').toUpperCase());
          let actions = '<button type="button" class="btn btn-sm btn-outline-info" data-action="details" data-reference="' + esc(ref) + '" title="Ver relatório" aria-label="Ver lote ' + esc(ref) + '"><i class="bi bi-eye" aria-hidden="true"></i></button>';
          if (eligible) actions += '<button type="button" class="btn btn-sm btn-outline-warning" data-action="resolve" data-reference="' + esc(ref) + '" title="Registar resolução" aria-label="Resolver lote ' + esc(ref) + '"><i class="bi bi-journal-check" aria-hidden="true"></i></button>';
          const expected = Number(x.total_expected_records || 0);
          const matched = Number(x.total_matched_records || 0);
          const issues = Number(x.total_discrepancy_records || 0);
          return '<tr>' +
            '<td class="ps-4"><div class="fw-bold font-monospace" style="color:var(--ok-text-primary);">' + esc(ref || '—') + '</div><div class="fin-subtext">ID ' + esc(x.id || '—') + '</div></td>' +
            '<td><span class="small">' + esc(providerName(x.provider)) + '</span></td>' +
            '<td><span class="small fin-nowrap">' + esc(dateOnly(x.period_start)) + ' – ' + esc(dateOnly(x.period_end)) + '</span></td>' +
            '<td><span class="fw-bold" style="color:var(--ok-text-primary);">' + (Number.isFinite(expected) ? expected : 0) + '</span><div class="fin-subtext">' + (Number.isFinite(matched) ? matched : 0) + ' correspondentes</div></td>' +
            '<td><span class="fw-bold ' + (issues > 0 ? 'text-warning' : 'text-success') + '">' + (Number.isFinite(issues) ? issues : 0) + '</span></td>' +
            '<td>' + statusBadge(x.status) + '</td>' +
            '<td><span class="small" style="color:var(--ok-text-muted);">' + esc(dateFmt(x.reconciled_at || x.created_at, true)) + '</span></td>' +
            '<td class="text-end pe-4"><div class="fin-actions">' + actions + '</div></td>' +
            '</tr>';
        }).join('');
      }

      function setPageControls(rows) {
        document.getElementById('fin-page-info').textContent = 'Página ' + page + ' · ' + rows.length + ' lote(s) apresentados · tamanho máximo ' + pageSize;
        el.prev.disabled = page <= 1;
        el.next.disabled = rows.length < pageSize;
      }

      /* ====================================================================
         CARREGAR HISTÓRICO
         ==================================================================== */
      async function loadHistory(requestedPage) {
        if (!canView) {
          el.loading.classList.add('d-none');
          el.card.classList.add('d-none');
          el.error.innerHTML = '<i class="bi bi-shield-lock" aria-hidden="true"></i><strong class="d-block mb-2" style="color:var(--ok-text-primary);">Acesso financeiro restrito</strong><span>A conciliação exige papel ADMIN, AUDITOR ou FINANCIAL_OPERATOR. O servidor valida todas as operações.</span>';
          el.error.classList.remove('d-none');
          return;
        }
        if (!window.apiClient || typeof window.apiClient.get !== 'function') {
          el.loading.classList.add('d-none');
          el.card.classList.add('d-none');
          el.error.innerHTML = '<i class="bi bi-plug" aria-hidden="true"></i><strong class="d-block mb-2" style="color:var(--ok-text-primary);">Cliente da API indisponível</strong><span>Não é seguro consultar nem alterar registos financeiros sem o cliente autenticado da API.</span><div class="mt-3"><button type="button" class="btn btn-sm btn-ghost-ok" id="fin-retry"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Tentar novamente</button></div>';
          el.error.classList.remove('d-none');
          return;
        }
        page = requestedPage || 1;
        const thisSeq = ++seq;
        clearAlert();
        el.error.classList.add('d-none');
        el.card.classList.add('d-none');
        el.loading.classList.remove('d-none');
        el.loading.innerHTML = '<span class="spinner-border spinner-border-sm me-2" style="color:var(--ok-purple-vibrant);" aria-hidden="true"></span>A carregar o histórico de conciliações…';
        try {
          const response = await window.apiClient.get('/payments/reconciliation?page=' + page + '&limit=' + pageSize);
          if (thisSeq !== seq) return;
          if (!response || response.success === false || !Array.isArray(response.data)) throw new Error('A API não devolveu uma lista de conciliações válida.');
          records = response.data;
          render(records);
          summary(records);
          setPageControls(records);
          el.loading.classList.add('d-none');
          el.card.classList.remove('d-none');
        } catch (error) {
          if (thisSeq !== seq) return;
          el.loading.classList.add('d-none');
          el.card.classList.add('d-none');
          const routeHint = error && Number(error.status) === 400 ? ' A rota GET /reconciliation está a ser interceptada por GET /:paymentId em src/routes/payment.routes.js; a rota estática deve ser declarada antes da rota dinâmica.' : '';
          el.error.innerHTML = '<i class="bi bi-exclamation-triangle" aria-hidden="true"></i><strong class="d-block mb-2" style="color:var(--ok-text-primary);">Não foi possível carregar o histórico</strong><span>' + esc(msg(error, 'Falha de comunicação com o servidor.') + routeHint) + '</span><div class="mt-3"><button type="button" class="btn btn-sm btn-ghost-ok" id="fin-retry"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Tentar novamente</button></div>';
          el.error.classList.remove('d-none');
        }
      }

      /* ====================================================================
         MODAIS
         ==================================================================== */
      function modal(id) {
        if (!window.bootstrap || !window.bootstrap.Modal) {
          showAlert('Os componentes de interface não foram inicializados. Recarregue antes de continuar.', 'warning');
          return null;
        }
        return window.bootstrap.Modal.getOrCreateInstance(document.getElementById(id));
      }
      function detailItem(label, value) {
        return '<div class="col-12 col-md-6"><div class="fin-detail-box"><span class="fin-detail-label">' + esc(label) + '</span><span class="fin-detail-value">' + esc(value == null || value === '' ? '—' : value) + '</span></div></div>';
      }

      function discrepancySeverity(d) {
        const type = String(d.type || '');
        if (type === 'MISSING_IN_INTERNAL') return ['CRÍTICA', 'fin-state-amount'];
        if (type === 'AMOUNT_MISMATCH') return [Math.abs(Number(d.internalAmount || 0) - Number(d.externalAmount || 0)) >= 10000 ? 'CRÍTICA' : 'ALTA', 'fin-state-amount'];
        if (type === 'MISSING_IN_EXTERNAL') return ['ALTA', 'fin-state-status'];
        return ['MÉDIA', 'fin-state-status'];
      }
      function discrepanciesHtml(list) {
        if (!Array.isArray(list) || !list.length) {
          return '<div class="fin-state-box py-4"><i class="bi bi-check2-circle" aria-hidden="true"></i><strong style="color:var(--ok-text-primary);">Não foram reportadas discrepâncias neste lote.</strong></div>';
        }
        return '<div class="d-grid gap-2">' + list.map(d => {
          const [sev, cls] = discrepancySeverity(d);
          return '<article class="fin-discrepancy"><div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2"><div class="fin-discrepancy-title">' + esc(({ MISSING_IN_EXTERNAL: 'Ausente no extrato do prestador', MISSING_IN_INTERNAL: 'Ausente no registo interno', AMOUNT_MISMATCH: 'Divergência de montante', STATUS_MISMATCH: 'Divergência de estado' })[d.type] || d.type || 'Discrepância') + '</div><span class="fin-badge ' + cls + '">' + esc(sev) + '</span></div><div class="row g-2 mb-2">' + detailItem('Referência do comerciante', d.merchantReference) + detailItem('ID da transação no prestador', d.providerTransactionId) + detailItem('Montante interno', d.internalAmount == null ? '—' : money(d.internalAmount, 'AOA')) + detailItem('Montante externo', d.externalAmount == null ? '—' : money(d.externalAmount, 'AOA')) + detailItem('Estado interno', d.internalStatus) + detailItem('Estado externo', d.externalStatus) + '</div><p class="small mb-0" style="color:var(--ok-text-muted);">' + esc(d.details || 'Sem detalhe adicional.') + '</p></article>';
        }).join('') + '</div>';
      }

      function resolveAllowed(b) {
        return canResolve && b && !['MATCHED', 'MANUALLY_RESOLVED'].includes(String(b.status || '').toUpperCase());
      }
      function openResolve(ref) {
        if (!canResolve) return showAlert('A resolução manual exige ADMIN ou AUDITOR.', 'warning');
        document.getElementById('resolve-batch-reference').value = ref;
        document.getElementById('resolve-notes').value = '';
        const m = modal('modal-fin-resolve');
        if (m) m.show();
      }

      async function showDetails(ref) {
        const m = modal('modal-fin-detail');
        const body = document.getElementById('fin-detail-body');
        const resolveBtn = document.getElementById('fin-detail-resolve');
        if (!m || !window.apiClient || typeof window.apiClient.get !== 'function') return;
        currentBatch = null;
        resolveBtn.classList.add('d-none');
        body.innerHTML = '<div class="fin-state-box"><span class="spinner-border spinner-border-sm" role="status" aria-label="A carregar"></span><span class="ms-2">A consultar o lote…</span></div>';
        m.show();
        try {
          const response = await window.apiClient.get('/payments/reconciliation/' + encodeURIComponent(ref));
          const b = response && response.data ? (response.data.batch || response.data) : null;
          if (!b || typeof b !== 'object') throw new Error('A API não devolveu os detalhes do lote.');
          currentBatch = b;
          if (resolveAllowed(b)) resolveBtn.classList.remove('d-none');
          let meta = b.report_metadata || {};
          if (typeof meta === 'string') { try { meta = JSON.parse(meta); } catch (_) { meta = {}; } }
          const list = Array.isArray(meta.discrepancies) ? meta.discrepancies : [];
          const resolution = meta.resolution || {};
          body.innerHTML = '<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><div class="h5 fw-bold font-monospace mb-1" style="color:var(--ok-text-primary);">' + esc(b.batch_reference || ref) + '</div><div class="d-flex flex-wrap gap-2">' + statusBadge(b.status) + '<span class="fin-badge fin-state-other">' + esc(providerName(b.provider)) + '</span></div></div><span class="small" style="color:var(--ok-text-muted);">' + esc(dateFmt(b.reconciled_at, true)) + '</span></div>' +
            '<h3 class="mb-3" style="font-size:0.7rem;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;color:var(--ok-purple-vibrant);">Resumo contábil</h3>' +
            '<div class="row g-2 mb-4">' + detailItem('Período', dateOnly(b.period_start) + ' – ' + dateOnly(b.period_end)) + detailItem('Registos esperados', b.total_expected_records) + detailItem('Registos correspondentes', b.total_matched_records) + detailItem('Discrepâncias', b.total_discrepancy_records) + detailItem('Montante interno', money(b.total_amount_internal, b.currency)) + detailItem('Montante do prestador', money(b.total_amount_external, b.currency)) + detailItem('Responsável pela execução', b.reconciled_by) + detailItem('Criado em', dateFmt(b.created_at, true)) + '</div>' +
            '<div class="d-flex align-items-center justify-content-between gap-2 mb-3"><h3 class="mb-0" style="font-size:0.7rem;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;color:var(--ok-purple-vibrant);">Discrepâncias detalhadas</h3><span class="small" style="color:var(--ok-text-muted);">' + list.length + ' registo(s)</span></div>' +
            discrepanciesHtml(list) +
            (resolution.notes ? '<div class="admin-note warning mt-3"><i class="bi bi-journal-check" aria-hidden="true"></i><span><strong>Parecer de resolução registado</strong><br>' + esc(resolution.notes) + '<br><span class="small">' + esc(dateFmt(resolution.resolvedAt, true)) + '</span></span></div>' : '');
        } catch (error) {
          body.innerHTML = '<div class="alert alert-danger mb-0" role="alert">' + esc(msg(error, 'Falha ao consultar o detalhe do lote.')) + '</div>';
        }
      }

      function showRunResult(r) {
        document.getElementById('fin-last-run').classList.remove('d-none');
        document.getElementById('run-title').textContent = 'Lote ' + String(r.batchReference || '') + ' · ' + String(providerName(r.provider));
        document.getElementById('run-summary').innerHTML = '<div class="col-6 col-lg-3"><div class="fin-detail-box"><span class="fin-detail-label">Estado</span><span class="fin-detail-value">' + statusBadge(r.status) + '</span></div></div><div class="col-6 col-lg-3"><div class="fin-detail-box"><span class="fin-detail-label">Correspondentes / esperados</span><span class="fin-result-number">' + fmtCount(r.totalMatchedRecords) + ' / ' + fmtCount(r.totalExpectedRecords) + '</span></div></div><div class="col-6 col-lg-3"><div class="fin-detail-box"><span class="fin-detail-label">Discrepâncias</span><span class="fin-result-number">' + fmtCount(r.totalDiscrepancyRecords) + '</span></div></div><div class="col-6 col-lg-3"><div class="fin-detail-box"><span class="fin-detail-label">Montantes interno / externo</span><span class="fin-detail-value">' + esc(money(r.totalAmountInternal, 'AOA')) + ' / ' + esc(money(r.totalAmountExternal, 'AOA')) + '</span></div></div>';
        document.getElementById('run-discrepancies').innerHTML = discrepanciesHtml(r.discrepancies || []);
        document.getElementById('fin-last-run').scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      async function confirmAction(title, text) {
        if (window.Swal && typeof window.Swal.fire === 'function') {
          const r = await window.Swal.fire({ icon: 'warning', title, text, showCancelButton: true, confirmButtonText: 'Confirmar', cancelButtonText: 'Cancelar', confirmButtonColor: '#7c3aed' });
          return Boolean(r.isConfirmed);
        }
        return window.confirm(title + '\n' + text);
      }
      function toast(message) {
        if (window.Alerts && typeof window.Alerts.toast === 'function') window.Alerts.toast(message, 'success');
        else showAlert(message, 'success');
      }
      function fail(error, fallback) {
        const text = msg(error, fallback);
        if (window.Alerts && typeof window.Alerts.error === 'function') window.Alerts.error(text);
        else showAlert(text, 'danger');
      }

      /* ====================================================================
         EVENTOS
         ==================================================================== */
      document.getElementById('fin-open-run').addEventListener('click', () => {
        if (!canRun) return showAlert('A execução exige ADMIN, AUDITOR ou FINANCIAL_OPERATOR.', 'warning');
        const m = modal('modal-fin-run');
        if (m) m.show();
      });
      document.getElementById('fin-refresh').addEventListener('click', () => loadHistory(page));
      document.getElementById('fin-prev').addEventListener('click', () => { if (page > 1) loadHistory(page - 1); });
      document.getElementById('fin-next').addEventListener('click', () => { if (records.length >= pageSize) loadHistory(page + 1); });
      el.error.addEventListener('click', ev => { if (ev.target.closest('#fin-retry')) loadHistory(page); });
      el.body.addEventListener('click', ev => {
        const b = ev.target.closest('button[data-action]');
        if (!b) return;
        const ref = b.dataset.reference;
        if (!ref) return;
        if (b.dataset.action === 'details') showDetails(ref);
        else if (b.dataset.action === 'resolve') openResolve(ref);
      });
      document.getElementById('fin-detail-resolve').addEventListener('click', () => {
        const m = window.bootstrap.Modal.getInstance(document.getElementById('modal-fin-detail'));
        if (m) m.hide();
        if (currentBatch) openResolve(currentBatch.batch_reference);
      });
      document.getElementById('run-hide').addEventListener('click', () => document.getElementById('fin-last-run').classList.add('d-none'));

      document.getElementById('form-fin-run').addEventListener('submit', async ev => {
        ev.preventDefault();
        if (!canRun || !window.apiClient || typeof window.apiClient.post !== 'function') return showAlert('A API ou as permissões necessárias não estão disponíveis.', 'danger');
        const provider = document.getElementById('run-provider').value;
        const startDate = document.getElementById('run-start-date').value;
        const endDate = document.getElementById('run-end-date').value;
        if (!startDate || !endDate || startDate > endDate) return showAlert('Indique um intervalo de datas válido: início igual ou anterior ao fim.', 'warning');
        if (!await confirmAction('Executar conciliação externa?', 'O sistema consultará o prestador e gravará um novo lote financeiro para o período selecionado.')) return;
        const button = document.getElementById('fin-run-submit');
        button.disabled = true;
        try {
          const response = await window.apiClient.post('/payments/reconciliation/run', { provider, startDate, endDate });
          if (!response || response.success === false || !response.data) throw new Error(response && response.message || 'O servidor não devolveu o resultado da conciliação.');
          const m = window.bootstrap.Modal.getInstance(document.getElementById('modal-fin-run'));
          if (m) m.hide();
          showRunResult(response.data);
          toast('Lote de conciliação criado.');
          page = 1;
          await loadHistory(1);
        } catch (error) {
          fail(error, 'Falha ao executar a conciliação.');
        } finally {
          button.disabled = false;
        }
      });

      document.getElementById('form-fin-resolve').addEventListener('submit', async ev => {
        ev.preventDefault();
        if (!canResolve || !window.apiClient || typeof window.apiClient.post !== 'function') return showAlert('A resolução exige ADMIN/AUDITOR e um cliente API ativo.', 'danger');
        const ref = document.getElementById('resolve-batch-reference').value;
        const notes = document.getElementById('resolve-notes').value.trim();
        if (!ref || notes.length < 10 || notes.length > 1000) return showAlert('O parecer deve conter entre 10 e 1000 caracteres.', 'warning');
        if (!await confirmAction('Registar resolução manual?', 'O lote será marcado como MANUALLY_RESOLVED. Não serão alteradas transações do prestador nem do razão.')) return;
        const button = document.getElementById('fin-resolve-submit');
        button.disabled = true;
        try {
          const response = await window.apiClient.post('/payments/reconciliation/' + encodeURIComponent(ref) + '/resolve', { resolutionNotes: notes });
          if (!response || response.success === false) throw new Error(response && response.message || 'A API recusou a resolução.');
          const m = window.bootstrap.Modal.getInstance(document.getElementById('modal-fin-resolve'));
          if (m) m.hide();
          toast('Parecer de resolução registado.');
          await loadHistory(page);
        } catch (error) {
          fail(error, 'Falha ao registar a resolução.');
        } finally {
          button.disabled = false;
        }
      });

      document.getElementById('modal-fin-resolve').addEventListener('hidden.bs.modal', () => {
        document.getElementById('form-fin-resolve').reset();
        document.getElementById('fin-resolve-submit').disabled = false;
      });
      document.getElementById('modal-fin-run').addEventListener('hidden.bs.modal', () => {
        document.getElementById('form-fin-run').reset();
        document.getElementById('fin-run-submit').disabled = false;
      });

      /* ====================================================================
         DATAS PADRÃO + RELÓGIO UTC + INICIALIZAÇÃO
         ==================================================================== */
      function localDate(d) { const x = new Date(d.getTime() - d.getTimezoneOffset() * 60000); return x.toISOString().slice(0, 10); }
      const today = localDate(new Date());
      const firstMonth = localDate(new Date(new Date().getFullYear(), new Date().getMonth(), 1));
      document.getElementById('run-start-date').value = firstMonth;
      document.getElementById('run-end-date').value = today;
      document.getElementById('run-start-date').max = today;
      document.getElementById('run-end-date').max = today;

      const clock = document.getElementById('admin-utc-clock');
      function updateClock() {
        if (clock) clock.textContent = new Intl.DateTimeFormat('pt-PT', { timeZone: 'UTC', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).format(new Date()) + ' UTC';
      }
      updateClock();
      window.setInterval(updateClock, 1000);

      document.addEventListener('DOMContentLoaded', () => {
        initThemeToggle();
        setupGlobalActions();
        loadHistory(1);
      });
    })();
  </script>
</body>
</html>