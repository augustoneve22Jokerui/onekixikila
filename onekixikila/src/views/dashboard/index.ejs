          <a href="/wallet/transfer" class="ok-vault-btn ghost">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
            Enviar
          </a>
        </div>
      </div>

      <!-- Gráfico -->
      <div class="ok-chart-module-card">
        <div class="ok-chart-header">
          <div class="ok-chart-tagline">
            <div class="ok-chart-tag-emblem">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
            </div>
            <div>
              <h5 class="fw-bold mb-0" style="font-size: 1.02rem; color: var(--ok-text-primary);">Fluxo das Partidas Dobradas</h5>
              <span style="font-size: 0.75rem; color: var(--ok-text-muted);">Entradas (Créditos) vs Saídas (Débitos)</span>
            </div>
          </div>

          <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; font-weight: 800; font-size: 0.72rem; padding: 5px 11px; border-radius: 999px;">
            Equilíbrio 100%
          </span>
        </div>

        <div class="ok-chart-canvas-wrapper" id="activity-chart-canvas-box">
          <svg width="100%" height="100%" viewBox="0 0 700 200" preserveAspectRatio="none">
            <defs>
              <linearGradient id="chartVioletGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.35"/>
                <stop offset="100%" stop-color="#8b5cf6" stop-opacity="0.0"/>
              </linearGradient>
            </defs>
            <path id="chart-area-path" d="M0,170 Q140,80 280,130 T560,60 T700,90 L700,200 L0,200 Z" fill="url(#chartVioletGrad)" />
            <path id="chart-stroke-path" d="M0,170 Q140,80 280,130 T560,60 T700,90" fill="none" stroke="#8b5cf6" stroke-width="3.5" stroke-linecap="round" />
            <circle cx="280" cy="130" r="5" fill="#ffffff" stroke="#8b5cf6" stroke-width="3"/>
            <circle cx="560" cy="60" r="6" fill="#8b5cf6" stroke="#ffffff" stroke-width="3"/>
          </svg>
        </div>

        <div class="d-flex justify-content-between align-items-center pt-3 mt-2" style="border-top: 1px solid var(--ok-border-subtle);">
          <span style="font-size: 0.75rem; color: var(--ok-text-muted);">Últimas 24 Horas</span>
          <span style="font-size: 0.75rem; color: var(--ok-text-muted);">Ciclo Corrente</span>
          <span style="font-size: 0.75rem; font-weight: 700; color: var(--ok-purple-vibrant);">Livro-Razão Conectado</span>
        </div>
      </div>

    </div>

    <!-- =========================================================================
       SESSÃO 3: GRUPOS + DONUT
       ========================================================================= -->
    <div class="ok-bottom-insights-grid">

      <div class="ok-groups-roster-card">
        <div class="ok-card-title-row">
          <div>
            <h4>Os Meus Grupos de Kixikila</h4>
            <span style="font-size: 0.78rem; color: var(--ok-text-muted);">Grupos onde é líder ou membro ativo</span>
          </div>
          <a href="/groups/create" class="ok-btn-pill-soft">
