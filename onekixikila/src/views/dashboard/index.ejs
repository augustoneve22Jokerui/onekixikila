        </div>

        <div class="ok-donut-centerpiece">
          <svg width="190" height="190" viewBox="0 0 100 100">
            <circle cx="50" cy="50" r="38" fill="none" stroke="var(--ok-meter-bg)" stroke-width="12"></circle>
            <circle id="donut-segment-available" cx="50" cy="50" r="38" fill="none" stroke="#8b5cf6" stroke-width="12" stroke-dasharray="170 240" stroke-linecap="round"></circle>
            <circle id="donut-segment-locked" cx="50" cy="50" r="38" fill="none" stroke="#06b6d4" stroke-width="12" stroke-dasharray="45 240" stroke-dashoffset="-175" stroke-linecap="round"></circle>
          </svg>
          <div class="ok-donut-inner-data">
            <span class="label">Total Geral</span>
            <div class="sum" id="donut-total-sum">0 Kz</div>
          </div>
        </div>

        <div class="d-flex flex-column gap-2 mt-2">
          <div class="d-flex justify-content-between align-items-center" style="font-size: 0.82rem;">
            <div class="d-flex align-items-center gap-2">
              <span style="width: 10px; height: 10px; border-radius: 50%; background: #8b5cf6;"></span>
              <span style="color: var(--ok-text-muted);">Disponível</span>
            </div>
            <strong style="color: var(--ok-text-primary);" id="legend-available-val">0 Kz</strong>
          </div>
          <div class="d-flex justify-content-between align-items-center" style="font-size: 0.82rem;">
            <div class="d-flex align-items-center gap-2">
              <span style="width: 10px; height: 10px; border-radius: 50%; background: #06b6d4;"></span>
              <span style="color: var(--ok-text-muted);">Garantias / Retido</span>
            </div>
            <strong style="color: var(--ok-text-primary);" id="legend-locked-val">0 Kz</strong>
          </div>
        </div>

        <a href="/wallet/statement" class="ok-btn-ghost-pill w-100 mt-3">
          Ver Livro-Razão Completo
        </a>
      </div>

    </div>

    <!-- =========================================================================
       SESSÃO 4: TRANSAÇÕES RECENTES
       ========================================================================= -->
    <section class="ok-recent-transactions-section">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h4 class="fw-bold mb-1" style="font-size: 1.15rem; color: var(--ok-text-primary);">Transações Recentes</h4>
          <span style="font-size: 0.78rem; color: var(--ok-text-muted);">Lançamentos certificados e reconciliados</span>
        </div>
        <a href="/wallet/statement" class="ok-btn-pill-soft">
          Ver Extrato &rarr;
        </a>
      </div>

      <div class="ok-stream-flat-list" id="dashboard-recent-transactions-tbody">
        <div class="ok-empty-state">
          <div class="spinner-border spinner-border-sm mb-2" role="status" style="color: var(--ok-purple-vibrant);"></div>
          <p class="small mb-0">A carregar extrato...</p>
        </div>
      </div>
    </section>

  </div>

  <!-- Scripts do Ecossistema -->
  <script src="/js/sweet-alert.js"></script>
  <script src="/js/api-client.js"></script>
  <script src="/js/app.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    (function () {
      'use strict';

      /* ====================================================================
         TEMA CLARO/ESCURO
         ==================================================================== */
      const THEME_KEY = 'ok-theme';
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-btn');
        if (!btn) return;
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      /* ====================================================================
         HELPERS
         ==================================================================== */
      const formatAOA = (amount) => {
        const val = Number(amount) || 0;
        return val.toLocaleString('pt-AO') + ' Kz';
      };
      const formatDateTime = (isoDate) => {
        if (!isoDate) return '—';
        const d = new Date(isoDate);
        return d.toLocaleDateString('pt-AO', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
      };

      const DEFAULT_AVATAR = '/assets/images/avatar-default.png';
      const FALLBACK_DATA_URI = 'data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 fill=%22%237c3aed%22/%3E%3Ccircle cx=%2232%22 cy=%2224%22 r=%2212%22 fill=%22%23ffffff%22/%3E%3Cpath d=%22M8 64c0-13.255 10.745-24 24-24s24 10.745 24 24%22 fill=%22%23ffffff%22/%3E%3C/svg%3E';

      function pick(obj, camel, snake, fallback) {
        if (!obj) return fallback;
        if (obj[camel] !== undefined && obj[camel] !== null) return obj[camel];
        if (obj[snake] !== undefined && obj[snake] !== null) return obj[snake];
        return fallback;
      }

      function isAbsoluteUrl(str) {
        return /^https?:\/\//i.test(str);
      }

      function resolveAvatarUrlForRender(rawUrl) {
        if (!rawUrl) return null;
        const trimmed = String(rawUrl).trim();
        if (!trimmed) return null;
        if (isAbsoluteUrl(trimmed) || trimmed.startsWith('/uploads/') || trimmed.startsWith('/assets/')) {
          if (trimmed === DEFAULT_AVATAR) return null;
          return trimmed;
        }
        return `/uploads/${trimmed.replace(/^\/+/, '')}`;
      }

      /**
       * Aplica um src ao <img> e GARANTE que o handler de fallback está ligado.
       */
      function applyAvatarToImg(imgEl, url) {
        if (!imgEl) return;
        const nextSrc = url || DEFAULT_AVATAR;

        if (imgEl.__okFallbackHandler) {
          imgEl.removeEventListener('error', imgEl.__okFallbackHandler);
          imgEl.__okFallbackHandler = null;
        }

        const onErr = function () {
          const fb = imgEl.getAttribute('data-fallback') || FALLBACK_DATA_URI;
          if (fb && imgEl.src !== fb) {
            imgEl.src = fb;
          }
        };
        imgEl.__okFallbackHandler = onErr;
        imgEl.addEventListener('error', onErr);

        if (imgEl.getAttribute('src') !== nextSrc) {
          imgEl.setAttribute('src', nextSrc);
        }
      }

      /* ====================================================================
         HIDRATAÇÃO DO UTILIZADOR (avatar real do backend)
         ==================================================================== */
      async function hydrateUserIdentity() {
        try {
          const res = await window.apiClient.get('/users/profile');
          const raw =
            (res && res.data && res.data.user) ||
            (res && res.data && res.data.data) ||
            (res && res.data) ||
            res;
          if (!raw) return;

          const fullName = pick(raw, 'fullName', 'full_name', '');
          const role = pick(raw, 'role', 'role', 'Utilizador');
          const avatarUrl = pick(raw, 'avatarUrl', 'avatar_url', null);
          const normalizedAvatar = resolveAvatarUrlForRender(avatarUrl);

          const navAvatar = document.getElementById('ok-nav-avatar');
          const navName = document.getElementById('ok-nav-fullname');
          const navRole = document.getElementById('ok-nav-role');
          const heroName = document.getElementById('ok-hero-username');

          applyAvatarToImg(navAvatar, normalizedAvatar);

          if (navName && fullName) {
            navName.textContent = fullName.split(' ')[0];
          }
          if (navRole) navRole.textContent = role || 'Utilizador';
          if (heroName && fullName) heroName.textContent = fullName;
        } catch (err) {
          // Silencioso — mantém os valores renderizados no servidor (EJS)
          console.warn('[DASHBOARD:USER:HYDRATE] Falha ao hidratar identidade:', err && err.message);
        }
      }

      /* ====================================================================
         1. WALLET METRICS
         ==================================================================== */
      async function loadWalletMetrics() {
        try {
          const res = await window.apiClient.get('/wallet/me');
          const wallet = res.data && res.data.wallet ? res.data.wallet : null;
          if (!wallet) return;

          const available = wallet.availableBalance || 0;
          const locked = wallet.lockedBalance || 0;
          const ledger = wallet.ledgerBalance || 0;

          document.getElementById('user-available-balance').textContent = formatAOA(available);
          document.getElementById('user-locked-balance').textContent = formatAOA(locked);
          document.getElementById('donut-total-sum').textContent = formatAOA(ledger);
          document.getElementById('legend-available-val').textContent = formatAOA(available);
          document.getElementById('legend-locked-val').textContent = formatAOA(locked);

          const statusBadge = document.getElementById('wallet-status-badge');
          if (statusBadge) {
            statusBadge.textContent = wallet.status === 'ACTIVE' ? 'Operacional' : wallet.status;
          }

          if (ledger > 0) {
            const availRatio = Math.round((available / ledger) * 240);
            const lockedRatio = Math.round((locked / ledger) * 240);
            document.getElementById('donut-segment-available').setAttribute('stroke-dasharray', `${availRatio} 240`);
            document.getElementById('donut-segment-locked').setAttribute('stroke-dasharray', `${lockedRatio} 240`);
          }

          loadRecentLedgerEntries(wallet.id);
        } catch (err) {
          console.error('[DASHBOARD:WALLET:ERROR]', err);
        }
      }

      /* ====================================================================
         2. GROUPS ROSTER
         ==================================================================== */
      async function loadGroupsRoster() {
        const container = document.getElementById('dashboard-groups-listing');
        try {
          const res = await window.apiClient.get('/groups?limit=5');
          const groups = res.data || [];

          if (groups.length === 0) {
            container.innerHTML = `
              <div class="ok-empty-state">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin: 0 auto 8px;">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                </svg>
                <h6>Ainda não participa de nenhum grupo</h6>
                <p class="small mb-3" style="color: var(--ok-text-muted);">Junte-se a uma Kixikila pública ou crie o seu próprio grupo.</p>
                <a href="/groups" class="ok-btn-pill-soft">Explorar Grupos</a>
              </div>
            `;
            return;
          }

          let html = '';
          let totalMembersCumulative = 0;
          let totalPoolCalculated = 0;

          groups.forEach((g) => {
            const quota = Number(g.contribution_amount || 0);
            const members = Number(g.active_members_count || 1);
            totalMembersCumulative += members;
            totalPoolCalculated += (quota * members);

            html += `
              <a href="/groups/${g.id || g.slug}" class="ok-group-row">
                <div class="ok-group-meta-cell">
                  <div class="ok-group-icon-badge">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2.2">
                      <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                      <path d="m9 12 2 2 4-4"></path>
                    </svg>
                  </div>
                  <div style="min-width:0;">
                    <h6 class="ok-group-title">${g.name}</h6>
                    <p class="ok-group-meta-line">${members} membros &bull; ${formatAOA(quota)} &bull; ${g.frequency}</p>
                  </div>
                </div>
                <div class="d-flex flex-column align-items-end gap-1">
                  <span class="ok-group-pill">Bolo: ${formatAOA(quota * members)}</span>
                  <span class="ok-group-meta-line">Ciclo ${g.current_cycle || 1}</span>
                </div>
              </a>
            `;
          });

          container.innerHTML = html;

          document.getElementById('stat-active-members-count').textContent = totalMembersCumulative;
          document.getElementById('stat-pool-target').textContent = formatAOA(totalPoolCalculated);
          document.getElementById('stat-total-collected').textContent = formatAOA(Math.round(totalPoolCalculated * 0.65));
        } catch (err) {
          container.innerHTML = `<div class="p-3 text-center text-danger small">Falha ao carregar grupos.</div>`;
        }
      }

      /* ====================================================================
         3. RECENT LEDGER ENTRIES
         ==================================================================== */
      async function loadRecentLedgerEntries(walletId) {
        const container = document.getElementById('dashboard-recent-transactions-tbody');
        if (!walletId || !container) return;

        try {
          const res = await window.apiClient.get(`/wallet/${walletId}/statement?limit=6`);
          const entries = res.data || [];

          if (entries.length === 0) {
            container.innerHTML = `
              <div class="ok-empty-state">
                <p class="small mb-0">Nenhuma transação contábil registada até ao momento.</p>
              </div>
            `;
            return;
          }

          let html = '';
          entries.forEach((tx) => {
            const isDebit = tx.direction === 'DEBIT';
            const iconClass = isDebit ? 'debit' : 'credit';
            const amountClass = isDebit ? 'debit' : 'credit';
            const dirClass = isDebit ? 'debit' : 'credit';
            const sign = isDebit ? '− ' : '+ ';

            html += `
              <div class="ok-stream-flat-row">
                <div class="ok-stream-tx-meta">
                  <div class="ok-stream-tx-icon ${iconClass}">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      ${isDebit
                        ? '<polyline points="7 17 17 7"></polyline><polyline points="7 7 17 7 17 17"></polyline>'
                        : '<polyline points="17 7 7 17"></polyline><polyline points="17 17 7 17 7 7"></polyline>'}
                    </svg>
                  </div>
                  <div style="min-width:0;">
                    <p class="ok-stream-tx-desc">${tx.description || tx.referenceCode}</p>
                    <p class="ok-stream-tx-meta-line">Ref: ${tx.referenceCode}</p>
                  </div>
                </div>
                <div class="ok-stream-tx-date">${formatDateTime(tx.postedAt)}</div>
                <div>
                  <span class="ok-stream-tx-direction ${dirClass}">
                    ${isDebit ? 'DÉBITO' : 'CRÉDITO'}
                  </span>
                </div>
                <div class="ok-stream-tx-amount ${amountClass}">
                  ${sign}${formatAOA(tx.amount)}
                </div>
                <div class="ok-stream-tx-status">
                  Confirmado
                </div>
              </div>
            `;
          });

          container.innerHTML = html;
        } catch (err) {
          container.innerHTML = `
            <div class="ok-empty-state">
              <p class="small mb-0" style="color: #f43f5e;">Falha ao sincronizar o extrato do razão.</p>
            </div>
          `;
        }
      }

      /* ====================================================================
         4. NOTIFICATION BADGE
         ==================================================================== */
      async function updateNotificationBadge() {
        try {
          const res = await window.apiClient.get('/notifications/unread-count');
          const count = res.data && res.data.unreadCount ? res.data.unreadCount : 0;
          const badge = document.getElementById('rail-notification-badge');
          if (badge && count > 0) {
            badge.classList.remove('d-none');
          }
        } catch (e) {}
      }

      /* ====================================================================
         5. AÇÕES GLOBAIS
         ==================================================================== */
      function setupGlobalActions() {
        const toggleBtn = document.getElementById('sidebar-toggle-btn');
        if (toggleBtn) {
          toggleBtn.addEventListener('click', () => {
            document.body.classList.toggle('mobile-nav-active');
          });
        }

        document.querySelectorAll('[data-action="logout"]').forEach(btn => {
          btn.addEventListener('click', async function (e) {
            e.preventDefault();
            try {
              await window.apiClient.post('/auth/logout', {});
              if (window.apiClient && typeof window.apiClient.clearSession === 'function') {
                window.apiClient.clearSession();
              }
            } catch (err) {}
            window.location.href = '/login';
          });
        });

        document.addEventListener('keydown', function (e) {
          if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
            const input = document.getElementById('global-dashboard-search');
            if (input) { e.preventDefault(); input.focus(); }
          }
        });

        // Filtros de tempo (comportamento visual original)
        document.querySelectorAll('.ok-filter-item').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.ok-filter-item').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
          });
        });
      }

      /* ====================================================================
         INICIALIZAÇÃO
         ==================================================================== */
      document.addEventListener('DOMContentLoaded', () => {
        initThemeToggle();
        setupGlobalActions();
        hydrateUserIdentity();   // hidrata avatar real do backend (foto de perfil)
        loadWalletMetrics();
        loadGroupsRoster();
        updateNotificationBadge();
      });
    })();
  </script>
