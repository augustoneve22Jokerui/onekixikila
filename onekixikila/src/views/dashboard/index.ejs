      <a href="/notifications" class="ok-rail-link" title="Notificações">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
        <span class="ok-badge-dot d-none" id="rail-notification-badge"></span>
      </a>
    </nav>

    <div class="ok-rail-footer">
      <a href="/profile" class="ok-rail-link" title="Perfil">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
      </a>
      <button type="button" class="ok-rail-link border-0 text-danger" data-action="logout" title="Terminar Sessão">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
      </button>
    </div>
  </aside>

  <!-- ======================================================================
       CONTEÚDO PRINCIPAL
       ====================================================================== -->
  <div class="ok-viewport-shell">

    <!-- Navbar Superior -->
    <header class="ok-top-nav">
      <div class="ok-search-capsule">
        <span class="search-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </span>
        <input type="search" id="global-dashboard-search" placeholder="Pesquisar grupos, membros ou comprovativos..." autocomplete="off">
        <kbd class="shortcut-hint">Ctrl K</kbd>
      </div>

      <div class="ok-nav-actions">
        <button type="button" id="sidebar-toggle-btn" class="ok-action-circle d-lg-none" aria-label="Abrir menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>

        <button type="button" id="theme-toggle-btn" class="ok-theme-toggle" title="Alternar tema claro/escuro" aria-label="Alternar tema">
          <svg id="theme-toggle-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
        </button>

        <a href="/notifications" class="ok-action-circle" title="Notificações">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
        </a>

        <a href="/profile" class="ok-profile-pill">
          <img 
            id="ok-nav-avatar"
            src="<%= typeof user !== 'undefined' && user && (user.avatarUrl || user.avatar_url || user.avatar) ? (user.avatarUrl || user.avatar_url || user.avatar) : '/assets/images/avatar-default.png' %>" 
            data-fallback='data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 fill=%22%237c3aed%22/%3E%3Ccircle cx=%2232%22 cy=%2224%22 r=%2212%22 fill=%22%23ffffff%22/%3E%3Cpath d=%22M8 64c0-13.255 10.745-24 24-24s24 10.745 24 24%22 fill=%22%23ffffff%22/%3E%3C/svg%3E'
            alt="Avatar" 
            class="ok-profile-avatar-nav"
          >
          <div class="d-flex flex-column text-start">
            <span class="fw-bold" id="ok-nav-fullname" style="font-size: 0.85rem; line-height: 1.1;"><%= typeof user !== 'undefined' && user && (user.fullName || user.full_name) ? (user.fullName || user.full_name).split(' ')[0] : 'Membro' %></span>
            <span class="text-muted" id="ok-nav-role" style="font-size: 0.7rem;"><%= typeof user !== 'undefined' && user && user.role ? user.role : 'Utilizador' %></span>
          </div>
        </a>
      </div>
    </header>

    <!-- Hero Estampado -->
    <section class="ok-canvas-hero-title">
      <div>
        <h1 class="ok-page-title-main">
          Carteira Kixikila,
          <span class="user-highlight" id="ok-hero-username"><%= typeof user !== 'undefined' && user && (user.fullName || user.full_name) ? (user.fullName || user.full_name) : 'Membro' %></span>
          <span class="ok-live-beacon">
            <span class="ok-pulse-dot"></span>
            Painel Ativo
          </span>
        </h1>
        <p class="ok-canvas-sub">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg>
          <%= new Date().toLocaleDateString('pt-AO', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %> &bull; Luanda, Angola
        </p>
      </div>

      <div class="ok-time-filter-pill">
        <button class="ok-filter-item active" data-range="today">Hoje</button>
        <button class="ok-filter-item" data-range="week">Semana</button>
        <button class="ok-filter-item" data-range="month">Mês</button>
        <button class="ok-filter-item" data-range="cycle">Ciclo</button>
      </div>
    </section>

    <!-- =========================================================================
       SESSÃO 1: 4 CARDS CHAPADOS (RESUMO KIXIKILA)
       ========================================================================= -->
    <div class="ok-flat-quad-strip">

      <div class="ok-flat-card-box theme-white">
        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="18" stroke="currentColor" stroke-linecap="square"/>
              <path d="M16 24L22 30L32 18" stroke="currentColor" stroke-linecap="square"/>
            </svg>
          </div>
          <h5 class="ok-flat-title">Total Arrecadado</h5>
          <p class="ok-flat-desc">Contribuições confirmadas nos grupos ativos.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" id="stat-total-collected">0 Kz</span>
          <div class="ok-flat-trend">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="18 15 12 9 6 15"></polyline></svg>
            +18.4%
          </div>
        </div>
      </div>

      <div class="ok-flat-card-box theme-lime">
        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="6" y="14" width="36" height="24" stroke="currentColor" stroke-linecap="square"/>
              <circle cx="24" cy="26" r="4" stroke="currentColor"/>
            </svg>
          </div>
          <h5 class="ok-flat-title">Fundo em Rodada</h5>
          <p class="ok-flat-desc">Pool total da vez corrente nos grupos.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" id="stat-pool-target">0 Kz</span>
          <div class="ok-flat-trend">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            Na Mão da Vez
          </div>
        </div>
      </div>

      <div class="ok-flat-card-box theme-white-alt">
        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="8" y="10" width="32" height="28" stroke="currentColor" stroke-linecap="square"/>
              <line x1="8" y1="18" x2="40" y2="18" stroke="currentColor"/>
              <path d="M18 26H30" stroke="currentColor" stroke-linecap="square"/>
            </svg>
          </div>
          <h5 class="ok-flat-title">Próximo Recebimento</h5>
          <p class="ok-flat-desc">Previsão do próximo desembolso.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" id="stat-next-payout-val">0 Kz</span>
          <div class="ok-flat-trend" id="stat-next-payout-date" style="background: rgba(16,185,129,0.15); color: #10b981;">Em dia</div>
        </div>
      </div>

      <div class="ok-flat-card-box theme-purple">
        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="18" cy="18" r="6" stroke="currentColor"/>
              <circle cx="32" cy="18" r="6" stroke="currentColor"/>
              <path d="M8 40C8 32 13 26 18 26C21 26 24 28 26 30" stroke="currentColor"/>
              <path d="M24 30C26 28 29 26 32 26C37 26 40 32 40 40" stroke="currentColor"/>
            </svg>
          </div>
          <h5 class="ok-flat-title">Membros Ativos</h5>
          <p class="ok-flat-desc">Participantes em rotação nos seus grupos.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" id="stat-active-members-count">0</span>
          <div class="ok-flat-trend">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
            100% Adimplentes
          </div>
        </div>
      </div>

    </div>

    <!-- =========================================================================
       SESSÃO 2: VAULT + GRÁFICO
       ========================================================================= -->
    <div class="ok-canvas-asides-grid">

      <!-- Vault -->
      <div class="ok-balance-vault-card">
        <div class="ok-vault-wave-bg"></div>

        <div>
          <div class="ok-vault-badge-cluster">
            <div class="ok-token-emblem" style="background: linear-gradient(135deg, #7c3aed, #4c1d95);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </div>
            <span class="fw-bold" style="font-size: 0.78rem; color: var(--ok-text-primary);">Carteira Transacional</span>
            <span class="badge ms-auto" style="background: rgba(139,92,246,0.15); color: var(--ok-purple-vibrant); font-size: 0.7rem; font-weight: 800;" id="wallet-status-badge">Ativa</span>
          </div>

          <div class="ok-vault-balance-display">
            <span class="ok-vault-caption">
