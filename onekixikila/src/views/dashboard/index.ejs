            </span>
            <div class="ok-vault-sum" id="user-available-balance">0,00 Kz</div>
            <div class="d-flex justify-content-between align-items-center mt-2" style="font-size: 0.78rem; color: var(--ok-text-muted);">
              <span>Retido em garantia:</span>
              <strong style="color: var(--ok-text-primary);" id="user-locked-balance">0,00 Kz</strong>
