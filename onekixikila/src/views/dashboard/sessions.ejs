  <script>
    (function () {
      'use strict';

      /* ====================================================================
         TEMA CLARO/ESCURO
         ==================================================================== */
      const THEME_KEY = 'ok-theme';
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-btn');
        if (!btn) return;
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      /* ====================================================================
         HELPERS DE AVATAR (real do backend + fallback robusto)
         ==================================================================== */
      const DEFAULT_AVATAR = '/assets/images/avatar-default.png';
      const FALLBACK_DATA_URI = 'data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 fill=%22%237c3aed%22/%3E%3Ccircle cx=%2232%22 cy=%2224%22 r=%2212%22 fill=%22%23ffffff%22/%3E%3Cpath d=%22M8 64c0-13.255 10.745-24 24-24s24 10.745 24 24%22 fill=%22%23ffffff%22/%3E%3C/svg%3E';

      function pick(obj, camel, snake, fallback) {
        if (!obj) return fallback;
        if (obj[camel] !== undefined && obj[camel] !== null) return obj[camel];
        if (obj[snake] !== undefined && obj[snake] !== null) return obj[snake];
        return fallback;
      }

      function isAbsoluteUrl(str) {
        return /^https?:\/\//i.test(str);
      }

      function resolveAvatarUrlForRender(rawUrl) {
        if (!rawUrl) return null;
        const trimmed = String(rawUrl).trim();
        if (!trimmed) return null;
        if (isAbsoluteUrl(trimmed) || trimmed.startsWith('/uploads/') || trimmed.startsWith('/assets/')) {
          if (trimmed === DEFAULT_AVATAR) return null;
          return trimmed;
        }
        return `/uploads/${trimmed.replace(/^\/+/, '')}`;
      }

      function applyAvatarToImg(imgEl, url) {
        if (!imgEl) return;
        const nextSrc = url || DEFAULT_AVATAR;

        if (imgEl.__okFallbackHandler) {
          imgEl.removeEventListener('error', imgEl.__okFallbackHandler);
          imgEl.__okFallbackHandler = null;
        }

        const onErr = function () {
          const fb = imgEl.getAttribute('data-fallback') || FALLBACK_DATA_URI;
          if (fb && imgEl.src !== fb) {
            imgEl.src = fb;
          }
        };
        imgEl.__okFallbackHandler = onErr;
        imgEl.addEventListener('error', onErr);

        if (imgEl.getAttribute('src') !== nextSrc) {
          imgEl.setAttribute('src', nextSrc);
        }
      }

      async function hydrateUserIdentity() {
        try {
          const res = await window.apiClient.get('/users/profile');
          const raw =
            (res && res.data && res.data.user) ||
            (res && res.data && res.data.data) ||
            (res && res.data) ||
            res;
          if (!raw) return;

          const fullName = pick(raw, 'fullName', 'full_name', '');
          const role = pick(raw, 'role', 'role', 'Utilizador');
          const avatarUrl = pick(raw, 'avatarUrl', 'avatar_url', null);
          const normalizedAvatar = resolveAvatarUrlForRender(avatarUrl);

          const navAvatar = document.getElementById('ok-nav-avatar');
          const navName = document.getElementById('ok-nav-fullname');
          const navRole = document.getElementById('ok-nav-role');

          applyAvatarToImg(navAvatar, normalizedAvatar);

          if (navName && fullName) {
            navName.textContent = fullName.split(' ')[0];
          }
          if (navRole) navRole.textContent = role || 'Utilizador';
        } catch (err) {
          console.warn('[SESSIONS:USER:HYDRATE] Falha ao hidratar identidade:', err && err.message);
        }
      }

      /* ====================================================================
         ESTADO E CONFIG
         ==================================================================== */
      const DEVICE_ICON_SVGS = {
        MOBILE: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>',
        TABLET: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="20" x="3" y="2" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>',
        DESKTOP: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>',
        OTHER: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>'
      };

      function formatTimeAgo(isoDate) {
        if (!isoDate) return '—';
        const d = new Date(isoDate);
        const diffMs = Date.now() - d.getTime();
        const diffMin = Math.floor(diffMs / 60000);
        if (diffMin < 1) return 'Ativo agora';
        if (diffMin < 60) return `Há ${diffMin} min`;
        const diffH = Math.floor(diffMin / 60);
        if (diffH < 24) return `Há ${diffH}h`;
        const diffDays = Math.floor(diffH / 24);
        if (diffDays === 1) return 'Ontem';
        return `Há ${diffDays} dias`;
      }

      /* ====================================================================
         CARREGAR SESSÕES
         ==================================================================== */
      async function loadActiveSessions() {
        const streamContainer = document.getElementById('sessions-stream-container');

        try {
          const res = await window.apiClient.get('/sessions/my');
          const sessions = res.data && res.data.sessions ? res.data.sessions : [];

          document.getElementById('sessions-count-badge').textContent = `${sessions.length} ativas`;
          document.getElementById('kpi-active-sessions-num').textContent = sessions.length;

          const uniqueIps = new Set(sessions.map(s => s.ipAddress).filter(Boolean));
          document.getElementById('kpi-unique-ips-num').textContent = uniqueIps.size;

          if (sessions.length === 0) {
            streamContainer.innerHTML = `
              <div class="ok-empty-state">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <h6>Nenhuma sessão ativa encontrada</h6>
                <p class="small text-muted mb-0">Todas as sessões foram encerradas com segurança.</p>
              </div>
            `;
            return;
          }

          let html = '';
          sessions.forEach((s) => {
            const isCurrent = Boolean(s.isCurrent);
            const devSvg = DEVICE_ICON_SVGS[s.deviceType] || DEVICE_ICON_SVGS.OTHER;

            html += `
              <div class="ok-session-item-row ${isCurrent ? 'current-active' : ''}" data-session-id="${s.id}">
                <div class="ok-device-emblem-cell">
                  <div class="ok-device-3d-badge ${isCurrent ? 'current' : 'regular'}">
                    ${devSvg}
                  </div>

                  <div class="ok-device-info-text">
                    <h6>
                      ${s.deviceName || 'Terminal Conectado'}
                      ${isCurrent ? '<span class="ok-status-pill-sub current">Sessão Atual</span>' : ''}
                      ${s.isTrusted ? '<span class="ok-status-pill-sub trusted">Aparelho Confiável</span>' : ''}
                    </h6>

                    <div class="ok-device-specs-line">
                      <span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                        IP: <code>${s.ipAddress || '127.0.0.1'}</code>
                      </span>
                      <span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="3" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                        ${s.operatingSystem || 'SO Desconhecido'} &bull; ${s.browser || 'Navegador'}
                      </span>
                      <span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        ${formatTimeAgo(s.lastActiveAt || s.createdAt)}
                      </span>
                    </div>
                  </div>
                </div>

                <div class="ok-session-action-cell">
                  ${isCurrent ? `
                    <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; font-weight: 700; font-size: 0.78rem; padding: 5px 12px; border-radius: 999px;">
                      Dispositivo em Uso
                    </span>
                  ` : `
                    <button type="button" class="ok-btn-revoke-single" data-action="revoke-single" data-session-id="${s.id}">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                      Encerrar Sessão
                    </button>
                  `}
                </div>
              </div>
            `;
          });

          streamContainer.innerHTML = html;

          streamContainer.querySelectorAll('[data-action="revoke-single"]').forEach((btn) => {
            btn.addEventListener('click', async () => {
              const sid = btn.getAttribute('data-session-id');
              await revokeIndividualSession(sid);
            });
          });

        } catch (err) {
          streamContainer.innerHTML = `<div class="ok-empty-state"><p class="small text-danger mb-0">Falha ao carregar as sessões ativas da base de dados.</p></div>`;
        }
      }

      /* ====================================================================
         DISPOSITIVOS CONFIÁVEIS
         ==================================================================== */
      async function loadTrustedDevices() {
        try {
          const res = await window.apiClient.get('/devices/my');
          const devices = res.data && res.data.devices ? res.data.devices : [];
          const trusted = devices.filter(d => Boolean(d.is_trusted));
          document.getElementById('kpi-trusted-devices-num').textContent = trusted.length;
        } catch (e) {}
      }

      /* ====================================================================
         REVOGAÇÃO INDIVIDUAL
         ==================================================================== */
      async function revokeIndividualSession(sessionId) {
        if (!sessionId) return;

        if (window.Alerts) {
          const confirmed = await window.Alerts.confirm({
            title: 'Terminar Sessão?',
            text: 'O acesso deste aparelho será revogado imediatamente.',
            confirmButtonText: 'Sim, encerrar',
            isDangerous: true
          });
          if (!confirmed) return;
        }

        try {
          await window.apiClient.delete(`/sessions/${sessionId}`);
          if (window.Alerts) window.Alerts.toast('Sessão encerrada com sucesso.', 'success');
          await loadActiveSessions();
        } catch (err) {
          if (window.Alerts) window.Alerts.error('Erro ao Revogar', err.message);
        }
      }

      /* ====================================================================
         TERMINAR OUTRAS
         ==================================================================== */
      async function terminateOtherSessions() {
        if (window.Alerts) {
          const confirmed = await window.Alerts.confirm({
            title: 'Terminar Outras Sessões?',
            text: 'Todas as conexões ativas noutros computadores ou telemóveis serão desconectadas.',
            confirmButtonText: 'Sim, desconectar outros',
            isDangerous: true
          });
          if (!confirmed) return;
        }

        try {
          if (window.Alerts) window.Alerts.showLoading('A revogar sessões...', 'Invalidando tokens remotos.');
          const res = await window.apiClient.delete('/sessions/other');
          if (window.Alerts) {
            window.Alerts.closeLoading();
            await window.Alerts.success('Sessões Revogadas', res.message || 'Todas as outras sessões foram encerradas com sucesso.');
          }
          await loadActiveSessions();
        } catch (err) {
          if (window.Alerts) {
            window.Alerts.closeLoading();
            window.Alerts.error('Falha na Operação', err.message);
          }
        }
      }

      /* ====================================================================
         TERMINAR TUDO E SAIR
         ==================================================================== */
      async function terminateAllSessionsAndExit() {
        if (window.Alerts) {
          const confirmed = await window.Alerts.confirm({
            title: 'Encerrar Absolutamente Tudo?',
            text: 'Esta ação revoga a sessão deste dispositivo e de todos os outros. Será redirecionado para a página de início de sessão.',
            confirmButtonText: 'Terminar e Sair',
            isDangerous: true
          });
          if (!confirmed) return;
        }

        try {
          await window.apiClient.delete('/sessions/all');
          if (window.apiClient) window.apiClient.clearSession();
          window.location.href = '/login?expired=1';
        } catch (err) {
          window.location.href = '/login';
        }
      }

      /* ====================================================================
         AÇÕES GLOBAIS
         ==================================================================== */
      function setupGlobalActions() {
        const toggleBtn = document.getElementById('sidebar-toggle-btn');
        if (toggleBtn) {
          toggleBtn.addEventListener('click', () => {
            document.body.classList.toggle('mobile-nav-active');
          });
        }

        document.querySelectorAll('[data-action="logout"]').forEach(btn => {
          btn.addEventListener('click', async function (e) {
            e.preventDefault();
            try {
              await window.apiClient.post('/auth/logout', {});
              if (window.apiClient && typeof window.apiClient.clearSession === 'function') {
                window.apiClient.clearSession();
              }
            } catch (err) {}
            window.location.href = '/login';
          });
        });
      }

      /* ====================================================================
         INIT
         ==================================================================== */
      document.addEventListener('DOMContentLoaded', () => {
        initThemeToggle();
        setupGlobalActions();
        hydrateUserIdentity();

        loadActiveSessions();
        loadTrustedDevices();

        document.getElementById('btn-terminate-other-sessions')?.addEventListener('click', terminateOtherSessions);
        document.getElementById('btn-side-revoke-others')?.addEventListener('click', terminateOtherSessions);
        document.getElementById('btn-terminate-all-exit')?.addEventListener('click', terminateAllSessionsAndExit);
        document.getElementById('btn-reload-sessions')?.addEventListener('click', loadActiveSessions);
      });
    })();
  </script>
</body>
</html>