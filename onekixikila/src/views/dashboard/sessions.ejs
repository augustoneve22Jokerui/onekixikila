<!DOCTYPE html>
<html lang="pt-AO">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title><%= typeof title !== 'undefined' ? title : 'Dispositivos e Sessões — OneKixikila' %></title>
  <% if (typeof csrfToken !== 'undefined') { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
  <% } %>
  <link rel="icon" type="image/x-icon" href="/assets/images/favicon.ico">

  <!-- Tipografia -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

  <style>
    /* =========================================================================
       SISTEMA DE DESIGN — ONEKIXIKILA (TEMA ESCURO PADRÃO + TEMA CLARO)
       Escala MAIOR (igual à Carteira ampliada)
       ========================================================================= */
    :root,
    html[data-theme="dark"] {
      --ok-bg-canvas: #050508;
      --ok-bg-surface: #0a0a10;
      --ok-bg-elevated: #111118;

      --ok-purple-primary: #7c3aed;
      --ok-purple-vibrant: #8b5cf6;
      --ok-purple-soft: rgba(139, 92, 246, 0.12);
      --ok-purple-border: rgba(139, 92, 246, 0.3);

      --ok-accent-emerald: #10b981;
      --ok-accent-amber: #f59e0b;
      --ok-accent-rose: #f43f5e;
      --ok-accent-cyan: #06b6d4;

      --ok-text-primary: #ffffff;
      --ok-text-secondary: #cbd5e1;
      --ok-text-muted: #94a3b8;

      --ok-border-subtle: rgba(255, 255, 255, 0.08);
      --ok-input-bg: rgba(255, 255, 255, 0.04);
      --ok-pill-bg: rgba(255, 255, 255, 0.05);
      --ok-pill-bg-hover: rgba(139, 92, 246, 0.12);
      --ok-meter-bg: rgba(255, 255, 255, 0.05);
      --ok-shadow-card: rgba(0, 0, 0, 0.75);
      --ok-shadow-sidebar: rgba(0, 0, 0, 0.6);

      --ok-radius-pill: 9999px;
      --ok-sidebar-width: 96px;
      --ok-navbar-height: 92px;
    }

    html[data-theme="light"] {
      --ok-bg-canvas: #f4f5f9;
      --ok-bg-surface: #ffffff;
      --ok-bg-elevated: #ffffff;

      --ok-purple-primary: #6d28d9;
      --ok-purple-vibrant: #7c3aed;
      --ok-purple-soft: rgba(124, 58, 237, 0.08);
      --ok-purple-border: rgba(124, 58, 237, 0.25);

      --ok-text-primary: #0f172a;
      --ok-text-secondary: #334155;
      --ok-text-muted: #64748b;

      --ok-border-subtle: rgba(15, 23, 42, 0.10);
      --ok-input-bg: #ffffff;
      --ok-pill-bg: rgba(15, 23, 42, 0.04);
      --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
      --ok-meter-bg: rgba(15, 23, 42, 0.06);
      --ok-shadow-card: rgba(15, 23, 42, 0.10);
      --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);
    }

    @media (prefers-color-scheme: light) {
      html:not([data-theme]) {
        --ok-bg-canvas: #f4f5f9;
        --ok-bg-surface: #ffffff;
        --ok-bg-elevated: #ffffff;

        --ok-purple-primary: #6d28d9;
        --ok-purple-vibrant: #7c3aed;
        --ok-purple-soft: rgba(124, 58, 237, 0.08);
        --ok-purple-border: rgba(124, 58, 237, 0.25);

        --ok-text-primary: #0f172a;
        --ok-text-secondary: #334155;
        --ok-text-muted: #64748b;

        --ok-border-subtle: rgba(15, 23, 42, 0.10);
        --ok-input-bg: #ffffff;
        --ok-pill-bg: rgba(15, 23, 42, 0.04);
        --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
        --ok-meter-bg: rgba(15, 23, 42, 0.06);
        --ok-shadow-card: rgba(15, 23, 42, 0.10);
        --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);
      }
    }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-font-smoothing: antialiased; }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--ok-bg-canvas);
      color: var(--ok-text-primary);
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
      transition: background-color 0.25s ease, color 0.25s ease;
      font-size: 15px;
    }

    .ok-ambient-glow-core {
      position: fixed;
      top: -140px; left: 20%;
      width: 650px; height: 650px;
      background: radial-gradient(circle, rgba(124, 58, 237, 0.16) 0%, rgba(5, 5, 8, 0) 70%);
      pointer-events: none; z-index: 0; filter: blur(100px);
    }
    html[data-theme="light"] .ok-ambient-glow-core {
      background: radial-gradient(circle, rgba(124, 58, 237, 0.12) 0%, rgba(244, 245, 249, 0) 70%);
    }

    /* =========================================================================
       BARRA LATERAL SLIM TECH
       ========================================================================= */
    .ok-rail-sidebar {
      position: fixed;
      top: 24px; left: 24px; bottom: 24px;
      width: var(--ok-sidebar-width);
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 24px;
      display: flex; flex-direction: column; align-items: center;
      padding: 26px 0;
      z-index: 1040;
      box-shadow: 0 12px 36px var(--ok-shadow-sidebar);
      backdrop-filter: blur(24px);
      transition: all 0.3s ease;
    }

    .ok-brand-emblem {
      width: 56px; height: 56px; border-radius: 18px;
      background: linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 32px;
      box-shadow: 0 10px 26px rgba(124, 58, 237, 0.45);
      text-decoration: none;
    }
    .ok-brand-emblem svg { width: 28px; height: 28px; }

    .ok-rail-nav {
      flex: 1;
      display: flex; flex-direction: column; align-items: center;
      gap: 16px; width: 100%;
    }

    .ok-rail-link {
      width: 52px; height: 52px; border-radius: 16px;
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-muted); text-decoration: none;
      transition: all 0.2s ease; background: transparent;
      position: relative;
    }
    .ok-rail-link svg { width: 22px; height: 22px; }
    .ok-rail-link:hover {
      color: var(--ok-purple-vibrant);
      background-color: var(--ok-purple-soft);
      transform: translateY(-2px);
    }
    .ok-rail-link.active {
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      color: #ffffff;
      box-shadow: 0 10px 24px rgba(139, 92, 246, 0.5);
    }

    .ok-rail-footer {
      display: flex; flex-direction: column; align-items: center;
      gap: 12px; width: 100%;
    }

    /* =========================================================================
       VIEWPORT SHELL
       ========================================================================= */
    .ok-viewport-shell {
      margin-left: calc(var(--ok-sidebar-width) + 44px);
      padding: 24px 40px 60px 0;
      position: relative; z-index: 1;
    }

    /* =========================================================================
       TOP BAR — CENTRALIZADA NO CONTEÚDO (max-width 1280px)
       ========================================================================= */
    .ok-top-nav {
      height: var(--ok-navbar-height);
      display: flex; align-items: center; justify-content: space-between;
      max-width: 1280px;
      margin: 0 auto 26px auto;
      gap: 20px;
      flex-wrap: wrap;
    }

    .ok-search-capsule {
      position: relative;
      width: 500px; max-width: 100%;
    }
    .ok-search-capsule input {
      width: 100%; height: 54px;
      border-radius: var(--ok-radius-pill);
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      padding: 0 90px 0 52px;
      font-size: 0.96rem;
      color: var(--ok-text-primary);
      outline: none;
      transition: all 0.25s ease;
    }
    .ok-search-capsule input::placeholder { color: var(--ok-text-muted); }
    .ok-search-capsule input:focus {
      border-color: var(--ok-purple-vibrant);
      box-shadow: 0 0 0 4px var(--ok-purple-soft);
    }
    .ok-search-capsule .search-icon {
      position: absolute; left: 18px; top: 50%;
      transform: translateY(-50%);
      color: var(--ok-text-muted);
    }
    .ok-search-capsule .search-icon svg { width: 18px; height: 18px; }
    .ok-search-capsule .shortcut-hint {
      position: absolute; right: 14px; top: 50%;
      transform: translateY(-50%);
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 8px;
      padding: 4px 9px;
      font-size: 0.74rem;
      color: var(--ok-text-muted);
      font-weight: 600;
    }

    .ok-nav-actions { display: flex; align-items: center; gap: 14px; }

    .ok-action-circle {
      width: 52px; height: 52px; border-radius: 16px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-primary);
      text-decoration: none;
      transition: all 0.2s ease;
      position: relative;
    }
    .ok-action-circle:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      transform: translateY(-2px);
    }

    .ok-profile-pill {
      display: flex; align-items: center; gap: 12px;
      padding: 6px 20px 6px 6px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: var(--ok-radius-pill);
      text-decoration: none; cursor: pointer;
    }
    .ok-profile-avatar-nav {
      width: 44px; height: 44px;
      border-radius: 50%; object-fit: cover;
      background: var(--ok-purple-soft);
      border: 2px solid var(--ok-purple-border);
    }

    .ok-theme-toggle {
      width: 52px; height: 52px; border-radius: 16px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-primary); cursor: pointer;
      transition: all 0.2s ease;
    }
    .ok-theme-toggle:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      transform: translateY(-2px);
    }
    .ok-theme-toggle svg { width: 20px; height: 20px; }

    /* =========================================================================
       HERO
       ========================================================================= */
    .ok-canvas-hero-title {
      max-width: 1280px;
      margin: 0 auto 30px auto;
      display: flex; justify-content: space-between; align-items: flex-end;
      flex-wrap: wrap; gap: 20px;
    }

    .ok-breadcrumb-btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 16px;
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      border-radius: var(--ok-radius-pill);
      color: var(--ok-text-muted);
      text-decoration: none;
      font-size: 0.86rem; font-weight: 700;
      margin-bottom: 12px;
      transition: all 0.2s ease;
    }
    .ok-breadcrumb-btn:hover {
      background: var(--ok-pill-bg-hover);
      color: var(--ok-purple-vibrant);
      border-color: var(--ok-purple-border);
      transform: translateX(-2px);
    }

    .ok-page-title-main {
      font-size: 2.15rem; font-weight: 800;
      letter-spacing: -0.03em; line-height: 1.15;
      color: var(--ok-text-primary);
      margin: 0;
      display: flex; align-items: center; gap: 14px;
      flex-wrap: wrap;
    }

    .ok-live-beacon {
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 0.76rem; font-weight: 800;
      padding: 5px 13px;
      border-radius: var(--ok-radius-pill);
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #10b981;
      letter-spacing: 0.04em; text-transform: uppercase;
    }
    .ok-pulse-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background-color: #10b981;
      box-shadow: 0 0 10px #10b981;
    }

    .ok-canvas-sub {
      color: var(--ok-text-muted);
      font-size: 0.96rem; margin-top: 8px; line-height: 1.5;
    }

    .ok-canvas-header-actions {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .ok-btn-confirm-pill {
      height: 52px;
      padding: 0 28px;
      border-radius: var(--ok-radius-pill);
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      color: #ffffff;
      border: none;
      font-size: 0.9rem;
      font-weight: 800;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 8px 24px rgba(124, 58, 237, 0.45);
      transition: all 0.25s ease;
      text-decoration: none;
    }
    .ok-btn-confirm-pill:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(124, 58, 237, 0.65);
      color: #ffffff;
    }

    .ok-btn-ghost-pill {
      height: 52px;
      padding: 0 24px;
      border-radius: var(--ok-radius-pill);
      background: var(--ok-pill-bg);
      color: var(--ok-text-primary);
      border: 1px solid var(--ok-border-subtle);
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
      text-decoration: none;
    }
    .ok-btn-ghost-pill:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      background: var(--ok-pill-bg-hover);
      transform: translateY(-2px);
    }

    /* Banner cautelar */
    .ok-security-banner-pill {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 16px 22px;
      border-radius: 18px;
      background: rgba(245, 158, 11, 0.10);
      border: 1px solid rgba(245, 158, 11, 0.3);
      color: #f59e0b;
      margin-bottom: 30px;
      font-size: 0.88rem;
      line-height: 1.55;
      max-width: 1280px;
      margin-left: auto;
      margin-right: auto;
    }

    /* =========================================================================
       LAYOUT 2 COLUNAS
       ========================================================================= */
    .ok-sessions-layout-grid {
      display: grid;
      grid-template-columns: 1fr 420px;
      gap: 32px;
      max-width: 1280px;
      margin: 0 auto;
    }

    .ok-sessions-roster-card {
      background: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 24px;
      padding: 2rem;
      box-shadow: 0 10px 36px var(--ok-shadow-card);
    }

    .ok-roster-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--ok-border-subtle);
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 12px;
    }

    /* Item de sessão */
    .ok-session-item-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px;
      border-radius: 18px;
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      margin-bottom: 14px;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      gap: 14px;
    }
    .ok-session-item-row:hover {
      border-color: var(--ok-purple-border);
      background: var(--ok-purple-soft);
      transform: translateX(4px);
    }
    .ok-session-item-row.current-active {
      border-left: 4px solid var(--ok-purple-vibrant);
      background: linear-gradient(90deg, rgba(139, 92, 246, 0.09) 0%, var(--ok-pill-bg) 100%);
    }

    .ok-device-emblem-cell {
      display: flex;
      align-items: center;
      gap: 16px;
      min-width: 0;
    }

    .ok-device-3d-badge {
      width: 54px;
      height: 54px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
    }
    .ok-device-3d-badge svg { width: 24px; height: 24px; }
    .ok-device-3d-badge.current {
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      color: #ffffff;
      box-shadow: 0 8px 20px rgba(139, 92, 246, 0.5);
    }
    .ok-device-3d-badge.regular {
      background: var(--ok-bg-surface);
      color: var(--ok-purple-vibrant);
      border: 1px solid var(--ok-purple-border);
    }

    .ok-device-info-text h6 {
      font-size: 1rem;
      font-weight: 800;
      color: var(--ok-text-primary);
      margin: 0 0 6px 0;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .ok-status-pill-sub {
      font-size: 0.7rem;
      font-weight: 800;
      padding: 3px 10px;
      border-radius: var(--ok-radius-pill);
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .ok-status-pill-sub.current {
      background: rgba(139, 92, 246, 0.2);
      color: var(--ok-purple-vibrant);
    }
    .ok-status-pill-sub.trusted {
      background: rgba(16, 185, 129, 0.15);
      color: #10b981;
    }

    .ok-device-specs-line {
      font-size: 0.8rem;
      color: var(--ok-text-muted);
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }
    .ok-device-specs-line span {
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .ok-device-specs-line code {
      background: var(--ok-pill-bg);
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 0.78rem;
      color: var(--ok-text-primary);
    }

    .ok-session-action-cell {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .ok-btn-revoke-single {
      height: 40px;
      padding: 0 18px;
      border-radius: var(--ok-radius-pill);
      background: transparent;
      color: #f43f5e;
      border: 1.5px solid rgba(244, 63, 94, 0.4);
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }
    .ok-btn-revoke-single:hover {
      background: #f43f5e;
      color: #ffffff;
      border-color: #f43f5e;
      box-shadow: 0 4px 12px rgba(244, 63, 94, 0.35);
    }

    /* =========================================================================
       WIDGETS DIREITA
       ========================================================================= */
    .ok-side-widget-card {
      background: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 24px;
      padding: 1.75rem;
      box-shadow: 0 10px 36px var(--ok-shadow-card);
      margin-bottom: 24px;
    }

    .ok-widget-title-row {
      display: flex; align-items: center; gap: 10px;
      margin-bottom: 20px;
    }
    .ok-widget-title-row h5 {
      font-size: 1.1rem; font-weight: 800;
      margin: 0;
      color: var(--ok-text-primary);
    }

    .ok-widget-kpi-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .ok-kpi-box {
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 16px;
      padding: 16px;
      text-align: center;
    }
    .ok-kpi-num {
      font-size: 1.65rem; font-weight: 800;
      font-family: 'Space Grotesk', sans-serif;
      color: var(--ok-text-primary);
      line-height: 1.1;
    }
    .ok-kpi-sub {
      font-size: 0.76rem; font-weight: 700;
      color: var(--ok-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-top: 6px;
    }

    .ok-widget-btn-stack {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .ok-side-action-btn {
      width: 100%;
      height: 48px;
      border-radius: var(--ok-radius-pill);
      font-size: 0.88rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
    }
    .ok-side-action-btn.secondary {
      background: var(--ok-pill-bg);
      color: var(--ok-text-primary);
      border: 1.5px solid var(--ok-border-subtle);
    }
    .ok-side-action-btn.secondary:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      background: var(--ok-purple-soft);
      transform: translateY(-2px);
    }
    .ok-side-action-btn.danger {
      background: transparent;
      color: #f43f5e;
      border: 1.5px solid rgba(244, 63, 94, 0.4);
    }
    .ok-side-action-btn.danger:hover {
      background: #f43f5e;
      color: #ffffff;
      border-color: #f43f5e;
      box-shadow: 0 4px 14px rgba(244, 63, 94, 0.35);
      transform: translateY(-2px);
    }

    .ok-vigilance-card {
      background: linear-gradient(145deg, var(--ok-bg-surface) 0%, var(--ok-bg-canvas) 100%);
      border: 1px solid var(--ok-purple-border);
      border-radius: 24px;
      padding: 1.75rem;
      position: relative;
      overflow: hidden;
      box-shadow: 0 8px 32px var(--ok-shadow-card), 0 0 30px rgba(124, 58, 237, 0.15);
    }
    .ok-vigilance-card svg.watermark {
      position: absolute;
      right: -20px; bottom: -20px;
      width: 140px; height: 140px;
      opacity: 0.08;
      pointer-events: none;
      color: var(--ok-purple-vibrant);
    }

    /* Empty state */
    .ok-empty-state {
      text-align: center; padding: 3rem 1.5rem;
      color: var(--ok-text-muted);
    }
    .ok-empty-state svg {
      opacity: 0.4;
      margin-bottom: 0.75rem;
      display: block;
      margin-inline: auto;
    }
    .ok-empty-state h6 {
      font-weight: 700;
      color: var(--ok-text-primary);
      margin-bottom: 6px;
      font-size: 1rem;
    }

    /* Responsividade */
    @media (max-width: 1280px) {
      .ok-sessions-layout-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 991px) {
      .ok-rail-sidebar { transform: translateX(-140%); }
      .ok-viewport-shell { margin-left: 0; padding: 20px; }
      body.mobile-nav-active .ok-rail-sidebar { transform: translateX(0); }
      .ok-page-title-main { font-size: 1.7rem; }
      .ok-session-item-row {
        flex-direction: column;
        align-items: flex-start;
      }
      .ok-session-action-cell {
        width: 100%;
        justify-content: flex-end;
      }
    }
  </style>
</head>
