        <div class="ok-side-widget-card">
          <div class="ok-widget-title-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--ok-purple-vibrant)" stroke-width="2.2" style="width: 22px; height: 22px;">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
