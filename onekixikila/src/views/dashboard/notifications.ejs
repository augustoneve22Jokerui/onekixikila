          </div>

          <div class="ok-channel-switch-row">
            <div class="ok-channel-meta">
              <div class="ok-channel-icon-pill">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
              </div>
              <div>
                <strong class="d-block" style="font-size: 0.9rem;">Painel e WebSockets</strong>
                <span class="text-muted" style="font-size: 0.76rem;">Alertas instantâneos na plataforma</span>
              </div>
            </div>
            <label class="ok-toggle-switch">
              <input type="checkbox" checked disabled>
              <span class="ok-toggle-slider"></span>
            </label>
          </div>

          <div class="ok-channel-switch-row">
            <div class="ok-channel-meta">
              <div class="ok-channel-icon-pill">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              <div>
                <strong class="d-block" style="font-size: 0.9rem;">SMS Gateway (+244)</strong>
                <span class="text-muted" style="font-size: 0.76rem;">Alertas de vencimento de quotas</span>
              </div>
            </div>
            <label class="ok-toggle-switch">
              <input type="checkbox" id="pref-channel-sms" checked>
              <span class="ok-toggle-slider"></span>
            </label>
          </div>

          <div class="ok-channel-switch-row">
            <div class="ok-channel-meta">
              <div class="ok-channel-icon-pill">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              </div>
              <div>
                <strong class="d-block" style="font-size: 0.9rem;">E-mail Corporativo</strong>
                <span class="text-muted" style="font-size: 0.76rem;">Comprovativos e auditoria KYC</span>
              </div>
            </div>
            <label class="ok-toggle-switch">
              <input type="checkbox" id="pref-channel-email" checked>
              <span class="ok-toggle-slider"></span>
            </label>
          </div>
        </div>

        <div class="ok-vigilance-card">
          <svg class="watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>

          <div style="position: relative; z-index: 1;">
            <div class="d-flex align-items-center gap-2 mb-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--ok-purple-vibrant)" stroke-width="2.5" style="width: 22px; height: 22px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <h5 class="fw-bold mb-0" style="font-size: 1.05rem;">Vigilância Permanente</h5>
            </div>
            <p class="small mb-3" style="color: var(--ok-text-secondary); line-height: 1.55; font-size: 0.86rem;">
              As notificações sensíveis (acessos de novos terminais e movimentações do livro-razão) são registadas de forma imutável com garantia de não-repúdio.
            </p>
            <a href="/sessions" class="ok-btn-qr-action">
              Rever Sessões Ativas &rarr;
            </a>
          </div>
        </div>

      </div>

    </div>

  </div>

  <!-- Scripts -->
  <script src="/js/sweet-alert.js"></script>
  <script src="/js/api-client.js"></script>
  <script src="/js/app.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    (function () {
      'use strict';

      /* ====================================================================
         TEMA CLARO/ESCURO
         ==================================================================== */
      const THEME_KEY = 'ok-theme';
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-btn');
        if (!btn) return;
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      /* ====================================================================
         HELPERS DE AVATAR (real do backend + fallback robusto)
         ==================================================================== */
      const DEFAULT_AVATAR = '/assets/images/avatar-default.png';
      const FALLBACK_DATA_URI = 'data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 fill=%22%237c3aed%22/%3E%3Ccircle cx=%2232%22 cy=%2224%22 r=%2212%22 fill=%22%23ffffff%22/%3E%3Cpath d=%22M8 64c0-13.255 10.745-24 24-24s24 10.745 24 24%22 fill=%22%23ffffff%22/%3E%3C/svg%3E';

      function pick(obj, camel, snake, fallback) {
        if (!obj) return fallback;
        if (obj[camel] !== undefined && obj[camel] !== null) return obj[camel];
        if (obj[snake] !== undefined && obj[snake] !== null) return obj[snake];
        return fallback;
      }

      function isAbsoluteUrl(str) {
        return /^https?:\/\//i.test(str);
      }

      function resolveAvatarUrlForRender(rawUrl) {
        if (!rawUrl) return null;
        const trimmed = String(rawUrl).trim();
        if (!trimmed) return null;
        if (isAbsoluteUrl(trimmed) || trimmed.startsWith('/uploads/') || trimmed.startsWith('/assets/')) {
          if (trimmed === DEFAULT_AVATAR) return null;
          return trimmed;
        }
        return `/uploads/${trimmed.replace(/^\/+/, '')}`;
      }

      function applyAvatarToImg(imgEl, url) {
        if (!imgEl) return;
        const nextSrc = url || DEFAULT_AVATAR;

        if (imgEl.__okFallbackHandler) {
          imgEl.removeEventListener('error', imgEl.__okFallbackHandler);
          imgEl.__okFallbackHandler = null;
        }

        const onErr = function () {
          const fb = imgEl.getAttribute('data-fallback') || FALLBACK_DATA_URI;
          if (fb && imgEl.src !== fb) {
            imgEl.src = fb;
          }
        };
        imgEl.__okFallbackHandler = onErr;
        imgEl.addEventListener('error', onErr);

        if (imgEl.getAttribute('src') !== nextSrc) {
          imgEl.setAttribute('src', nextSrc);
        }
      }

      async function hydrateUserIdentity() {
        try {
          const res = await window.apiClient.get('/users/profile');
          const raw =
            (res && res.data && res.data.user) ||
            (res && res.data && res.data.data) ||
            (res && res.data) ||
            res;
          if (!raw) return;

          const fullName = pick(raw, 'fullName', 'full_name', '');
          const role = pick(raw, 'role', 'role', 'Utilizador');
          const avatarUrl = pick(raw, 'avatarUrl', 'avatar_url', null);
          const normalizedAvatar = resolveAvatarUrlForRender(avatarUrl);

          const navAvatar = document.getElementById('ok-nav-avatar');
          const navName = document.getElementById('ok-nav-fullname');
          const navRole = document.getElementById('ok-nav-role');

          applyAvatarToImg(navAvatar, normalizedAvatar);

          if (navName && fullName) {
            navName.textContent = fullName.split(' ')[0];
          }
          if (navRole) navRole.textContent = role || 'Utilizador';
        } catch (err) {
          console.warn('[NOTIFICATIONS:USER:HYDRATE] Falha ao hidratar identidade:', err && err.message);
        }
      }

      /* ====================================================================
         ESTADO E CONFIGURAÇÃO
         ==================================================================== */
      let currentPage = 1;
      let totalPages = 1;
      let currentCategory = 'ALL';
      let searchQuery = '';
      let searchDebounceTimeout = null;
      let lastKnownUnreadCount = null;

      const NOTIF_MAP = {
        CONTRIBUTION_DUE_ALERT: {
          category: 'FINANCE', badgeCls: 'quota', label: 'Vencimento de Quota',
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>'
        },
        CONTRIBUTION_PAID: {
          category: 'FINANCE', badgeCls: 'payment', label: 'Quota Liquidada',
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>'
        },
        PAYMENT_CONFIRMED: {
          category: 'FINANCE', badgeCls: 'payment', label: 'Depósito Confirmado',
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"></polyline></svg>'
        },
        PAYMENT_FAILED: {
          category: 'FINANCE', badgeCls: 'alert', label: 'Falha de Pagamento',
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>'
        },
        ROTATION_BENEFICIARY_TURN: {
          category: 'FINANCE', badgeCls: 'payment', label: 'Contemplação da Kixikila',
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>'
        },
        GROUP_INVITATION: {
          category: 'GROUPS', badgeCls: 'group', label: 'Convite para Kixikila',
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>'
        },
        GROUP_MEMBERSHIP_REQUESTED: {
          category: 'GROUPS', badgeCls: 'group', label: 'Pedido de Adesão',
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>'
        },
        GROUP_MEMBERSHIP_APPROVED: {
          category: 'GROUPS', badgeCls: 'group', label: 'Adesão Aprovada',
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><polyline points="16 11 18 13 22 9"></polyline></svg>'
        },
        GROUP_MEMBERSHIP_REJECTED: {
          category: 'GROUPS', badgeCls: 'alert', label: 'Adesão Não Aprovada',
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="16" y1="10" x2="22" y2="16"></line><line x1="22" y1="10" x2="16" y2="16"></line></svg>'
        },
        LOGIN_ALERT: {
          category: 'SECURITY', badgeCls: 'security', label: 'Alerta de Acesso',
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>'
        },
        ACCOUNT_VERIFICATION: {
          category: 'SECURITY', badgeCls: 'security', label: 'Validação Cadastral',
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>'
        },
        IDENTITY_REVIEW_RESULT: {
          category: 'SECURITY', badgeCls: 'security', label: 'Parecer KYC',
          svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line></svg>'
        }
      };

      const DEFAULT_CONFIG = {
        category: 'SECURITY', badgeCls: 'security', label: 'Aviso da Plataforma',
        svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>'
      };

      const formatTimeAgo = (dateStr) => {
        if (!dateStr) return '';
        const d = new Date(dateStr);
        const diffMs = Date.now() - d.getTime();
        const diffMin = Math.floor(diffMs / 60000);
        if (diffMin < 1) return 'Agora mesmo';
        if (diffMin < 60) return `Há ${diffMin} min`;
        const diffH = Math.floor(diffMin / 60);
        if (diffH < 24) return `Há ${diffH}h`;
        const diffDays = Math.floor(diffH / 24);
        if (diffDays === 1) return 'Ontem';
        if (diffDays < 7) return `Há ${diffDays} dias`;
        return d.toLocaleDateString('pt-AO', { day: '2-digit', month: 'short' });
      };

      const escapeHtml = (value) => String(value == null ? '' : value).replace(/[&<>"']/g, (char) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[char]));

      const safeActionUrl = (value) => {
        if (typeof value !== 'string' || !value.trim()) return '';
        try {
          const url = new URL(value, window.location.origin);
          if (url.origin !== window.location.origin || !['http:', 'https:'].includes(url.protocol)) return '';
          return `${url.pathname}${url.search}${url.hash}`;
        } catch (error) {
          return '';
        }
      };

      /* ====================================================================
         FETCH NOTIFICAÇÕES
         ==================================================================== */
      async function fetchNotifications() {
        const streamContainer = document.getElementById('notifications-stream-list');
        const statusText = document.getElementById('pagination-status-text');

        const params = new URLSearchParams({ page: String(currentPage), limit: '15' });
        if (currentCategory === 'UNREAD') params.set('isRead', 'false');

        try {
          const res = await window.apiClient.get(`/notifications?${params.toString()}`);
          let items = res.data || [];
          const pagination = res.pagination || {};

          totalPages = pagination.totalPages || 1;
          const totalItems = pagination.totalItems || items.length;

          document.getElementById('notif-total-badge').textContent = `${totalItems} registos`;
          document.getElementById('current-page-badge').textContent = currentPage;
          document.getElementById('total-pages-label').textContent = `de ${totalPages}`;

          document.getElementById('prev-page-btn').disabled = currentPage <= 1;
          document.getElementById('next-page-btn').disabled = currentPage >= totalPages;

          if (currentCategory === 'FINANCE') {
            items = items.filter(n => (NOTIF_MAP[n.event_type] || DEFAULT_CONFIG).category === 'FINANCE');
          } else if (currentCategory === 'GROUPS') {
            items = items.filter(n => (NOTIF_MAP[n.event_type] || DEFAULT_CONFIG).category === 'GROUPS');
          } else if (currentCategory === 'SECURITY') {
            items = items.filter(n => (NOTIF_MAP[n.event_type] || DEFAULT_CONFIG).category === 'SECURITY');
          }

          if (searchQuery) {
            const q = searchQuery.toLowerCase();
            items = items.filter(n =>
              (n.title && n.title.toLowerCase().includes(q)) ||
              (n.message && n.message.toLowerCase().includes(q))
            );
          }

          if (items.length === 0) {
            streamContainer.innerHTML = `
              <div class="ok-empty-state">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                  <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
                  <line x1="2" y1="2" x2="22" y2="22"></line>
                </svg>
                <h6>Nenhum alerta localizado</h6>
                <p class="small text-muted mb-0">Não existem notificações correspondentes aos filtros selecionados.</p>
              </div>
            `;
            statusText.textContent = '0 resultados';
            return;
          }

          statusText.textContent = `Mostrando ${items.length} nesta página`;

          let html = '';
          items.forEach((item) => {
            const cfg = NOTIF_MAP[item.event_type] || DEFAULT_CONFIG;
            const isUnread = !item.is_read;
            const payload = item.payload || {};
            const actionUrl = safeActionUrl(payload.actionUrl || payload.url || '');
            const actionLabel = typeof payload.actionLabel === 'string' && payload.actionLabel.trim()
              ? payload.actionLabel.trim()
              : 'Ver detalhes';

            html += `
              <div class="ok-notification-item ${isUnread ? 'unread' : ''}" data-notif-id="${escapeHtml(item.id)}" data-action-url="${escapeHtml(actionUrl)}">
                <div class="ok-notif-emblem ${cfg.badgeCls}">
                  ${cfg.svg}
                </div>

                <div class="ok-notif-content-area">
                  <div class="ok-notif-header-line">
                    <h6 class="ok-notif-title-text">
                      ${escapeHtml(item.title)}
                      ${isUnread ? '<span class="ok-unread-indicator"></span>' : ''}
                    </h6>
                    <span class="ok-notif-timestamp">${formatTimeAgo(item.created_at)}</span>
                  </div>

                  <p class="ok-notif-body-text">${escapeHtml(item.message)}</p>

                  <div class="ok-notif-footer-actions">
                    ${actionUrl ? `
                      <a href="${escapeHtml(actionUrl)}" data-notification-action class="ok-action-link-btn">
                        ${escapeHtml(actionLabel)}
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </a>
                    ` : ''}

                    ${isUnread ? `
                      <button type="button" class="ok-mark-read-micro-btn" data-mark-id="${item.id}" onclick="event.stopPropagation();">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        Marcar como lida
                      </button>
                    ` : ''}
                  </div>
                </div>
              </div>
            `;
          });

          streamContainer.innerHTML = html;

          streamContainer.querySelectorAll('.ok-notification-item').forEach((card) => {
            card.addEventListener('click', async (event) => {
              const notifId = card.getAttribute('data-notif-id');
              const actionUrl = safeActionUrl(card.getAttribute('data-action-url'));
              const actionLink = event.target.closest('[data-notification-action]');
              const isUnread = card.classList.contains('unread');

              if (isUnread && notifId) {
                if (actionLink) event.preventDefault();
                await markSingleAsRead(notifId);
                card.classList.remove('unread');
                card.querySelector('.ok-unread-indicator')?.remove();
                card.querySelector('.ok-mark-read-micro-btn')?.remove();
              }

              if (actionUrl && (actionLink || !event.target.closest('button'))) {
                event.preventDefault();
                window.location.assign(actionUrl);
              }
            });
          });

          streamContainer.querySelectorAll('[data-mark-id]').forEach((btn) => {
            btn.addEventListener('click', async (e) => {
              e.stopPropagation();
              const notifId = btn.getAttribute('data-mark-id');
              await markSingleAsRead(notifId);
              const parent = btn.closest('.ok-notification-item');
              if (parent) {
                parent.classList.remove('unread');
                parent.querySelector('.ok-unread-indicator')?.remove();
                btn.remove();
              }
            });
          });

        } catch (err) {
          streamContainer.innerHTML = `<div class="ok-empty-state"><p class="small text-danger mb-0">Falha ao conectar com o serviço de notificações.</p></div>`;
        }
      }

      async function markSingleAsRead(notificationId) {
        try {
          await window.apiClient.patch(`/notifications/${notificationId}/read`, {});
          updateSummaryMetrics();
        } catch (e) {
          console.error('[NOTIF:MARK_READ:ERROR]', e);
        }
      }

      async function markAllNotificationsAsRead() {
        if (window.Alerts) window.Alerts.showLoading('A atualizar...', 'Marcando todas as notificações como lidas.');
        try {
          await window.apiClient.patch('/notifications/read-all', {});
          if (window.Alerts) {
            window.Alerts.closeLoading();
            window.Alerts.toast('Todas as notificações foram marcadas como lidas.', 'success');
          }
          await updateSummaryMetrics();
          await fetchNotifications();
        } catch (err) {
          if (window.Alerts) {
            window.Alerts.closeLoading();
            window.Alerts.error(err.message || 'Erro ao atualizar notificações.');
          }
        }
      }

      async function updateSummaryMetrics() {
        try {
          const res = await window.apiClient.get('/notifications/unread-count');
          const unread = res.data && res.data.unreadCount !== undefined ? res.data.unreadCount : 0;

          document.getElementById('kpi-unread-count').textContent = unread;
          const railBadge = document.getElementById('rail-notif-dot');
          if (railBadge) railBadge.classList.toggle('d-none', unread === 0);

          const sample = await window.apiClient.get('/notifications?limit=50');
          const items = sample.data || [];

          let fin = 0, grp = 0, sec = 0;
          items.forEach(i => {
            const cat = (NOTIF_MAP[i.event_type] || DEFAULT_CONFIG).category;
            if (cat === 'FINANCE') fin++;
            else if (cat === 'GROUPS') grp++;
            else if (cat === 'SECURITY') sec++;
          });

          document.getElementById('kpi-financial-count').textContent = fin;
          document.getElementById('kpi-groups-count').textContent = grp;
          document.getElementById('kpi-security-count').textContent = sec;
          return Number(unread) || 0;
        } catch (e) {
          return null;
        }
      }

      async function pollForNewNotifications() {
        if (document.hidden) return;
        const unreadCount = await updateSummaryMetrics();
        if (unreadCount === null) return;
        if (lastKnownUnreadCount !== null && unreadCount > lastKnownUnreadCount) {
          await fetchNotifications();
        }
        lastKnownUnreadCount = unreadCount;
      }

      /* ====================================================================
         AÇÕES GLOBAIS
         ==================================================================== */
      function setupGlobalActions() {
        const toggleBtn = document.getElementById('sidebar-toggle-btn');
        if (toggleBtn) {
          toggleBtn.addEventListener('click', () => {
            document.body.classList.toggle('mobile-nav-active');
          });
        }

        document.querySelectorAll('[data-action="logout"]').forEach(btn => {
          btn.addEventListener('click', async function (e) {
            e.preventDefault();
            try {
              await window.apiClient.post('/auth/logout', {});
              if (window.apiClient && typeof window.apiClient.clearSession === 'function') {
                window.apiClient.clearSession();
              }
            } catch (err) {}
            window.location.href = '/login';
          });
        });
      }

      /* ====================================================================
         INIT
         ==================================================================== */
      document.addEventListener('DOMContentLoaded', () => {
        initThemeToggle();
        setupGlobalActions();
        hydrateUserIdentity();

        updateSummaryMetrics().then((count) => {
          if (count !== null) lastKnownUnreadCount = count;
        });
        fetchNotifications();
        window.setInterval(pollForNewNotifications, 30000);
        document.addEventListener('visibilitychange', () => {
          if (!document.hidden) pollForNewNotifications();
        });

        document.querySelectorAll('.ok-category-filter-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.ok-category-filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentCategory = btn.getAttribute('data-category');
            currentPage = 1;
            fetchNotifications();
          });
        });

        document.getElementById('btn-mark-all-read')?.addEventListener('click', markAllNotificationsAsRead);

        document.getElementById('prev-page-btn')?.addEventListener('click', () => {
          if (currentPage > 1) { currentPage--; fetchNotifications(); }
        });

        document.getElementById('next-page-btn')?.addEventListener('click', () => {
          if (currentPage < totalPages) { currentPage++; fetchNotifications(); }
        });

        document.getElementById('notif-search-input')?.addEventListener('input', (e) => {
          clearTimeout(searchDebounceTimeout);
          searchDebounceTimeout = setTimeout(() => {
            searchQuery = e.target.value.trim();
            currentPage = 1;
            fetchNotifications();
          }, 300);
        });
      });
    })();
  </script>
</body>
</html>