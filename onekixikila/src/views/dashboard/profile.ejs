  <!-- Scripts -->
  <script src="/js/sweet-alert.js"></script>
  <script src="/js/api-client.js"></script>
  <script src="/js/app.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    (function () {
      'use strict';

      /* ====================================================================
         TEMA CLARO/ESCURO
         ==================================================================== */
      const THEME_KEY = 'ok-theme';
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-btn');
        if (!btn) return;
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      /* ====================================================================
         ESTADO
         ==================================================================== */
      let cachedUser = null;
      let modalAvatarInstance = null;
      let pendingUploadedAvatarUrl = null;

      /* ====================================================================
         NORMALIZAÇÃO DUAL-FORMAT (camelCase + snake_case)
         ==================================================================== */
      function pick(obj, camel, snake, fallback) {
        if (!obj) return fallback;
        if (obj[camel] !== undefined && obj[camel] !== null) return obj[camel];
        if (obj[snake] !== undefined && obj[snake] !== null) return obj[snake];
        return fallback;
      }

      function normalizeUser(raw) {
        if (!raw) return null;
        return {
          id: raw.id,
          email: pick(raw, 'email', 'email', null),
          phoneNumber: pick(raw, 'phoneNumber', 'phone_number', null),
          fullName: pick(raw, 'fullName', 'full_name', ''),
          preferredName: pick(raw, 'preferredName', 'preferred_name', ''),
          avatarUrl: pick(raw, 'avatarUrl', 'avatar_url', null),
          dateOfBirth: (() => {
            const v = pick(raw, 'dateOfBirth', 'date_of_birth', null);
            return v ? String(v).split('T')[0] : null;
          })(),
          gender: pick(raw, 'gender', 'gender', ''),
          province: pick(raw, 'province', 'province', ''),
          municipality: pick(raw, 'municipality', 'municipality', ''),
          neighborhood: pick(raw, 'neighborhood', 'neighborhood', ''),
          addressLine: pick(raw, 'addressLine', 'address_line', ''),
          latitude: pick(raw, 'latitude', 'latitude', null),
          longitude: pick(raw, 'longitude', 'longitude', null),
          locationAuthorized: Boolean(pick(raw, 'locationAuthorized', 'location_authorized', false)),
          preferredLocale: pick(raw, 'preferredLocale', 'preferred_locale', 'pt-AO'),
          preferredCurrency: pick(raw, 'preferredCurrency', 'preferred_currency', 'AOA'),
          notificationPreferences: pick(raw, 'notificationPreferences', 'notification_preferences', null),
          bio: pick(raw, 'bio', 'bio', ''),
          role: pick(raw, 'role', 'role', 'Utilizador'),
          status: pick(raw, 'status', 'status', 'ACTIVE'),
          identityTier: pick(raw, 'identityTier', 'identity_tier', 'TIER_1_UNVERIFIED'),
          createdAt: pick(raw, 'createdAt', 'created_at', null)
        };
      }

      /* ====================================================================
         HELPERS DE AVATAR
         ==================================================================== */
      const DEFAULT_AVATAR = '/assets/images/avatar-default.png';
      const FALLBACK_DATA_URI = 'data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 fill=%22%237c3aed%22/%3E%3Ccircle cx=%2232%22 cy=%2224%22 r=%2212%22 fill=%22%23ffffff%22/%3E%3Cpath d=%22M8 64c0-13.255 10.745-24 24-24s24 10.745 24 24%22 fill=%22%23ffffff%22/%3E%3C/svg%3E';

      function buildAvatarUrlFromUploadResponse(docData) {
        if (!docData) return null;
        // Ordem de preferência:
        // 1. avatarUrl / avatar_url (novo backend AVATAR — já com /uploads/)
        // 2. url (URL absoluta ou relativa já pronta)
        // 3. storageKey (precisa de prefixo /uploads/)
        const direct = docData.avatarUrl || docData.avatar_url || docData.url;
        if (direct) return String(direct);

        const key = docData.storageKey || docData.storage_key;
        if (key) {
          const normalized = String(key).replace(/^\/+/, '');
          return `/uploads/${normalized}`;
        }
        return null;
      }

      function isAbsoluteUrl(str) {
        return /^https?:\/\//i.test(str);
      }

      function resolveAvatarUrlForSave(rawUrl) {
        if (!rawUrl) return null;
        const trimmed = String(rawUrl).trim();
        if (!trimmed) return null;
        // URLs absolutas ou caminhos já prontos (/uploads/...) passam intactos
        if (isAbsoluteUrl(trimmed) || trimmed.startsWith('/uploads/') || trimmed.startsWith('/assets/')) {
          return trimmed;
        }
        // Se for uma storageKey (sem prefixo), prefixa /uploads/
        return `/uploads/${trimmed.replace(/^\/+/, '')}`;
      }

      function resolveAvatarUrlForRender(rawUrl) {
        if (!rawUrl) return null;
        const normalized = resolveAvatarUrlForSave(rawUrl);
        if (!normalized) return null;
        if (normalized === DEFAULT_AVATAR) return null;
        return normalized;
      }

      /**
       * Aplica um src ao <img> e GARANTE que o handler de fallback está ligado.
       * O handler cai SEMPRE para o data-fallback (svg) e nunca fica pendurado.
       */
      function applyAvatarToImg(imgEl, url) {
        if (!imgEl) return;
        const nextSrc = url || DEFAULT_AVATAR;

        // Remove handler antigo se existir
        if (imgEl.__okFallbackHandler) {
          imgEl.removeEventListener('error', imgEl.__okFallbackHandler);
          imgEl.__okFallbackHandler = null;
        }

        // Handler idempotente: sempre que o src falha, cai para o data-fallback
        const onErr = function () {
          const fb = imgEl.getAttribute('data-fallback') || FALLBACK_DATA_URI;
          if (fb && imgEl.src !== fb) {
            imgEl.src = fb;
          }
        };
        imgEl.__okFallbackHandler = onErr;
        imgEl.addEventListener('error', onErr);

        // Só muda o src se for diferente (evita re-render loop)
        if (imgEl.getAttribute('src') !== nextSrc) {
          imgEl.setAttribute('src', nextSrc);
        }
      }

      /* ====================================================================
         DATA FETCH
         ==================================================================== */
      async function fetchUserProfileData() {
        try {
          const res = await window.apiClient.get('/users/profile');
          const raw =
            (res && res.data && res.data.user) ||
            (res && res.data && res.data.data) ||
            (res && res.data) ||
            res;
          const user = normalizeUser(raw);
          if (!user) throw new Error('Dados de utilizador não encontrados.');
          cachedUser = user;

          renderIdentityCard(user);
          populatePersonalForm(user);
          populateLocationForm(user);
          populatePreferencesForm(user);
        } catch (err) {
          if (window.Alerts) {
            window.Alerts.error('Falha de Sincronização', err.message || 'Erro ao carregar dados do perfil.');
          } else {
            console.error('[PROFILE:FETCH:ERROR]', err);
          }
        }
      }

      function renderIdentityCard(user) {
        const nameEl = document.getElementById('user-display-name');
        const emailEl = document.getElementById('user-display-email');
        const phoneEl = document.getElementById('spec-phone-number');
        const createdEl = document.getElementById('spec-created-at');
        const profileAvatar = document.getElementById('user-profile-avatar');
        const navAvatar = document.getElementById('nav-avatar-img');
        const navName = document.getElementById('nav-user-fullname');
        const navRole = document.getElementById('nav-user-role');
        const tierBadge = document.getElementById('user-kyc-tier-badge');

        if (nameEl) nameEl.textContent = user.fullName || user.preferredName || 'Utilizador';
        if (emailEl) emailEl.textContent = user.email || '—';
        if (phoneEl) phoneEl.textContent = user.phoneNumber || '—';

        if (createdEl && user.createdAt) {
          const d = new Date(user.createdAt);
          if (!isNaN(d.getTime())) {
            createdEl.textContent = d.toLocaleDateString('pt-AO', { month: 'short', year: 'numeric' });
          }
        }

        // FOTO DE PERFIL: aplica a foto real se existir; caso contrário, default.
        const normalizedAvatar = resolveAvatarUrlForRender(user.avatarUrl);
        applyAvatarToImg(profileAvatar, normalizedAvatar);
        applyAvatarToImg(navAvatar, normalizedAvatar);

        if (navName) navName.textContent = user.fullName ? user.fullName.split(' ')[0] : 'Membro';
        if (navRole) navRole.textContent = user.role || 'Utilizador';

        const tier = user.identityTier || 'TIER_1_UNVERIFIED';
        if (tierBadge) {
          if (tier === 'TIER_2_VERIFIED' || tier === 'TIER_3_ENHANCED') {
            tierBadge.className = 'ok-kyc-tier-capsule verified';
            tierBadge.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> ' + tier.replace(/_/g, ' ');
          } else {
            tierBadge.className = 'ok-kyc-tier-capsule unverified';
            tierBadge.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg> TIER 1 &bull; NÃO VERIFICADO';
          }
        }
      }

      function populatePersonalForm(user) {
        const setVal = (id, v) => { const el = document.getElementById(id); if (el) el.value = v || ''; };
        setVal('input-fullName', user.fullName);
        setVal('input-preferredName', user.preferredName);
        setVal('input-dateOfBirth', user.dateOfBirth);
        setVal('input-gender', user.gender);
        setVal('input-bio', user.bio);
      }
      function populateLocationForm(user) {
        const setVal = (id, v) => { const el = document.getElementById(id); if (el) el.value = v != null ? v : ''; };
        setVal('input-province', user.province);
        setVal('input-municipality', user.municipality);
        setVal('input-neighborhood', user.neighborhood);
        setVal('input-addressLine', user.addressLine);
        setVal('input-latitude', user.latitude);
        setVal('input-longitude', user.longitude);
        const check = document.getElementById('check-locationAuthorized');
        if (check) check.checked = Boolean(user.locationAuthorized);
      }
      function populatePreferencesForm(user) {
        const localeEl = document.getElementById('select-locale');
        const currencyEl = document.getElementById('select-currency');
        if (localeEl) localeEl.value = user.preferredLocale || 'pt-AO';
        if (currencyEl) currencyEl.value = user.preferredCurrency || 'AOA';

        const prefs = user.notificationPreferences || {};
        const emailEl = document.getElementById('pref-email-active');
        const smsEl = document.getElementById('pref-sms-active');
        const inappEl = document.getElementById('pref-inapp-active');
        if (emailEl) emailEl.checked = prefs.email !== false;
        if (smsEl) smsEl.checked = prefs.sms !== false;
        if (inappEl) inappEl.checked = prefs.inApp !== false;
      }

      /* ====================================================================
         TABS
         ==================================================================== */
      function setupTabs() {
        document.querySelectorAll('.ok-tab-pill-btn[data-tab]').forEach((btn) => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.ok-tab-pill-btn[data-tab]').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const tabId = btn.getAttribute('data-tab');
            document.querySelectorAll('.ok-tab-content-panel').forEach(p => p.classList.add('d-none'));
            const pane = document.getElementById(`tab-pane-${tabId}`);
            if (pane) pane.classList.remove('d-none');
          });
        });
      }

      /* ====================================================================
         FORMULÁRIOS
         ==================================================================== */
      function setupFormSubmissions() {
        const formPersonal = document.getElementById('form-update-personal');
        if (formPersonal) {
          formPersonal.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btn-save-personal');
            if (btn) btn.disabled = true;
            try {
              const payload = {
                fullName: document.getElementById('input-fullName').value.trim(),
                preferredName: document.getElementById('input-preferredName').value.trim() || null,
                dateOfBirth: document.getElementById('input-dateOfBirth').value || null,
                gender: document.getElementById('input-gender').value || null,
                bio: document.getElementById('input-bio').value.trim() || null
              };
              await window.apiClient.put('/users/profile', payload);
              if (window.Alerts) window.Alerts.toast('Dados pessoais atualizados com sucesso!', 'success');
              await fetchUserProfileData();
            } catch (err) {
              if (window.Alerts) window.Alerts.error('Erro ao Atualizar', err.message);
            } finally {
              if (btn) btn.disabled = false;
            }
          });
        }

        const formLocation = document.getElementById('form-update-location');
        if (formLocation) {
          formLocation.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btn-save-location');
            if (btn) btn.disabled = true;
            try {
              const latRaw = document.getElementById('input-latitude').value;
              const lngRaw = document.getElementById('input-longitude').value;
              const payload = {
                province: document.getElementById('input-province').value.trim() || null,
                municipality: document.getElementById('input-municipality').value.trim() || null,
                neighborhood: document.getElementById('input-neighborhood').value.trim() || null,
                addressLine: document.getElementById('input-addressLine').value.trim() || null,
                latitude: latRaw ? Number(latRaw) : null,
                longitude: lngRaw ? Number(lngRaw) : null,
                locationAuthorized: document.getElementById('check-locationAuthorized').checked
              };
              await window.apiClient.patch('/users/location', payload);
              if (window.Alerts) window.Alerts.toast('Localização territorial guardada com sucesso!', 'success');
              await fetchUserProfileData();
            } catch (err) {
              if (window.Alerts) window.Alerts.error('Erro na Localização', err.message);
            } finally {
              if (btn) btn.disabled = false;
            }
          });
        }

        const formPrefs = document.getElementById('form-update-preferences');
        if (formPrefs) {
          formPrefs.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btn-save-preferences');
            if (btn) btn.disabled = true;
            try {
              const payload = {
                preferredLocale: document.getElementById('select-locale').value,
                preferredCurrency: document.getElementById('select-currency').value,
                notificationPreferences: {
                  email: document.getElementById('pref-email-active').checked,
                  sms: document.getElementById('pref-sms-active').checked,
                  inApp: document.getElementById('pref-inapp-active').checked
                }
              };
              await window.apiClient.patch('/users/preferences', payload);
              if (window.Alerts) window.Alerts.toast('Preferências gravadas com sucesso!', 'success');
              await fetchUserProfileData();
            } catch (err) {
              if (window.Alerts) window.Alerts.error('Erro nas Preferências', err.message);
            } finally {
              if (btn) btn.disabled = false;
            }
          });
        }

        const gpsBtn = document.getElementById('btn-detect-gps');
        if (gpsBtn) {
          gpsBtn.addEventListener('click', () => {
            if (!navigator.geolocation) {
              if (window.Alerts) window.Alerts.warning('Geolocalização não suportada no seu navegador.');
              return;
            }
            gpsBtn.disabled = true;
            navigator.geolocation.getCurrentPosition(
              (pos) => {
                document.getElementById('input-latitude').value = pos.coords.latitude.toFixed(6);
                document.getElementById('input-longitude').value = pos.coords.longitude.toFixed(6);
                document.getElementById('check-locationAuthorized').checked = true;
                gpsBtn.disabled = false;
                if (window.Alerts) window.Alerts.toast('Coordenadas captadas pelo GPS!', 'success');
              },
              () => {
                gpsBtn.disabled = false;
                if (window.Alerts) window.Alerts.warning('Acesso à localização negado. Preencha manualmente.');
              },
              { timeout: 10000 }
            );
          });
        }
      }

      /* ====================================================================
         HELPERS DE PUT PARA AVATAR (fallback de nomes + formato)
         ==================================================================== */
      function absolutizeUrl(url) {
        if (!url) return url;
        if (isAbsoluteUrl(url)) return url;
        try {
          return new URL(url, window.location.origin).toString();
        } catch (e) {
          return url;
        }
      }

      /**
       * Tenta guardar o avatar no backend cobrindo as variantes mais comuns:
       *  - { avatarUrl: "/uploads/..." }         (camel, relativo)
       *  - { avatar_url: "/uploads/..." }        (snake, relativo)
       *  - { avatarUrl, avatar_url }             (ambos)
       *  - { avatarUrl: "https://host/uploads/..." } (absoluto, caso o backend valide IsUrl)
       * Devolve { ok, response, error, lastPayload, attempts } para o caller decidir.
       */
      async function putAvatarWithFallbacks(rawUrl) {
        const relative = resolveAvatarUrlForSave(rawUrl); // mantém /uploads/...
        if (!relative) {
          return { ok: false, error: new Error('URL inválida.'), attempts: [] };
        }
        const absolute = absolutizeUrl(relative);

        const attempts = [
          { avatarUrl: relative },
          { avatar_url: relative },
          { avatarUrl: relative, avatar_url: relative },
          { avatarUrl: absolute },
          { avatar_url: absolute },
          { avatarUrl: absolute, avatar_url: absolute }
        ];

        const tried = [];
        let lastErr = null;

        for (const payload of attempts) {
          tried.push(payload);
          try {
            const res = await window.apiClient.put('/users/profile', payload);
            return { ok: true, response: res, payload, attempts: tried };
          } catch (err) {
            lastErr = err;
            // Só continua a tentar em erros de validação; outros (401, 500) abortam
            const status = err && (err.status || err.statusCode);
            if (status && status !== 400 && status !== 422) {
              return { ok: false, error: err, attempts: tried };
            }
          }
        }
        return { ok: false, error: lastErr, attempts: tried };
      }

      function describePutError(err, attempts) {
        const status = (err && (err.status || err.statusCode)) || '?';
        const msg = (err && err.message) || 'Erro desconhecido.';
        const triedNames = Array.from(new Set(attempts.map(a => Object.keys(a).join('+')))).join(', ');
        return `${msg} (HTTP ${status}). Tentativas: ${triedNames}.`;
      }

      /* ====================================================================
         AVATAR
         ==================================================================== */
      function setupAvatarManagement() {
        const modalEl = document.getElementById('modal-upload-avatar');
        if (!modalEl) return;
        modalAvatarInstance = new bootstrap.Modal(modalEl);

        const triggerBtn = document.getElementById('btn-trigger-avatar-modal');
        if (triggerBtn) {
          triggerBtn.addEventListener('click', () => {
            const current = (cachedUser && cachedUser.avatarUrl) || DEFAULT_AVATAR;
            const preview = document.getElementById('avatar-modal-preview');
            const urlInput = document.getElementById('input-avatar-url');
            if (preview) preview.src = current;
            if (urlInput) urlInput.value = (cachedUser && cachedUser.avatarUrl) || '';
            pendingUploadedAvatarUrl = null;
            modalAvatarInstance.show();
          });
        }

        const dropzone = document.getElementById('avatar-dropzone-box');
        const fileInput = document.getElementById('input-avatar-file');

        if (dropzone && fileInput) {
          dropzone.addEventListener('click', () => fileInput.click());

          fileInput.addEventListener('change', async (e) => {
            const file = e.target.files && e.target.files[0];
            if (!file) return;
            if (file.size > 5 * 1024 * 1024) {
              if (window.Alerts) window.Alerts.error('Ficheiro Demasiado Grande', 'O tamanho máximo autorizado é de 5 MB.');
              fileInput.value = '';
              return;
            }
            const reader = new FileReader();
            reader.onload = (re) => {
              const preview = document.getElementById('avatar-modal-preview');
              if (preview && re.target) preview.src = re.target.result;
            };
            reader.readAsDataURL(file);

            const formData = new FormData();
            formData.append('document', file);
            formData.append('category', 'AVATAR');

            try {
              if (window.Alerts) window.Alerts.showLoading('A processar imagem...', 'Inspecionando bytes e enviando ao cofre privado.');
              const res = await window.apiClient.upload('/documents/upload', formData);
              if (window.Alerts) window.Alerts.closeLoading();

              const docData =
                (res && res.data && (res.data.document || res.data.data)) ||
                (res && res.data) ||
                res;
              const finalUrl = buildAvatarUrlFromUploadResponse(docData);
              if (!finalUrl) {
                throw new Error('Resposta do servidor inválida (sem URL nem storageKey).');
              }
              pendingUploadedAvatarUrl = finalUrl;
              const urlInput = document.getElementById('input-avatar-url');
              if (urlInput) urlInput.value = finalUrl;
              if (window.Alerts) window.Alerts.toast('Imagem carregada! Clique em Guardar para confirmar.', 'success');
            } catch (uploadErr) {
              if (window.Alerts) {
                window.Alerts.closeLoading();
                window.Alerts.error('Erro no Upload', uploadErr.message);
              } else {
                console.error('[AVATAR:UPLOAD:ERROR]', uploadErr);
              }
            }
          });
        }

        const saveBtn = document.getElementById('btn-save-avatar');
        if (saveBtn) {
          saveBtn.addEventListener('click', async () => {
            const urlInput = document.getElementById('input-avatar-url');
            const rawFinal = pendingUploadedAvatarUrl || (urlInput && urlInput.value.trim());

            if (!rawFinal) {
              if (window.Alerts) window.Alerts.warning('Selecione uma imagem ou introduza um URL válido.');
              return;
            }

            const original = saveBtn.innerHTML;
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>A guardar...';

            try {
              const result = await putAvatarWithFallbacks(rawFinal);

              if (!result.ok) {
                const detail = describePutError(result.error, result.attempts || []);
                if (window.Alerts) {
                  window.Alerts.error('Falha ao Guardar Fotografia', detail);
                } else {
                  console.error('[AVATAR:PUT:ERROR]', result.error, 'attempts:', result.attempts);
                }
                return;
              }

              if (window.Alerts) window.Alerts.success('Fotografia Atualizada', 'A sua foto de perfil foi alterada com sucesso.');
              if (modalAvatarInstance) modalAvatarInstance.hide();
              pendingUploadedAvatarUrl = null;
              await fetchUserProfileData();
            } catch (saveErr) {
              if (window.Alerts) window.Alerts.error('Falha ao Guardar', saveErr.message);
            } finally {
              saveBtn.disabled = false;
              saveBtn.innerHTML = original;
            }
          });
        }
      }

      /* ====================================================================
         AÇÕES GLOBAIS
         ==================================================================== */
      function setupGlobalActions() {
        const toggleBtn = document.getElementById('sidebar-toggle-btn');
        if (toggleBtn) {
          toggleBtn.addEventListener('click', () => {
            document.body.classList.toggle('mobile-nav-active');
          });
        }
        document.querySelectorAll('[data-action="logout"]').forEach(btn => {
          btn.addEventListener('click', async function (e) {
            e.preventDefault();
            try {
              await window.apiClient.post('/auth/logout', {});
              if (window.apiClient && typeof window.apiClient.clearSession === 'function') {
                window.apiClient.clearSession();
              }
            } catch (err) {}
            window.location.href = '/login';
          });
        });
      }

      /* ====================================================================
         INIT
         ==================================================================== */
      document.addEventListener('DOMContentLoaded', () => {
        initThemeToggle();
        setupGlobalActions();
        setupTabs();
        setupFormSubmissions();
        setupAvatarManagement();
        fetchUserProfileData();
      });
    })();
  </script>
</body>
</html>