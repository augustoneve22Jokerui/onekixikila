<!DOCTYPE html>
<html lang="pt-AO">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>Criar Grupo de Kixikila — OneKixikila</title>
  <% if (typeof csrfToken !== 'undefined') { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
  <% } %>
  <link rel="icon" type="image/x-icon" href="/assets/images/favicon.ico">

  <!-- Tipografia -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>
    /* =========================================================================
       SISTEMA DE DESIGN — ONEKIXIKILA (TEMA ESCURO PADRÃO + TEMA CLARO)
       Sidebar + Top Bar: arredondados. Cards centrais: quadrados.
       Cores 100% roxo.
       ========================================================================= */
    :root,
    html[data-theme="dark"] {
      --ok-bg-canvas: #050508;
      --ok-bg-surface: #0a0a10;
      --ok-bg-elevated: #111118;

      --ok-purple-primary: #7c3aed;
      --ok-purple-vibrant: #8b5cf6;
      --ok-purple-soft: rgba(139, 92, 246, 0.12);
      --ok-purple-border: rgba(139, 92, 246, 0.3);

      --ok-text-primary: #ffffff;
      --ok-text-secondary: #cbd5e1;
      --ok-text-muted: #94a3b8;

      --ok-border-subtle: rgba(255, 255, 255, 0.08);
      --ok-input-bg: rgba(255, 255, 255, 0.04);
      --ok-pill-bg: rgba(255, 255, 255, 0.05);
      --ok-pill-bg-hover: rgba(139, 92, 246, 0.12);
      --ok-meter-bg: rgba(255, 255, 255, 0.05);
      --ok-shadow-card: rgba(0, 0, 0, 0.75);
      --ok-shadow-sidebar: rgba(0, 0, 0, 0.6);

      --ok-radius-pill: 9999px;
      --ok-sidebar-width: 96px;
      --ok-navbar-height: 92px;
    }

    html[data-theme="light"] {
      --ok-bg-canvas: #f4f5f9;
      --ok-bg-surface: #ffffff;
      --ok-bg-elevated: #ffffff;

      --ok-purple-primary: #6d28d9;
      --ok-purple-vibrant: #7c3aed;
      --ok-purple-soft: rgba(124, 58, 237, 0.08);
      --ok-purple-border: rgba(124, 58, 237, 0.25);

      --ok-text-primary: #0f172a;
      --ok-text-secondary: #334155;
      --ok-text-muted: #64748b;

      --ok-border-subtle: rgba(15, 23, 42, 0.10);
      --ok-input-bg: #ffffff;
      --ok-pill-bg: rgba(15, 23, 42, 0.04);
      --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
      --ok-meter-bg: rgba(15, 23, 42, 0.06);
      --ok-shadow-card: rgba(15, 23, 42, 0.10);
      --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);
    }

    @media (prefers-color-scheme: light) {
      html:not([data-theme]) {
        --ok-bg-canvas: #f4f5f9;
        --ok-bg-surface: #ffffff;
        --ok-bg-elevated: #ffffff;

        --ok-purple-primary: #6d28d9;
        --ok-purple-vibrant: #7c3aed;
        --ok-purple-soft: rgba(124, 58, 237, 0.08);
        --ok-purple-border: rgba(124, 58, 237, 0.25);

        --ok-text-primary: #0f172a;
        --ok-text-secondary: #334155;
        --ok-text-muted: #64748b;

        --ok-border-subtle: rgba(15, 23, 42, 0.10);
        --ok-input-bg: #ffffff;
        --ok-pill-bg: rgba(15, 23, 42, 0.04);
        --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
        --ok-meter-bg: rgba(15, 23, 42, 0.06);
        --ok-shadow-card: rgba(15, 23, 42, 0.10);
        --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);
      }
    }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-font-smoothing: antialiased; }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--ok-bg-canvas);
      color: var(--ok-text-primary);
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
      transition: background-color 0.25s ease, color 0.25s ease;
      font-size: 15px;
    }

    .ok-ambient-glow-core {
      position: fixed;
      top: -140px; left: 20%;
      width: 650px; height: 650px;
      background: radial-gradient(circle, rgba(124, 58, 237, 0.16) 0%, rgba(5, 5, 8, 0) 70%);
      pointer-events: none; z-index: 0; filter: blur(100px);
    }
    html[data-theme="light"] .ok-ambient-glow-core {
      background: radial-gradient(circle, rgba(124, 58, 237, 0.12) 0%, rgba(244, 245, 249, 0) 70%);
    }

    /* =========================================================================
       BARRA LATERAL — ARREDONDADA
       ========================================================================= */
    .ok-rail-sidebar {
      position: fixed;
      top: 24px; left: 24px; bottom: 24px;
      width: var(--ok-sidebar-width);
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 24px;
      display: flex; flex-direction: column; align-items: center;
      padding: 26px 0;
      z-index: 1040;
      box-shadow: 0 12px 36px var(--ok-shadow-sidebar);
      backdrop-filter: blur(24px);
      transition: all 0.3s ease;
    }

    .ok-brand-emblem {
      width: 56px; height: 56px; border-radius: 18px;
      background: linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 32px;
      box-shadow: 0 10px 26px rgba(124, 58, 237, 0.45);
      text-decoration: none;
    }
    .ok-brand-emblem svg { width: 28px; height: 28px; }

    .ok-rail-nav {
      flex: 1;
      display: flex; flex-direction: column; align-items: center;
      gap: 16px; width: 100%;
    }

    .ok-rail-link {
      width: 52px; height: 52px; border-radius: 16px;
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-muted); text-decoration: none;
      transition: all 0.2s ease; background: transparent;
      position: relative;
    }
    .ok-rail-link svg { width: 22px; height: 22px; }
    .ok-rail-link:hover {
      color: var(--ok-purple-vibrant);
      background-color: var(--ok-purple-soft);
      transform: translateY(-2px);
    }
    .ok-rail-link.active {
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      color: #ffffff;
      box-shadow: 0 10px 24px rgba(139, 92, 246, 0.5);
    }

    .ok-rail-footer {
      display: flex; flex-direction: column; align-items: center;
      gap: 12px; width: 100%;
    }

    /* =========================================================================
       VIEWPORT SHELL
       ========================================================================= */
    .ok-viewport-shell {
      margin-left: calc(var(--ok-sidebar-width) + 44px);
      padding: 24px 40px 60px 0;
      position: relative; z-index: 1;
    }

    /* =========================================================================
       TOP BAR — ARREDONDADA
       ========================================================================= */
    .ok-top-nav {
      height: var(--ok-navbar-height);
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 26px;
      gap: 20px;
      flex-wrap: wrap;
    }

    .ok-search-capsule {
      position: relative;
      width: 500px; max-width: 100%;
    }
    .ok-search-capsule input {
      width: 100%; height: 54px;
      border-radius: var(--ok-radius-pill);
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      padding: 0 90px 0 52px;
      font-size: 0.96rem;
      color: var(--ok-text-primary);
      outline: none;
      transition: all 0.25s ease;
    }
    .ok-search-capsule input::placeholder { color: var(--ok-text-muted); }
    .ok-search-capsule input:focus {
      border-color: var(--ok-purple-vibrant);
      box-shadow: 0 0 0 4px var(--ok-purple-soft);
    }
    .ok-search-capsule .search-icon {
      position: absolute; left: 18px; top: 50%;
      transform: translateY(-50%);
      color: var(--ok-text-muted);
    }
    .ok-search-capsule .search-icon svg { width: 18px; height: 18px; }
    .ok-search-capsule .shortcut-hint {
      position: absolute; right: 14px; top: 50%;
      transform: translateY(-50%);
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 8px;
      padding: 4px 9px;
      font-size: 0.74rem;
      color: var(--ok-text-muted);
      font-weight: 600;
    }

    .ok-nav-actions { display: flex; align-items: center; gap: 14px; }

    .ok-action-circle {
      width: 52px; height: 52px; border-radius: 16px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-primary);
      text-decoration: none;
      transition: all 0.2s ease;
      position: relative;
    }
    .ok-action-circle:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      transform: translateY(-2px);
    }

    .ok-profile-pill {
      display: flex; align-items: center; gap: 12px;
      padding: 6px 20px 6px 6px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: var(--ok-radius-pill);
      text-decoration: none; cursor: pointer;
    }
    .ok-profile-avatar-nav {
      width: 44px; height: 44px;
      border-radius: 50%; object-fit: cover;
      background: var(--ok-purple-soft);
      border: 2px solid var(--ok-purple-border);
    }

    .ok-theme-toggle {
      width: 52px; height: 52px; border-radius: 16px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-primary); cursor: pointer;
      transition: all 0.2s ease;
    }
    .ok-theme-toggle:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      transform: translateY(-2px);
    }
    .ok-theme-toggle svg { width: 20px; height: 20px; }

    /* =========================================================================
       HERO — ARREDONDADO
       ========================================================================= */
    .ok-canvas-hero-title {
      max-width: 1280px;
      margin: 0 auto 30px auto;
      display: flex; justify-content: space-between; align-items: flex-end;
      flex-wrap: wrap; gap: 20px;
    }

    .ok-breadcrumb-btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 16px;
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      border-radius: var(--ok-radius-pill);
      color: var(--ok-text-muted);
      text-decoration: none;
      font-size: 0.86rem; font-weight: 700;
      margin-bottom: 12px;
      transition: all 0.2s ease;
    }
    .ok-breadcrumb-btn:hover {
      background: var(--ok-pill-bg-hover);
      color: var(--ok-purple-vibrant);
      border-color: var(--ok-purple-border);
      transform: translateX(-2px);
    }

    .ok-page-title-main {
      font-size: 2.15rem; font-weight: 800;
      letter-spacing: -0.03em; line-height: 1.15;
      color: var(--ok-text-primary);
      margin: 0;
      display: flex; align-items: center; gap: 14px;
      flex-wrap: wrap;
    }

    .ok-live-beacon {
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 0.76rem; font-weight: 800;
      padding: 5px 13px;
      border-radius: var(--ok-radius-pill);
      background: var(--ok-purple-soft);
      border: 1px solid var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      letter-spacing: 0.04em; text-transform: uppercase;
    }
    .ok-pulse-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background-color: var(--ok-purple-vibrant);
      box-shadow: 0 0 10px var(--ok-purple-vibrant);
    }

    .ok-canvas-sub {
      color: var(--ok-text-muted);
      font-size: 0.96rem; margin-top: 8px; line-height: 1.5;
    }

    /* =========================================================================
       CARD CENTRAL — QUADRADO
       ========================================================================= */
    .ok-create-layout {
      max-width: 900px;
      margin: 0 auto;
    }

    .ok-create-card {
      background: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 0;
      padding: 0;
      box-shadow: 0 8px 32px var(--ok-shadow-card);
      overflow: hidden;
    }
    .ok-create-card-header {
      padding: 1.5rem 1.75rem;
      border-bottom: 1px solid var(--ok-border-subtle);
      display: flex; justify-content: space-between; align-items: center;
      flex-wrap: wrap; gap: 12px;
    }
    .ok-create-card-header h5 {
      font-size: 1.15rem; font-weight: 800;
      color: var(--ok-text-primary);
      margin: 0;
      display: flex; align-items: center; gap: 8px;
    }
    .ok-create-card-body { padding: 1.75rem; }

    /* Form fields quadrados */
    .ok-form-label {
      font-size: 0.86rem; font-weight: 700;
      color: var(--ok-text-primary);
      margin-bottom: 8px;
      display: block;
    }
    .ok-form-control,
    .ok-form-select {
      width: 100%;
      height: 50px;
      border-radius: 0;
      background: var(--ok-input-bg);
      border: 1px solid var(--ok-border-subtle);
      padding: 0 18px;
      font-size: 0.92rem;
      color: var(--ok-text-primary);
      outline: none;
      transition: all 0.2s ease;
    }
    .ok-form-control:focus,
    .ok-form-select:focus {
      border-color: var(--ok-purple-vibrant);
      background: var(--ok-bg-surface);
      box-shadow: 0 0 0 4px var(--ok-purple-soft);
    }
    .ok-form-control::placeholder { color: var(--ok-text-muted); }
    .ok-form-select option { color: #0f172a; }

    .ok-form-textarea {
      width: 100%;
      border-radius: 0;
      background: var(--ok-input-bg);
      border: 1px solid var(--ok-border-subtle);
      padding: 14px 18px;
      font-size: 0.92rem;
      color: var(--ok-text-primary);
      outline: none;
      resize: vertical;
      min-height: 80px;
      transition: all 0.2s ease;
    }
    .ok-form-textarea:focus {
      border-color: var(--ok-purple-vibrant);
      background: var(--ok-bg-surface);
      box-shadow: 0 0 0 4px var(--ok-purple-soft);
    }
    .ok-form-textarea::placeholder { color: var(--ok-text-muted); }

    /* Botão submit — QUADRADO */
    .ok-btn-submit {
      height: 54px;
      padding: 0 32px;
      border-radius: 0;
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      color: #ffffff;
      border: none;
      font-size: 0.96rem;
      font-weight: 800;
      cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center;
      gap: 10px;
      box-shadow: 0 8px 24px rgba(124, 58, 237, 0.45);
      transition: all 0.25s ease;
      width: 100%;
    }
    .ok-btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(124, 58, 237, 0.65);
      color: #ffffff;
    }
    .ok-btn-submit:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      transform: none;
    }

    /* Botão voltar estampado no hero — pill */
    .ok-btn-ghost-pill {
      height: 48px; padding: 0 22px;
      border-radius: var(--ok-radius-pill);
      background: var(--ok-pill-bg);
      color: var(--ok-text-primary);
      border: 1px solid var(--ok-border-subtle);
      font-size: 0.86rem; font-weight: 700;
      cursor: pointer;
      display: inline-flex; align-items: center; gap: 8px;
      transition: all 0.2s ease;
      text-decoration: none;
    }
    .ok-btn-ghost-pill:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      background: var(--ok-pill-bg-hover);
      transform: translateY(-2px);
    }

    /* Responsividade */
    @media (max-width: 991px) {
      .ok-rail-sidebar { transform: translateX(-140%); }
      .ok-viewport-shell { margin-left: 0; padding: 20px; }
      body.mobile-nav-active .ok-rail-sidebar { transform: translateX(0); }
      .ok-page-title-main { font-size: 1.7rem; }
    }
  </style>
</head>
<body>

  <div class="ok-ambient-glow-core"></div>

  <!-- ======================================================================
       BARRA LATERAL SLIM TECH
       ====================================================================== -->
  <aside class="ok-rail-sidebar" id="app-rail-sidebar" aria-label="Navegação Principal">
    <a href="/dashboard" class="ok-brand-emblem" title="OneKixikila Core">
      <svg viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
        <polyline points="2 17 12 22 22 17"></polyline>
        <polyline points="2 12 12 17 22 12"></polyline>
      </svg>
    </a>

    <nav class="ok-rail-nav">
      <a href="/dashboard" class="ok-rail-link" title="Painel Geral">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
      </a>

      <a href="/wallet" class="ok-rail-link" title="Carteira">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"></path></svg>
      </a>

      <a href="/groups" class="ok-rail-link active" title="Grupos">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
      </a>

      <a href="/wallet/transfer" class="ok-rail-link" title="Transferências">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
      </a>

      <a href="/wallet/deposit" class="ok-rail-link" title="Depósitos">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
      </a>

      <a href="/wallet/statement" class="ok-rail-link" title="Extrato">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
      </a>

      <a href="/notifications" class="ok-rail-link" title="Notificações">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
      </a>
    </nav>

    <div class="ok-rail-footer">
      <a href="/profile" class="ok-rail-link" title="Perfil">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
      </a>
      <button type="button" class="ok-rail-link border-0 text-danger" data-action="logout" title="Terminar Sessão">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
      </button>
    </div>
  </aside>

  <!-- ======================================================================
       CONTEÚDO PRINCIPAL
       ====================================================================== -->
  <div class="ok-viewport-shell">

    <!-- Top Bar -->
    <header class="ok-top-nav">
      <div class="ok-search-capsule">
        <span class="search-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </span>
        <input type="search" placeholder="Pesquisar grupos, membros..." autocomplete="off">
        <kbd class="shortcut-hint">Ctrl K</kbd>
      </div>

      <div class="ok-nav-actions">
        <button type="button" id="sidebar-toggle-btn" class="ok-action-circle d-lg-none" aria-label="Abrir menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>

        <button type="button" id="theme-toggle-btn" class="ok-theme-toggle" title="Alternar tema claro/escuro" aria-label="Alternar tema">
          <svg id="theme-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
        </button>

        <a href="/notifications" class="ok-action-circle" title="Notificações">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
        </a>

        <a href="/profile" class="ok-profile-pill">
          <img 
            id="ok-nav-avatar"
            src="<%= typeof user !== 'undefined' && user && user.avatarUrl ? user.avatarUrl : '/assets/images/avatar-default.png' %>" 
            data-fallback='data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 fill=%22%237c3aed%22/%3E%3Ccircle cx=%2232%22 cy=%2224%22 r=%2212%22 fill=%22%23ffffff%22/%3E%3Cpath d=%22M8 64c0-13.255 10.745-24 24-24s24 10.745 24 24%22 fill=%22%23ffffff%22/%3E%3C/svg%3E'
            alt="Avatar" 
            class="ok-profile-avatar-nav"
          >
          <div class="d-flex flex-column text-start">
            <span class="fw-bold" style="font-size: 0.92rem; line-height: 1.15;"><%= typeof user !== 'undefined' && user && user.fullName ? user.fullName.split(' ')[0] : 'Membro' %></span>
            <span class="text-muted" style="font-size: 0.76rem;"><%= typeof user !== 'undefined' && user && user.role ? user.role : 'Utilizador' %></span>
          </div>
        </a>
      </div>
    </header>

    <!-- Hero -->
    <section class="ok-canvas-hero-title">
      <div>
        <a href="/groups" class="ok-breadcrumb-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
          Voltar aos Grupos
        </a>
        <h1 class="ok-page-title-main">
          Criar Nova Kixikila
          <span class="ok-live-beacon">
            <span class="ok-pulse-dot"></span>
            Fundação de Grupo
          </span>
        </h1>
        <p class="ok-canvas-sub">
          Configure os parâmetros operacionais e financeiros do seu novo grupo de poupança rotativa.
        </p>
      </div>
    </section>

    <!-- ====================================================================
         CARD CENTRAL — QUADRADO
         ==================================================================== -->
    <div class="ok-create-layout">

      <div class="ok-create-card">
        <div class="ok-create-card-header">
          <h5>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ok-purple-vibrant)" stroke-width="2.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            Configuração do Grupo
          </h5>
          <a href="/groups" class="ok-btn-ghost-pill" style="height: 40px; padding: 0 16px; font-size: 0.82rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            Voltar
          </a>
        </div>

        <div class="ok-create-card-body">
          <form id="create-group-page-form">
            <div class="row g-3">
              <div class="col-12">
                <label class="ok-form-label">Nome do Grupo *</label>
                <input type="text" id="g-name" class="ok-form-control" placeholder="ex: Kixikila dos Colegas de Trabalho" required>
              </div>

              <div class="col-12">
                <label class="ok-form-label">Descrição / Finalidade</label>
                <textarea id="g-desc" class="ok-form-textarea" rows="2" placeholder="Regras básicas ou finalidade da poupança..."></textarea>
              </div>

              <div class="col-md-6">
                <label class="ok-form-label">Quota por Membro (Kz) *</label>
                <input type="number" id="g-amount" class="ok-form-control" min="1000" placeholder="ex: 20000" required>
              </div>

              <div class="col-md-6">
                <label class="ok-form-label">Frequência *</label>
                <select id="g-frequency" class="ok-form-select">
                  <option value="MONTHLY" selected>Mensal</option>
                  <option value="BIWEEKLY">Quinzenal</option>
                  <option value="WEEKLY">Semanal</option>
                  <option value="DAILY">Diário</option>
                </select>
              </div>

              <div class="col-md-6">
                <label class="ok-form-label">Lotação de Membros *</label>
                <input type="number" id="g-max-members" class="ok-form-control" min="3" max="50" value="10">
              </div>

              <div class="col-md-6">
                <label class="ok-form-label">Data de Início *</label>
                <input type="date" id="g-start-date" class="ok-form-control" required>
              </div>

              <div class="col-md-6">
                <label class="ok-form-label">Província *</label>
                <input type="text" id="g-province" class="ok-form-control" value="Luanda" required>
              </div>

              <div class="col-md-6">
                <label class="ok-form-label">Município *</label>
                <input type="text" id="g-municipality" class="ok-form-control" value="Talatona" required>
              </div>

              <div class="col-12 mt-4">
                <button type="submit" id="btn-submit" class="ok-btn-submit">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                  Fundar Grupo de Kixikila
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

    </div>

  </div>

  <!-- Scripts -->
  <script src="/js/sweet-alert.js"></script>
  <script src="/js/api-client.js"></script>
  <script src="/js/app.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    (function () {
      'use strict';

      /* ====================================================================
         TEMA CLARO/ESCURO
         ==================================================================== */
      const THEME_KEY = 'ok-theme';
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-btn');
        if (!btn) return;
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }
      function initAvatarFallback() {
        const img = document.getElementById('ok-nav-avatar');
        if (!img) return;
        img.addEventListener('error', function onErr() {
          img.removeEventListener('error', onErr);
          const fb = img.getAttribute('data-fallback');
          if (fb && img.src !== fb) img.src = fb;
        });
      }

      function setupGlobalActions() {
        const toggleBtn = document.getElementById('sidebar-toggle-btn');
        if (toggleBtn) {
          toggleBtn.addEventListener('click', () => {
            document.body.classList.toggle('mobile-nav-active');
          });
        }
        document.querySelectorAll('[data-action="logout"]').forEach(btn => {
          btn.addEventListener('click', async function (e) {
            e.preventDefault();
            try {
              await window.apiClient.post('/auth/logout', {});
              if (window.apiClient) window.apiClient.clearSession();
            } catch (err) {}
            window.location.href = '/login';
          });
        });
      }

      /* ====================================================================
         LÓGICA DE CRIAÇÃO — PRESERVADA INTEGRALMENTE
         ==================================================================== */
      function initCreateGroupForm() {
        const startDateInput = document.getElementById('g-start-date');
        if (startDateInput && !startDateInput.value) {
          startDateInput.value = new Date().toISOString().split('T')[0];
        }

        const form = document.getElementById('create-group-page-form');
        if (!form) return;

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = document.getElementById('btn-submit');
          btn.disabled = true;

          const payload = {
            name: document.getElementById('g-name').value.trim(),
            description: document.getElementById('g-desc').value.trim() || undefined,
            contributionAmount: Number(document.getElementById('g-amount').value),
            frequency: document.getElementById('g-frequency').value,
            maxMembers: Number(document.getElementById('g-max-members').value),
            startDate: document.getElementById('g-start-date').value,
            location: {
              province: document.getElementById('g-province').value.trim(),
              municipality: document.getElementById('g-municipality').value.trim()
            }
          };

          try {
            const res = await window.apiClient.post('/groups', payload);
            if (window.Alerts) {
              await window.Alerts.success('Grupo Fundado!', 'O seu grupo foi criado com sucesso.');
            }
            window.location.href = `/groups`;
          } catch (err) {
            if (window.Alerts) window.Alerts.error(err.message || 'Erro ao criar grupo.');
          } finally {
            btn.disabled = false;
          }
        });
      }

      /* ====================================================================
         INIT
         ==================================================================== */
      document.addEventListener('DOMContentLoaded', () => {
        initThemeToggle();
        initAvatarFallback();
        setupGlobalActions();
        initCreateGroupForm();
      });
    })();
  </script>
</body>
</html>