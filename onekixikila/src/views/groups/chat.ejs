  <script src="/js/api-client.js"></script>
  <script src="/js/app.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    (function () {
      'use strict';

      /* ====================================================================
         TEMA CLARO/ESCURO
         ==================================================================== */
      const THEME_KEY = 'ok-theme';
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-btn');
        if (!btn) return;
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      function initAvatarFallback() {
        const img = document.getElementById('ok-nav-avatar');
        if (!img) return;
        img.addEventListener('error', function onErr() {
          img.removeEventListener('error', onErr);
          const fb = img.getAttribute('data-fallback');
          if (fb && img.src !== fb) img.src = fb;
        });
      }

      function escapeHtml(value) {
        const element = document.createElement('span');
        element.textContent = value == null ? '' : String(value);
        return element.innerHTML;
      }

      function setChatControlsEnabled(enabled) {
        document.querySelectorAll(
          '#chat-message-input, #chat-send-btn, #chat-attach-document-btn, #chat-start-record-btn, ' +
          '#chat-emoji-toggle-btn, #chat-recording-pause-btn, #chat-recording-cancel-btn, #chat-recording-send-btn'
        ).forEach((element) => { element.disabled = !enabled; });
      }

      function showChatAccessError(message) {
        setChatControlsEnabled(false);
        const container = document.getElementById('chat-container');
        const messages = document.getElementById('chat-messages-list');
        const status = document.getElementById('chat-socket-status-label');
        if (container) container.classList.add('chat-access-denied');
        if (status) {
          status.textContent = 'Acesso não autorizado';
          status.style.color = '#f43f5e';
        }
        if (messages) {
          messages.innerHTML = `
            <div class="ok-chat-access-banner" role="alert">
              <strong>Chat indisponível</strong>
              <span>${escapeHtml(message || 'Não foi possível confirmar uma filiação ativa neste grupo. Por segurança, a sala não foi iniciada.')}</span>
              <div class="mt-3"><a class="ok-chat-nav-back-link" href="/groups">Voltar à lista de grupos</a></div>
            </div>`;
        }
      }

      function loadScriptAfterAuthorization(src) {
        return new Promise((resolve, reject) => {
          const existing = document.querySelector(`script[data-authorized-chat-script="${src}"]`);
          if (existing) {
            if (existing.dataset.loaded === 'true') return resolve();
            existing.addEventListener('load', resolve, { once: true });
            existing.addEventListener('error', () => reject(new Error(`Falha ao carregar ${src}`)), { once: true });
            return;
          }
          const script = document.createElement('script');
          script.src = src;
          script.async = false;
          script.dataset.authorizedChatScript = src;
          script.addEventListener('load', () => {
            script.dataset.loaded = 'true';
            resolve();
          }, { once: true });
          script.addEventListener('error', () => reject(new Error(`Falha ao carregar ${src}`)), { once: true });
          document.body.appendChild(script);
        });
      }

      async function loadProtectedChatScripts() {
        // Ordem deliberada: as dependências de áudio/documentos devem existir antes do ChatManager.
        for (const src of ['/js/audio-recorder.js', '/js/document-upload.js', '/js/chat.js']) {
          await loadScriptAfterAuthorization(src);
        }
      }

      function setupGlobalActions() {
        const toggleBtn = document.getElementById('sidebar-toggle-btn');
        if (toggleBtn) {
          toggleBtn.addEventListener('click', () => {
            document.body.classList.toggle('mobile-nav-active');
          });
        }
        document.querySelectorAll('[data-action="logout"]').forEach(btn => {
          btn.addEventListener('click', async function (e) {
            e.preventDefault();
            try {
              await window.apiClient.post('/auth/logout', {});
              if (window.apiClient) window.apiClient.clearSession();
            } catch (err) {}
            window.location.href = '/login';
          });
        });
      }

      /* ====================================================================
         EMOJI PICKER
         ==================================================================== */
      const COMMON_EMOJIS = [
        '👍', '👏', '🤝', '🙌', '💰', '💵', '💸', '🏦',
        '✅', '🎉', '🔥', '⭐', '❤️', '😊', '🙏', '💯',
        '🎯', '📊', '📈', '🚀', '💡', '🔔', '📅', '💬'
      ];

      function initEmojiPickerBox() {
        const pickerBox = document.getElementById('chat-emoji-picker');
        const toggleBtn = document.getElementById('chat-emoji-toggle-btn');
        const messageInput = document.getElementById('chat-message-input');
        if (!pickerBox || !toggleBtn || !messageInput) return;

        pickerBox.innerHTML = COMMON_EMOJIS.map(e => `<button type="button" data-emoji="${e}">${e}</button>`).join('');

        toggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          pickerBox.classList.toggle('d-none');
        });

        pickerBox.addEventListener('click', (e) => {
          const btn = e.target.closest('button[data-emoji]');
          if (!btn) return;
          const emoji = btn.getAttribute('data-emoji');
          messageInput.value += emoji;
          messageInput.focus();
        });

        document.addEventListener('click', (e) => {
          if (!pickerBox.contains(e.target) && e.target !== toggleBtn) {
            pickerBox.classList.add('d-none');
          }
        });
      }

      /* ====================================================================
         CARREGAR SIDEBAR DO CHAT
         ==================================================================== */
      async function loadChatGroupSidebar(groupId) {
        const stream = document.getElementById('chat-members-stream');
        const sidebarTitle = document.getElementById('sidebar-group-title');
        const paneTitle = document.getElementById('chat-pane-group-name');
        const activeCount = document.getElementById('chat-active-members-count');
        const statusLabel = document.getElementById('chat-socket-status-label');

        try {
          // A rota de membros exige membership ativo; ambos os pedidos são necessários
          // antes de carregar chat.js, Socket.IO, gravador ou uploader.
          const [groupRes, membersRes] = await Promise.all([
            window.apiClient.get(`/groups/${encodeURIComponent(groupId)}`),
            window.apiClient.get(`/groups/${encodeURIComponent(groupId)}/members`)
          ]);

          const groupPayload = groupRes && groupRes.data;
          const group = groupPayload && (groupPayload.group || groupPayload);
          const membersPayload = membersRes && membersRes.data;
          const members = membersPayload && (membersPayload.members || membersPayload);
          if (!group || !Array.isArray(members)) {
            throw new Error('A resposta do servidor não confirmou o acesso ao grupo.');
          }

          const activeMembers = members.filter((member) => String(member.status || '').toUpperCase() === 'ACTIVE');
          if (sidebarTitle) sidebarTitle.textContent = group.name || 'Grupo de Kixikila';
          if (paneTitle) paneTitle.textContent = group.name || 'Chat da Kixikila';
          if (activeCount) activeCount.textContent = `${activeMembers.length} membro(s) ativo(s)`;
          if (statusLabel) statusLabel.textContent = 'Acesso validado • a iniciar ligação…';

          if (stream) {
            if (activeMembers.length === 0) {
              stream.innerHTML = '<div class="text-center py-4 text-muted small">Sem membros ativos para apresentar.</div>';
            } else {
              stream.innerHTML = activeMembers.map((member) => {
                const name = member.preferred_name || member.full_name || member.fullName || 'Participante';
                const safeName = escapeHtml(name);
                const roleValue = String(member.role || '').toUpperCase();
                const role = roleValue === 'PRIMARY_LEADER' || roleValue === 'LEADER'
                  ? 'Líder Titular'
                  : roleValue === 'VICE_LEADER' ? 'Vice-Líder' : 'Membro';
                const initials = String(name).split(' ').filter(Boolean).slice(0, 2).map((word) => word[0]).join('').toUpperCase() || 'M';
                return `
                  <div class="ok-chat-member-row">
                    <div class="ok-chat-member-avatar online" style="background: linear-gradient(135deg, #7c3aed, #4c1d95);">
                      ${escapeHtml(initials)}
                    </div>
                    <div class="ok-chat-member-info">
                      <p class="ok-chat-member-name">${safeName}</p>
                      <p class="ok-chat-member-role">${escapeHtml(role)}</p>
                    </div>
                  </div>`;
              }).join('');
            }
          }
          return true;
        } catch (error) {
          if (stream) stream.innerHTML = '<div class="text-center py-4 small" style="color: #f43f5e;">Membership ativo não confirmado.</div>';
          showChatAccessError(error && error.message ? error.message : 'É necessário ser membro ativo do grupo para aceder ao chat.');
          return false;
        }
      }

      /* ====================================================================
         INIT
         ==================================================================== */
      document.addEventListener('DOMContentLoaded', async () => {
        initThemeToggle();
        initAvatarFallback();
        setupGlobalActions();
        initEmojiPickerBox();
        setChatControlsEnabled(false);

        const pathSegments = window.location.pathname.split('/').filter(Boolean);
        const groupIndex = pathSegments.indexOf('groups');
        const resolvedGroupId = groupIndex >= 0
          ? pathSegments[groupIndex + 1]
          : document.body.getAttribute('data-chat-group-id');

        if (!resolvedGroupId || !window.apiClient) {
          showChatAccessError('Não foi possível validar o grupo. Volte à lista de grupos e tente novamente.');
          return;
        }

        document.body.setAttribute('data-chat-group-id', resolvedGroupId);
        const authorized = await loadChatGroupSidebar(resolvedGroupId);
        if (!authorized) return;

        try {
          await loadProtectedChatScripts();
          // chat.js auto-inicializa depois de ser carregado; não chamar init() outra vez.
          if (!window.chatManager) throw new Error('O módulo de chat não ficou disponível.');
          setChatControlsEnabled(true);
        } catch (error) {
          showChatAccessError('O acesso foi validado, mas os componentes do chat não puderam ser iniciados. Atualize a página.');
          console.error('[CHAT:BOOTSTRAP_ERROR]', error);
        }
      });
    })();
  </script>
</body>
</html>