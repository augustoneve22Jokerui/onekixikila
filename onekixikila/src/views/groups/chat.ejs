<!DOCTYPE html>
<html lang="pt-AO">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title><%= typeof title !== 'undefined' ? title : 'Chat do Grupo — OneKixikila' %></title>
  <% if (typeof csrfToken !== 'undefined') { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
  <% } %>
  <link rel="icon" type="image/x-icon" href="/assets/images/favicon.ico">

  <!-- Tipografia -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 CSS + Icons + SweetAlert2 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.min.css">

  <style>
    /* =========================================================================
       SISTEMA DE DESIGN — ONEKIXIKILA (TEMA ESCURO PADRÃO + TEMA CLARO)
       Sidebar + Top Bar: arredondados. Cards centrais: quadrados.
       Cores 100% roxo.
       Escala MAIOR (igual ao Perfil / Carteira ampliada)
       ========================================================================= */
    :root,
    html[data-theme="dark"] {
      --ok-bg-canvas: #050508;
      --ok-bg-surface: #0a0a10;
      --ok-bg-elevated: #111118;

      --ok-purple-primary: #7c3aed;
      --ok-purple-vibrant: #8b5cf6;
      --ok-purple-soft: rgba(139, 92, 246, 0.12);
      --ok-purple-border: rgba(139, 92, 246, 0.3);

      --ok-text-primary: #ffffff;
      --ok-text-secondary: #cbd5e1;
      --ok-text-muted: #94a3b8;

      --ok-border-subtle: rgba(255, 255, 255, 0.08);
      --ok-input-bg: rgba(255, 255, 255, 0.04);
      --ok-pill-bg: rgba(255, 255, 255, 0.05);
      --ok-pill-bg-hover: rgba(139, 92, 246, 0.12);
      --ok-meter-bg: rgba(255, 255, 255, 0.06);
      --ok-stream-hover: var(--ok-purple-soft);
      --ok-shadow-card: rgba(0, 0, 0, 0.75);
      --ok-shadow-sidebar: rgba(0, 0, 0, 0.6);

      --ok-radius-pill: 9999px;
      --ok-sidebar-width: 96px;
      --ok-navbar-height: 92px;
      --ok-content-max-width: 1280px;

      /* Bolhas de Conversa */
      --ok-bubble-mine: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      --ok-bubble-other: #111118;
      --ok-bubble-other-border: rgba(255, 255, 255, 0.08);
    }

    html[data-theme="light"] {
      --ok-bg-canvas: #f4f5f9;
      --ok-bg-surface: #ffffff;
      --ok-bg-elevated: #ffffff;

      --ok-purple-primary: #6d28d9;
      --ok-purple-vibrant: #7c3aed;
      --ok-purple-soft: rgba(124, 58, 237, 0.08);
      --ok-purple-border: rgba(124, 58, 237, 0.25);

      --ok-text-primary: #0f172a;
      --ok-text-secondary: #334155;
      --ok-text-muted: #64748b;

      --ok-border-subtle: rgba(15, 23, 42, 0.10);
      --ok-input-bg: #ffffff;
      --ok-pill-bg: rgba(15, 23, 42, 0.04);
      --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
      --ok-meter-bg: rgba(15, 23, 42, 0.08);
      --ok-stream-hover: rgba(124, 58, 237, 0.08);
      --ok-shadow-card: rgba(15, 23, 42, 0.10);
      --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);

      --ok-bubble-mine: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      --ok-bubble-other: #ffffff;
      --ok-bubble-other-border: rgba(15, 23, 42, 0.10);
    }

    @media (prefers-color-scheme: light) {
      html:not([data-theme]) {
        --ok-bg-canvas: #f4f5f9;
        --ok-bg-surface: #ffffff;
        --ok-bg-elevated: #ffffff;

        --ok-purple-primary: #6d28d9;
        --ok-purple-vibrant: #7c3aed;
        --ok-purple-soft: rgba(124, 58, 237, 0.08);
        --ok-purple-border: rgba(124, 58, 237, 0.25);

        --ok-text-primary: #0f172a;
        --ok-text-secondary: #334155;
        --ok-text-muted: #64748b;

        --ok-border-subtle: rgba(15, 23, 42, 0.10);
        --ok-input-bg: #ffffff;
        --ok-pill-bg: rgba(15, 23, 42, 0.04);
        --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
        --ok-meter-bg: rgba(15, 23, 42, 0.08);
        --ok-stream-hover: rgba(124, 58, 237, 0.08);
        --ok-shadow-card: rgba(15, 23, 42, 0.10);
        --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);

        --ok-bubble-mine: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
        --ok-bubble-other: #ffffff;
        --ok-bubble-other-border: rgba(15, 23, 42, 0.10);
      }
    }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-font-smoothing: antialiased; }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--ok-bg-canvas);
      color: var(--ok-text-primary);
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
      transition: background-color 0.25s ease, color 0.25s ease;
      font-size: 15px;
    }

    .ok-ambient-glow-core {
      position: fixed;
      top: -140px; left: 20%;
      width: 650px; height: 650px;
      background: radial-gradient(circle, rgba(124, 58, 237, 0.16) 0%, rgba(5, 5, 8, 0) 70%);
      pointer-events: none; z-index: 0; filter: blur(100px);
    }
    html[data-theme="light"] .ok-ambient-glow-core {
      background: radial-gradient(circle, rgba(124, 58, 237, 0.12) 0%, rgba(244, 245, 249, 0) 70%);
    }

    /* =========================================================================
       BARRA LATERAL — ARREDONDADA
       ========================================================================= */
    .ok-rail-sidebar {
      position: fixed;
      top: 24px; left: 24px; bottom: 24px;
      width: var(--ok-sidebar-width);
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 24px;
      display: flex; flex-direction: column; align-items: center;
      padding: 26px 0;
      z-index: 1040;
      box-shadow: 0 12px 36px var(--ok-shadow-sidebar);
      backdrop-filter: blur(24px);
      transition: all 0.3s ease;
    }

    .ok-brand-emblem {
      width: 56px; height: 56px; border-radius: 18px;
      background: linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 32px;
      box-shadow: 0 10px 26px rgba(124, 58, 237, 0.45);
      text-decoration: none;
    }
    .ok-brand-emblem svg { width: 28px; height: 28px; }

    .ok-rail-nav {
      flex: 1;
      display: flex; flex-direction: column; align-items: center;
      gap: 16px; width: 100%;
    }

    .ok-rail-link {
      width: 52px; height: 52px; border-radius: 16px;
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-muted); text-decoration: none;
      transition: all 0.2s ease; background: transparent;
      position: relative;
    }
    .ok-rail-link svg { width: 22px; height: 22px; }
    .ok-rail-link:hover {
      color: var(--ok-purple-vibrant);
      background-color: var(--ok-purple-soft);
      transform: translateY(-2px);
    }
    .ok-rail-link.active {
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      color: #ffffff;
      box-shadow: 0 10px 24px rgba(139, 92, 246, 0.5);
    }

    .ok-rail-footer {
      display: flex; flex-direction: column; align-items: center;
      gap: 12px; width: 100%;
    }

    /* =========================================================================
       VIEWPORT SHELL & TOPBAR
       ========================================================================= */
    .ok-viewport-shell {
      margin-left: calc(var(--ok-sidebar-width) + 44px);
      padding: 24px 40px 40px 0;
      position: relative; z-index: 1;
    }

    /* Navbar Superior — Centralizada ao conteúdo (max-width 1280px) */
    .ok-top-nav {
      height: var(--ok-navbar-height);
      display: flex; align-items: center; justify-content: space-between;
      margin: 0 auto 26px auto;
      max-width: var(--ok-content-max-width);
      width: 100%;
      gap: 20px;
      flex-wrap: wrap;
    }

    .ok-search-capsule {
      position: relative;
      width: 500px; max-width: 100%;
      flex-shrink: 1;
    }
    .ok-search-capsule input {
      width: 100%; height: 54px;
      border-radius: var(--ok-radius-pill);
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      padding: 0 90px 0 52px;
      font-size: 0.96rem;
      color: var(--ok-text-primary);
      outline: none;
      transition: all 0.25s ease;
    }
    .ok-search-capsule input::placeholder { color: var(--ok-text-muted); }
    .ok-search-capsule input:focus {
      border-color: var(--ok-purple-vibrant);
      box-shadow: 0 0 0 4px var(--ok-purple-soft);
    }
    .ok-search-capsule .search-icon {
      position: absolute; left: 18px; top: 50%;
      transform: translateY(-50%);
      color: var(--ok-text-muted);
    }
    .ok-search-capsule .search-icon svg { width: 18px; height: 18px; }
    .ok-search-capsule .shortcut-hint {
      position: absolute; right: 14px; top: 50%;
      transform: translateY(-50%);
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 8px;
      padding: 4px 9px;
      font-size: 0.74rem;
      color: var(--ok-text-muted);
      font-weight: 600;
    }

    .ok-nav-actions { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }

    .ok-action-circle {
      width: 52px; height: 52px; border-radius: 16px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-primary);
      text-decoration: none;
      transition: all 0.2s ease;
      position: relative;
    }
    .ok-action-circle svg { width: 20px; height: 20px; }
    .ok-action-circle:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      transform: translateY(-2px);
    }

    .ok-profile-pill {
      display: flex; align-items: center; gap: 12px;
      padding: 6px 20px 6px 6px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: var(--ok-radius-pill);
      text-decoration: none; cursor: pointer;
    }
    .ok-profile-avatar-nav {
      width: 44px; height: 44px;
      border-radius: 50%; object-fit: cover;
      background: var(--ok-purple-soft);
      border: 2px solid var(--ok-purple-border);
    }

    .ok-theme-toggle {
      width: 52px; height: 52px; border-radius: 16px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-primary); cursor: pointer;
      transition: all 0.2s ease;
    }
    .ok-theme-toggle:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      transform: translateY(-2px);
    }
    .ok-theme-toggle svg { width: 20px; height: 20px; }

    /* =========================================================================
       WORKSPACE DO CHAT — 2 COLUNAS
       ========================================================================= */
    .ok-chat-workspace {
      max-width: var(--ok-content-max-width);
      margin: 0 auto;
      display: grid;
      grid-template-columns: 300px 1fr;
      gap: 24px;
      height: calc(100vh - var(--ok-navbar-height) - 90px);
      min-height: 600px;
    }

    /* =========================================================================
       COLUNA ESQUERDA — LISTA DE MEMBROS — QUADRADA
       ========================================================================= */
    .ok-chat-members-sidebar {
      background: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 0;
      padding: 1.5rem 1.25rem;
      display: flex;
      flex-direction: column;
      box-shadow: 0 10px 32px var(--ok-shadow-card);
      overflow: hidden;
    }

    .ok-members-sidebar-header {
      padding-bottom: 14px;
      border-bottom: 1px solid var(--ok-border-subtle);
      margin-bottom: 14px;
    }
    .ok-members-sidebar-title {
      font-size: 0.76rem;
      font-weight: 800;
      color: var(--ok-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 4px;
    }
    .ok-members-sidebar-groupname {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--ok-text-primary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-bottom: 8px;
    }

    .ok-chat-nav-back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--ok-purple-vibrant);
      text-decoration: none;
      transition: all 0.2s;
    }
    .ok-chat-nav-back-link:hover {
      text-decoration: underline;
      transform: translateX(-2px);
    }

    .ok-chat-members-stream {
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding-right: 4px;
    }
    .ok-chat-members-stream::-webkit-scrollbar { width: 5px; }
    .ok-chat-members-stream::-webkit-scrollbar-thumb { background: var(--ok-border-subtle); }

    .ok-chat-member-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px 10px;
      border-radius: 0;
      transition: background 0.2s;
    }
    .ok-chat-member-row:hover {
      background: var(--ok-pill-bg-hover);
    }
    .ok-chat-member-avatar {
      width: 38px;
      height: 38px;
      border-radius: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.8rem;
      color: #ffffff;
      flex-shrink: 0;
      position: relative;
    }
    .ok-chat-member-avatar.online::after {
      content: '';
      position: absolute;
      bottom: 0;
      right: 0;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--ok-purple-vibrant);
      border: 2px solid var(--ok-bg-surface);
    }
    .ok-chat-member-info {
      min-width: 0;
      flex: 1;
    }
    .ok-chat-member-name {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--ok-text-primary);
      margin: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .ok-chat-member-role {
      font-size: 0.74rem;
      color: var(--ok-text-muted);
      margin: 0;
    }

    /* =========================================================================
       COLUNA DIREITA — SALA PRINCIPAL — QUADRADA
       ========================================================================= */
    .ok-chat-main-pane {
      background: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 0;
      display: flex;
      flex-direction: column;
      box-shadow: 0 10px 32px var(--ok-shadow-card);
      overflow: hidden;
      position: relative;
    }

    .ok-chat-pane-header {
      padding: 1.25rem 1.75rem;
      border-bottom: 1px solid var(--ok-border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      background: var(--ok-bg-surface);
      z-index: 2;
    }
    .ok-chat-header-identity {
      display: flex;
      align-items: center;
      gap: 14px;
      min-width: 0;
    }
    .ok-chat-group-emblem {
      width: 48px;
      height: 48px;
      border-radius: 0;
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      box-shadow: 0 6px 18px rgba(124, 58, 237, 0.4);
      flex-shrink: 0;
    }
    .ok-chat-pane-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--ok-text-primary);
      margin: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .ok-chat-pane-subtitle {
      font-size: 0.8rem;
      color: var(--ok-text-muted);
      margin: 2px 0 0 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .ok-live-indicator-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--ok-purple-vibrant);
      box-shadow: 0 0 8px var(--ok-purple-vibrant);
    }

    .ok-chat-header-tools {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .ok-chat-tool-btn {
      width: 42px;
      height: 42px;
      border-radius: 0;
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--ok-text-primary);
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .ok-chat-tool-btn:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      transform: translateY(-2px);
    }

    /* STREAM DE MENSAGENS */
    .ok-messages-stream-box {
      flex: 1;
      overflow-y: auto;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 12px;
      scroll-behavior: smooth;
      background: var(--ok-bg-surface);
    }
    .ok-messages-stream-box::-webkit-scrollbar { width: 6px; }
    .ok-messages-stream-box::-webkit-scrollbar-thumb { background: var(--ok-border-subtle); }

    /* BOLHAS DE CONVERSA — QUADRADAS */
    .chat-bubble {
      padding: 12px 18px;
      border-radius: 0;
      font-size: 0.94rem;
      line-height: 1.5;
      position: relative;
      word-wrap: break-word;
      overflow-wrap: break-word;
      transition: all 0.2s ease;
    }
    .chat-bubble-mine {
      background: var(--ok-bubble-mine);
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(124, 58, 237, 0.3);
    }
    .chat-bubble-other {
      background: var(--ok-bubble-other);
      color: var(--ok-text-primary);
      border: 1px solid var(--ok-bubble-other-border);
      box-shadow: 0 4px 14px var(--ok-shadow-card);
    }

    .chat-document-wrapper {
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 0;
      padding: 12px 14px;
      margin-top: 6px;
    }

    /* BOTÃO ROLAR PARA O FUNDO — mantém redondo (é um FAB flutuante) */
    #chat-scroll-bottom-btn {
      position: absolute;
      bottom: 95px;
      right: 25px;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--ok-purple-vibrant);
      color: #ffffff;
      border: none;
      box-shadow: 0 6px 18px rgba(124, 58, 237, 0.5);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 3;
      transition: all 0.2s ease;
    }
    #chat-scroll-bottom-btn:hover { transform: scale(1.08); }

    /* INDICADOR DE DIGITAÇÃO */
    .ok-typing-indicator-bar {
      padding: 6px 20px;
      font-size: 0.78rem;
      color: var(--ok-text-muted);
      display: flex;
      align-items: center;
      gap: 8px;
      font-style: italic;
    }
    .ok-typing-dots span {
      display: inline-block;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--ok-purple-vibrant);
      animation: okTyping 1.4s infinite;
    }
    .ok-typing-dots span:nth-child(2) { animation-delay: 0.2s; }
    .ok-typing-dots span:nth-child(3) { animation-delay: 0.4s; }
    @keyframes okTyping {
      0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
      30% { transform: translateY(-4px); opacity: 1; }
    }

    /* PAINEL DE GRAVAÇÃO — QUADRADO */
    .ok-recording-panel-active {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 12px 20px;
      background: rgba(244, 63, 94, 0.12);
      border: 1px solid rgba(244, 63, 94, 0.3);
      border-radius: 0;
      margin-bottom: 10px;
    }

    /* DOCK INFERIOR — QUADRADO */
    .ok-chat-bottom-dock {
      padding: 1rem 1.75rem 1.25rem 1.75rem;
      border-top: 1px solid var(--ok-border-subtle);
      background: var(--ok-bg-surface);
      position: relative;
      z-index: 2;
    }

    .ok-input-toolbar-flex {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }
    .ok-tool-circle-btn {
      width: 38px;
      height: 38px;
      border-radius: 0;
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      color: var(--ok-text-muted);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }
    .ok-tool-circle-btn:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      background: var(--ok-pill-bg-hover);
    }

    .ok-input-dispatch-row {
      display: flex;
      align-items: flex-end;
      gap: 12px;
    }

    .ok-chat-textarea {
      flex: 1;
      min-height: 50px;
      max-height: 140px;
      padding: 12px 22px;
      border-radius: 0;
      background: var(--ok-input-bg);
      border: 1.5px solid var(--ok-border-subtle);
      color: var(--ok-text-primary);
      font-size: 0.94rem;
      font-family: inherit;
      outline: none;
      resize: none;
      line-height: 1.5;
      transition: all 0.2s ease;
    }
    .ok-chat-textarea:focus {
      border-color: var(--ok-purple-vibrant);
      box-shadow: 0 0 0 3px var(--ok-purple-soft);
      background: var(--ok-bg-surface);
    }
    .ok-chat-textarea::placeholder { color: var(--ok-text-muted); }

    .ok-btn-dispatch-send {
      width: 50px;
      height: 50px;
      border-radius: 0;
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      color: #ffffff;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 6px 18px rgba(124, 58, 237, 0.45);
      transition: all 0.2s ease;
      flex-shrink: 0;
    }
    .ok-btn-dispatch-send:hover {
      transform: scale(1.06);
      box-shadow: 0 8px 24px rgba(124, 58, 237, 0.65);
    }

    /* EMOJI PICKER — QUADRADO */
    .ok-emoji-picker-box {
      position: absolute;
      bottom: 90px;
      left: 20px;
      width: 320px;
      height: 260px;
      background: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 0;
      box-shadow: 0 12px 36px var(--ok-shadow-card);
      padding: 12px;
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      gap: 4px;
      overflow-y: auto;
      z-index: 10;
    }
    .ok-emoji-picker-box button {
      background: transparent;
      border: none;
      font-size: 1.25rem;
      cursor: pointer;
      border-radius: 0;
      padding: 4px;
      transition: transform 0.15s ease;
    }
    .ok-emoji-picker-box button:hover {
      background: var(--ok-pill-bg);
      transform: scale(1.2);
    }

    /* Responsividade */
    @media (max-width: 991px) {
      .ok-rail-sidebar { transform: translateX(-140%); }
      .ok-viewport-shell { margin-left: 0; padding: 16px; }
      body.mobile-nav-active .ok-rail-sidebar { transform: translateX(0); }
      .ok-chat-workspace { grid-template-columns: 1fr; height: calc(100vh - 120px); }
      .ok-chat-members-sidebar { display: none; }
      .ok-search-capsule { width: 100%; }
      .ok-top-nav { gap: 10px; }
    }
    @media (max-width: 600px) {
      .ok-top-nav { flex-wrap: wrap; height: auto; padding: 10px 0; }
      .ok-nav-actions { margin-left: auto; }
    }
    .ok-chat-access-banner {
      margin: 24px;
      padding: 18px 20px;
      border: 1px solid rgba(244, 63, 94, 0.32);
      background: rgba(244, 63, 94, 0.08);
      color: var(--ok-text-primary);
      line-height: 1.5;
    }
    .ok-chat-access-banner strong { display: block; margin-bottom: 4px; }
    .chat-access-denied .ok-chat-bottom-dock,
    .chat-access-denied #chat-typing-indicator,
    .chat-access-denied #chat-scroll-bottom-btn { display: none !important; }
  </style>
</head>
