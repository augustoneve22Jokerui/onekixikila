  <!-- ======================================================================
       CONTEÚDO PRINCIPAL
       ====================================================================== -->
  <div class="ok-viewport-shell">

    <!-- Top Bar — Centralizada ao eixo do conteúdo -->
    <header class="ok-top-nav">
      <div class="ok-search-capsule">
        <span class="search-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </span>
        <input type="search" placeholder="Pesquisar membros, contactos..." autocomplete="off">
        <kbd class="shortcut-hint">Ctrl K</kbd>
      </div>

      <div class="ok-nav-actions">
        <button type="button" id="sidebar-toggle-btn" class="ok-action-circle d-lg-none" aria-label="Abrir menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>

        <button type="button" id="theme-toggle-btn" class="ok-theme-toggle" title="Alternar tema claro/escuro" aria-label="Alternar tema">
          <svg id="theme-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
        </button>

        <a href="/notifications" class="ok-action-circle" title="Notificações">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
        </a>

        <a href="/profile" class="ok-profile-pill">
          <img 
            id="ok-nav-avatar"
            src="<%= typeof user !== 'undefined' && user && (user.avatarUrl || user.avatar_url || user.avatar) ? (user.avatarUrl || user.avatar_url || user.avatar) : '/assets/images/avatar-default.png' %>" 
            data-fallback='data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 fill=%22%237c3aed%22/%3E%3Ccircle cx=%2232%22 cy=%2224%22 r=%2212%22 fill=%22%23ffffff%22/%3E%3Cpath d=%22M8 64c0-13.255 10.745-24 24-24s24 10.745 24 24%22 fill=%22%23ffffff%22/%3E%3C/svg%3E'
            alt="Avatar" 
            class="ok-profile-avatar-nav"
          >
          <div class="d-flex flex-column text-start">
            <span class="fw-bold" style="font-size: 0.92rem; line-height: 1.15;" id="ok-nav-fullname"><%= typeof user !== 'undefined' && user && (user.fullName || user.full_name) ? (user.fullName || user.full_name).split(' ')[0] : 'Membro' %></span>
            <span class="text-muted" style="font-size: 0.76rem;" id="ok-nav-role"><%= typeof user !== 'undefined' && user && user.role ? user.role : 'Utilizador' %></span>
          </div>
        </a>
      </div>
    </header>

    <!-- Hero -->
    <section class="ok-canvas-hero-title">
      <div>
        <a href="/groups/<%= groupId %>" class="ok-breadcrumb-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
          Voltar ao Grupo
        </a>
        <h1 class="ok-page-title-main">
          Membros & Vagas
          <span class="ok-live-beacon">
            <span class="ok-pulse-dot"></span>
            <span id="members-quorum-badge">0 / 0 vagas</span>
          </span>
        </h1>
        <p class="ok-canvas-sub">
          <span id="group-name-badge">Grupo</span> &bull; Gestão de filiações, cargos internos e restrições operacionais
        </p>
      </div>

      <div class="d-flex gap-2 flex-wrap">
        <a href="/groups/<%= groupId %>/invitations" class="ok-btn-confirm-pill">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
          Convidar Membro
        </a>
      </div>
    </section>

    <!-- Nav pills internas -->
    <div class="ok-group-nav-pills">
      <a href="/groups/<%= groupId %>" class="ok-group-nav-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        Visão Geral
      </a>
      <a href="/groups/<%= groupId %>/members" class="ok-group-nav-pill active">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
        Membros & Vagas (<span id="tab-members-count">0</span>)
      </a>
      <a href="/groups/<%= groupId %>/schedule" class="ok-group-nav-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect width="18" height="18" x="3" y="4" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        Calendário
      </a>
      <a href="/groups/<%= groupId %>/rules" class="ok-group-nav-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        Regras
      </a>
      <a href="/groups/<%= groupId %>/invitations" class="ok-group-nav-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        Convites
      </a>
      <a href="/groups/<%= groupId %>/chat" class="ok-group-nav-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        Chat
      </a>
    </div>

    <!-- Loading state -->
    <div id="members-loading-state" class="ok-empty-state" style="max-width:var(--ok-content-max-width);margin:0 auto;">
      <div class="spinner-border mb-3" role="status" style="color: var(--ok-purple-vibrant); width: 3rem; height: 3rem;"></div>
      <h6>A carregar lista de membros e vagas...</h6>
      <p class="small">A consultar filiações, papéis internos, turnos e restrições no sistema.</p>
    </div>

    <!-- Conteúdo principal (oculto até hidratação) -->
    <div id="members-content-wrapper" class="d-none ok-members-layout" data-group-id="<%= groupId %>">

      <!-- Card de pendentes -->
      <div class="ok-members-card ok-pending-card d-none" id="pending-requests-card">
        <div class="ok-members-card-header">
          <h5>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ok-purple-vibrant)" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            Pedidos de Adesão Pendentes
            <span class="ok-badge-purple" id="pending-requests-count">0</span>
          </h5>
        </div>
        <div class="table-responsive">
          <table class="ok-members-table">
            <thead>
              <tr>
                <th>Candidato</th>
                <th>Contacto</th>
                <th>Data do Pedido</th>
                <th class="text-end">Decisão</th>
              </tr>
            </thead>
            <tbody id="pending-requests-table-body"></tbody>
          </table>
        </div>
      </div>

      <!-- Card principal de membros -->
      <div class="ok-members-card">
        <div class="ok-members-card-header">
          <h5>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ok-purple-vibrant)" stroke-width="2.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><polyline points="16 11 18 13 22 9"></polyline></svg>
            Membros Ativos & Ordem das Vagas
          </h5>

          <div class="d-flex gap-2 flex-wrap align-items-center">
            <span class="ok-badge-soft" id="active-members-count-badge">0 participantes</span>
            <select class="ok-members-filter" id="filter-member-role">
              <option value="">Todos os Cargos</option>
              <option value="PRIMARY_LEADER">Líder Titular</option>
              <option value="VICE_LEADER">Vice-Líder</option>
              <option value="TREASURER">Tesoureiro</option>
              <option value="SECRETARY">Secretário</option>
              <option value="MEMBER">Membro Regular</option>
            </select>
            <select class="ok-members-filter" id="filter-member-status">
              <option value="">Todos os Estados</option>
              <option value="ACTIVE" selected>Ativos</option>
              <option value="SUSPENDED">Suspensos</option>
              <option value="DEFAULTED">Inadimplentes</option>
              <option value="LEFT">Ex-membros</option>
            </select>
          </div>
        </div>

        <div class="table-responsive">
          <table class="ok-members-table">
            <thead>
              <tr>
                <th style="width: 100px;">Vaga</th>
                <th>Membro</th>
                <th>Contacto</th>
                <th>Cargo</th>
                <th>Estado</th>
                <th>Restrições</th>
                <th>Adesão</th>
                <th class="text-end">Gestão</th>
              </tr>
            </thead>
            <tbody id="members-table-body"></tbody>
          </table>
        </div>

        <div id="members-empty-state" class="ok-empty-state d-none">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
          </svg>
          <h6>Nenhum membro encontrado</h6>
          <p class="small mb-0">Não existem participantes que correspondam aos filtros selecionados.</p>
        </div>
      </div>

    </div>

  </div>

  <!-- ======================================================================
       MODAL: SUSPENDER MEMBRO
       ====================================================================== -->
  <div class="modal fade" id="modal-suspend-member" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold">
            Suspender Participante
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <form id="form-suspend-member">
          <input type="hidden" name="membershipId" id="suspend-membership-id">
          <div class="modal-body py-4">
            <p class="text-muted small">
              A suspensão temporária impede o membro de interagir no chat e pode restringir novas deliberações. As obrigações de quota continuam exigíveis.
            </p>
            <div class="mb-3">
              <label class="form-label">Justificativa Formal <span class="text-danger">*</span></label>
              <textarea class="form-control" name="reason" rows="3" placeholder="Indique o motivo disciplinar ou de litígio..." required minlength="5" maxlength="255"></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label">Suspenso Até (Opcional)</label>
              <input type="date" class="form-control" name="suspendedUntil">
            </div>
          </div>
          <div class="modal-footer border-0 pt-0">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="ok-btn-confirm-pill" style="height: 44px; font-size: 0.84rem;">
              Confirmar Suspensão
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ======================================================================
       MODAL: RESTRIÇÕES
       ====================================================================== -->
  <div class="modal fade" id="modal-manage-restrictions" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold">
            Restrições Operacionais
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <form id="form-manage-restrictions">
          <input type="hidden" name="membershipId" id="restrictions-membership-id">
          <div class="modal-body py-4">
            <p class="text-muted small mb-4">
              Defina as sanções operacionais cautelares para o participante selecionado:
            </p>

            <div class="form-check form-switch mb-3 p-3 border" style="border-color: var(--ok-border-subtle) !important;">
              <input class="form-check-input" type="checkbox" role="switch" id="switch-ban-chat" name="isBannedFromChat">
              <label class="form-check-label fw-bold ms-2" for="switch-ban-chat" style="font-size: 0.9rem;">
                Silenciar no Chat
                <span class="d-block small mt-1" style="font-weight: 400; color: var(--ok-text-muted);">Impede envio de mensagens, áudios e documentos.</span>
              </label>
            </div>

            <div class="form-check form-switch mb-3 p-3 border" style="border-color: var(--ok-border-subtle) !important;">
              <input class="form-check-input" type="checkbox" role="switch" id="switch-restrict-contrib" name="isContributionRestricted">
              <label class="form-check-label fw-bold ms-2" for="switch-restrict-contrib" style="font-size: 0.9rem;">
                Bloquear Liquidação de Quotas
                <span class="d-block small mt-1" style="font-weight: 400; color: var(--ok-text-muted);">Suspende liquidação automática até resolução.</span>
              </label>
            </div>

            <div class="form-check form-switch mb-0 p-3 border" style="border-color: var(--ok-border-subtle) !important;">
              <input class="form-check-input" type="checkbox" role="switch" id="switch-restrict-payout" name="isPayoutRestricted">
              <label class="form-check-label fw-bold ms-2" for="switch-restrict-payout" style="font-size: 0.9rem;">
                Retenção Cautelar de Desembolso
                <span class="d-block small mt-1" style="font-weight: 400; color: var(--ok-text-muted);">Impede recebimento do bolo caso seja a vez do participante.</span>
              </label>
            </div>
          </div>
          <div class="modal-footer border-0 pt-0">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="ok-btn-confirm-pill" style="height: 44px; font-size: 0.84rem;">
              Guardar Restrições
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ======================================================================
       MODAL: DELEGAR CARGO
       ====================================================================== -->
  <div class="modal fade" id="modal-delegate-role" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold">
            Designar Cargo de Governança
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <form id="form-delegate-role">
          <input type="hidden" name="targetUserId" id="delegate-target-user-id">
          <div class="modal-body py-4">
            <div class="mb-3">
              <label class="form-label">Cargo Interno no Grupo</label>
              <select class="form-select" name="leadershipRole" id="delegate-leadership-role-select" required>
                <option value="VICE_LEADER" selected>Vice-Líder (Poderes de moderação)</option>
                <option value="TREASURER">Tesoureiro (Supervisão de quotas)</option>
                <option value="SECRETARY">Secretário (Apoio administrativo)</option>
                <option value="ACTING_LEADER">Líder Interino (Substituição temporária)</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Mandato Válido Até (Opcional)</label>
              <input type="date" class="form-control" name="delegatedUntil">
            </div>
          </div>
          <div class="modal-footer border-0 pt-0">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="ok-btn-confirm-pill" style="height: 44px; font-size: 0.84rem;">
              Designar Cargo
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="/js/sweet-alert.js"></script>
  <script src="/js/api-client.js"></script>
  <script src="/js/app.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    (function () {
      'use strict';

      /* ====================================================================
         TEMA CLARO/ESCURO
         ==================================================================== */
      const THEME_KEY = 'ok-theme';
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-btn');
        if (!btn) return;
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      /* ====================================================================
         HELPERS DE AVATAR (replicados do Perfil para consistência total)
         ==================================================================== */
      const DEFAULT_AVATAR = '/assets/images/avatar-default.png';
      const FALLBACK_DATA_URI = 'data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 fill=%22%237c3aed%22/%3E%3Ccircle cx=%2232%22 cy=%2224%22 r=%2212%22 fill=%22%23ffffff%22/%3E%3Cpath d=%22M8 64c0-13.255 10.745-24 24-24s24 10.745 24 24%22 fill=%22%23ffffff%22/%3E%3C/svg%3E';

      function isAbsoluteUrl(str) {
        return /^https?:\/\//i.test(str);
      }

      function resolveAvatarUrlForSave(rawUrl) {
        if (!rawUrl) return null;
        const trimmed = String(rawUrl).trim();
        if (!trimmed) return null;
        if (isAbsoluteUrl(trimmed) || trimmed.startsWith('/uploads/') || trimmed.startsWith('/assets/')) {
          return trimmed;
        }
        return `/uploads/${trimmed.replace(/^\/+/, '')}`;
      }

      function resolveAvatarUrlForRender(rawUrl) {
        if (!rawUrl) return null;
        const normalized = resolveAvatarUrlForSave(rawUrl);
        if (!normalized) return null;
        if (normalized === DEFAULT_AVATAR) return null;
        return normalized;
      }

      function applyAvatarToImg(imgEl, url) {
        if (!imgEl) return;
        const nextSrc = url || DEFAULT_AVATAR;

        if (imgEl.__okFallbackHandler) {
          imgEl.removeEventListener('error', imgEl.__okFallbackHandler);
          imgEl.__okFallbackHandler = null;
        }

        const onErr = function () {
          const fb = imgEl.getAttribute('data-fallback') || FALLBACK_DATA_URI;
          if (fb && imgEl.src !== fb) {
            imgEl.src = fb;
          }
        };
        imgEl.__okFallbackHandler = onErr;
        imgEl.addEventListener('error', onErr);

        if (imgEl.getAttribute('src') !== nextSrc) {
          imgEl.setAttribute('src', nextSrc);
        }
      }

      function pickAvatarField(obj) {
        if (!obj) return null;
        return obj.avatarUrl || obj.avatar_url || obj.avatar || null;
      }

      /**
       * Busca o perfil do utilizador e atualiza o avatar do navbar com a foto real.
       * Replica o comportamento do Perfil (fetch /users/profile → resolveAvatarUrlForRender → applyAvatarToImg).
       * Silencioso em caso de erro: o EJS já renderizou um fallback inicial.
       */
      async function hydrateNavbarAvatar() {
        const navAvatar = document.getElementById('ok-nav-avatar');
        const navName = document.getElementById('ok-nav-fullname');
        const navRole = document.getElementById('ok-nav-role');
        if (!navAvatar || !window.apiClient) return;

        try {
          const res = await window.apiClient.get('/users/profile');
          const raw =
            (res && res.data && res.data.user) ||
            (res && res.data && res.data.data) ||
            (res && res.data) ||
            res;
          if (!raw) return;

          const avatarField = pickAvatarField(raw);
          const normalizedAvatar = resolveAvatarUrlForRender(avatarField);
          applyAvatarToImg(navAvatar, normalizedAvatar);

          const fullName = raw.fullName || raw.full_name || '';
          const role = raw.role || 'Utilizador';
          if (navName && fullName) navName.textContent = String(fullName).split(' ')[0];
          if (navRole) navRole.textContent = role;
        } catch (err) {
          // Silencioso: EJS já tem fallback. Apenas loga em modo debug.
          console.warn('[NAV:AVATAR_HYDRATE_WARN]', err && err.message ? err.message : err);
        }
      }

      function initAvatarFallback() {
        const img = document.getElementById('ok-nav-avatar');
        if (!img) return;
        // Garante que o handler de fallback está ligado já no load inicial
        // (antes mesmo do hydrateNavbarAvatar completar).
        applyAvatarToImg(img, resolveAvatarUrlForRender(img.getAttribute('src')));
      }

      function setupGlobalActions() {
        const toggleBtn = document.getElementById('sidebar-toggle-btn');
        if (toggleBtn) {
          toggleBtn.addEventListener('click', () => {
            document.body.classList.toggle('mobile-nav-active');
          });
        }
        document.querySelectorAll('[data-action="logout"]').forEach(btn => {
          btn.addEventListener('click', async function (e) {
            e.preventDefault();
            try {
              await window.apiClient.post('/auth/logout', {});
              if (window.apiClient) window.apiClient.clearSession();
            } catch (err) {}
            window.location.href = '/login';
          });
        });
      }

      /* ====================================================================
         LÓGICA DOS MEMBROS — PRESERVADA INTEGRALMENTE
         ==================================================================== */
      const groupId = '<%= groupId %>';
      let activeGroup = null;
      let allMembers = [];
      let currentUserId = null;
      let isLeaderOrAdmin = false;

      const loadingEl = document.getElementById('members-loading-state');
      const contentEl = document.getElementById('members-content-wrapper');
      const tableBody = document.getElementById('members-table-body');
      const emptyState = document.getElementById('members-empty-state');
      const pendingCard = document.getElementById('pending-requests-card');
      const pendingTableBody = document.getElementById('pending-requests-table-body');
      const pendingCountEl = document.getElementById('pending-requests-count');
      const filterRoleSelect = document.getElementById('filter-member-role');
      const filterStatusSelect = document.getElementById('filter-member-status');

      async function initializePage() {
        try {
          if (!window.apiClient) return;

          currentUserId = window.App ? window.App.resolveCurrentUserId ? window.App.resolveCurrentUserId() : null : null;

          const groupRes = await window.apiClient.get('/groups/' + groupId);
          activeGroup = groupRes.data && groupRes.data.group ? groupRes.data.group : groupRes.data;

          document.getElementById('group-name-badge').textContent = activeGroup.name || 'Grupo';

          isLeaderOrAdmin = Boolean(
            activeGroup.leader_id === currentUserId ||
            activeGroup.creator_id === currentUserId ||
            (window.App && window.App.user && (window.App.user.role === 'ADMIN' || window.App.user.role === 'AUDITOR'))
          );

          await loadMembersList();

          loadingEl.classList.add('d-none');
          contentEl.classList.remove('d-none');
        } catch (err) {
          loadingEl.innerHTML = `
            <div class="ok-empty-state">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <h6>Erro ao Carregar Participantes</h6>
              <p class="small mb-3">${err.message || 'Falha ao consultar a lista de membros do grupo.'}</p>
              <a href="/groups/${groupId}" class="ok-btn-ghost-pill" style="height: 40px; padding: 0 16px; font-size: 0.82rem; text-decoration: none;">Voltar ao Grupo</a>
            </div>
          `;
        }
      }

      async function loadMembersList() {
        try {
          const res = await window.apiClient.get(`/groups/${groupId}/members`);
          allMembers = res.data && res.data.members ? res.data.members : res.data || [];

          const activeCount = allMembers.filter(m => m.status === 'ACTIVE').length;
          const maxCount = activeGroup.max_members || 12;

          document.getElementById('members-quorum-badge').textContent = `${activeCount} / ${maxCount} vagas`;
          document.getElementById('tab-members-count').textContent = activeCount;
          document.getElementById('active-members-count-badge').textContent = `${activeCount} participante(s) ativo(s)`;

          const pendingList = allMembers.filter(m => m.status === 'PENDING_APPROVAL');
          if (isLeaderOrAdmin && pendingList.length > 0) {
            renderPendingRequests(pendingList);
            pendingCard.classList.remove('d-none');
          } else {
            pendingCard.classList.add('d-none');
          }

          renderMembersTable();
        } catch (error) {
          tableBody.innerHTML = `
            <tr>
              <td colspan="8" class="text-center py-4" style="color: #f43f5e; font-size: 0.86rem;">
                Falha ao listar participantes.
              </td>
            </tr>
          `;
        }
      }

      function renderPendingRequests(pendingList) {
        pendingCountEl.textContent = pendingList.length;
        let html = '';

        pendingList.forEach(m => {
          const name = m.full_name || m.preferred_name || 'Utilizador';
          const email = m.email || '—';
          const phone = m.phone_number || '—';
          const joinedDate = window.App ? window.App.formatDate(m.joined_at || m.created_at, true) : 'Hoje';

          html += `
            <tr>
              <td>
                <div class="d-flex align-items-center gap-3">
                  <div class="ok-avatar-initial">
                    ${name.charAt(0).toUpperCase()}
                  </div>
                  <div>
                    <strong style="color: var(--ok-text-primary); display: block;">${name}</strong>
                    <span style="color: var(--ok-text-muted); font-size: 0.78rem;">${email}</span>
                  </div>
                </div>
              </td>
              <td style="color: var(--ok-text-muted); font-family: monospace; font-size: 0.82rem;">${phone}</td>
              <td style="color: var(--ok-text-muted); font-size: 0.82rem;">${joinedDate}</td>
              <td class="text-end">
                <div class="d-flex gap-2 justify-content-end">
                  <button type="button" class="ok-action-approve" data-action="approve-member" data-membership-id="${m.membership_id || m.id}">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    Aprovar
                  </button>
                  <button type="button" class="ok-action-reject" data-action="reject-member" data-membership-id="${m.membership_id || m.id}">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    Rejeitar
                  </button>
                </div>
              </td>
            </tr>
          `;
        });

        pendingTableBody.innerHTML = html;

        pendingTableBody.querySelectorAll('[data-action="approve-member"]').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            const membershipId = btn.getAttribute('data-membership-id');
            await handlePendingAction(membershipId, 'approve');
          });
        });

        pendingTableBody.querySelectorAll('[data-action="reject-member"]').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            const membershipId = btn.getAttribute('data-membership-id');
            await handlePendingAction(membershipId, 'reject');
          });
        });
      }

      async function handlePendingAction(membershipId, action) {
        try {
          if (window.Alerts) {
            const confirm = await window.Alerts.confirm({
              title: action === 'approve' ? 'Aprovar Adesão?' : 'Rejeitar Pedido?',
              text: action === 'approve'
                ? 'O candidato passará a integrar o grupo como membro ativo.'
                : 'O pedido será recusado e o candidato removido da fila.',
              confirmButtonText: action === 'approve' ? 'Sim, aprovar' : 'Sim, rejeitar',
              isDangerous: action === 'reject'
            });
            if (!confirm) return;
          }

          if (window.Alerts) window.Alerts.showLoading('A processar...', 'Atualizando estado da filiação.');

          await window.apiClient.post(`/groups/memberships/${membershipId}/${action}`, {});

          if (window.Alerts) {
            window.Alerts.closeLoading();
            window.Alerts.success(
              action === 'approve' ? 'Adesão Aprovada!' : 'Pedido Rejeitado',
              action === 'approve' ? 'O participante já está ativo no grupo.' : 'O pedido foi rejeitado.'
            );
          }

          await loadMembersList();
        } catch (err) {
          if (window.Alerts) {
            window.Alerts.closeLoading();
            window.Alerts.error('Falha na Operação', err.message || 'Erro ao processar.');
          }
        }
      }

      function renderMembersTable() {
        const roleFilter = filterRoleSelect.value;
        const statusFilter = filterStatusSelect.value;

        let filtered = allMembers.filter(m => m.status !== 'PENDING_APPROVAL');

        if (statusFilter) {
          filtered = filtered.filter(m => m.status === statusFilter);
        }

        if (roleFilter) {
          if (roleFilter === 'PRIMARY_LEADER') {
            filtered = filtered.filter(m => m.is_leader);
          } else {
            filtered = filtered.filter(m => m.role === roleFilter && !m.is_leader);
          }
        }

        if (filtered.length === 0) {
          tableBody.innerHTML = '';
          emptyState.classList.remove('d-none');
          return;
        }

        emptyState.classList.add('d-none');
        let html = '';

        filtered.forEach(m => {
          const isLeader = Boolean(m.is_leader);
          const isSelf = m.user_id === currentUserId;
          const name = m.full_name || m.preferred_name || 'Participante';
          const slot = m.slot_number ? `<span class="ok-badge-purple">Vaga #${m.slot_number}</span>` : '<span style="color: var(--ok-text-muted); font-size: 0.82rem;">—</span>';
          const roleBadge = getMemberRoleBadge(m.role, isLeader);
          const statusBadge = getMemberStatusBadge(m.status);
          const restrictions = getRestrictionsBadge(m);
          const joinedAt = window.App ? window.App.formatDate(m.joined_at, false) : '—';
          const phone = m.phone_number ? `<span style="font-family: monospace; font-size: 0.82rem; color: var(--ok-text-muted);">${m.phone_number}</span>` : '—';

          html += `
            <tr>
              <td>${slot}</td>
              <td>
                <div class="d-flex align-items-center gap-3">
                  <div class="ok-avatar-initial">
                    ${name.charAt(0).toUpperCase()}
                  </div>
                  <div>
                    <strong style="color: var(--ok-text-primary); display: block;">
                      ${name} ${isSelf ? '<span class="ok-badge-purple" style="font-size: 0.65rem;">Você</span>' : ''}
                    </strong>
                    <span style="color: var(--ok-text-muted); font-size: 0.76rem;">${m.email || ''}</span>
                  </div>
                </div>
              </td>
              <td>${phone}</td>
              <td>${roleBadge}</td>
              <td>${statusBadge}</td>
              <td>${restrictions}</td>
              <td style="color: var(--ok-text-muted); font-size: 0.82rem;">${joinedAt}</td>
              <td class="text-end">
                ${isLeaderOrAdmin && !isLeader ? `
                  <div class="dropdown">
                    <button class="ok-row-action-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                      <li>
                        <button class="dropdown-item" onclick="window.openRestrictionsModal('${m.membership_id || m.id}', ${Boolean(m.is_banned_from_chat)}, ${Boolean(m.is_contribution_restricted)}, ${Boolean(m.is_payout_restricted)})">
                          Restrições Operacionais
                        </button>
                      </li>
                      <li>
                        <button class="dropdown-item" onclick="window.openDelegateModal('${m.user_id}')">
                          Designar Cargo
                        </button>
                      </li>
                      <li><hr class="dropdown-divider"></li>
                      ${m.status === 'ACTIVE' ? `
                        <li>
                          <button class="dropdown-item text-warning" onclick="window.openSuspendModal('${m.membership_id || m.id}')">
                            Suspender Membro
                          </button>
                        </li>
                      ` : m.status === 'SUSPENDED' ? `
                        <li>
                          <button class="dropdown-item text-success" data-action="reactivate-member" data-membership-id="${m.membership_id || m.id}">
                            Reativar Filiação
                          </button>
                        </li>
                      ` : ''}
                    </ul>
                  </div>
                ` : '<span style="color: var(--ok-text-muted); font-size: 0.82rem;">—</span>'}
              </td>
            </tr>
          `;
        });

        tableBody.innerHTML = html;

        tableBody.querySelectorAll('[data-action="reactivate-member"]').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            const membershipId = btn.getAttribute('data-membership-id');
            try {
              if (window.Alerts) window.Alerts.showLoading('A reativar...', 'Restaurando filiação do membro.');
              await window.apiClient.post(`/groups/memberships/${membershipId}/reactivate`, {});
              if (window.Alerts) {
                window.Alerts.closeLoading();
                window.Alerts.success('Membro Reativado!', 'O participante voltou ao estado ativo.');
              }
              await loadMembersList();
            } catch (err) {
              if (window.Alerts) {
                window.Alerts.closeLoading();
                window.Alerts.error(err.message || 'Falha ao reativar membro.');
              }
            }
          });
        });
      }

      function getMemberRoleBadge(role, isLeader) {
        if (isLeader) {
          return '<span class="ok-badge-purple">Líder Titular</span>';
        }
        switch (role) {
          case 'VICE_LEADER':
            return '<span class="ok-badge-purple">Vice-Líder</span>';
          case 'TREASURER':
            return '<span class="ok-badge-purple">Tesoureiro</span>';
          case 'SECRETARY':
            return '<span class="ok-badge-purple">Secretário</span>';
          default:
            return '<span class="ok-badge-soft">Membro</span>';
        }
      }

      function getMemberStatusBadge(status) {
        switch (status) {
          case 'ACTIVE':
            return '<span class="ok-badge-purple">Ativo</span>';
          case 'SUSPENDED':
            return '<span class="ok-badge-soft" style="color: #f59e0b;">Suspenso</span>';
          case 'DEFAULTED':
            return '<span class="ok-badge-soft" style="color: #f43f5e;">Inadimplente</span>';
          case 'LEFT':
            return '<span class="ok-badge-soft">Saiu do Grupo</span>';
          default:
            return '<span class="ok-badge-soft">' + status + '</span>';
        }
      }

      function getRestrictionsBadge(m) {
        const badges = [];
        if (m.is_banned_from_chat) badges.push('<span class="ok-badge-soft" style="color: #f43f5e;">Chat</span>');
        if (m.is_contribution_restricted) badges.push('<span class="ok-badge-soft" style="color: #f59e0b;">Quota</span>');
        if (m.is_payout_restricted) badges.push('<span class="ok-badge-soft">Bolo</span>');

        return badges.length > 0 ? `<div class="d-flex gap-1 flex-wrap">${badges.join('')}</div>` : '<span style="color: var(--ok-text-muted); font-size: 0.78rem;">Nenhuma</span>';
      }

      window.openSuspendModal = function (membershipId) {
        document.getElementById('suspend-membership-id').value = membershipId;
        const modal = new bootstrap.Modal(document.getElementById('modal-suspend-member'));
        modal.show();
      };

      window.openRestrictionsModal = function (membershipId, chatBanned, contribRestricted, payoutRestricted) {
        document.getElementById('restrictions-membership-id').value = membershipId;
        document.getElementById('switch-ban-chat').checked = chatBanned;
        document.getElementById('switch-restrict-contrib').checked = contribRestricted;
        document.getElementById('switch-restrict-payout').checked = payoutRestricted;

        const modal = new bootstrap.Modal(document.getElementById('modal-manage-restrictions'));
        modal.show();
      };

      window.openDelegateModal = function (userId) {
        document.getElementById('delegate-target-user-id').value = userId;
        const modal = new bootstrap.Modal(document.getElementById('modal-delegate-role'));
        modal.show();
      };

      const formSuspend = document.getElementById('form-suspend-member');
      if (formSuspend) {
        formSuspend.addEventListener('submit', async (e) => {
          e.preventDefault();
          const membershipId = document.getElementById('suspend-membership-id').value;
          const reason = formSuspend.querySelector('[name="reason"]').value.trim();
          const suspendedUntil = formSuspend.querySelector('[name="suspendedUntil"]').value || null;

          try {
            if (window.Alerts) window.Alerts.showLoading('A suspender...', 'Aplicando sanção disciplinar.');
            await window.apiClient.post(`/groups/memberships/${membershipId}/suspend`, { reason, suspendedUntil });
            bootstrap.Modal.getInstance(document.getElementById('modal-suspend-member')).hide();
            if (window.Alerts) {
              window.Alerts.closeLoading();
              window.Alerts.toast('Participante suspenso com sucesso.', 'info');
            }
            await loadMembersList();
          } catch (err) {
            if (window.Alerts) {
              window.Alerts.closeLoading();
              window.Alerts.error(err.message || 'Falha ao suspender participante.');
            }
          }
        });
      }

      const formRestrictions = document.getElementById('form-manage-restrictions');
      if (formRestrictions) {
        formRestrictions.addEventListener('submit', async (e) => {
          e.preventDefault();
          const membershipId = document.getElementById('restrictions-membership-id').value;
          const isBannedFromChat = document.getElementById('switch-ban-chat').checked;
          const isContributionRestricted = document.getElementById('switch-restrict-contrib').checked;
          const isPayoutRestricted = document.getElementById('switch-restrict-payout').checked;

          try {
            if (window.Alerts) window.Alerts.showLoading('A guardar...', 'Atualizando restrições cautelares.');
            await window.apiClient.patch(`/groups/memberships/${membershipId}/restrictions`, {
              isBannedFromChat,
              isContributionRestricted,
              isPayoutRestricted
            });
            bootstrap.Modal.getInstance(document.getElementById('modal-manage-restrictions')).hide();
            if (window.Alerts) {
              window.Alerts.closeLoading();
              window.Alerts.toast('Restrições atualizadas.', 'success');
            }
            await loadMembersList();
          } catch (err) {
            if (window.Alerts) {
              window.Alerts.closeLoading();
              window.Alerts.error(err.message || 'Falha ao atualizar restrições.');
            }
          }
        });
      }

      const formDelegate = document.getElementById('form-delegate-role');
      if (formDelegate) {
        formDelegate.addEventListener('submit', async (e) => {
          e.preventDefault();
          const targetUserId = document.getElementById('delegate-target-user-id').value;
          const leadershipRole = document.getElementById('delegate-leadership-role-select').value;
          const delegatedUntil = formDelegate.querySelector('[name="delegatedUntil"]').value || null;

          try {
            if (window.Alerts) window.Alerts.showLoading('A designar...', 'Atribuindo cargo de liderança.');
            await window.apiClient.post(`/groups/${groupId}/leadership/delegate`, {
              targetUserId,
              leadershipRole,
              delegatedUntil
            });
            bootstrap.Modal.getInstance(document.getElementById('modal-delegate-role')).hide();
            if (window.Alerts) {
              window.Alerts.closeLoading();
              window.Alerts.success('Cargo Atribuído!', 'O participante assumiu as novas funções de governança.');
            }
            await loadMembersList();
          } catch (err) {
            if (window.Alerts) {
              window.Alerts.closeLoading();
              window.Alerts.error(err.message || 'Erro ao designar cargo de liderança.');
            }
          }
        });
      }

      filterRoleSelect.addEventListener('change', renderMembersTable);
      filterStatusSelect.addEventListener('change', renderMembersTable);

      /* ====================================================================
         INIT
         ==================================================================== */
      document.addEventListener('DOMContentLoaded', () => {
        initThemeToggle();
        initAvatarFallback();
        // Hidrata o avatar do navbar com a foto real do backend (igual ao Perfil).
        hydrateNavbarAvatar();
        setupGlobalActions();
        initializePage();
      });
    })();
  </script>
</body>
</html>