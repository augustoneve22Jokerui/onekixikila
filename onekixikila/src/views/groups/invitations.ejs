<!DOCTYPE html>
<html lang="pt-AO">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title><%= typeof title !== 'undefined' ? title : 'Convites & QR Code — OneKixikila' %></title>
  <% if (typeof csrfToken !== 'undefined') { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
  <% } %>
  <link rel="icon" type="image/x-icon" href="/assets/images/favicon.ico">

  <!-- Tipografia -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>
    /* =========================================================================
       SISTEMA DE DESIGN — ONEKIXIKILA (TEMA ESCURO PADRÃO + TEMA CLARO)
       Sidebar + Top Bar: arredondados. Cards centrais: quadrados.
       Cores 100% roxo.
       Escala MAIOR (igual ao Perfil / Carteira ampliada)
       ========================================================================= */
    :root,
    html[data-theme="dark"] {
      --ok-bg-canvas: #050508;
      --ok-bg-surface: #0a0a10;
      --ok-bg-elevated: #111118;

      --ok-purple-primary: #7c3aed;
      --ok-purple-vibrant: #8b5cf6;
      --ok-purple-soft: rgba(139, 92, 246, 0.12);
      --ok-purple-border: rgba(139, 92, 246, 0.3);

      --ok-text-primary: #ffffff;
      --ok-text-secondary: #cbd5e1;
      --ok-text-muted: #94a3b8;

      --ok-border-subtle: rgba(255, 255, 255, 0.08);
      --ok-input-bg: rgba(255, 255, 255, 0.04);
      --ok-pill-bg: rgba(255, 255, 255, 0.05);
      --ok-pill-bg-hover: rgba(139, 92, 246, 0.12);
      --ok-meter-bg: rgba(255, 255, 255, 0.05);
      --ok-stream-hover: var(--ok-purple-soft);
      --ok-shadow-card: rgba(0, 0, 0, 0.75);
      --ok-shadow-sidebar: rgba(0, 0, 0, 0.6);

      --ok-radius-pill: 9999px;
      --ok-sidebar-width: 96px;
      --ok-navbar-height: 92px;
      --ok-content-max-width: 1280px;
    }

    html[data-theme="light"] {
      --ok-bg-canvas: #f4f5f9;
      --ok-bg-surface: #ffffff;
      --ok-bg-elevated: #ffffff;

      --ok-purple-primary: #6d28d9;
      --ok-purple-vibrant: #7c3aed;
      --ok-purple-soft: rgba(124, 58, 237, 0.08);
      --ok-purple-border: rgba(124, 58, 237, 0.25);

      --ok-text-primary: #0f172a;
      --ok-text-secondary: #334155;
      --ok-text-muted: #64748b;

      --ok-border-subtle: rgba(15, 23, 42, 0.10);
      --ok-input-bg: #ffffff;
      --ok-pill-bg: rgba(15, 23, 42, 0.04);
      --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
      --ok-meter-bg: rgba(15, 23, 42, 0.06);
      --ok-stream-hover: rgba(124, 58, 237, 0.08);
      --ok-shadow-card: rgba(15, 23, 42, 0.10);
      --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);
    }

    @media (prefers-color-scheme: light) {
      html:not([data-theme]) {
        --ok-bg-canvas: #f4f5f9;
        --ok-bg-surface: #ffffff;
        --ok-bg-elevated: #ffffff;

        --ok-purple-primary: #6d28d9;
        --ok-purple-vibrant: #7c3aed;
        --ok-purple-soft: rgba(124, 58, 237, 0.08);
        --ok-purple-border: rgba(124, 58, 237, 0.25);

        --ok-text-primary: #0f172a;
        --ok-text-secondary: #334155;
        --ok-text-muted: #64748b;

        --ok-border-subtle: rgba(15, 23, 42, 0.10);
        --ok-input-bg: #ffffff;
        --ok-pill-bg: rgba(15, 23, 42, 0.04);
        --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
        --ok-meter-bg: rgba(15, 23, 42, 0.06);
        --ok-stream-hover: rgba(124, 58, 237, 0.08);
        --ok-shadow-card: rgba(15, 23, 42, 0.10);
        --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);
      }
    }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-font-smoothing: antialiased; }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--ok-bg-canvas);
      color: var(--ok-text-primary);
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
      transition: background-color 0.25s ease, color 0.25s ease;
      font-size: 15px;
    }

    .ok-ambient-glow-core {
      position: fixed;
      top: -140px; left: 20%;
      width: 650px; height: 650px;
      background: radial-gradient(circle, rgba(124, 58, 237, 0.16) 0%, rgba(5, 5, 8, 0) 70%);
      pointer-events: none; z-index: 0; filter: blur(100px);
    }
    html[data-theme="light"] .ok-ambient-glow-core {
      background: radial-gradient(circle, rgba(124, 58, 237, 0.12) 0%, rgba(244, 245, 249, 0) 70%);
    }

    /* =========================================================================
       BARRA LATERAL — ARREDONDADA
       ========================================================================= */
    .ok-rail-sidebar {
      position: fixed;
      top: 24px; left: 24px; bottom: 24px;
      width: var(--ok-sidebar-width);
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 24px;
      display: flex; flex-direction: column; align-items: center;
      padding: 26px 0;
      z-index: 1040;
      box-shadow: 0 12px 36px var(--ok-shadow-sidebar);
      backdrop-filter: blur(24px);
      transition: all 0.3s ease;
    }

    .ok-brand-emblem {
      width: 56px; height: 56px; border-radius: 18px;
      background: linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 32px;
      box-shadow: 0 10px 26px rgba(124, 58, 237, 0.45);
      text-decoration: none;
    }
    .ok-brand-emblem svg { width: 28px; height: 28px; }

    .ok-rail-nav {
      flex: 1;
      display: flex; flex-direction: column; align-items: center;
      gap: 16px; width: 100%;
    }

    .ok-rail-link {
      width: 52px; height: 52px; border-radius: 16px;
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-muted); text-decoration: none;
      transition: all 0.2s ease; background: transparent;
      position: relative;
    }
    .ok-rail-link svg { width: 22px; height: 22px; }
    .ok-rail-link:hover {
      color: var(--ok-purple-vibrant);
      background-color: var(--ok-purple-soft);
      transform: translateY(-2px);
    }
    .ok-rail-link.active {
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      color: #ffffff;
      box-shadow: 0 10px 24px rgba(139, 92, 246, 0.5);
    }
    .ok-badge-dot {
      position: absolute; top: 10px; right: 10px;
      width: 9px; height: 9px; border-radius: 50%;
      background-color: #ef4444;
      border: 2px solid var(--ok-bg-surface);
    }

    .ok-rail-footer {
      display: flex; flex-direction: column; align-items: center;
      gap: 12px; width: 100%;
    }

    /* =========================================================================
       VIEWPORT SHELL
       ========================================================================= */
    .ok-viewport-shell {
      margin-left: calc(var(--ok-sidebar-width) + 44px);
      padding: 24px 40px 60px 0;
      position: relative; z-index: 1;
    }

    /* =========================================================================
       TOP BAR — ARREDONDADA — CENTRALIZADA AO CONTEÚDO
       ========================================================================= */
    .ok-top-nav {
      height: var(--ok-navbar-height);
      display: flex; align-items: center; justify-content: space-between;
      margin: 0 auto 26px auto;
      max-width: var(--ok-content-max-width);
      width: 100%;
      gap: 20px;
      flex-wrap: wrap;
    }

    .ok-search-capsule {
      position: relative;
      width: 500px; max-width: 100%;
      flex-shrink: 1;
    }
    .ok-search-capsule input {
      width: 100%; height: 54px;
      border-radius: var(--ok-radius-pill);
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      padding: 0 90px 0 52px;
      font-size: 0.96rem;
      color: var(--ok-text-primary);
      outline: none;
      transition: all 0.25s ease;
    }
    .ok-search-capsule input::placeholder { color: var(--ok-text-muted); }
    .ok-search-capsule input:focus {
      border-color: var(--ok-purple-vibrant);
      box-shadow: 0 0 0 4px var(--ok-purple-soft);
    }
    .ok-search-capsule .search-icon {
      position: absolute; left: 18px; top: 50%;
      transform: translateY(-50%);
      color: var(--ok-text-muted);
    }
    .ok-search-capsule .search-icon svg { width: 18px; height: 18px; }
    .ok-search-capsule .shortcut-hint {
      position: absolute; right: 14px; top: 50%;
      transform: translateY(-50%);
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 8px;
      padding: 4px 9px;
      font-size: 0.74rem;
      color: var(--ok-text-muted);
      font-weight: 600;
    }

    .ok-nav-actions { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }

    .ok-action-circle {
      width: 52px; height: 52px; border-radius: 16px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-primary);
      text-decoration: none;
      transition: all 0.2s ease;
      position: relative;
    }
    .ok-action-circle:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      transform: translateY(-2px);
    }

    .ok-profile-pill {
      display: flex; align-items: center; gap: 12px;
      padding: 6px 20px 6px 6px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: var(--ok-radius-pill);
      text-decoration: none; cursor: pointer;
    }
    .ok-profile-avatar-nav {
      width: 44px; height: 44px;
      border-radius: 50%; object-fit: cover;
      background: var(--ok-purple-soft);
      border: 2px solid var(--ok-purple-border);
    }

    .ok-theme-toggle {
      width: 52px; height: 52px; border-radius: 16px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-primary); cursor: pointer;
      transition: all 0.2s ease;
    }
    .ok-theme-toggle:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      transform: translateY(-2px);
    }
    .ok-theme-toggle svg { width: 20px; height: 20px; }

    /* =========================================================================
       HERO — ARREDONDADO
       ========================================================================= */
    .ok-canvas-hero-title {
      max-width: var(--ok-content-max-width);
      margin: 0 auto 30px auto;
      display: flex; justify-content: space-between; align-items: flex-end;
      flex-wrap: wrap; gap: 20px;
    }

    .ok-breadcrumb-btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 16px;
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      border-radius: var(--ok-radius-pill);
      color: var(--ok-text-muted);
      text-decoration: none;
      font-size: 0.86rem; font-weight: 700;
      margin-bottom: 12px;
      transition: all 0.2s ease;
    }
    .ok-breadcrumb-btn:hover {
      background: var(--ok-pill-bg-hover);
      color: var(--ok-purple-vibrant);
      border-color: var(--ok-purple-border);
      transform: translateX(-2px);
    }

    .ok-page-title-main {
      font-size: 2.15rem; font-weight: 800;
      letter-spacing: -0.03em; line-height: 1.15;
      color: var(--ok-text-primary);
      margin: 0;
      display: flex; align-items: center; gap: 14px;
      flex-wrap: wrap;
    }

    .ok-live-beacon {
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 0.76rem; font-weight: 800;
      padding: 5px 13px;
      border-radius: var(--ok-radius-pill);
      background: var(--ok-purple-soft);
      border: 1px solid var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      letter-spacing: 0.04em; text-transform: uppercase;
    }
    .ok-pulse-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background-color: var(--ok-purple-vibrant);
      box-shadow: 0 0 10px var(--ok-purple-vibrant);
    }

    .ok-canvas-sub {
      color: var(--ok-text-muted);
      font-size: 0.96rem; margin-top: 8px; line-height: 1.5;
    }

    .ok-btn-confirm-pill {
      height: 48px; padding: 0 22px;
      border-radius: var(--ok-radius-pill);
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      color: #ffffff; border: none;
      font-size: 0.86rem; font-weight: 800;
      cursor: pointer;
      display: inline-flex; align-items: center; gap: 8px;
      box-shadow: 0 8px 20px rgba(124, 58, 237, 0.4);
      transition: all 0.2s ease;
      text-decoration: none;
    }
    .ok-btn-confirm-pill:hover { transform: translateY(-2px); color: #ffffff; }

    .ok-btn-ghost-pill {
      height: 48px; padding: 0 22px;
      border-radius: var(--ok-radius-pill);
      background: var(--ok-pill-bg);
      color: var(--ok-text-primary);
      border: 1px solid var(--ok-border-subtle);
      font-size: 0.86rem; font-weight: 700;
      cursor: pointer;
      display: inline-flex; align-items: center; gap: 8px;
      transition: all 0.2s ease;
      text-decoration: none;
    }
    .ok-btn-ghost-pill:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      background: var(--ok-pill-bg-hover);
      transform: translateY(-2px);
    }

    /* Nav pills internas do grupo */
    .ok-group-nav-pills {
      display: flex; gap: 8px;
      padding: 8px;
      background: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: var(--ok-radius-pill);
      overflow-x: auto;
      margin-bottom: 30px;
      max-width: var(--ok-content-max-width);
      margin-left: auto; margin-right: auto;
      scrollbar-width: none;
    }
    .ok-group-nav-pills::-webkit-scrollbar { display: none; }
    .ok-group-nav-pill {
      padding: 10px 20px;
      border-radius: var(--ok-radius-pill);
      font-size: 0.84rem; font-weight: 700;
      color: var(--ok-text-muted);
      text-decoration: none;
      white-space: nowrap;
      transition: all 0.2s ease;
      display: inline-flex; align-items: center; gap: 6px;
    }
    .ok-group-nav-pill:hover {
      color: var(--ok-purple-vibrant);
      background: var(--ok-pill-bg-hover);
    }
    .ok-group-nav-pill.active {
      background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
      color: #ffffff;
      box-shadow: 0 6px 18px rgba(124, 58, 237, 0.4);
    }

    /* =========================================================================
       CARDS CENTRAIS — QUADRADOS
       ========================================================================= */
    .ok-invitations-layout {
      max-width: var(--ok-content-max-width);
      margin: 0 auto;
    }

    .ok-invitation-card {
      background: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 0;
      padding: 0;
      box-shadow: 0 8px 32px var(--ok-shadow-card);
      margin-bottom: 24px;
      overflow: hidden;
    }
    .ok-invitation-card-header {
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--ok-border-subtle);
      display: flex; justify-content: space-between; align-items: center;
      flex-wrap: wrap; gap: 12px;
    }
    .ok-invitation-card-header h5 {
      font-size: 1.1rem; font-weight: 800;
      color: var(--ok-text-primary);
      margin: 0;
      display: flex; align-items: center; gap: 8px;
    }
    .ok-invitation-card-body { padding: 1.5rem; }

    /* Form/input square */
    .ok-input-square {
      width: 100%;
      height: 48px;
      border-radius: 0;
      background: var(--ok-input-bg);
      border: 1px solid var(--ok-border-subtle);
      padding: 0 18px;
      font-size: 0.9rem;
      color: var(--ok-text-primary);
      outline: none;
      transition: all 0.2s ease;
    }
    .ok-input-square:focus {
      border-color: var(--ok-purple-vibrant);
      background: var(--ok-bg-surface);
      box-shadow: 0 0 0 4px var(--ok-purple-soft);
    }
    .ok-input-square::placeholder { color: var(--ok-text-muted); }
    .ok-input-square[readonly] { cursor: pointer; }

    /* QR Box — quadrado */
    .ok-qr-box-square {
      padding: 14px;
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 0;
      display: inline-block;
      max-width: 240px;
    }

    /* Tabela */
    .ok-invitations-table {
      width: 100%;
      border-collapse: collapse;
    }
    .ok-invitations-table thead {
      background: var(--ok-pill-bg);
    }
    .ok-invitations-table thead th {
      padding: 14px 16px;
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ok-text-muted);
      text-align: left;
      border-bottom: 1px solid var(--ok-border-subtle);
      white-space: nowrap;
    }
    .ok-invitations-table tbody tr {
      border-bottom: 1px solid var(--ok-border-subtle);
      transition: background 0.2s ease;
    }
    .ok-invitations-table tbody tr:hover {
      background: var(--ok-stream-hover);
    }
    .ok-invitations-table tbody tr:last-child { border-bottom: none; }
    .ok-invitations-table tbody td {
      padding: 14px 16px;
      font-size: 0.86rem;
      color: var(--ok-text-primary);
      vertical-align: middle;
    }

    /* Badges */
    .ok-badge-purple {
      display: inline-flex; align-items: center;
      padding: 4px 10px;
      border-radius: 0;
      font-size: 0.72rem; font-weight: 800;
      background: var(--ok-purple-soft);
      color: var(--ok-purple-vibrant);
    }
    .ok-badge-soft {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 4px 10px;
      border-radius: 0;
      font-size: 0.72rem; font-weight: 700;
      background: var(--ok-pill-bg);
      color: var(--ok-text-muted);
      border: 1px solid var(--ok-border-subtle);
    }

    /* Botão de ação em linha */
    .ok-row-action-btn {
      width: 34px; height: 34px; border-radius: 0;
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      color: var(--ok-text-primary);
      display: inline-flex; align-items: center; justify-content: center;
      cursor: pointer;
      transition: all 0.2s ease;
      margin-left: 4px;
    }
    .ok-row-action-btn:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      background: var(--ok-purple-soft);
    }
    .ok-row-action-btn.danger {
      color: #f43f5e;
      border-color: rgba(244, 63, 94, 0.3);
    }
    .ok-row-action-btn.danger:hover {
      background: #f43f5e;
      color: #ffffff;
      border-color: #f43f5e;
    }

    /* Social share buttons */
    .ok-social-btn {
      height: 40px; padding: 0 16px;
      border-radius: 0;
      font-size: 0.82rem; font-weight: 700;
      display: inline-flex; align-items: center; gap: 6px;
      border: 1px solid var(--ok-border-subtle);
      background: var(--ok-pill-bg);
      color: var(--ok-text-primary);
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .ok-social-btn:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      background: var(--ok-purple-soft);
    }

    /* Filters */
    .ok-filter-select {
      height: 40px;
      padding: 0 16px;
      border-radius: 0;
      background: var(--ok-input-bg);
      border: 1px solid var(--ok-border-subtle);
      font-size: 0.84rem;
      font-weight: 700;
      color: var(--ok-text-primary);
      outline: none;
      cursor: pointer;
    }
    .ok-filter-select option { color: #0f172a; }

    /* Pagination */
    .ok-pagination-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 20px;
      margin-top: 10px;
      border-top: 1px solid var(--ok-border-subtle);
      flex-wrap: wrap;
      gap: 10px;
    }
    .ok-page-btn {
      min-width: 36px; height: 36px;
      padding: 0 12px;
      border-radius: 0;
      border: 1px solid var(--ok-border-subtle);
      background: var(--ok-pill-bg);
      color: var(--ok-text-primary);
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .ok-page-btn:hover:not(:disabled) {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
    }
    .ok-page-btn.active {
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      color: #ffffff;
      border-color: transparent;
    }
    .ok-page-btn:disabled { opacity: 0.4; cursor: not-allowed; }

    /* Empty state */
    .ok-empty-state {
      text-align: center; padding: 3rem 1.5rem;
      color: var(--ok-text-muted);
    }
    .ok-empty-state svg {
      opacity: 0.4; margin-bottom: 1rem;
      display: block; margin-inline: auto;
    }
    .ok-empty-state h6 {
      font-weight: 700;
      color: var(--ok-text-primary);
      margin-bottom: 8px;
      font-size: 1.05rem;
    }

    /* Modais quadrados */
    .modal-content {
      background: var(--ok-bg-surface) !important;
      border: 1px solid var(--ok-border-subtle) !important;
      border-radius: 0 !important;
      color: var(--ok-text-primary) !important;
    }
    .modal-header, .modal-footer { border-color: var(--ok-border-subtle) !important; }
    .modal-title { color: var(--ok-text-primary) !important; }
    .form-label { color: var(--ok-text-primary); font-size: 0.86rem; font-weight: 700; }
    .form-control, .form-select {
      background: var(--ok-input-bg) !important;
      border: 1px solid var(--ok-border-subtle) !important;
      color: var(--ok-text-primary) !important;
      border-radius: 0 !important;
      height: 48px;
      font-size: 0.9rem;
    }
    .form-control:focus, .form-select:focus {
      border-color: var(--ok-purple-vibrant) !important;
      box-shadow: 0 0 0 4px var(--ok-purple-soft) !important;
      background: var(--ok-bg-surface) !important;
    }
    .form-control::placeholder { color: var(--ok-text-muted) !important; }
    .form-select option { color: #0f172a; }
    .input-group-text {
      background: var(--ok-pill-bg) !important;
      border: 1px solid var(--ok-border-subtle) !important;
      color: var(--ok-text-primary) !important;
      border-radius: 0 !important;
    }
    .btn-close { filter: invert(1); }
    html[data-theme="light"] .btn-close { filter: none; }

    /* Responsividade */
    @media (max-width: 991px) {
      .ok-rail-sidebar { transform: translateX(-140%); }
      .ok-viewport-shell { margin-left: 0; padding: 20px; }
      body.mobile-nav-active .ok-rail-sidebar { transform: translateX(0); }
      .ok-page-title-main { font-size: 1.7rem; }
      .ok-invitations-table { font-size: 0.78rem; }
      .ok-invitations-table thead th,
      .ok-invitations-table tbody td { padding: 10px 8px; }
      .ok-search-capsule { width: 100%; }
      .ok-top-nav { gap: 10px; }
    }
    @media (max-width: 600px) {
      .ok-top-nav { flex-wrap: wrap; height: auto; padding: 10px 0; }
      .ok-nav-actions { margin-left: auto; }
    }
  </style>
</head>
