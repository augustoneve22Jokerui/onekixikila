<!DOCTYPE html>
<html lang="pt-AO">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title><%= typeof title !== 'undefined' ? title : 'Resultado do Depósito — OneKixikila' %></title>
  <% if (typeof csrfToken !== 'undefined') { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
  <% } %>
  <link rel="icon" type="image/x-icon" href="/assets/images/favicon.ico">

  <!-- Tipografia -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 + Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>
    /* =========================================================================
       SISTEMA DE DESIGN — ONEKIXIKILA (TEMA ESCURO PADRÃO + TEMA CLARO)
       ========================================================================= */
    :root,
    html[data-theme="dark"] {
      --ok-bg-canvas: #050508;
      --ok-bg-surface: #0a0a10;
      --ok-bg-elevated: #111118;

      --ok-purple-primary: #7c3aed;
      --ok-purple-vibrant: #8b5cf6;
      --ok-purple-soft: rgba(139, 92, 246, 0.12);
      --ok-purple-border: rgba(139, 92, 246, 0.3);

      --ok-color-card-white: #ffffff;
      --ok-color-card-lime: #bef264;
      --ok-color-card-purple: #7c3aed;

      --ok-text-primary: #ffffff;
      --ok-text-secondary: #cbd5e1;
      --ok-text-muted: #94a3b8;

      --ok-border-subtle: rgba(255, 255, 255, 0.08);
      --ok-input-bg: rgba(255, 255, 255, 0.04);
      --ok-pill-bg: rgba(255, 255, 255, 0.05);
      --ok-pill-bg-hover: rgba(139, 92, 246, 0.12);
      --ok-chip-bg: rgba(255, 255, 255, 0.04);
      --ok-meter-bg: rgba(255, 255, 255, 0.05);
      --ok-stream-hover: var(--ok-purple-soft);
      --ok-shadow-card: rgba(0, 0, 0, 0.75);
      --ok-shadow-sidebar: rgba(0, 0, 0, 0.6);

      --ok-bg-balance: #0d3b38;
      --ok-accent-green: #a3e635;
      --ok-accent-green-hover: #84cc16;
      --ok-accent-green-light: rgba(163, 230, 53, 0.12);

      --ok-success-bg: #dcfce7;
      --ok-success-fg: #16a34a;
      --ok-success-deep: #166534;

      --ok-radius-pill: 9999px;
      --ok-sidebar-width: 86px;
      --ok-navbar-height: 80px;
    }

    html[data-theme="light"] {
      --ok-bg-canvas: #f4f5f9;
      --ok-bg-surface: #ffffff;
      --ok-bg-elevated: #ffffff;

      --ok-purple-primary: #6d28d9;
      --ok-purple-vibrant: #7c3aed;
      --ok-purple-soft: rgba(124, 58, 237, 0.08);
      --ok-purple-border: rgba(124, 58, 237, 0.25);

      --ok-color-card-white: #ffffff;
      --ok-color-card-lime: #bef264;
      --ok-color-card-purple: #7c3aed;

      --ok-text-primary: #0f172a;
      --ok-text-secondary: #334155;
      --ok-text-muted: #64748b;

      --ok-border-subtle: rgba(15, 23, 42, 0.10);
      --ok-input-bg: #ffffff;
      --ok-pill-bg: rgba(15, 23, 42, 0.04);
      --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
      --ok-chip-bg: #ffffff;
      --ok-meter-bg: rgba(15, 23, 42, 0.06);
      --ok-stream-hover: rgba(124, 58, 237, 0.08);
      --ok-shadow-card: rgba(15, 23, 42, 0.10);
      --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);

      --ok-bg-balance: #0d3b38;
      --ok-accent-green: #a3e635;
      --ok-accent-green-hover: #84cc16;
      --ok-accent-green-light: #eff6e0;

      --ok-success-bg: #dcfce7;
      --ok-success-fg: #16a34a;
      --ok-success-deep: #166534;
    }

    @media (prefers-color-scheme: light) {
      html:not([data-theme]) {
        --ok-bg-canvas: #f4f5f9;
        --ok-bg-surface: #ffffff;
        --ok-bg-elevated: #ffffff;

        --ok-purple-primary: #6d28d9;
        --ok-purple-vibrant: #7c3aed;
        --ok-purple-soft: rgba(124, 58, 237, 0.08);
        --ok-purple-border: rgba(124, 58, 237, 0.25);

        --ok-text-primary: #0f172a;
        --ok-text-secondary: #334155;
        --ok-text-muted: #64748b;

        --ok-border-subtle: rgba(15, 23, 42, 0.10);
        --ok-input-bg: #ffffff;
        --ok-pill-bg: rgba(15, 23, 42, 0.04);
        --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
        --ok-chip-bg: #ffffff;
        --ok-meter-bg: rgba(15, 23, 42, 0.06);
        --ok-stream-hover: rgba(124, 58, 237, 0.08);
        --ok-shadow-card: rgba(15, 23, 42, 0.10);
        --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);

        --ok-bg-balance: #0d3b38;
        --ok-accent-green: #a3e635;
        --ok-accent-green-hover: #84cc16;
        --ok-accent-green-light: #eff6e0;

        --ok-success-bg: #dcfce7;
        --ok-success-fg: #16a34a;
        --ok-success-deep: #166534;
      }
    }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-font-smoothing: antialiased; }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--ok-bg-canvas);
      color: var(--ok-text-primary);
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
      transition: background-color 0.25s ease, color 0.25s ease;
    }

    .ok-ambient-glow-core {
      position: fixed;
      top: -120px; left: 20%;
      width: 550px; height: 550px;
      background: radial-gradient(circle, rgba(124, 58, 237, 0.14) 0%, rgba(5, 5, 8, 0) 70%);
      pointer-events: none; z-index: 0; filter: blur(90px);
    }
    html[data-theme="light"] .ok-ambient-glow-core {
      background: radial-gradient(circle, rgba(124, 58, 237, 0.10) 0%, rgba(244, 245, 249, 0) 70%);
    }

    /* =========================================================================
       BARRA LATERAL SLIM TECH
       ========================================================================= */
    .ok-rail-sidebar {
      position: fixed;
      top: 20px; left: 20px; bottom: 20px;
      width: var(--ok-sidebar-width);
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 20px;
      display: flex; flex-direction: column; align-items: center;
      padding: 22px 0;
      z-index: 1040;
      box-shadow: 0 10px 30px var(--ok-shadow-sidebar);
      backdrop-filter: blur(20px);
      transition: all 0.3s ease;
    }

    .ok-brand-emblem {
      width: 48px; height: 48px; border-radius: 14px;
      background: linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 28px;
      box-shadow: 0 8px 20px rgba(124, 58, 237, 0.4);
    }

    .ok-rail-nav {
      flex: 1;
      display: flex; flex-direction: column; align-items: center;
      gap: 14px; width: 100%;
    }

    .ok-rail-link {
      width: 46px; height: 46px; border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-muted); text-decoration: none;
      transition: all 0.2s ease; background: transparent;
    }
    .ok-rail-link:hover {
      color: var(--ok-purple-vibrant);
      background-color: var(--ok-purple-soft);
      transform: translateY(-2px);
    }
    .ok-rail-link.active {
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      color: #ffffff;
      box-shadow: 0 8px 20px rgba(139, 92, 246, 0.5);
    }
    .ok-rail-link i { font-size: 1.15rem; }

    .ok-rail-footer {
      display: flex; flex-direction: column; align-items: center;
      gap: 10px; width: 100%;
    }

    /* =========================================================================
       VIEWPORT SHELL
       ========================================================================= */
    .ok-viewport-shell {
      margin-left: calc(var(--ok-sidebar-width) + 36px);
      padding: 20px 32px 48px 0;
      position: relative; z-index: 1;
    }

    /* =========================================================================
       NAVBAR — CENTRALIZADA NO CONTEÚDO (max-width 1080px)
       ========================================================================= */
    .ok-top-nav {
      height: var(--ok-navbar-height);
      display: flex; align-items: center; justify-content: space-between;
      max-width: 1080px;
      margin: 0 auto 20px auto;
      gap: 14px;
      flex-wrap: wrap;
    }

    .ok-search-capsule {
      position: relative;
      width: 380px; max-width: 100%;
    }
    .ok-search-capsule input {
      width: 100%; height: 46px;
      border-radius: var(--ok-radius-pill);
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      padding: 0 75px 0 46px;
      font-size: 0.88rem;
      color: var(--ok-text-primary);
      outline: none;
      transition: all 0.25s ease;
    }
    .ok-search-capsule input::placeholder { color: var(--ok-text-muted); }
    .ok-search-capsule input:focus {
      border-color: var(--ok-purple-vibrant);
      box-shadow: 0 0 0 4px var(--ok-purple-soft);
    }
    .ok-search-capsule .search-icon {
      position: absolute; left: 16px; top: 50%;
      transform: translateY(-50%);
      color: var(--ok-text-muted);
    }
    .ok-search-capsule .shortcut-hint {
      position: absolute; right: 12px; top: 50%;
      transform: translateY(-50%);
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 6px;
      padding: 2px 7px;
      font-size: 0.7rem;
      color: var(--ok-text-muted);
      font-weight: 600;
    }

    .ok-nav-actions { display: flex; align-items: center; gap: 12px; }

    .ok-action-circle {
      width: 44px; height: 44px; border-radius: 14px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-primary);
      text-decoration: none;
      transition: all 0.2s ease;
      position: relative;
    }
    .ok-action-circle:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      transform: translateY(-2px);
    }
    .ok-notification-badge {
      position: absolute; top: -2px; right: -2px;
      min-width: 18px; height: 18px; padding: 0 5px;
      background-color: #ef4444; color: #fff;
      font-size: 0.65rem; font-weight: 700;
      border-radius: var(--ok-radius-pill);
      display: flex; align-items: center; justify-content: center;
      border: 2px solid var(--ok-bg-surface);
    }

    .ok-profile-pill {
      display: flex; align-items: center; gap: 10px;
      padding: 5px 16px 5px 5px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: var(--ok-radius-pill);
      text-decoration: none; cursor: pointer;
    }
    .ok-profile-avatar-nav {
      width: 36px; height: 36px;
      border-radius: 50%; object-fit: cover;
      background: var(--ok-purple-soft);
      border: 2px solid var(--ok-purple-border);
    }

    .ok-theme-toggle {
      width: 44px; height: 44px; border-radius: 14px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-primary); cursor: pointer;
      transition: all 0.2s ease;
    }
    .ok-theme-toggle:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      transform: translateY(-2px);
    }

    /* Hero */
    .ok-canvas-hero-title {
      max-width: 1080px;
      margin: 0 auto 22px auto;
      display: flex; justify-content: space-between; align-items: flex-end;
      flex-wrap: wrap; gap: 16px;
    }

    .ok-breadcrumb-btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 14px;
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      border-radius: var(--ok-radius-pill);
      color: var(--ok-text-muted);
      text-decoration: none;
      font-size: 0.78rem; font-weight: 700;
      margin-bottom: 10px;
      transition: all 0.2s ease;
    }
    .ok-breadcrumb-btn:hover {
      background: var(--ok-pill-bg-hover);
      color: var(--ok-purple-vibrant);
      border-color: var(--ok-purple-border);
      transform: translateX(-2px);
    }

    .ok-page-title-main {
      font-size: 1.85rem; font-weight: 800;
      letter-spacing: -0.03em; line-height: 1.15;
      color: var(--ok-text-primary);
      margin: 0;
      display: flex; align-items: center; gap: 12px;
      flex-wrap: wrap;
    }

    .ok-live-beacon {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 0.7rem; font-weight: 800;
      padding: 4px 11px;
      border-radius: var(--ok-radius-pill);
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #10b981;
      letter-spacing: 0.04em; text-transform: uppercase;
    }
    .ok-pulse-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background-color: #10b981;
      box-shadow: 0 0 8px #10b981;
    }

    .ok-canvas-sub {
      color: var(--ok-text-muted);
      font-size: 0.88rem; margin-top: 5px; line-height: 1.45;
    }

    .ok-live-balance-pill {
      background: var(--ok-bg-surface);
      border: 1px solid var(--ok-purple-border);
      border-radius: var(--ok-radius-pill);
      padding: 8px 22px;
      display: flex; align-items: center; gap: 10px;
      box-shadow: 0 4px 18px var(--ok-shadow-card), 0 0 25px rgba(124, 58, 237, 0.2);
    }
    .ok-live-balance-pill .label {
      font-size: 0.72rem; font-weight: 700;
      color: var(--ok-text-muted);
      text-transform: uppercase; letter-spacing: 0.04em;
    }
    .ok-live-balance-pill .val {
      font-size: 1.15rem; font-weight: 800;
      font-family: 'Space Grotesk', sans-serif;
      color: var(--ok-purple-vibrant);
    }

    /* =========================================================================
       SESSÃO 1: 4 CARDS CHAPADOS (RESUMO DO RECIBO)
       ========================================================================= */
    .ok-flat-quad-strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      max-width: 1080px;
      margin: 0 auto 28px auto;
      border-radius: 0px !important;
      overflow: hidden;
      box-shadow: 0 16px 36px var(--ok-shadow-card);
      border: 1px solid var(--ok-border-subtle);
    }

    .ok-flat-card-box {
      padding: 22px 18px 20px 18px;
      display: flex; flex-direction: column; justify-content: space-between;
      min-height: 165px;
      border-radius: 0px !important;
      position: relative;
      transition: transform 0.2s ease, filter 0.2s ease;
    }
    .ok-flat-card-box:hover {
      z-index: 2; filter: brightness(1.04);
      transform: translateY(-2px);
    }

    .ok-flat-card-box.theme-white { background-color: #ffffff; color: #0f172a; }
    .ok-flat-card-box.theme-lime { background-color: #bef264; color: #0f172a; }
    .ok-flat-card-box.theme-white-alt {
      background-color: #ffffff; color: #0f172a;
      border-left: 1px solid rgba(0,0,0,0.08);
    }
    .ok-flat-card-box.theme-purple { background-color: #7c3aed; color: #ffffff; }

    .ok-flat-icon-container { width: 36px; height: 36px; margin-bottom: 14px; }
    .ok-flat-icon-container svg { width: 100%; height: 100%; stroke-width: 1.9; }
    .theme-white .ok-flat-icon-container svg,
    .theme-lime .ok-flat-icon-container svg,
    .theme-white-alt .ok-flat-icon-container svg { stroke: #0f172a; }
    .theme-purple .ok-flat-icon-container svg { stroke: #ffffff; }

    .ok-flat-title {
      font-size: 1.02rem; font-weight: 800;
      letter-spacing: -0.02em; line-height: 1.2;
      margin-bottom: 5px;
    }
    .ok-flat-desc {
      font-size: 0.74rem; line-height: 1.4;
      opacity: 0.85; margin-bottom: 8px;
    }
    .ok-flat-metric-data {
      font-size: 1.15rem; font-weight: 800;
      font-family: 'Space Grotesk', sans-serif;
      letter-spacing: -0.02em;
    }

    /* =========================================================================
       SESSÃO 2: ASIDES ESTAMPADOS
       ========================================================================= */
    .ok-canvas-asides-grid {
      display: grid;
      grid-template-columns: 1fr 320px;
      gap: 28px;
      max-width: 1080px;
      margin: 0 auto;
      align-items: start;
    }

    .ok-form-canvas-side { width: 100%; }

    .ok-canvas-form-header {
      padding-bottom: 10px;
      margin-bottom: 16px;
      border-bottom: 1px solid var(--ok-border-subtle);
      display: flex; justify-content: space-between; align-items: center;
      flex-wrap: wrap; gap: 8px;
    }
    .ok-canvas-form-header h4 {
      font-size: 1.1rem; font-weight: 800; margin: 0;
      color: var(--ok-text-primary);
      display: flex; align-items: center; gap: 8px;
    }

    /* Receipt hero estampado */
    .ok-receipt-hero {
      background: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 20px;
      padding: 2.25rem 1.75rem 1.75rem;
      text-align: center;
      position: relative;
      overflow: hidden;
      box-shadow: 0 8px 32px var(--ok-shadow-card);
    }

    .ok-receipt-success-icon {
      width: 96px; height: 96px;
      border-radius: 50%;
      background: var(--ok-success-bg);
      color: var(--ok-success-fg);
      display: flex; align-items: center; justify-content: center;
      font-size: 3rem;
      margin: 0 auto 1.25rem;
      position: relative;
      animation: pop-in 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .ok-receipt-success-icon::before,
    .ok-receipt-success-icon::after {
      content: '';
      position: absolute;
      border-radius: 50%;
      background: rgba(22, 163, 74, 0.10);
    }
    .ok-receipt-success-icon::before {
      width: 120px; height: 120px;
      top: -12px; left: -12px; z-index: -1;
    }
    .ok-receipt-success-icon::after {
      width: 148px; height: 148px;
      top: -26px; left: -26px; z-index: -2;
      background: rgba(22, 163, 74, 0.05);
    }
    @keyframes pop-in {
      0% { transform: scale(0.5); opacity: 0; }
      80% { transform: scale(1.05); }
      100% { transform: scale(1); opacity: 1; }
    }

    .ok-receipt-title {
      font-size: 1.5rem; font-weight: 800;
      color: var(--ok-text-primary);
      margin-bottom: 6px;
      letter-spacing: -0.02em;
    }
    .ok-receipt-subtitle {
      font-size: 0.88rem;
      color: var(--ok-text-muted);
      margin-bottom: 1.5rem;
      line-height: 1.5;
    }

    /* Sumário montante + data */
    .ok-receipt-summary {
      background: var(--ok-accent-green-light);
      border-radius: 14px;
      padding: 1.1rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 14px;
      margin-bottom: 1.5rem;
      text-align: left;
    }
    .ok-summary-block {
      display: flex; align-items: center; gap: 12px;
    }
    .ok-summary-icon-circle {
      width: 42px; height: 42px;
      border-radius: 50%;
      background: var(--ok-bg-surface);
      color: var(--ok-bg-balance);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.15rem; flex-shrink: 0;
    }
    .ok-summary-label {
      font-size: 0.72rem;
      color: var(--ok-text-muted);
      margin: 0 0 2px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.04em;
    }
    .ok-summary-value {
      font-size: 1.1rem; font-weight: 800;
      font-family: 'Space Grotesk', sans-serif;
      color: var(--ok-text-primary);
      margin: 0;
    }

    /* Detalhes */
    .ok-details-section {
      text-align: left;
      border-top: 1px solid var(--ok-border-subtle);
      padding-top: 1.25rem;
    }
    .ok-details-title {
      font-size: 0.95rem; font-weight: 800;
      color: var(--ok-text-primary);
      margin-bottom: 0.75rem;
      display: flex; align-items: center; gap: 8px;
    }
    .ok-detail-row {
      display: flex; justify-content: space-between; align-items: center;
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--ok-border-subtle);
      gap: 12px;
    }
    .ok-detail-row:last-child { border-bottom: none; }
    .ok-detail-label {
      font-size: 0.8rem;
      color: var(--ok-text-muted);
      display: flex; align-items: center; gap: 8px;
      font-weight: 600;
    }
    .ok-detail-label .bi { font-size: 0.95rem; opacity: 0.85; }
    .ok-detail-value {
      font-size: 0.84rem; font-weight: 700;
      color: var(--ok-text-primary);
      text-align: right;
      word-break: break-word;
    }

    .ok-status-badge {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 0.25rem 0.7rem;
      border-radius: var(--ok-radius-pill);
      background: var(--ok-success-bg);
      color: var(--ok-success-deep);
      font-size: 0.72rem; font-weight: 800;
    }

    /* Ações */
    .ok-receipt-actions {
      display: flex; gap: 10px; justify-content: space-between;
      margin-top: 1.5rem; flex-wrap: wrap;
    }
    .ok-btn-confirm-pill {
      height: 46px;
      border-radius: var(--ok-radius-pill);
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      color: #ffffff; border: none;
      font-size: 0.88rem; font-weight: 800;
      cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center;
      gap: 6px;
      padding: 0 22px;
      box-shadow: 0 8px 24px rgba(124, 58, 237, 0.45);
      transition: all 0.2s ease;
      text-decoration: none;
    }
    .ok-btn-confirm-pill:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(124, 58, 237, 0.65);
      color: #ffffff;
    }

    .ok-btn-ghost-pill {
      height: 46px;
      border-radius: var(--ok-radius-pill);
      background: var(--ok-pill-bg);
      color: var(--ok-text-primary);
      border: 1px solid var(--ok-border-subtle);
      font-size: 0.85rem; font-weight: 700;
      cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center;
      gap: 6px;
      padding: 0 20px;
      transition: all 0.2s ease;
    }
    .ok-btn-ghost-pill:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      background: var(--ok-pill-bg-hover);
    }

    /* Aside direito */
    .ok-audit-canvas-side {
      display: flex; flex-direction: column; gap: 22px;
    }

    .ok-canvas-subhead {
      font-size: 0.96rem; font-weight: 800;
      color: var(--ok-text-primary);
      margin-bottom: 14px; padding-bottom: 8px;
      border-bottom: 1px solid var(--ok-border-subtle);
      display: flex; justify-content: space-between; align-items: center;
    }

    .ok-side-card {
      background: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 16px;
      padding: 1.1rem;
      box-shadow: 0 4px 18px var(--ok-shadow-card);
    }

    .ok-balance-mini {
      display: flex; align-items: center; gap: 12px;
      padding: 0.85rem;
      border-radius: 12px;
      background: var(--ok-pill-bg);
      margin-bottom: 10px;
    }
    .ok-balance-mini:last-child { margin-bottom: 0; }
    .ok-balance-mini-icon {
      width: 40px; height: 40px;
      border-radius: 50%;
      background: var(--ok-purple-soft);
      color: var(--ok-purple-vibrant);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem; flex-shrink: 0;
    }
    .ok-balance-mini-label {
      font-size: 0.72rem;
      color: var(--ok-text-muted);
      margin: 0 0 2px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.03em;
    }
    .ok-balance-mini-value {
      font-size: 1.05rem; font-weight: 800;
      font-family: 'Space Grotesk', sans-serif;
      color: var(--ok-text-primary);
      margin: 0;
    }

    .ok-progress-mini {
      height: 6px;
      background: var(--ok-meter-bg);
      border-radius: 3px;
      overflow: hidden;
      margin-top: 8px;
    }
    .ok-progress-mini-bar {
      height: 100%;
      background: linear-gradient(90deg, #bef264, #8b5cf6);
      border-radius: 3px;
      transition: width 0.3s ease;
    }
    .ok-progress-mini-text {
      display: flex; justify-content: space-between;
      font-size: 0.7rem;
      color: var(--ok-text-muted);
      margin-top: 4px;
    }

    /* Recent list */
    .ok-stream-flat-list { display: flex; flex-direction: column; gap: 2px; }
    .ok-stream-flat-row {
      display: flex; align-items: center; justify-content: space-between;
      gap: 10px;
      padding: 9px 6px;
      border-bottom: 1px solid var(--ok-border-subtle);
      transition: all 0.2s ease;
      border-radius: 10px;
    }
    .ok-stream-flat-row:hover {
      padding-left: 10px;
      background: var(--ok-stream-hover);
      border-bottom-color: transparent;
    }
    .ok-stream-tx-meta {
      display: flex; align-items: center; gap: 10px; min-width: 0;
    }
    .ok-stream-tx-icon {
      width: 32px; height: 32px; border-radius: 10px;
      background: rgba(16,185,129,0.15); color: #10b981;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; font-size: 0.9rem;
    }
    .ok-stream-tx-text { min-width: 0; }
    .ok-stream-tx-desc {
      font-size: 0.8rem; font-weight: 700;
      color: var(--ok-text-primary);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      margin: 0;
    }
    .ok-stream-tx-meta-line {
      font-size: 0.7rem; color: var(--ok-text-muted);
      margin: 0;
    }
    .ok-stream-tx-amount {
      font-size: 0.85rem; font-weight: 800;
      font-family: 'Space Grotesk', sans-serif;
      white-space: nowrap;
      color: #10b981;
    }

    /* Card de Segurança */
    .ok-security-card {
      background: var(--ok-bg-balance);
      border-radius: 16px;
      padding: 1.25rem;
      color: #fff;
      position: relative;
      overflow: hidden;
    }
    .ok-security-card::before {
      content: '';
      position: absolute;
      top: -40%; right: -25%;
      width: 200px; height: 200px;
      background: rgba(255,255,255,0.06);
      border-radius: 50%;
    }
    .ok-security-content { position: relative; z-index: 1; }
    .ok-security-title { font-size: 1rem; font-weight: 800; line-height: 1.25; margin-bottom: 6px; }
    .ok-security-text { font-size: 0.76rem; opacity: 0.85; line-height: 1.5; margin-bottom: 12px; }
    .ok-security-btn {
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--ok-accent-green);
      color: #14532d;
      border-radius: var(--ok-radius-pill);
      padding: 0.5rem 1rem;
      font-size: 0.78rem; font-weight: 700;
      text-decoration: none;
      transition: all 0.2s ease;
    }
    .ok-security-btn:hover { background: var(--ok-accent-green-hover); color: #14532d; }
    .ok-security-illustration {
      position: absolute; right: 10px; bottom: 10px;
      width: 90px; opacity: 0.9;
    }

    /* Responsividade */
    @media (max-width: 1200px) {
      .ok-flat-quad-strip { grid-template-columns: repeat(2, 1fr); }
      .ok-canvas-asides-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 991px) {
      .ok-rail-sidebar { transform: translateX(-120%); }
      .ok-viewport-shell { margin-left: 0; padding: 16px; }
      body.mobile-nav-active .ok-rail-sidebar { transform: translateX(0); }
      .ok-page-title-main { font-size: 1.55rem; }
    }
    @media (max-width: 600px) {
      .ok-flat-quad-strip { grid-template-columns: 1fr; }
      .ok-receipt-actions { flex-direction: column-reverse; }
      .ok-receipt-actions .ok-btn-confirm-pill,
      .ok-receipt-actions .ok-btn-ghost-pill { width: 100%; }
      .ok-receipt-summary { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
<body>

  <div class="ok-ambient-glow-core"></div>

  <!-- ======================================================================
       BARRA LATERAL SLIM TECH
       ====================================================================== -->
  <aside class="ok-rail-sidebar" id="app-rail-sidebar" aria-label="Navegação Principal">
    <a href="/dashboard" class="ok-brand-emblem" title="OneKixikila Core">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
        <polyline points="2 17 12 22 22 17"></polyline>
        <polyline points="2 12 12 17 22 12"></polyline>
      </svg>
    </a>

    <nav class="ok-rail-nav">
      <a href="/dashboard" class="ok-rail-link" title="Painel Geral">
        <i class="bi bi-house-door"></i>
      </a>
      <a href="/wallet" class="ok-rail-link" title="Carteira">
        <i class="bi bi-wallet2"></i>
      </a>
      <a href="/groups" class="ok-rail-link" title="Kixikila / Grupos">
        <i class="bi bi-people"></i>
      </a>
      <a href="/wallet/transfer" class="ok-rail-link" title="Transferências">
        <i class="bi bi-arrow-left-right"></i>
      </a>
      <a href="/wallet/deposit" class="ok-rail-link active" title="Depósitos">
        <i class="bi bi-credit-card"></i>
      </a>
      <a href="/wallet/statement" class="ok-rail-link" title="Extrato">
        <i class="bi bi-clock-history"></i>
      </a>
      <a href="/notifications" class="ok-rail-link" title="Notificações">
        <i class="bi bi-bell"></i>
      </a>
    </nav>

    <div class="ok-rail-footer">
      <a href="/profile" class="ok-rail-link" title="Perfil e Definições">
        <i class="bi bi-gear"></i>
      </a>
      <button type="button" class="ok-rail-link border-0 text-danger" data-action="logout" title="Terminar Sessão">
        <i class="bi bi-box-arrow-right"></i>
      </button>
    </div>
  </aside>

  <!-- ======================================================================
       CONTEÚDO PRINCIPAL
       ====================================================================== -->
  <div class="ok-viewport-shell">

    <!-- Navbar Superior — CENTRALIZADA NO CONTEÚDO (max-width 1080px) -->
    <header class="ok-top-nav">
      <div class="ok-search-capsule">
        <span class="search-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </span>
        <input type="search" id="global-search-input" placeholder="Pesquisar transações..." autocomplete="off">
        <kbd class="shortcut-hint">Ctrl K</kbd>
      </div>

      <div class="ok-nav-actions">
        <button type="button" id="sidebar-toggle-btn" class="ok-action-circle d-lg-none" aria-label="Abrir menu">
          <i class="bi bi-list"></i>
        </button>

        <button type="button" id="theme-toggle-btn" class="ok-theme-toggle" title="Alternar tema claro/escuro" aria-label="Alternar tema">
          <svg id="theme-toggle-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
        </button>

        <a href="/notifications" class="ok-action-circle" title="Notificações">
          <i class="bi bi-bell"></i>
          <span class="ok-notification-badge d-none" id="notification-badge">0</span>
        </a>

        <a href="/profile" class="ok-profile-pill">
          <img 
            id="ok-nav-avatar"
            src="<%= typeof user !== 'undefined' && user && (user.avatarUrl || user.avatar_url || user.avatar) ? (user.avatarUrl || user.avatar_url || user.avatar) : '/assets/images/avatar-default.png' %>" 
            data-fallback='data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 fill=%22%237c3aed%22/%3E%3Ccircle cx=%2232%22 cy=%2224%22 r=%2212%22 fill=%22%23ffffff%22/%3E%3Cpath d=%22M8 64c0-13.255 10.745-24 24-24s24 10.745 24 24%22 fill=%22%23ffffff%22/%3E%3C/svg%3E'
            alt="Avatar" 
            class="ok-profile-avatar-nav"
          >
          <div class="d-flex flex-column text-start">
            <span class="fw-bold" id="ok-nav-fullname" style="font-size: 0.85rem; line-height: 1.1;"><%= typeof user !== 'undefined' && user && (user.fullName || user.full_name) ? (user.fullName || user.full_name).split(' ')[0] : 'Membro' %></span>
            <span class="text-muted" id="ok-nav-role" style="font-size: 0.7rem;"><%= typeof user !== 'undefined' && user && user.role ? user.role : 'Utilizador' %></span>
          </div>
        </a>
      </div>
    </header>

    <!-- Hero -->
    <section class="ok-canvas-hero-title">
      <div>
        <a href="/wallet/deposit" class="ok-breadcrumb-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
          Voltar aos Depósitos
        </a>
        <h1 class="ok-page-title-main">
          Resultado do Depósito
          <span class="ok-live-beacon">
            <span class="ok-pulse-dot"></span>
            Concluído
          </span>
        </h1>
        <p class="ok-canvas-sub">
          O seu depósito foi processado com sucesso e o valor já está disponível na carteira OneKixikila.
        </p>
      </div>

      <div class="ok-live-balance-pill">
        <span class="label">Saldo disponível:</span>
        <span class="val" id="side-wallet-balance">AOA 0,00</span>
      </div>
    </section>

    <!-- =========================================================================
       SESSÃO 1: 4 CARDS RESUMO DO RECIBO
       ========================================================================= -->
    <div class="ok-flat-quad-strip">
      
      <!-- Card 1: Montante depositado -->
      <div class="ok-flat-card-box theme-white">
        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="18" stroke="currentColor" stroke-linecap="square"/>
              <path d="M24 14V34" stroke="currentColor"/>
              <path d="M18 24L24 30L30 24" stroke="currentColor" stroke-linecap="square"/>
            </svg>
          </div>
          <h5 class="ok-flat-title">Montante Depositado</h5>
          <p class="ok-flat-desc">Valor creditado na sua carteira.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" id="receipt-amount">AOA 0,00</span>
        </div>
      </div>

      <!-- Card 2: Valor a receber -->
      <div class="ok-flat-card-box theme-lime">
        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="6" y="14" width="36" height="26" rx="2" stroke="currentColor" stroke-linecap="square"/>
              <path d="M6 20H42" stroke="currentColor"/>
              <circle cx="34" cy="30" r="3" stroke="currentColor"/>
            </svg>
          </div>
          <h5 class="ok-flat-title">Valor a Receber</h5>
          <p class="ok-flat-desc">Líquido após dedução de taxas.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" id="detail-net">AOA 0,00</span>
        </div>
      </div>

      <!-- Card 3: Taxa -->
      <div class="ok-flat-card-box theme-white-alt">
        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="18" cy="18" r="6" stroke="currentColor"/>
              <circle cx="30" cy="30" r="6" stroke="currentColor"/>
              <line x1="12" y1="36" x2="36" y2="12" stroke="currentColor" stroke-linecap="square"/>
            </svg>
          </div>
          <h5 class="ok-flat-title">Taxa</h5>
          <p class="ok-flat-desc">Comissão aplicada ao depósito.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" style="color: #7c3aed;" id="detail-fee">0,00 AOA</span>
        </div>
      </div>

      <!-- Card 4: Data -->
      <div class="ok-flat-card-box theme-purple">
        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="8" y="10" width="32" height="30" stroke="currentColor" stroke-linecap="square"/>
              <line x1="8" y1="18" x2="40" y2="18" stroke="currentColor"/>
              <line x1="16" y1="6" x2="16" y2="14" stroke="currentColor"/>
              <line x1="32" y1="6" x2="32" y2="14" stroke="currentColor"/>
            </svg>
          </div>
          <h5 class="ok-flat-title">Data e Hora</h5>
          <p class="ok-flat-desc">Momento exato da operação.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" style="font-size: 0.9rem;" id="receipt-date">—</span>
        </div>
      </div>

    </div>

    <!-- =========================================================================
       SESSÃO 2: ASIDES
       ========================================================================= -->
    <div class="ok-canvas-asides-grid">

      <!-- ASIDE ESQUERDO: RECIBO + DETALHES -->
      <div class="ok-form-canvas-side">

        <div class="ok-canvas-form-header">
          <h4>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ok-purple-vibrant)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Comprovativo da Operação
          </h4>
          <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; font-weight: 800; font-size: 0.7rem;">
            Concluído
          </span>
        </div>

        <div class="ok-receipt-hero">
          <div class="ok-receipt-success-icon" id="receipt-success-icon">
            <i class="bi bi-check-lg"></i>
          </div>

          <h2 class="ok-receipt-title" id="receipt-title">Depósito realizado com sucesso!</h2>
          <p class="ok-receipt-subtitle" id="receipt-subtitle">
            O valor foi adicionado à sua carteira OneKixikila.<br>
            Obrigado por confiar na nossa plataforma!
          </p>

          <div class="ok-receipt-summary">
            <div class="ok-summary-block">
              <div class="ok-summary-icon-circle"><i class="bi bi-arrow-down-circle-fill"></i></div>
              <div>
                <p class="ok-summary-label">Montante depositado</p>
                <p class="ok-summary-value" id="receipt-amount-inline">AOA 0,00</p>
              </div>
            </div>
            <div class="ok-summary-block">
              <div class="ok-summary-icon-circle" style="background-color: var(--ok-pill-bg); color: var(--ok-purple-vibrant);"><i class="bi bi-clock"></i></div>
              <div>
                <p class="ok-summary-label">Data e hora</p>
                <p class="ok-summary-value" id="receipt-date-inline" style="font-size: 0.85rem;">—</p>
              </div>
            </div>
          </div>

          <div class="ok-details-section">
            <h5 class="ok-details-title"><i class="bi bi-list-ul" style="color: var(--ok-purple-vibrant);"></i> Detalhes da operação</h5>

            <div class="ok-detail-row">
              <span class="ok-detail-label"><i class="bi bi-bank2"></i> Método de depósito</span>
              <span class="ok-detail-value" id="detail-method">—</span>
            </div>
            <div class="ok-detail-row">
              <span class="ok-detail-label"><i class="bi bi-building"></i> Banco de origem</span>
              <span class="ok-detail-value" id="detail-bank">—</span>
            </div>
            <div class="ok-detail-row">
              <span class="ok-detail-label"><i class="bi bi-person"></i> Titular da conta</span>
              <span class="ok-detail-value" id="detail-holder">—</span>
            </div>
            <div class="ok-detail-row">
              <span class="ok-detail-label"><i class="bi bi-credit-card"></i> Número da conta</span>
              <span class="ok-detail-value" id="detail-account">—</span>
            </div>
            <div class="ok-detail-row">
              <span class="ok-detail-label"><i class="bi bi-cash-stack"></i> Montante depositado</span>
              <span class="ok-detail-value" id="detail-amount">AOA 0,00</span>
            </div>
            <div class="ok-detail-row">
              <span class="ok-detail-label"><i class="bi bi-percent"></i> Taxa</span>
              <span class="ok-detail-value" id="detail-fee-row">0,00 AOA</span>
            </div>
            <div class="ok-detail-row">
              <span class="ok-detail-label"><i class="bi bi-wallet2"></i> Valor a receber</span>
              <span class="ok-detail-value" id="detail-net-row" style="color: #10b981;">AOA 0,00</span>
            </div>
            <div class="ok-detail-row">
              <span class="ok-detail-label"><i class="bi bi-file-earmark"></i> Comprovativo</span>
              <span class="ok-detail-value" id="detail-proof">—</span>
            </div>
            <div class="ok-detail-row">
              <span class="ok-detail-label"><i class="bi bi-check-circle"></i> Status</span>
              <span class="ok-detail-value">
                <span class="ok-status-badge"><i class="bi bi-check-circle-fill"></i> Concluído</span>
              </span>
            </div>
            <div class="ok-detail-row">
              <span class="ok-detail-label"><i class="bi bi-calendar3"></i> Data e hora</span>
              <span class="ok-detail-value" id="detail-date">—</span>
            </div>
          </div>

          <div class="ok-receipt-actions">
            <button type="button" class="ok-btn-ghost-pill" id="btn-view-proof">
              <i class="bi bi-eye"></i> Ver comprovativo
            </button>
            <button type="button" class="ok-btn-ghost-pill" id="btn-share">
              <i class="bi bi-share"></i> Partilhar
            </button>
            <a href="/wallet" class="ok-btn-confirm-pill">
              Voltar à Carteira <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- ASIDE DIREITO: RESUMO + RECENTES + SEGURANÇA -->
      <div class="ok-audit-canvas-side">

        <div class="ok-side-card">
          <div class="ok-canvas-subhead" style="margin-bottom: 12px;">
            <span>Resumo da Carteira</span>
            <a href="/wallet" class="small text-decoration-none" style="color: var(--ok-purple-vibrant); font-weight: 700;">Ver &rarr;</a>
          </div>

          <div class="ok-balance-mini">
            <div class="ok-balance-mini-icon"><i class="bi bi-wallet2"></i></div>
            <div>
              <p class="ok-balance-mini-label">Saldo disponível</p>
              <p class="ok-balance-mini-value" id="side-wallet-balance-detail">AOA 0,00</p>
            </div>
          </div>

          <div class="ok-balance-mini" style="background: var(--ok-pill-bg);">
            <div class="ok-balance-mini-icon" style="background: rgba(37,99,235,0.15); color: #3b82f6;"><i class="bi bi-graph-up-arrow"></i></div>
            <div class="flex-grow-1">
              <p class="ok-balance-mini-label">Limite diário</p>
              <p class="ok-balance-mini-value" id="side-daily-limit" style="font-size: 0.92rem;">AOA 500.000,00</p>
              <div class="ok-progress-mini">
                <div class="ok-progress-mini-bar" id="side-daily-limit-bar" style="width: 0%;"></div>
              </div>
              <div class="ok-progress-mini-text">
                <span id="side-daily-used">AOA 0,00 usado</span>
                <span id="side-daily-percent">0%</span>
              </div>
            </div>
          </div>
        </div>

        <div class="ok-side-card">
          <div class="ok-canvas-subhead" style="margin-bottom: 12px;">
            <span>Depósitos Recentes</span>
            <a href="/wallet/statement" class="small text-decoration-none" style="color: var(--ok-purple-vibrant); font-weight: 700;">Ver todos &rarr;</a>
          </div>

          <div class="ok-stream-flat-list" id="recent-deposits-list">
            <div class="text-center py-3 text-muted small">
              <div class="spinner-border spinner-border-sm mb-2" role="status" style="color: var(--ok-purple-vibrant);"></div>
              <p class="mb-0">A carregar...</p>
            </div>
          </div>
        </div>

        <div class="ok-security-card">
          <div class="ok-security-content">
            <h5 class="ok-security-title">A sua segurança é a nossa prioridade</h5>
            <p class="ok-security-text">Todos os seus dados são protegidos com tecnologia de ponta e encriptação.</p>
            <a href="/sessions" class="ok-security-btn">Saiba mais <i class="bi bi-arrow-right"></i></a>
          </div>
          <svg class="ok-security-illustration" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="50" cy="50" r="45" fill="#a3e635" opacity="0.3" />
            <path d="M50 20L75 35V55C75 68 50 82 50 82C50 82 25 68 25 55V35L50 20Z" fill="#a3e635" opacity="0.8"/>
            <rect x="42" y="45" width="16" height="18" rx="3" fill="#0d3b38" />
            <path d="M45 45V40C45 36 48 33 50 33C52 33 55 36 55 40V45" stroke="#0d3b38" stroke-width="2.5" fill="none" />
          </svg>
        </div>

      </div>

    </div>

  </div>

  <!-- SweetAlert2 + Scripts -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js"></script>
  <script src="/js/sweet-alert.js"></script>
  <script src="/js/api-client.js"></script>
  <script src="/js/app.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

  <script>
    (function () {
      'use strict';

      /* ====================================================================
         TEMA CLARO/ESCURO
         ==================================================================== */
      const THEME_KEY = 'ok-theme';

      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-btn');
        if (!btn) return;
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      /* ====================================================================
         HELPERS DE AVATAR (real do backend + fallback robusto)
         ==================================================================== */
      const DEFAULT_AVATAR = '/assets/images/avatar-default.png';
      const FALLBACK_DATA_URI = 'data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 fill=%22%237c3aed%22/%3E%3Ccircle cx=%2232%22 cy=%2224%22 r=%2212%22 fill=%22%23ffffff%22/%3E%3Cpath d=%22M8 64c0-13.255 10.745-24 24-24s24 10.745 24 24%22 fill=%22%23ffffff%22/%3E%3C/svg%3E';

      function pick(obj, camel, snake, fallback) {
        if (!obj) return fallback;
        if (obj[camel] !== undefined && obj[camel] !== null) return obj[camel];
        if (obj[snake] !== undefined && obj[snake] !== null) return obj[snake];
        return fallback;
      }

      function isAbsoluteUrl(str) {
        return /^https?:\/\//i.test(str);
      }

      function resolveAvatarUrlForRender(rawUrl) {
        if (!rawUrl) return null;
        const trimmed = String(rawUrl).trim();
        if (!trimmed) return null;
        if (isAbsoluteUrl(trimmed) || trimmed.startsWith('/uploads/') || trimmed.startsWith('/assets/')) {
          if (trimmed === DEFAULT_AVATAR) return null;
          return trimmed;
        }
        return `/uploads/${trimmed.replace(/^\/+/, '')}`;
      }

      function applyAvatarToImg(imgEl, url) {
        if (!imgEl) return;
        const nextSrc = url || DEFAULT_AVATAR;

        if (imgEl.__okFallbackHandler) {
          imgEl.removeEventListener('error', imgEl.__okFallbackHandler);
          imgEl.__okFallbackHandler = null;
        }

        const onErr = function () {
          const fb = imgEl.getAttribute('data-fallback') || FALLBACK_DATA_URI;
          if (fb && imgEl.src !== fb) {
            imgEl.src = fb;
          }
        };
        imgEl.__okFallbackHandler = onErr;
        imgEl.addEventListener('error', onErr);

        if (imgEl.getAttribute('src') !== nextSrc) {
          imgEl.setAttribute('src', nextSrc);
        }
      }

      async function hydrateUserIdentity() {
        try {
          const res = await window.apiClient.get('/users/profile');
          const raw =
            (res && res.data && res.data.user) ||
            (res && res.data && res.data.data) ||
            (res && res.data) ||
            res;
          if (!raw) return;

          const fullName = pick(raw, 'fullName', 'full_name', '');
          const role = pick(raw, 'role', 'role', 'Utilizador');
          const avatarUrl = pick(raw, 'avatarUrl', 'avatar_url', null);
          const normalizedAvatar = resolveAvatarUrlForRender(avatarUrl);

          const navAvatar = document.getElementById('ok-nav-avatar');
          const navName = document.getElementById('ok-nav-fullname');
          const navRole = document.getElementById('ok-nav-role');

          applyAvatarToImg(navAvatar, normalizedAvatar);

          if (navName && fullName) {
            navName.textContent = fullName.split(' ')[0];
          }
          if (navRole) navRole.textContent = role || 'Utilizador';
        } catch (err) {
          console.warn('[RECEIPT:USER:HYDRATE] Falha ao hidratar identidade:', err && err.message);
        }
      }

      /* ====================================================================
         ESTADO
         ==================================================================== */
      let currentWallet = null;
      let currentReceipt = null;

      /* ====================================================================
         HELPERS
         ==================================================================== */
      function formatMoney(value) {
        if (value === null || value === undefined) return 'AOA 0,00';
        const num = Number(value);
        if (isNaN(num)) return 'AOA 0,00';
        return 'AOA ' + num.toLocaleString('pt-AO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }
      function formatDate(dateInput) {
        if (!dateInput) return '—';
        const d = new Date(dateInput);
        if (isNaN(d.getTime())) return '—';
        return d.toLocaleDateString('pt-AO', {
          day: '2-digit', month: 'short', year: 'numeric',
          hour: '2-digit', minute: '2-digit'
        });
      }
      function escapeHtml(str) {
        if (!str) return '';
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }
      function mapOperationType(type) {
        const map = {
          DEPOSIT: 'Transferência bancária',
          WITHDRAWAL: 'Levantamento',
          INTERNAL_TRANSFER: 'Transferência interna',
          CONTRIBUTION_PAYMENT: 'Contribuição Kixikila',
          ROTATION_PAYOUT: 'Recebimento Kixikila'
        };
        return map[type] || type || '—';
      }
      function mapBankName(type) {
        const map = {
          DEPOSIT: 'Banco BAI',
          WITHDRAWAL: 'Banco BFA',
          INTERNAL_TRANSFER: 'OneKixikila',
          CONTRIBUTION_PAYMENT: 'OneKixikila',
          ROTATION_PAYOUT: 'OneKixikila'
        };
        return map[type] || '—';
      }

      /* ====================================================================
         CARREGAR CARTEIRA
         ==================================================================== */
      async function loadWallet() {
        try {
          const res = await window.apiClient.get('/wallet/me');
          const wallet = res.data && res.data.wallet ? res.data.wallet : null;
          if (!wallet) return;
          currentWallet = wallet;

          const bal = formatMoney(wallet.availableBalance);
          document.getElementById('side-wallet-balance').textContent = bal;
          const balDetail = document.getElementById('side-wallet-balance-detail');
          if (balDetail) balDetail.textContent = bal;

          const limit = 500000;
          const used = 345000;
          const percent = Math.min(100, Math.round((used / limit) * 100));
          document.getElementById('side-daily-limit').textContent = formatMoney(limit);
          document.getElementById('side-daily-used').textContent = formatMoney(used) + ' usado';
          document.getElementById('side-daily-percent').textContent = percent + '%';
          const bar = document.getElementById('side-daily-limit-bar');
          if (bar) bar.style.width = percent + '%';
        } catch (error) {
          console.warn('Falha ao carregar carteira:', error.message);
        }
      }

      /* ====================================================================
         CARREGAR RECIBO POR ID DE TRANSAÇÃO
         ==================================================================== */
      async function loadReceipt(transactionId) {
        if (!transactionId) {
          document.getElementById('receipt-title').textContent = 'Nenhum recibo selecionado';
          document.getElementById('receipt-subtitle').textContent = 'Volte à carteira e selecione uma transação para ver o comprovativo.';
          return;
        }

        try {
          const res = await window.apiClient.get(`/wallet/receipts/${transactionId}`);
          const receipt = res.data && res.data.receipt ? res.data.receipt : null;
          if (!receipt) throw new Error('Recibo não encontrado.');

          currentReceipt = receipt;

          const amountStr = formatMoney(receipt.amount);
          const dateStr = formatDate(receipt.postedAt);

          document.getElementById('receipt-amount').textContent = amountStr;
          document.getElementById('receipt-amount-inline').textContent = amountStr;
          document.getElementById('receipt-date').textContent = dateStr;
          document.getElementById('receipt-date-inline').textContent = dateStr;

          document.getElementById('detail-method').textContent = mapOperationType(receipt.operationType);
          document.getElementById('detail-bank').textContent = mapBankName(receipt.operationType);
          document.getElementById('detail-holder').textContent = receipt.counterparty?.fullName || '—';
          document.getElementById('detail-account').textContent = receipt.metadata?.accountNumber || '—';
          document.getElementById('detail-amount').textContent = amountStr;

          const fee = Number(receipt.metadata?.fee || 0);
          const feeStr = formatMoney(fee);
          const netStr = formatMoney(Number(receipt.amount) - fee);

          document.getElementById('detail-fee').textContent = feeStr;
          document.getElementById('detail-fee-row').textContent = feeStr;
          document.getElementById('detail-net').textContent = netStr;
          document.getElementById('detail-net-row').textContent = netStr;

          document.getElementById('detail-proof').textContent =
            receipt.metadata?.fileName || `Comprovativo_${receipt.referenceCode}.pdf`;
          document.getElementById('detail-date').textContent = dateStr;
        } catch (error) {
          if (window.Alerts) {
            window.Alerts.error('Falha ao carregar recibo', error.message || 'Tente novamente.');
          }
          document.getElementById('receipt-title').textContent = 'Recibo não encontrado';
          document.getElementById('receipt-subtitle').textContent = 'Não foi possível carregar o recibo solicitado.';
        }
      }

      /* ====================================================================
         AÇÕES: VER COMPROVATIVO + PARTILHAR
         ==================================================================== */
      function bindActions() {
        const viewBtn = document.getElementById('btn-view-proof');
        if (viewBtn) {
          viewBtn.addEventListener('click', function () {
            if (!currentReceipt) return;
            if (window.Swal) {
              window.Swal.fire({
                title: 'Comprovativo',
                html: `
                  <div style="text-align: left; font-size: 0.9rem;">
                    <div style="display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid rgba(148,163,184,0.2);"><span style="color: #94a3b8;">Referência</span><strong>${escapeHtml(currentReceipt.referenceCode)}</strong></div>
                    <div style="display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid rgba(148,163,184,0.2);"><span style="color: #94a3b8;">Tipo</span><strong>${mapOperationType(currentReceipt.operationType)}</strong></div>
                    <div style="display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid rgba(148,163,184,0.2);"><span style="color: #94a3b8;">Montante</span><strong>${formatMoney(currentReceipt.amount)}</strong></div>
                    <div style="display: flex; justify-content: space-between; padding: 6px 0;"><span style="color: #94a3b8;">Data</span><strong>${formatDate(currentReceipt.postedAt)}</strong></div>
                  </div>
                `,
                confirmButtonText: 'Fechar',
                confirmButtonColor: '#7c3aed'
              });
            } else {
              window.print();
            }
          });
        }

        const shareBtn = document.getElementById('btn-share');
        if (shareBtn) {
          shareBtn.addEventListener('click', async function () {
            const txId = new URLSearchParams(window.location.search).get('tx');
            const shareUrl = window.location.origin + '/wallet/receipts?tx=' + (txId || '');
            if (navigator.clipboard && navigator.clipboard.writeText) {
              try {
                await navigator.clipboard.writeText(shareUrl);
                if (window.Alerts) window.Alerts.toast('Link do recibo copiado!', 'success');
              } catch (err) {
                if (window.Alerts) window.Alerts.error('Não foi possível copiar o link.');
              }
            } else {
              if (window.Alerts) window.Alerts.info('Link do recibo', shareUrl);
            }
          });
        }
      }

      /* ====================================================================
         DEPÓSITOS RECENTES (ASIDE)
         ==================================================================== */
      async function loadRecentDeposits() {
        const listEl = document.getElementById('recent-deposits-list');
        if (!listEl) return;

        try {
          if (!currentWallet) {
            const wRes = await window.apiClient.get('/wallet/me');
            currentWallet = wRes.data && wRes.data.wallet ? wRes.data.wallet : null;
          }
          if (!currentWallet) {
            listEl.innerHTML = '<p class="text-muted small mb-0">Sem dados disponíveis.</p>';
            return;
          }

          const res = await window.apiClient.get(`/wallet/${currentWallet.id}/statement?limit=4&operationType=DEPOSIT`);
          const items = res.data || [];

          if (items.length === 0) {
            listEl.innerHTML = `
              <div class="text-center py-3" style="color: var(--ok-text-muted);">
                <i class="bi bi-inbox fs-3 d-block mb-2" style="opacity:0.5;"></i>
                <p class="small mb-0">Nenhum depósito recente.</p>
              </div>
            `;
            return;
          }

          listEl.innerHTML = '';
          items.forEach(function (tx) {
            const formatted = formatMoney(tx.amount);
            const d = new Date(tx.postedAt);
            const date = d.toLocaleDateString('pt-AO', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });

            const div = document.createElement('div');
            div.className = 'ok-stream-flat-row';
            div.innerHTML = `
              <div class="ok-stream-tx-meta">
                <div class="ok-stream-tx-icon"><i class="bi bi-arrow-down-left"></i></div>
                <div class="ok-stream-tx-text">
                  <p class="ok-stream-tx-desc">${escapeHtml(tx.description || 'Depósito')}</p>
                  <p class="ok-stream-tx-meta-line">${date}</p>
                </div>
              </div>
              <span class="ok-stream-tx-amount">+ ${formatted}</span>
            `;
            listEl.appendChild(div);
          });
        } catch (error) {
          listEl.innerHTML = '<p class="text-muted small mb-0">Não foi possível carregar.</p>';
        }
      }

      /* ====================================================================
         AÇÕES GLOBAIS
         ==================================================================== */
      function setupGlobalActions() {
        const toggleBtn = document.getElementById('sidebar-toggle-btn');
        if (toggleBtn) {
          toggleBtn.addEventListener('click', () => {
            document.body.classList.toggle('mobile-nav-active');
          });
        }

        document.querySelectorAll('[data-action="logout"]').forEach(function (btn) {
          btn.addEventListener('click', async function (e) {
            e.preventDefault();
            try {
              await window.apiClient.post('/auth/logout', {});
              if (window.apiClient && typeof window.apiClient.clearSession === 'function') {
                window.apiClient.clearSession();
              }
            } catch (err) {}
            window.location.href = '/login';
          });
        });

        document.addEventListener('keydown', function (e) {
          if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
            const input = document.getElementById('global-search-input');
            if (input) { e.preventDefault(); input.focus(); }
          }
        });
      }

      /* ====================================================================
         INICIALIZAÇÃO
         ==================================================================== */
      document.addEventListener('DOMContentLoaded', async function () {
        initThemeToggle();
        hydrateUserIdentity();
        setupGlobalActions();
        bindActions();

        await loadWallet();
        await loadRecentDeposits();

        const params = new URLSearchParams(window.location.search);
        const txId = params.get('tx');
        if (txId) {
          await loadReceipt(txId);
        } else {
          ['receipt-amount', 'receipt-amount-inline'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.textContent = '—';
          });
          ['receipt-date', 'receipt-date-inline'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.textContent = '—';
          });
        }
      });
    })();
  </script>
