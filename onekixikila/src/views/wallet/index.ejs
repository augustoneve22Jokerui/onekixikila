  <script>
    (function () {
      'use strict';

      /* ====================================================================
         TEMA CLARO/ESCURO
         ==================================================================== */
      const THEME_KEY = 'ok-theme';
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-btn');
        if (!btn) return;
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      /* ====================================================================
         HELPERS DE AVATAR (real do backend + fallback robusto)
         ==================================================================== */
      const DEFAULT_AVATAR = '/assets/images/avatar-default.png';
      const FALLBACK_DATA_URI = 'data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 fill=%22%237c3aed%22/%3E%3Ccircle cx=%2232%22 cy=%2224%22 r=%2212%22 fill=%22%23ffffff%22/%3E%3Cpath d=%22M8 64c0-13.255 10.745-24 24-24s24 10.745 24 24%22 fill=%22%23ffffff%22/%3E%3C/svg%3E';

      function pick(obj, camel, snake, fallback) {
        if (!obj) return fallback;
        if (obj[camel] !== undefined && obj[camel] !== null) return obj[camel];
        if (obj[snake] !== undefined && obj[snake] !== null) return obj[snake];
        return fallback;
      }

      function isAbsoluteUrl(str) {
        return /^https?:\/\//i.test(str);
      }

      function resolveAvatarUrlForRender(rawUrl) {
        if (!rawUrl) return null;
        const trimmed = String(rawUrl).trim();
        if (!trimmed) return null;
        if (isAbsoluteUrl(trimmed) || trimmed.startsWith('/uploads/') || trimmed.startsWith('/assets/')) {
          if (trimmed === DEFAULT_AVATAR) return null;
          return trimmed;
        }
        return `/uploads/${trimmed.replace(/^\/+/, '')}`;
      }

      function applyAvatarToImg(imgEl, url) {
        if (!imgEl) return;
        const nextSrc = url || DEFAULT_AVATAR;

        if (imgEl.__okFallbackHandler) {
          imgEl.removeEventListener('error', imgEl.__okFallbackHandler);
          imgEl.__okFallbackHandler = null;
        }

        const onErr = function () {
          const fb = imgEl.getAttribute('data-fallback') || FALLBACK_DATA_URI;
          if (fb && imgEl.src !== fb) {
            imgEl.src = fb;
          }
        };
        imgEl.__okFallbackHandler = onErr;
        imgEl.addEventListener('error', onErr);

        if (imgEl.getAttribute('src') !== nextSrc) {
          imgEl.setAttribute('src', nextSrc);
        }
      }

      async function hydrateUserIdentity() {
        try {
          const res = await window.apiClient.get('/users/profile');
          const raw =
            (res && res.data && res.data.user) ||
            (res && res.data && res.data.data) ||
            (res && res.data) ||
            res;
          if (!raw) return;

          const fullName = pick(raw, 'fullName', 'full_name', '');
          const role = pick(raw, 'role', 'role', 'Utilizador');
          const avatarUrl = pick(raw, 'avatarUrl', 'avatar_url', null);
          const normalizedAvatar = resolveAvatarUrlForRender(avatarUrl);

          const navAvatar = document.getElementById('ok-nav-avatar');
          const navName = document.getElementById('ok-nav-fullname');
          const navRole = document.getElementById('ok-nav-role');
          const heroName = document.getElementById('ok-hero-username');

          applyAvatarToImg(navAvatar, normalizedAvatar);

          if (navName && fullName) {
            navName.textContent = fullName.split(' ')[0];
          }
          if (navRole) navRole.textContent = role || 'Utilizador';
          if (heroName && fullName) heroName.textContent = fullName;
        } catch (err) {
          console.warn('[WALLET:USER:HYDRATE] Falha ao hidratar identidade:', err && err.message);
        }
      }

      /* ====================================================================
         ESTADO
         ==================================================================== */
      let currentWalletId = null;
      let activeQrTokenCode = null;

      const formatAOA = (amount) => {
        const val = Number(amount) || 0;
        return val.toLocaleString('pt-AO') + ' Kz';
      };
      const formatDateTime = (isoDate) => {
        if (!isoDate) return '—';
        const d = new Date(isoDate);
        return d.toLocaleDateString('pt-AO', { day: '2-digit', month: 'short', year: 'numeric' });
      };

      /* ====================================================================
         1. WALLET CORE
         ==================================================================== */
      async function loadWalletCore() {
        try {
          const res = await window.apiClient.get('/wallet/me');
          const wallet = res.data && res.data.wallet ? res.data.wallet : null;
          if (!wallet) return;
          currentWalletId = wallet.id;

          const available = Number(wallet.availableBalance || 0);
          const locked = Number(wallet.lockedBalance || 0);
          const ledger = Number(wallet.ledgerBalance || 0);

          document.getElementById('card-available-sum').textContent = formatAOA(available);
          document.getElementById('card-locked-sum').textContent = formatAOA(locked);
          document.getElementById('card-ledger-sum').textContent = formatAOA(ledger);
          document.getElementById('stat-donut-total-val').textContent = formatAOA(ledger);

          if (wallet.id) {
            const hexDigits = wallet.id.replace(/-/g, '').slice(-4).toUpperCase();
            document.getElementById('card-primary-digits').textContent = `•••• ${hexDigits}`;
          }

          if (ledger > 0) {
            const availRatio = Math.round((available / ledger) * 240);
            const lockedRatio = Math.round((locked / ledger) * 240);
            document.getElementById('donut-slice-available').setAttribute('stroke-dasharray', `${availRatio} 240`);
            document.getElementById('donut-slice-locked').setAttribute('stroke-dasharray', `${lockedRatio} 240`);
          }

          await loadRecentTransactionsStream(wallet.id);
          await loadRealBackendQrCode();
        } catch (err) {
          console.error('[WALLET:LOAD:ERROR]', err);
        }
      }

      /* ====================================================================
         2. QR CODE
         ==================================================================== */
      async function loadRealBackendQrCode() {
        const qrImage = document.getElementById('real-qr-image-tag');
        const tokenLabel = document.getElementById('qr-token-code-text');
        const scanCounter = document.getElementById('qr-scan-counter');

        try {
          const myQrsRes = await window.apiClient.get('/payments/qr/my?status=ACTIVE&limit=1');
          let qrData = myQrsRes.data && myQrsRes.data.length > 0 ? myQrsRes.data[0] : null;

          if (!qrData) {
            const genRes = await window.apiClient.post('/payments/qr/generate', {
              fixedAmount: null,
              description: 'Convite e Recebimento Oficial OneKixikila',
              maxScans: 10,
              expiresInMinutes: 1440
            });
            qrData = genRes.data || {};
          }

          if (qrData) {
            activeQrTokenCode = qrData.tokenCode || qrData.token_code;
            tokenLabel.textContent = activeQrTokenCode;

            if (qrData.qrCodeDataUrl) {
              qrImage.src = qrData.qrCodeDataUrl;
            } else if (activeQrTokenCode) {
              const scanRes = await window.apiClient.post('/payments/qr/scan', { tokenCode: activeQrTokenCode });
              if (scanRes.data && scanRes.data.qrCodeDataUrl) {
                qrImage.src = scanRes.data.qrCodeDataUrl;
              }
            }

            const currentScans = qrData.scanCount !== undefined ? qrData.scanCount : qrData.scan_count || 0;
            const maxScans = qrData.maxScans !== undefined ? qrData.maxScans : qrData.max_scans || 10;
            scanCounter.textContent = `• ${currentScans}/${maxScans} utilizações`;
          }
        } catch (qrErr) {
          console.warn('[WALLET:QR_LOAD:WARN]', qrErr);
          tokenLabel.textContent = 'QRP-DISPONIVEL';
        }
      }

      async function regenerateNewQrToken() {
        const tokenLabel = document.getElementById('qr-token-code-text');
        const btn = document.getElementById('btn-regenerate-qr');
        btn.disabled = true;
        tokenLabel.textContent = 'A gerar...';

        try {
          const genRes = await window.apiClient.post('/payments/qr/generate', {
            fixedAmount: null,
            description: 'Novo Token de Pagamento e Convite',
            maxScans: 10,
            expiresInMinutes: 1440
          });

          const qrData = genRes.data || {};
          activeQrTokenCode = qrData.tokenCode || qrData.token_code;
          tokenLabel.textContent = activeQrTokenCode;

          if (qrData.qrCodeDataUrl) {
            document.getElementById('real-qr-image-tag').src = qrData.qrCodeDataUrl;
          }

          if (window.Alerts) window.Alerts.toast('Novo Código QR gerado no banco de dados!', 'success');
        } catch (err) {
          if (window.Alerts) window.Alerts.error('Erro ao Gerar QR', err.message);
          tokenLabel.textContent = activeQrTokenCode || 'Erro';
        } finally {
          btn.disabled = false;
        }
      }

      /* ====================================================================
         3. TRANSAÇÕES
         ==================================================================== */
      async function loadRecentTransactionsStream(walletId) {
        const streamContainer = document.getElementById('stamped-recent-transactions-stream');
        if (!walletId || !streamContainer) return;

        try {
          const res = await window.apiClient.get(`/wallet/${walletId}/statement?limit=6`);
          const items = res.data || [];

          if (items.length === 0) {
            streamContainer.innerHTML = `
              <div class="ok-empty-state">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                  <line x1="3" y1="9" x2="21" y2="9"></line>
                </svg>
                <h6>Nenhuma movimentação registada</h6>
                <p class="small text-muted mb-0">Efetue o seu primeiro depósito ou participe numa Kixikila.</p>
              </div>
            `;
            return;
          }

          let html = '';
          let sumQuotas = 0;
          let sumDeposits = 0;
          let sumTransfers = 0;
          let sumPayouts = 0;

          items.forEach((tx) => {
            const isDebit = tx.direction === 'DEBIT';
            const amountNum = Number(tx.amount || 0);

            const op = tx.operationType || '';
            if (op === 'CONTRIBUTION_PAYMENT') sumQuotas += amountNum;
            else if (op === 'DEPOSIT') sumDeposits += amountNum;
            else if (op === 'INTERNAL_TRANSFER') sumTransfers += amountNum;
            else if (op === 'ROTATION_PAYOUT') sumPayouts += amountNum;

            const sign = isDebit ? '- ' : '+ ';
            const amountClass = isDebit ? 'debit' : 'credit';

            let statusBadge = '<span class="ok-real-status-pill success"><span class="ok-status-bullet"></span> Sucesso</span>';
            if (tx.status === 'PENDING' || tx.status === 'PROCESSING') {
              statusBadge = '<span class="ok-real-status-pill process"><span class="ok-status-bullet"></span> Em curso</span>';
            } else if (tx.status === 'FAILED') {
              statusBadge = '<span class="ok-real-status-pill failed"><span class="ok-status-bullet"></span> Falhou</span>';
            }

            const title = tx.description || tx.referenceCode || 'Movimentação';
            const initials = title.split(' ').slice(0, 2).map(w => w[0]).join('').toUpperCase() || 'TX';

            html += `
              <div class="ok-stamped-row">
                <div class="ok-stamped-sender-cell">
                  <div class="ok-stamped-avatar-fallback">${initials}</div>
                  <div style="min-width:0;">
                    <p class="ok-sender-name-text">${title}</p>
                    <p class="ok-sender-sub-text">Ref: ${tx.referenceCode}</p>
                  </div>
                </div>
                <div class="ok-stamped-date-text">${formatDateTime(tx.postedAt)}</div>
                <div>${statusBadge}</div>
                <div class="ok-stamped-amount-text ${amountClass}">${sign}${formatAOA(tx.amount)}</div>
              </div>
            `;
          });

          streamContainer.innerHTML = html;

          document.getElementById('breakdown-quotas-sum').textContent = `- ${formatAOA(sumQuotas)}`;
          document.getElementById('breakdown-deposits-sum').textContent = `+ ${formatAOA(sumDeposits)}`;
          document.getElementById('breakdown-transfers-sum').textContent = formatAOA(sumTransfers);
          document.getElementById('breakdown-payouts-sum').textContent = `+ ${formatAOA(sumPayouts)}`;

        } catch (err) {
          streamContainer.innerHTML = `
            <div class="p-4 text-center text-danger small">
              Falha ao sincronizar movimentações do livro-razão contábil.
            </div>
          `;
        }
      }

      /* ====================================================================
         4. AÇÕES GLOBAIS
         ==================================================================== */
      function setupGlobalActions() {
        const toggleBtn = document.getElementById('sidebar-toggle-btn');
        if (toggleBtn) {
          toggleBtn.addEventListener('click', () => {
            document.body.classList.toggle('mobile-nav-active');
          });
        }

        document.querySelectorAll('[data-action="logout"]').forEach(btn => {
          btn.addEventListener('click', async function (e) {
            e.preventDefault();
            try {
              await window.apiClient.post('/auth/logout', {});
              if (window.apiClient && typeof window.apiClient.clearSession === 'function') {
                window.apiClient.clearSession();
              }
            } catch (err) {}
            window.location.href = '/login';
          });
        });

        document.addEventListener('keydown', function (e) {
          if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
            const input = document.querySelector('.ok-search-capsule input');
            if (input) { e.preventDefault(); input.focus(); }
          }
        });
      }

      /* ====================================================================
         INICIALIZAÇÃO
         ==================================================================== */
      document.addEventListener('DOMContentLoaded', () => {
        initThemeToggle();
        setupGlobalActions();
        hydrateUserIdentity();
        loadWalletCore();

        document.getElementById('btn-regenerate-qr')?.addEventListener('click', regenerateNewQrToken);

        document.getElementById('btn-copy-qr-token')?.addEventListener('click', () => {
          if (!activeQrTokenCode) return;
          navigator.clipboard.writeText(activeQrTokenCode).then(() => {
            if (window.Alerts) window.Alerts.toast('Código do Token copiado!', 'success');
          });
        });
      });
    })();
  </script>
</body>
</html>