          <p class="ok-flat-desc">Total creditado no período filtrado.</p>
        </div>
        <div>
          <span class="ok-flat-metric-data" id="card-stat-credit">AOA 0,00</span>
        </div>
      </div>

      <!-- Card 3: Saídas -->
      <div class="ok-flat-card-box theme-white-alt">
        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 6V42" stroke="currentColor" stroke-linecap="square"/>
