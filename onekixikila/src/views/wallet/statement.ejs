        <div>
          <div class="ok-flat-icon-container">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="6" y="14" width="36" height="26" rx="2" stroke="currentColor" stroke-linecap="square"/>
              <path d="M6 20H42" stroke="currentColor"/>
              <circle cx="34" cy="30" r="3" stroke="currentColor"/>
            </svg>
          </div>
