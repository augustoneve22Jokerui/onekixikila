      </div>

    </div>

  </div>

  <!-- SweetAlert2 + Scripts -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js"></script>
  <script src="/js/sweet-alert.js"></script>
  <script src="/js/api-client.js"></script>
  <script src="/js/app.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

  <script>
    (function () {
      'use strict';

      /* ====================================================================
         TEMA CLARO/ESCURO
         ==================================================================== */
      const THEME_KEY = 'ok-theme';

      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-btn');
        if (!btn) return;
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }

      /* ====================================================================
         HELPERS DE AVATAR (real do backend + fallback robusto)
         ==================================================================== */
      const DEFAULT_AVATAR = '/assets/images/avatar-default.png';
      const FALLBACK_DATA_URI = 'data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 fill=%22%237c3aed%22/%3E%3Ccircle cx=%2232%22 cy=%2224%22 r=%2212%22 fill=%22%23ffffff%22/%3E%3Cpath d=%22M8 64c0-13.255 10.745-24 24-24s24 10.745 24 24%22 fill=%22%23ffffff%22/%3E%3C/svg%3E';

      function pick(obj, camel, snake, fallback) {
        if (!obj) return fallback;
        if (obj[camel] !== undefined && obj[camel] !== null) return obj[camel];
        if (obj[snake] !== undefined && obj[snake] !== null) return obj[snake];
        return fallback;
      }

      function isAbsoluteUrl(str) {
        return /^https?:\/\//i.test(str);
      }

      function resolveAvatarUrlForRender(rawUrl) {
        if (!rawUrl) return null;
        const trimmed = String(rawUrl).trim();
        if (!trimmed) return null;
        if (isAbsoluteUrl(trimmed) || trimmed.startsWith('/uploads/') || trimmed.startsWith('/assets/')) {
          if (trimmed === DEFAULT_AVATAR) return null;
          return trimmed;
        }
        return `/uploads/${trimmed.replace(/^\/+/, '')}`;
      }

      function applyAvatarToImg(imgEl, url) {
        if (!imgEl) return;
        const nextSrc = url || DEFAULT_AVATAR;

        if (imgEl.__okFallbackHandler) {
          imgEl.removeEventListener('error', imgEl.__okFallbackHandler);
          imgEl.__okFallbackHandler = null;
        }

        const onErr = function () {
          const fb = imgEl.getAttribute('data-fallback') || FALLBACK_DATA_URI;
          if (fb && imgEl.src !== fb) {
            imgEl.src = fb;
          }
        };
        imgEl.__okFallbackHandler = onErr;
        imgEl.addEventListener('error', onErr);

        if (imgEl.getAttribute('src') !== nextSrc) {
          imgEl.setAttribute('src', nextSrc);
        }
      }

      async function hydrateUserIdentity() {
        try {
          const res = await window.apiClient.get('/users/profile');
          const raw =
            (res && res.data && res.data.user) ||
            (res && res.data && res.data.data) ||
            (res && res.data) ||
            res;
          if (!raw) return;

          const fullName = pick(raw, 'fullName', 'full_name', '');
          const role = pick(raw, 'role', 'role', 'Utilizador');
          const avatarUrl = pick(raw, 'avatarUrl', 'avatar_url', null);
          const normalizedAvatar = resolveAvatarUrlForRender(avatarUrl);

          const navAvatar = document.getElementById('ok-nav-avatar');
          const navName = document.getElementById('ok-nav-fullname');
          const navRole = document.getElementById('ok-nav-role');

          applyAvatarToImg(navAvatar, normalizedAvatar);

          if (navName && fullName) {
            navName.textContent = fullName.split(' ')[0];
          }
          if (navRole) navRole.textContent = role || 'Utilizador';
        } catch (err) {
          console.warn('[STATEMENT:USER:HYDRATE] Falha ao hidratar identidade:', err && err.message);
        }
      }

      /* ====================================================================
         CONFIGURAÇÃO DE TIPOS DE OPERAÇÃO
         ==================================================================== */
      const OP_ICONS = {
        DEPOSIT:              { icon: 'bi-arrow-down-left',       color: 'ok-icon-green'  },
        WITHDRAWAL:           { icon: 'bi-arrow-up-right',         color: 'ok-icon-red'    },
        INTERNAL_TRANSFER:    { icon: 'bi-arrow-left-right',       color: 'ok-icon-blue'   },
        CONTRIBUTION_PAYMENT: { icon: 'bi-people-fill',            color: 'ok-icon-purple' },
        ROTATION_PAYOUT:      { icon: 'bi-cash-coin',              color: 'ok-icon-green'  },
        PLATFORM_FEE:         { icon: 'bi-percent',                color: 'ok-icon-yellow' },
        LATE_PENALTY:         { icon: 'bi-exclamation-triangle',   color: 'ok-icon-red'    },
        REFUND_REVERSAL:      { icon: 'bi-arrow-counterclockwise', color: 'ok-icon-blue'   }
      };

      const OP_LABELS = {
        DEPOSIT:              'Depósito',
        WITHDRAWAL:           'Levantamento',
        INTERNAL_TRANSFER:    'Transferência',
        CONTRIBUTION_PAYMENT: 'Contribuição Kixikila',
        ROTATION_PAYOUT:      'Recebimento Kixikila',
        PLATFORM_FEE:         'Comissão',
        LATE_PENALTY:         'Multa',
        REFUND_REVERSAL:      'Estorno'
      };

      /* ====================================================================
         ESTADO
         ==================================================================== */
      let currentPage = 1;
      let totalPages = 1;
      let totalItems = 0;
      let currentLimit = 20;
      let walletId = null;
      let currentWallet = null;
      let allItemsCache = [];
      let quickFilter = 'all';

      /* ====================================================================
         HELPERS
         ==================================================================== */
      function formatMoney(value) {
        if (value === null || value === undefined) return 'AOA 0,00';
        const num = Number(value);
        if (isNaN(num)) return 'AOA 0,00';
        return 'AOA ' + num.toLocaleString('pt-AO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }
      function formatDate(dateInput) {
        if (!dateInput) return '—';
        const d = new Date(dateInput);
        if (isNaN(d.getTime())) return '—';
        return d.toLocaleDateString('pt-AO', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
      }
      function escapeHtml(str) {
        if (!str) return '';
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }
      function getOpLabel(type) { return OP_LABELS[type] || type || 'Movimentação'; }

      /* ====================================================================
         CARREGAR CARTEIRA
         ==================================================================== */
      async function loadWallet() {
        try {
          const res = await window.apiClient.get('/wallet/me');
          currentWallet = res.data && res.data.wallet ? res.data.wallet : null;
          walletId = currentWallet ? currentWallet.id : null;

          if (currentWallet) {
            const bal = formatMoney(currentWallet.availableBalance || 0);
            document.getElementById('summary-balance').textContent = bal;
            document.getElementById('card-stat-balance').textContent = bal;
          }
        } catch (error) {
          console.warn('Falha ao carregar carteira:', error.message);
        }
      }

      /* ====================================================================
         CARREGAR EXTRATO
         ==================================================================== */
      async function loadStatement(page) {
        if (!walletId) {
          document.getElementById('statement-list-container').innerHTML = `
            <div class="ok-empty-state">
              <i class="bi bi-wallet2"></i>
              <h6>Carteira não encontrada</h6>
              <p class="small mb-0">Não foi possível carregar a sua carteira.</p>
            </div>
          `;
          return;
        }

        currentPage = page || 1;
        const container = document.getElementById('statement-list-container');
        const paginationBar = document.getElementById('statement-pagination-bar');
        const paginationEl = document.getElementById('statement-pagination');
        const paginationInfo = document.getElementById('statement-pagination-info');
        const filterForm = document.getElementById('wallet-statement-filter-form');

        const operationType = filterForm.querySelector('[name="operationType"]').value;
        const startDate = filterForm.querySelector('[name="startDate"]').value;
        const endDate = filterForm.querySelector('[name="endDate"]').value;
        const q = filterForm.querySelector('[name="q"]').value;

        const params = new URLSearchParams({ page: String(currentPage), limit: String(currentLimit) });
        if (operationType) params.set('operationType', operationType);
        if (startDate) params.set('startDate', startDate);
        if (endDate) params.set('endDate', endDate);
        if (q) params.set('q', q);

        container.innerHTML = `
          <div class="ok-empty-state">
            <div class="spinner-border spinner-border-sm mb-2" role="status" style="color: var(--ok-purple-vibrant);"></div>
            <p class="small mb-0">A carregar extrato...</p>
          </div>
        `;
        paginationBar.style.display = 'none';

        try {
          const res = await window.apiClient.get(`/wallet/${walletId}/statement?${params.toString()}`);
          const items = res.data || [];
          const pagination = res.pagination || {};
          totalPages = pagination.totalPages || 1;
          totalItems = pagination.totalItems || items.length;
          allItemsCache = items;

          if (items.length === 0) {
            container.innerHTML = `
              <div class="ok-empty-state">
                <i class="bi bi-receipt"></i>
                <h6>Nenhuma movimentação encontrada</h6>
                <p class="small mb-0">Ajuste os filtros ou efetue a sua primeira transação.</p>
              </div>
            `;
            updateSummary(items);
            renderCategories(items);
            return;
          }

          renderItems(items);
          updateSummary(items);
          renderCategories(items);
          renderPagination(paginationInfo, paginationEl);
          paginationBar.style.display = 'flex';

        } catch (error) {
          container.innerHTML = `
            <div class="ok-empty-state">
              <i class="bi bi-exclamation-triangle" style="color: #f43f5e;"></i>
              <h6>Não foi possível carregar o extrato</h6>
              <p class="small mb-0">${escapeHtml(error.message || 'Tente novamente em breve.')}</p>
            </div>
          `;
          paginationBar.style.display = 'none';
        }
      }

      /* ====================================================================
         RENDERIZAR ITENS
         ==================================================================== */
      function renderItems(items) {
        const container = document.getElementById('statement-list-container');

        let filtered = items;
        if (quickFilter === 'credit') filtered = items.filter(tx => tx.direction !== 'DEBIT');
        else if (quickFilter === 'debit') filtered = items.filter(tx => tx.direction === 'DEBIT');

        if (filtered.length === 0) {
          container.innerHTML = `
            <div class="ok-empty-state">
              <i class="bi bi-funnel"></i>
              <h6>Nenhum resultado para este filtro</h6>
              <p class="small mb-0">Tente ajustar os critérios de pesquisa.</p>
            </div>
          `;
          return;
        }

        const list = document.createElement('div');
        list.className = 'ok-stream-flat-list';

        filtered.forEach(function (tx) {
          const meta = OP_ICONS[tx.operationType] || OP_ICONS.INTERNAL_TRANSFER;
          const isDebit = tx.direction === 'DEBIT';
          const sign = isDebit ? '− ' : '+ ';
          const amountClass = isDebit ? 'debit' : 'credit';
          const formatted = formatMoney(tx.amount);
          const date = formatDate(tx.postedAt);
          const status = tx.status || 'COMPLETED';
          const statusClass = status === 'COMPLETED' ? 'done' : 'pending';
          const statusLabel = status === 'COMPLETED' ? 'Concluído' : status === 'PENDING' ? 'Pendente' : status;
          const statusIcon = status === 'COMPLETED' ? 'bi-check-circle-fill' : 'bi-clock-fill';

          const item = document.createElement('div');
          item.className = 'ok-stream-flat-row';
          item.innerHTML = `
            <div class="ok-stream-tx-meta">
              <div class="ok-stream-tx-icon ${meta.color}">
                <i class="bi ${meta.icon}"></i>
              </div>
              <div class="ok-stream-tx-text">
                <p class="ok-stream-tx-desc">${escapeHtml(tx.description || 'Movimentação')}</p>
                <p class="ok-stream-tx-meta-line">${date} · ${getOpLabel(tx.operationType)}</p>
              </div>
            </div>
            <div class="text-end">
              <div class="ok-stream-tx-amount ${amountClass}">${sign}${formatted}</div>
              <div class="ok-stream-tx-status ${statusClass}">
                <i class="bi ${statusIcon}"></i> ${statusLabel}
              </div>
            </div>
          `;
          item.addEventListener('click', () => openTransactionDetail(tx));
          list.appendChild(item);
        });

        container.innerHTML = '';
        container.appendChild(list);
      }

      /* ====================================================================
         RESUMO DO PERÍODO
         ==================================================================== */
      function updateSummary(items) {
        let credit = 0, debit = 0;
        items.forEach(tx => {
          const val = Number(tx.amount) || 0;
          if (tx.direction === 'DEBIT') debit += val;
          else credit += val;
        });

        document.getElementById('card-stat-credit').textContent = formatMoney(credit);
        document.getElementById('card-stat-debit').textContent = formatMoney(debit);
        document.getElementById('card-stat-count').textContent = items.length;

        document.getElementById('side-credit').textContent = formatMoney(credit);
        document.getElementById('side-debit').textContent = formatMoney(debit);
        document.getElementById('side-net').textContent = formatMoney(credit - debit);
        document.getElementById('side-count').textContent = items.length;
      }

      /* ====================================================================
         CATEGORIAS (POR TIPO DE OPERAÇÃO)
         ==================================================================== */
      function renderCategories(items) {
        const el = document.getElementById('side-categories');
        if (!items || items.length === 0) {
          el.innerHTML = '<div class="text-muted small py-3 text-center">Sem dados para categorizar.</div>';
          return;
        }

        const counts = {};
        items.forEach(tx => {
          const key = tx.operationType || 'OUTROS';
          counts[key] = (counts[key] || 0) + 1;
        });

        const sorted = Object.entries(counts).sort((a, b) => b[1] - a[1]);
        let html = '';
        sorted.forEach(([type, count]) => {
          const meta = OP_ICONS[type] || OP_ICONS.INTERNAL_TRANSFER;
          html += `
            <div class="ok-category-item">
              <div class="ok-category-icon ${meta.color}"><i class="bi ${meta.icon}"></i></div>
              <span class="ok-category-name">${escapeHtml(getOpLabel(type))}</span>
              <span class="ok-category-count">${count}</span>
            </div>
          `;
        });
        el.innerHTML = html;
      }

      /* ====================================================================
         PAGINAÇÃO
         ==================================================================== */
      function renderPagination(infoEl, controlsEl) {
        if (totalPages <= 1) {
          infoEl.textContent = '';
          controlsEl.innerHTML = '';
          return;
        }
        const from = (currentPage - 1) * currentLimit + 1;
        const to = Math.min(currentPage * currentLimit, totalItems);
        infoEl.textContent = `Mostrando ${from}–${to} de ${totalItems} movimentações`;

        let html = '';
        html += `<button class="ok-page-btn" data-page="${currentPage - 1}" ${currentPage === 1 ? 'disabled' : ''} aria-label="Anterior"><i class="bi bi-chevron-left"></i></button>`;

        for (let p = 1; p <= totalPages; p++) {
          if (p === 1 || p === totalPages || (p >= currentPage - 1 && p <= currentPage + 1)) {
            html += `<button class="ok-page-btn ${p === currentPage ? 'active' : ''}" data-page="${p}">${p}</button>`;
          } else if (p === currentPage - 2 || p === currentPage + 2) {
            html += `<span class="ok-page-btn" style="cursor:default;">…</span>`;
          }
        }

        html += `<button class="ok-page-btn" data-page="${currentPage + 1}" ${currentPage === totalPages ? 'disabled' : ''} aria-label="Seguinte"><i class="bi bi-chevron-right"></i></button>`;
        controlsEl.innerHTML = html;

        controlsEl.querySelectorAll('[data-page]').forEach(btn => {
          btn.addEventListener('click', function () {
            const p = Number(btn.getAttribute('data-page'));
            if (p > 0 && p <= totalPages && p !== currentPage) {
              loadStatement(p);
              window.scrollTo({ top: 0, behavior: 'smooth' });
            }
          });
        });
      }

      /* ====================================================================
         DETALHE DA TRANSAÇÃO (MODAL)
         ==================================================================== */
      function openTransactionDetail(tx) {
        if (!window.Swal) return;
        const isDebit = tx.direction === 'DEBIT';
        const sign = isDebit ? '− ' : '+ ';
        const color = isDebit ? '#f43f5e' : '#10b981';
        const meta = OP_ICONS[tx.operationType] || OP_ICONS.INTERNAL_TRANSFER;

        window.Swal.fire({
          title: 'Detalhes da movimentação',
          html: `
            <div style="text-align: left; font-size: 0.9rem;">
              <div style="display: flex; align-items: center; gap: 12px; padding: 1rem; background: rgba(124,58,237,0.08); border-radius: 12px; margin-bottom: 1rem;">
                <div style="width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.5);">
                  <i class="bi ${meta.icon}" style="font-size: 1.2rem; color: #7c3aed;"></i>
                </div>
                <div>
                  <div style="font-size: 0.75rem; color: #64748b;">${getOpLabel(tx.operationType)}</div>
                  <div style="font-size: 1.2rem; font-weight: 800; color: ${color};">${sign}${formatMoney(tx.amount)}</div>
                </div>
              </div>
              <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #e8ecf1;">
                <span style="color: #64748b;">Descrição</span><strong>${escapeHtml(tx.description || '—')}</strong>
              </div>
              <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #e8ecf1;">
                <span style="color: #64748b;">Referência</span><strong>${escapeHtml(tx.referenceCode || '—')}</strong>
              </div>
              <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #e8ecf1;">
                <span style="color: #64748b;">Data</span><strong>${formatDate(tx.postedAt)}</strong>
              </div>
              <div style="display: flex; justify-content: space-between; padding: 8px 0;">
                <span style="color: #64748b;">Estado</span>
                <strong style="color: ${tx.status === 'COMPLETED' ? '#10b981' : '#f59e0b'};">
                  ${tx.status === 'COMPLETED' ? 'Concluído' : tx.status === 'PENDING' ? 'Pendente' : (tx.status || '—')}
                </strong>
              </div>
            </div>
          `,
          showCancelButton: true,
          confirmButtonText: 'Ver comprovativo',
          cancelButtonText: 'Fechar',
          confirmButtonColor: '#7c3aed',
          cancelButtonColor: '#64748b',
          reverseButtons: true
        }).then(result => {
          if (result.isConfirmed && tx.id) {
            window.location.href = `/wallet/receipts?tx=${tx.id}`;
          }
        });
      }

      /* ====================================================================
         EXPORTAR CSV
         ==================================================================== */
      function exportStatementCSV() {
        if (!allItemsCache || allItemsCache.length === 0) {
          if (window.Alerts) window.Alerts.info('Sem dados', 'Não há movimentações para exportar.');
          return;
        }
        const headers = ['Data', 'Tipo', 'Descrição', 'Referência', 'Direção', 'Montante (AOA)', 'Estado'];
        const rows = allItemsCache.map(tx => [
          formatDate(tx.postedAt),
          getOpLabel(tx.operationType),
          tx.description || '',
          tx.referenceCode || '',
          tx.direction === 'DEBIT' ? 'Saída' : 'Entrada',
          Number(tx.amount || 0).toFixed(2).replace('.', ','),
          tx.status || ''
        ]);
        const csv = [headers, ...rows]
          .map(r => r.map(cell => `"${String(cell).replace(/"/g, '""')}"`).join(';'))
          .join('\n');
        const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `extrato-onekixikila-${new Date().toISOString().slice(0, 10)}.csv`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
        if (window.Alerts) window.Alerts.toast('Extrato exportado com sucesso!', 'success');
      }

      /* ====================================================================
         FILTROS RÁPIDOS
         ==================================================================== */
      function bindQuickFilters() {
        document.querySelectorAll('#quick-filters [data-quick]').forEach(btn => {
          btn.addEventListener('click', function () {
            document.querySelectorAll('#quick-filters [data-quick]').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            quickFilter = btn.getAttribute('data-quick');
            renderItems(allItemsCache);
          });
        });
      }

      function bindClearFilters() {
        const btn = document.getElementById('btn-clear-filters');
        if (!btn) return;
        btn.addEventListener('click', function () {
          const form = document.getElementById('wallet-statement-filter-form');
          form.reset();
          quickFilter = 'all';
          document.querySelectorAll('#quick-filters [data-quick]').forEach(b => b.classList.remove('active'));
          document.querySelector('#quick-filters [data-quick="all"]').classList.add('active');
          loadStatement(1);
        });
      }

      /* ====================================================================
         AÇÕES GLOBAIS
         ==================================================================== */
      function setupGlobalActions() {
        const toggleBtn = document.getElementById('sidebar-toggle-btn');
        if (toggleBtn) {
          toggleBtn.addEventListener('click', () => {
            document.body.classList.toggle('mobile-nav-active');
          });
        }

        document.querySelectorAll('[data-action="logout"]').forEach(btn => {
          btn.addEventListener('click', async function (e) {
            e.preventDefault();
            try {
              await window.apiClient.post('/auth/logout', {});
              if (window.apiClient && typeof window.apiClient.clearSession === 'function') {
                window.apiClient.clearSession();
              }
            } catch (err) {}
            window.location.href = '/login';
          });
        });

        document.addEventListener('keydown', function (e) {
          if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
            const input = document.getElementById('global-search-input');
            if (input) { e.preventDefault(); input.focus(); }
          }
        });
      }

      /* ====================================================================
         INICIALIZAÇÃO
         ==================================================================== */
      document.addEventListener('DOMContentLoaded', async function () {
        initThemeToggle();
        hydrateUserIdentity();
        setupGlobalActions();
        bindQuickFilters();
        bindClearFilters();

        await loadWallet();
        if (walletId) await loadStatement(1);

        const filterForm = document.getElementById('wallet-statement-filter-form');
        if (filterForm) {
          filterForm.addEventListener('submit', function (e) {
            e.preventDefault();
            loadStatement(1);
          });
        }

        const exportBtn = document.getElementById('btn-export-statement');
        if (exportBtn) exportBtn.addEventListener('click', exportStatementCSV);
      });
    })();
  </script>
</body>
</html>