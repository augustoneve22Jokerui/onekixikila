<!DOCTYPE html>
<html lang="pt-AO">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>Verificação de Identidade (KYC) — OneKixikila</title>
  <% if (typeof csrfToken !== 'undefined') { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
  <% } %>
  <link rel="icon" type="image/x-icon" href="/assets/images/favicon.ico">

  <!-- Tipografia -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>
    /* =========================================================================
       SISTEMA DE DESIGN — ONEKIXIKILA (TEMA ESCURO PADRÃO + TEMA CLARO)
       Sidebar e Top Bar MANTÊM arredondamento normal (cápsulas/pill).
       Apenas os CARDS CENTRAIS de conteúdo são quadrados.
       Cor principal: roxo (sem verde).
       ========================================================================= */
    :root,
    html[data-theme="dark"] {
      --ok-bg-canvas: #050508;
      --ok-bg-surface: #0a0a10;
      --ok-bg-elevated: #111118;

      --ok-purple-primary: #7c3aed;
      --ok-purple-vibrant: #8b5cf6;
      --ok-purple-soft: rgba(139, 92, 246, 0.12);
      --ok-purple-border: rgba(139, 92, 246, 0.3);

      --ok-text-primary: #ffffff;
      --ok-text-secondary: #cbd5e1;
      --ok-text-muted: #94a3b8;

      --ok-border-subtle: rgba(255, 255, 255, 0.08);
      --ok-input-bg: rgba(255, 255, 255, 0.04);
      --ok-pill-bg: rgba(255, 255, 255, 0.05);
      --ok-pill-bg-hover: rgba(139, 92, 246, 0.12);
      --ok-shadow-card: rgba(0, 0, 0, 0.75);
      --ok-shadow-sidebar: rgba(0, 0, 0, 0.6);

      --ok-radius-pill: 9999px;
      --ok-sidebar-width: 96px;
      --ok-navbar-height: 92px;
    }

    html[data-theme="light"] {
      --ok-bg-canvas: #f4f5f9;
      --ok-bg-surface: #ffffff;
      --ok-bg-elevated: #ffffff;

      --ok-purple-primary: #6d28d9;
      --ok-purple-vibrant: #7c3aed;
      --ok-purple-soft: rgba(124, 58, 237, 0.08);
      --ok-purple-border: rgba(124, 58, 237, 0.25);

      --ok-text-primary: #0f172a;
      --ok-text-secondary: #334155;
      --ok-text-muted: #64748b;

      --ok-border-subtle: rgba(15, 23, 42, 0.10);
      --ok-input-bg: #ffffff;
      --ok-pill-bg: rgba(15, 23, 42, 0.04);
      --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
      --ok-shadow-card: rgba(15, 23, 42, 0.10);
      --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);
    }

    @media (prefers-color-scheme: light) {
      html:not([data-theme]) {
        --ok-bg-canvas: #f4f5f9;
        --ok-bg-surface: #ffffff;
        --ok-bg-elevated: #ffffff;

        --ok-purple-primary: #6d28d9;
        --ok-purple-vibrant: #7c3aed;
        --ok-purple-soft: rgba(124, 58, 237, 0.08);
        --ok-purple-border: rgba(124, 58, 237, 0.25);

        --ok-text-primary: #0f172a;
        --ok-text-secondary: #334155;
        --ok-text-muted: #64748b;

        --ok-border-subtle: rgba(15, 23, 42, 0.10);
        --ok-input-bg: #ffffff;
        --ok-pill-bg: rgba(15, 23, 42, 0.04);
        --ok-pill-bg-hover: rgba(124, 58, 237, 0.10);
        --ok-shadow-card: rgba(15, 23, 42, 0.10);
        --ok-shadow-sidebar: rgba(15, 23, 42, 0.08);
      }
    }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-font-smoothing: antialiased; }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--ok-bg-canvas);
      color: var(--ok-text-primary);
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
      transition: background-color 0.25s ease, color 0.25s ease;
      font-size: 15px;
    }

    .ok-ambient-glow-core {
      position: fixed;
      top: -140px; left: 20%;
      width: 650px; height: 650px;
      background: radial-gradient(circle, rgba(124, 58, 237, 0.16) 0%, rgba(5, 5, 8, 0) 70%);
      pointer-events: none; z-index: 0; filter: blur(100px);
    }
    html[data-theme="light"] .ok-ambient-glow-core {
      background: radial-gradient(circle, rgba(124, 58, 237, 0.12) 0%, rgba(244, 245, 249, 0) 70%);
    }

    /* =========================================================================
       BARRA LATERAL — MANTÉM ARREDONDAMENTO (pill/cápsula)
       ========================================================================= */
    .ok-rail-sidebar {
      position: fixed;
      top: 24px; left: 24px; bottom: 24px;
      width: var(--ok-sidebar-width);
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 24px;
      display: flex; flex-direction: column; align-items: center;
      padding: 26px 0;
      z-index: 1040;
      box-shadow: 0 12px 36px var(--ok-shadow-sidebar);
      backdrop-filter: blur(24px);
      transition: all 0.3s ease;
    }

    .ok-brand-emblem {
      width: 56px; height: 56px; border-radius: 18px;
      background: linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 32px;
      box-shadow: 0 10px 26px rgba(124, 58, 237, 0.45);
      text-decoration: none;
    }
    .ok-brand-emblem svg { width: 28px; height: 28px; }

    .ok-rail-nav {
      flex: 1;
      display: flex; flex-direction: column; align-items: center;
      gap: 16px; width: 100%;
    }

    .ok-rail-link {
      width: 52px; height: 52px; border-radius: 16px;
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-muted); text-decoration: none;
      transition: all 0.2s ease; background: transparent;
      position: relative;
    }
    .ok-rail-link svg { width: 22px; height: 22px; }
    .ok-rail-link:hover {
      color: var(--ok-purple-vibrant);
      background-color: var(--ok-purple-soft);
      transform: translateY(-2px);
    }
    .ok-rail-link.active {
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      color: #ffffff;
      box-shadow: 0 10px 24px rgba(139, 92, 246, 0.5);
    }

    .ok-rail-footer {
      display: flex; flex-direction: column; align-items: center;
      gap: 12px; width: 100%;
    }

    /* =========================================================================
       VIEWPORT SHELL
       ========================================================================= */
    .ok-viewport-shell {
      margin-left: calc(var(--ok-sidebar-width) + 44px);
      padding: 24px 40px 60px 0;
      position: relative; z-index: 1;
    }

    /* =========================================================================
       TOP BAR — MANTÉM ARREDONDAMENTO (pill)
       ========================================================================= */
    .ok-top-nav {
      height: var(--ok-navbar-height);
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 26px;
      gap: 20px;
      flex-wrap: wrap;
    }

    .ok-search-capsule {
      position: relative;
      width: 500px; max-width: 100%;
    }
    .ok-search-capsule input {
      width: 100%; height: 54px;
      border-radius: var(--ok-radius-pill);
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      padding: 0 90px 0 52px;
      font-size: 0.96rem;
      color: var(--ok-text-primary);
      outline: none;
      transition: all 0.25s ease;
    }
    .ok-search-capsule input::placeholder { color: var(--ok-text-muted); }
    .ok-search-capsule input:focus {
      border-color: var(--ok-purple-vibrant);
      box-shadow: 0 0 0 4px var(--ok-purple-soft);
    }
    .ok-search-capsule .search-icon {
      position: absolute; left: 18px; top: 50%;
      transform: translateY(-50%);
      color: var(--ok-text-muted);
    }
    .ok-search-capsule .search-icon svg { width: 18px; height: 18px; }
    .ok-search-capsule .shortcut-hint {
      position: absolute; right: 14px; top: 50%;
      transform: translateY(-50%);
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 8px;
      padding: 4px 9px;
      font-size: 0.74rem;
      color: var(--ok-text-muted);
      font-weight: 600;
    }

    .ok-nav-actions { display: flex; align-items: center; gap: 14px; }

    .ok-action-circle {
      width: 52px; height: 52px; border-radius: 16px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-primary);
      text-decoration: none;
      transition: all 0.2s ease;
      position: relative;
    }
    .ok-action-circle:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      transform: translateY(-2px);
    }

    .ok-profile-pill {
      display: flex; align-items: center; gap: 12px;
      padding: 6px 20px 6px 6px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: var(--ok-radius-pill);
      text-decoration: none; cursor: pointer;
    }
    .ok-profile-avatar-nav {
      width: 44px; height: 44px;
      border-radius: 50%; object-fit: cover;
      background: var(--ok-purple-soft);
      border: 2px solid var(--ok-purple-border);
    }

    .ok-theme-toggle {
      width: 52px; height: 52px; border-radius: 16px;
      background-color: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      display: flex; align-items: center; justify-content: center;
      color: var(--ok-text-primary); cursor: pointer;
      transition: all 0.2s ease;
    }
    .ok-theme-toggle:hover {
      border-color: var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      transform: translateY(-2px);
    }
    .ok-theme-toggle svg { width: 20px; height: 20px; }

    /* =========================================================================
       HERO — TAMBÉM ARREDONDADO (breadcrumb pill, beacon pill)
       ========================================================================= */
    .ok-canvas-hero-title {
      max-width: 1280px;
      margin: 0 auto 30px auto;
      display: flex; justify-content: space-between; align-items: flex-end;
      flex-wrap: wrap; gap: 20px;
    }

    .ok-breadcrumb-btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 16px;
      background: var(--ok-pill-bg);
      border: 1px solid var(--ok-border-subtle);
      border-radius: var(--ok-radius-pill);
      color: var(--ok-text-muted);
      text-decoration: none;
      font-size: 0.86rem; font-weight: 700;
      margin-bottom: 12px;
      transition: all 0.2s ease;
    }
    .ok-breadcrumb-btn:hover {
      background: var(--ok-pill-bg-hover);
      color: var(--ok-purple-vibrant);
      border-color: var(--ok-purple-border);
      transform: translateX(-2px);
    }

    .ok-page-title-main {
      font-size: 2.15rem; font-weight: 800;
      letter-spacing: -0.03em; line-height: 1.15;
      color: var(--ok-text-primary);
      margin: 0;
      display: flex; align-items: center; gap: 14px;
      flex-wrap: wrap;
    }

    .ok-live-beacon {
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 0.76rem; font-weight: 800;
      padding: 5px 13px;
      border-radius: var(--ok-radius-pill);
      background: var(--ok-purple-soft);
      border: 1px solid var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
      letter-spacing: 0.04em; text-transform: uppercase;
    }
    .ok-pulse-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background-color: var(--ok-purple-vibrant);
      box-shadow: 0 0 10px var(--ok-purple-vibrant);
    }

    .ok-canvas-sub {
      color: var(--ok-text-muted);
      font-size: 0.96rem; margin-top: 8px; line-height: 1.5;
    }

    /* =========================================================================
       LAYOUT PRINCIPAL
       ========================================================================= */
    .ok-kyc-layout-grid {
      display: grid;
      grid-template-columns: 1fr 440px;
      gap: 32px;
      max-width: 1280px;
      margin: 0 auto;
      align-items: start;
    }

    /* =========================================================================
       APENAS CARDS CENTRAIS SÃO QUADRADOS (border-radius: 0)
       ========================================================================= */

    .ok-kyc-form-card {
      background: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 0;   /* quadrado */
      padding: 2.25rem;
      box-shadow: 0 10px 36px var(--ok-shadow-card);
    }

    .ok-tier-status-card {
      background: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 0;   /* quadrado */
      padding: 1.75rem;
      box-shadow: 0 10px 36px var(--ok-shadow-card);
      margin-bottom: 24px;
    }

    .ok-side-widget-card {
      background: var(--ok-bg-surface);
      border: 1px solid var(--ok-border-subtle);
      border-radius: 0;   /* quadrado */
      padding: 1.75rem;
      box-shadow: 0 10px 36px var(--ok-shadow-card);
      margin-bottom: 24px;
    }

    .ok-vigilance-card {
      background: linear-gradient(145deg, var(--ok-bg-surface) 0%, var(--ok-bg-canvas) 100%);
      border: 1px solid var(--ok-purple-border);
      border-radius: 0;   /* quadrado */
      padding: 1.75rem;
      position: relative;
      overflow: hidden;
      box-shadow: 0 8px 32px var(--ok-shadow-card), 0 0 30px rgba(124, 58, 237, 0.15);
    }

    .ok-tier-badge {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 16px;
      border-radius: 0;   /* quadrado */
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 16px;
      background: var(--ok-purple-soft);
      border: 1px solid var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
    }
    .ok-tier-badge.warning,
    .ok-tier-badge.success,
    .ok-tier-badge.info {
      background: var(--ok-purple-soft);
      border: 1px solid var(--ok-purple-border);
      color: var(--ok-purple-vibrant);
    }

    .ok-step-num {
      width: 32px; height: 32px;
      border-radius: 0;   /* quadrado */
      background: var(--ok-purple-soft);
      color: var(--ok-purple-vibrant);
      display: flex; align-items: center; justify-content: center;
      font-weight: 800;
      font-size: 0.88rem;
      flex-shrink: 0;
    }

    /* Inputs/Selects dos formulários centrais — quadrados */
    .ok-input-pill-tech,
    .ok-select-pill-tech {
      width: 100%;
      height: 52px;
      border-radius: 0;   /* quadrado */
      background: var(--ok-input-bg);
      border: 1.5px solid var(--ok-border-subtle);
      padding: 0 22px;
      font-size: 0.94rem;
      color: var(--ok-text-primary);
      outline: none;
      transition: all 0.25s ease;
    }
    .ok-input-pill-tech:focus,
    .ok-select-pill-tech:focus {
      border-color: var(--ok-purple-vibrant);
      background: var(--ok-bg-surface);
      box-shadow: 0 0 0 4px var(--ok-purple-soft);
    }
    .ok-input-pill-tech::placeholder { color: var(--ok-text-muted); }
    .ok-select-pill-tech option { color: #0f172a; }

    .ok-file-input-tech {
      width: 100%;
      min-height: 52px;
      border-radius: 0;   /* quadrado */
      background: var(--ok-input-bg);
      border: 1.5px dashed var(--ok-border-subtle);
      padding: 12px 16px;
      font-size: 0.9rem;
      color: var(--ok-text-primary);
      outline: none;
      transition: all 0.25s ease;
      cursor: pointer;
    }
    .ok-file-input-tech:hover {
      border-color: var(--ok-purple-vibrant);
      background: var(--ok-purple-soft);
    }
    .ok-file-input-tech::file-selector-button {
      background: var(--ok-purple-soft);
      color: var(--ok-purple-vibrant);
      border: 1px solid var(--ok-purple-border);
      border-radius: 0;   /* quadrado */
      padding: 6px 14px;
      font-size: 0.82rem;
      font-weight: 700;
      margin-right: 12px;
      cursor: pointer;
    }

    .ok-btn-submit-action {
      height: 54px;
      padding: 0 32px;
      border-radius: 0;   /* quadrado */
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      color: #ffffff;
      border: none;
      font-size: 0.96rem;
      font-weight: 800;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 8px 24px rgba(124, 58, 237, 0.45);
      transition: all 0.25s ease;
      width: 100%;
    }
    .ok-btn-submit-action:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(124, 58, 237, 0.65);
      color: #ffffff;
    }
    .ok-btn-submit-action:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      transform: none;
    }

    /* Textos e headings dos cards centrais */
    .ok-form-section-heading {
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--ok-text-primary);
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--ok-border-subtle);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .ok-form-label-tech {
      font-size: 0.86rem;
      font-weight: 700;
      color: var(--ok-text-primary);
      margin-bottom: 8px;
      display: block;
    }

    .ok-tier-title {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--ok-text-primary);
      margin: 0 0 8px 0;
    }
    .ok-tier-desc {
      font-size: 0.88rem;
      color: var(--ok-text-muted);
      line-height: 1.55;
      margin: 0;
    }

    .ok-widget-title-row {
      display: flex; align-items: center; gap: 10px;
      margin-bottom: 20px;
    }
    .ok-widget-title-row h5 {
      font-size: 1.1rem; font-weight: 800;
      margin: 0;
      color: var(--ok-text-primary);
    }

    .ok-step-row {
      display: flex; gap: 14px;
      padding: 14px 0;
      border-bottom: 1px solid var(--ok-border-subtle);
    }
    .ok-step-row:last-child { border-bottom: none; }
    .ok-step-title {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--ok-text-primary);
      margin: 0 0 4px 0;
    }
    .ok-step-desc {
      font-size: 0.78rem;
      color: var(--ok-text-muted);
      margin: 0;
      line-height: 1.5;
    }

    .ok-vigilance-card svg.watermark {
      position: absolute;
      right: -20px; bottom: -20px;
      width: 140px; height: 140px;
      opacity: 0.08;
      pointer-events: none;
      color: var(--ok-purple-vibrant);
    }

    /* Link "Rever Sessões de Acesso" no card de privacidade — mantém pill do hero */
    .ok-vigilance-card .ok-breadcrumb-btn { margin: 0; }

    /* Responsividade */
    @media (max-width: 1280px) {
      .ok-kyc-layout-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 991px) {
      .ok-rail-sidebar { transform: translateX(-140%); }
      .ok-viewport-shell { margin-left: 0; padding: 20px; }
      body.mobile-nav-active .ok-rail-sidebar { transform: translateX(0); }
      .ok-page-title-main { font-size: 1.7rem; }
    }
  </style>
</head>
<body>

  <div class="ok-ambient-glow-core"></div>

  <!-- ======================================================================
       BARRA LATERAL SLIM TECH — MANTÉM ARREDONDAMENTO
       ====================================================================== -->
  <aside class="ok-rail-sidebar" id="app-rail-sidebar" aria-label="Navegação Principal">
    <a href="/dashboard" class="ok-brand-emblem" title="OneKixikila Core">
      <svg viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
        <polyline points="2 17 12 22 22 17"></polyline>
        <polyline points="2 12 12 17 22 12"></polyline>
      </svg>
    </a>

    <nav class="ok-rail-nav">
      <a href="/dashboard" class="ok-rail-link" title="Painel Geral">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
      </a>

      <a href="/wallet" class="ok-rail-link" title="Carteira">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"></path></svg>
      </a>

      <a href="/groups" class="ok-rail-link" title="Grupos">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
      </a>

      <a href="/wallet/transfer" class="ok-rail-link" title="Transferências">
