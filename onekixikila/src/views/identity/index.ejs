    <div class="ok-rail-footer">
      <a href="/profile" class="ok-rail-link active" title="Perfil">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
      </a>
      <button type="button" class="ok-rail-link border-0 text-danger" data-action="logout" title="Terminar Sessão">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
      </button>
    </div>
  </aside>

  <!-- ======================================================================
       CONTEÚDO PRINCIPAL
       ====================================================================== -->
  <div class="ok-viewport-shell">

    <!-- Top Bar — MANTÉM ARREDONDAMENTO -->
    <header class="ok-top-nav">
      <div class="ok-search-capsule">
        <span class="search-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </span>
        <input type="search" placeholder="Pesquisar definições, documentos..." autocomplete="off">
        <kbd class="shortcut-hint">Ajuda</kbd>
      </div>

      <div class="ok-nav-actions">
        <button type="button" id="sidebar-toggle-btn" class="ok-action-circle d-lg-none" aria-label="Abrir menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>

        <button type="button" id="theme-toggle-btn" class="ok-theme-toggle" title="Alternar tema claro/escuro" aria-label="Alternar tema">
          <svg id="theme-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
        </button>

        <a href="/notifications" class="ok-action-circle" title="Notificações">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
        </a>

        <a href="/profile" class="ok-profile-pill">
          <img 
            id="ok-nav-avatar"
            src="<%= typeof user !== 'undefined' && user && user.avatarUrl ? user.avatarUrl : '/assets/images/avatar-default.png' %>" 
            data-fallback='data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 fill=%22%237c3aed%22/%3E%3Ccircle cx=%2232%22 cy=%2224%22 r=%2212%22 fill=%22%23ffffff%22/%3E%3Cpath d=%22M8 64c0-13.255 10.745-24 24-24s24 10.745 24 24%22 fill=%22%23ffffff%22/%3E%3C/svg%3E'
            alt="Avatar" 
            class="ok-profile-avatar-nav"
          >
          <div class="d-flex flex-column text-start">
            <span class="fw-bold" style="font-size: 0.92rem; line-height: 1.15;"><%= typeof user !== 'undefined' && user && user.fullName ? user.fullName.split(' ')[0] : 'Membro' %></span>
            <span class="text-muted" style="font-size: 0.76rem;"><%= typeof user !== 'undefined' && user && user.role ? user.role : 'Utilizador' %></span>
          </div>
        </a>
      </div>
    </header>

    <!-- Hero — MANTÉM ARREDONDAMENTO (breadcrumb pill, beacon pill) -->
    <section class="ok-canvas-hero-title">
      <div>
        <a href="/profile" class="ok-breadcrumb-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
          Voltar ao Perfil
        </a>
        <h1 class="ok-page-title-main">
          Verificação de Identidade (KYC)
          <span class="ok-live-beacon">
            <span class="ok-pulse-dot"></span>
            Conformidade BNA
          </span>
        </h1>
        <p class="ok-canvas-sub">
          Validação oficial conforme as diretrizes do Banco Nacional de Angola para desbloquear levantamentos e quotas elevadas.
        </p>
      </div>
    </section>

    <!-- ====================================================================
         CARDS CENTRAIS — QUADRADOS
         ==================================================================== -->
    <div class="ok-kyc-layout-grid">

      <!-- COLUNA ESQUERDA -->
      <div>
        
        <div class="ok-tier-status-card" id="kyc-status-container">
          <div class="ok-tier-badge warning" id="current-tier-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            NÍVEL 1 &bull; NÃO VERIFICADO
          </div>
          <h3 class="ok-tier-title">Estado: <span id="kyc-status-text">Pendente</span></h3>
          <p class="ok-tier-desc" id="kyc-desc-text">
            Submeta o seu Bilhete de Identidade para desbloquear levantamentos e quotas elevadas.
          </p>
        </div>

        <div class="ok-kyc-form-card">
          <form id="kyc-submission-form" enctype="multipart/form-data">
            <h5 class="ok-form-section-heading">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--ok-purple-vibrant)" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
              Submeter Documento Oficial
            </h5>

            <div class="row g-4">
              <div class="col-md-6">
                <label class="ok-form-label-tech">Tipo de Documento *</label>
                <select id="idType" name="idType" class="ok-select-pill-tech">
                  <option value="NATIONAL_ID" selected>Bilhete de Identidade (Angola)</option>
                  <option value="PASSPORT">Passaporte</option>
                  <option value="DRIVING_LICENSE">Carta de Condução</option>
                </select>
              </div>

              <div class="col-md-6">
                <label class="ok-form-label-tech">Número do Documento (BI) *</label>
                <input type="text" id="idNumber" name="idNumber" class="ok-input-pill-tech" placeholder="005432100LA045" required>
              </div>

              <div class="col-md-6">
                <label class="ok-form-label-tech">Nome Completo no Documento *</label>
                <input type="text" id="fullNameOnDocument" name="fullNameOnDocument" class="ok-input-pill-tech" placeholder="Conforme impresso no BI" required>
              </div>

              <div class="col-md-6">
                <label class="ok-form-label-tech">Data de Nascimento *</label>
                <input type="date" id="birthDateOnDocument" name="birthDateOnDocument" class="ok-input-pill-tech" required>
              </div>

              <div class="col-md-6">
                <label class="ok-form-label-tech">Fotografia / Cópia do BI (Frente e Verso) *</label>
                <input type="file" id="idDocument" name="idDocument" class="ok-file-input-tech" accept="image/jpeg,image/png,application/pdf" required>
              </div>

              <div class="col-md-6">
                <label class="ok-form-label-tech">Fotografia Facial (Selfie) *</label>
                <input type="file" id="facialPhoto" name="facialPhoto" class="ok-file-input-tech" accept="image/jpeg,image/png" required>
              </div>

              <div class="col-12 mt-4">
                <button type="submit" id="btn-kyc" class="ok-btn-submit-action">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width: 18px; height: 18px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                  Enviar para Homologação
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- COLUNA DIREITA -->
      <div>

        <div class="ok-side-widget-card">
          <div class="ok-widget-title-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--ok-purple-vibrant)" stroke-width="2.2" style="width: 22px; height: 22px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <h5>Como Funciona a Verificação</h5>
          </div>

          <div class="ok-step-row">
            <div class="ok-step-num">1</div>
            <div>
              <p class="ok-step-title">Submissão de Documentos</p>
              <p class="ok-step-desc">Envie a fotografia do Bilhete de Identidade (frente e verso) e uma selfie recente.</p>
            </div>
          </div>

          <div class="ok-step-row">
            <div class="ok-step-num">2</div>
            <div>
              <p class="ok-step-title">Auditoria Interna</p>
              <p class="ok-step-desc">Os nossos auditores verificam a autenticidade e o cumprimento das normas do BNA.</p>
            </div>
          </div>

          <div class="ok-step-row">
            <div class="ok-step-num">3</div>
            <div>
              <p class="ok-step-title">Aprovação & Nível 2</p>
              <p class="ok-step-desc">Após validação, é elevado a TIER 2 com acesso total a levantamentos e quotas elevadas.</p>
            </div>
          </div>

          <div class="ok-step-row">
            <div class="ok-step-num">4</div>
            <div>
              <p class="ok-step-title">Cofre Criptográfico</p>
              <p class="ok-step-desc">Todos os documentos são encriptados e armazenados em cofre privado (não-repúdio).</p>
            </div>
          </div>
        </div>

        <div class="ok-vigilance-card">
          <svg class="watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>

          <div style="position: relative; z-index: 1;">
            <div class="d-flex align-items-center gap-2 mb-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--ok-purple-vibrant)" stroke-width="2.5" style="width: 22px; height: 22px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <h5 class="fw-bold mb-0" style="font-size: 1.05rem;">Privacidade Garantida</h5>
            </div>
            <p class="small mb-3" style="color: var(--ok-text-secondary); line-height: 1.55; font-size: 0.86rem;">
              Os dados sensíveis são encriptados com chaves SHA-256 e apenas o resultado da homologação (aprovado/rejeitado) é exposto ao utilizador. Nenhum documento é partilhado com terceiros.
            </p>
            <a href="/sessions" class="ok-breadcrumb-btn" style="text-decoration: none; margin: 0;">
              Rever Sessões de Acesso &rarr;
            </a>
          </div>
        </div>

      </div>

    </div>

  </div>

  <!-- Scripts -->
  <script src="/js/sweet-alert.js"></script>
  <script src="/js/api-client.js"></script>
  <script src="/js/app.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    (function () {
      'use strict';

      /* ====================================================================
         TEMA CLARO/ESCURO
         ==================================================================== */
      const THEME_KEY = 'ok-theme';
      function applyTheme(theme) {
        const html = document.documentElement;
        if (theme === 'light' || theme === 'dark') html.setAttribute('data-theme', theme);
        else html.removeAttribute('data-theme');
        const icon = document.getElementById('theme-toggle-icon');
        if (icon) {
          const isLight = theme === 'light' ||
            (theme !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          icon.innerHTML = isLight
            ? '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>'
            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        }
      }
      function getStoredTheme() { try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; } }
      function setStoredTheme(t) { try { t ? localStorage.setItem(THEME_KEY, t) : localStorage.removeItem(THEME_KEY); } catch (e) {} }
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle-btn');
        if (!btn) return;
        const stored = getStoredTheme();
        if (stored) applyTheme(stored);
        btn.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme');
          let next;
          if (cur === 'light') next = 'dark';
          else if (cur === 'dark') next = 'light';
          else next = window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
          applyTheme(next); setStoredTheme(next);
        });
      }
      function initAvatarFallback() {
        const img = document.getElementById('ok-nav-avatar');
        if (!img) return;
        img.addEventListener('error', function onErr() {
          img.removeEventListener('error', onErr);
          const fb = img.getAttribute('data-fallback');
          if (fb && img.src !== fb) img.src = fb;
        });
      }

      function setupGlobalActions() {
        const toggleBtn = document.getElementById('sidebar-toggle-btn');
        if (toggleBtn) {
          toggleBtn.addEventListener('click', () => {
            document.body.classList.toggle('mobile-nav-active');
          });
        }
        document.querySelectorAll('[data-action="logout"]').forEach(btn => {
          btn.addEventListener('click', async function (e) {
            e.preventDefault();
            try {
              await window.apiClient.post('/auth/logout', {});
              if (window.apiClient) window.apiClient.clearSession();
            } catch (err) {}
            window.location.href = '/login';
          });
        });
      }

      /* ====================================================================
         LÓGICA KYC — PRESERVADA INTEGRALMENTE
         ==================================================================== */
      async function loadStatus() {
        try {
          const res = await window.apiClient.get('/identity/me');
          const kyc = res.data?.verification || res.data;
          if (kyc && kyc.status === 'APPROVED') {
            const badge = document.getElementById('current-tier-badge');
            badge.className = 'ok-tier-badge success';
            badge.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> NÍVEL 2 &bull; VERIFICADO';
            document.getElementById('kyc-status-text').textContent = 'Aprovado';
            document.getElementById('kyc-desc-text').textContent = 'A sua identidade oficial foi validada com sucesso.';
            document.getElementById('kyc-submission-form').style.display = 'none';
          } else if (kyc && kyc.status === 'UNDER_REVIEW') {
            const badge = document.getElementById('current-tier-badge');
            badge.className = 'ok-tier-badge info';
            badge.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> EM ANÁLISE';
            document.getElementById('kyc-status-text').textContent = 'Em Auditoria';
            document.getElementById('kyc-desc-text').textContent = 'Os seus documentos estão a ser analisados pelos auditores.';
            document.getElementById('btn-kyc').disabled = true;
            document.getElementById('btn-kyc').textContent = 'Processo já submetido em análise';
          }
        } catch (e) {}
      }

      function setupKycForm() {
        document.getElementById('kyc-submission-form').addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = document.getElementById('btn-kyc');
          btn.disabled = true;

          const formData = new FormData();
          formData.append('idType', document.getElementById('idType').value);
          formData.append('idNumber', document.getElementById('idNumber').value.trim());
          formData.append('fullNameOnDocument', document.getElementById('fullNameOnDocument').value.trim());
          formData.append('birthDateOnDocument', document.getElementById('birthDateOnDocument').value);
          formData.append('idDocument', document.getElementById('idDocument').files[0]);
          formData.append('facialPhoto', document.getElementById('facialPhoto').files[0]);

          try {
            if (window.Alerts) window.Alerts.showLoading('A enviar documentos...', 'Criptografando para o cofre seguro.');
            await window.apiClient.upload('/identity/submit', formData);
            if (window.Alerts) {
              window.Alerts.closeLoading();
              await window.Alerts.success('Documentos Submetidos!', 'A sua verificação está em análise.');
            }
            window.location.reload();
          } catch (err) {
            if (window.Alerts) {
              window.Alerts.closeLoading();
              window.Alerts.error(err.message || 'Erro ao submeter KYC.');
            }
            btn.disabled = false;
          }
        });
      }

      document.addEventListener('DOMContentLoaded', () => {
        initThemeToggle();
        initAvatarFallback();
        setupGlobalActions();
        loadStatus();
        setupKycForm();
      });
    })();
  </script>
</body>
</html>